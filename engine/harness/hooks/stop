#!/usr/bin/env bash
# Stop hook: refuse to let a session end on work nothing has verified.
#
# This is the guidebook's central rule, and until now Felix stated it without
# enforcing it. Two events were wired, SessionStart and UserPromptSubmit, and
# both only inject text. Between an agent writing code and an agent saying it is
# done, there was nothing.
#
# The decision is made on the state of the tree, never on what the agent said.
# The payload carries last_assistant_message, and matching "done" or "tests pass"
# against it was considered and rejected: it fails in the worst direction. "that
# should do it" would slip through while an honest "complete, though I have not
# run anything" would be blocked. Tree state has no such failure mode.
#
# Honest about its reach. The platform documents that a Stop hook must return
# success while stop_hook_active is set, and caps consecutive blocks itself, so
# this interrupts once per chain it starts; a chain another hook started is
# judged like any other stop (felix_hold_take in lib/verify.sh). The one
# exception is a session's own night, which carries through the chain on bounds
# of its own (lib/overnight.sh).
# Everything else is a speed bump with a permanent record,
# not an inescapable barrier. The inescapable barrier is CI at the merge
# boundary, which Felix already sets up and which is not affected by this.
#
# Everything unexpected allows and records. A completion gate that can strand a
# session gets removed, and a removed gate enforces nothing.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FELIX_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
. "${SCRIPT_DIR}/../lib/resolve.sh"
. "${SCRIPT_DIR}/../lib/verify.sh"
. "${SCRIPT_DIR}/../lib/route.sh"
. "${SCRIPT_DIR}/../lib/ready.sh"
. "${SCRIPT_DIR}/../lib/guard.sh"
. "${SCRIPT_DIR}/../lib/say.sh"
. "${SCRIPT_DIR}/../lib/detect.sh"
. "${SCRIPT_DIR}/../lib/maintenance.sh"
. "${SCRIPT_DIR}/../lib/overnight.sh"
. "${SCRIPT_DIR}/../lib/overnight-stop.sh"

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# The payload is read before any decision now, because the refusal below is a
# block like every other one here. The platform documents that a Stop hook must
# return success while stop_hook_active is set, and deciding to block before
# consulting that flag is how a hook loops.
#
# Tokenised whole rather than parsed, for the same reason the prompt hook does
# it: a hand-rolled JSON reader breaks on the first payload containing a quote,
# and the failure mode is a hook that silently stops enforcing anything.
raw="$(cat 2>/dev/null || true)"
SID="$(printf '%s' "$raw" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
# The flag is read as a FIELD, not as two substrings in order. The payload
# carries the model's last message, and a glob for `"stop_hook_active"` then
# `true` anywhere after it was satisfied by a message containing the word —
# a session whose final sentence was "that is true" was exempt from its own
# gate. Anchored on the structural comma or brace before the key, which an
# occurrence inside a JSON string cannot have: a quote inside a string is
# spelt \" there, and the character before it is a backslash.
_active="$(printf '%s' "$raw" \
  | sed -n 's/.*[{,][[:space:]]*"stop_hook_active"[[:space:]]*:[[:space:]]*\([a-z]*\).*/\1/p' \
  | head -1)"

FELIX_HOME_DIR="$(felix_home "$FELIX_ROOT")"

# A chain the platform started from Felix's own hold ends here, as the
# platform asks, except for a session that holds a night of its own. That
# night is the grant to keep going, and leaving at the flag meant it held a
# session once per prompt, so a session nobody was typing into (the one kind
# a night exists for) got a single continuation. It is bounded by its own
# deadline, budget and quiet count (lib/overnight-stop.sh), and inside the chain
# nothing else here may block: every other refusal below still lets a chain
# end, as it always has, except the gate's, which is charged to the night.
#
# A chain Felix did not start does not end here. The flag says only that some
# hook started this turn, and an asyncRewake hook's rewake is a turn started
# with it set, so leaving at the flag let the turn that answered a background
# review end unchecked and unrecorded. The hold's own record tells the two
# apart, and is taken at every flagged stop, a night's included, so a night
# leaves none behind. An id or a record that cannot tell ends the stop, as
# before. FOREIGN marks a stop judged inside another hook's chain.
CHAIN=0 FOREIGN=0
if [ "${_active:-}" = "true" ]; then
  _chain_proj="$(felix_resolve_project "$PWD" "$FELIX_HOME_DIR" 2>/dev/null)" || exit 0
  felix_hold_take "$FELIX_HOME_DIR" "${SID:-}"; _held=$?
  if felix_overnight_owns "$_chain_proj" "${SID:-}"; then
    CHAIN=1
  else
    [ "$_held" -eq 1 ] || exit 0
    FOREIGN=1
  fi
else
  felix_hold_clear "$FELIX_HOME_DIR" "${SID:-}"
fi

# Every hold goes on record as Felix's own before it is made, because the
# flagged stop after it is let through on that record alone. Inside another
# hook's chain a hold that cannot be recorded is not made: the stop after it
# would be judged afresh and held again, and two holds in a row is a loop.
_felix_stop_may_hold() {
  felix_hold_mark "$FELIX_HOME_DIR" "${SID:-}" || [ "$FOREIGN" = "0" ]
}

# The transcript this stop's payload names, or nothing.
_felix_stop_tp() {
  printf '%s' "$raw" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

# This session's night, decided at this stop. It exits when the night decides:
# with a hold, or with the morning page when the night ended here. It returns
# when the session holds no night, and the caller carries on as if there were
# none. The argument is whatever else this stop had to say, carried along
# because a blocking branch that exits first silences every message after it.
_felix_stop_night() {   # extra -> exits, or returns
  local body rc due
  due="$(felix_maint_status "$PROJ" "$ROOT" 2>/dev/null | awk -F'\t' '$1 == "due" { printf "%s%s", sep, $2; sep = ", " }')"
  body="$(felix_overnight_continue "$PROJ" "${SID:-}" "$(_felix_stop_tp)" "$due")"; rc=$?
  case "$rc" in
    0)
      body="${body}${1:-}"
      _felix_stop_may_hold
      felix_say "$PROJ" "overnight" "$body" "" "${SID:-}"
      printf '{\n  "decision": "block",\n  "reason": "%s"\n}\n' "$(escape_for_json "$body")"
      exit 0 ;;
    2)
      body="${body}${1:-}"
      felix_say "$PROJ" "overnight-end" "$body" "" "${SID:-}"
      printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "additionalContext": "%s"\n  }\n}\n' \
        "$(escape_for_json "$body")"
      exit 0 ;;
  esac
  return 0
}

# A session nobody in it typed into has no work of anyone's to judge. The
# platform's summary request is one (#264): held here in a tree with unverified
# work, the summarising model was told to run the gate, and whatever it did on
# that advice went into the ledger as a session. Consulted first, so nothing
# below it runs for that session: no hold, no nudge, no record. The prompt hook
# leaves the marker, and felix_session_machine says when it is honoured.
felix_session_machine "$FELIX_HOME_DIR" "${SID:-}" && exit 0

# The one place this file does not fail open, and it is deliberate.
#
# Everything else here allows and records, because a completion gate that can
# strand a session gets removed and a removed gate enforces nothing. That rule
# is about the unexpected. This is not unexpected: a marker naming a project
# that does not exist, or a home pointer naming something that is not a home,
# is somebody's edit, and until now it ended the session here with exit 0 —
# `echo nonexistent > .felix` bought no gate, no hold and no record, in one
# line, from inside the repository.
#
# An ABSENT binding still means ungoverned and still exits 0 below. What
# separates the two is the whole fix: "nothing due" and "nothing is being
# checked" must not render identically.
broken="$(felix_binding_broken "$PWD" "$FELIX_HOME_DIR")"
if [ -n "$broken" ]; then
  [ "$CHAIN" = "1" ] && exit 0
  _felix_stop_may_hold || exit 0
  felix_unresolved_log "$broken" "$PWD"
  printf '{\n  "decision": "block",\n  "reason": "%s"\n}\n' "$(escape_for_json "$broken")"
  exit 0
fi

PROJ="$(felix_resolve_project "$PWD" "$FELIX_HOME_DIR")" || PROJ=""
[ -n "$PROJ" ] || exit 0

# A project that declares no gate has nothing to enforce. Inventing an
# obligation for it would make Felix unusable on a repo part-way through
# onboarding, which is exactly when it is most wanted.
GATE="$(felix_json_str "$PROJ/project.json" gate 2>/dev/null)"
[ -n "$GATE" ] || exit 0

ROOT="$(felix_repo_root "$PWD")"
git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || exit 0

# A clean tree used to end the hook here, which meant committing your work
# skipped the completion check entirely — and committing is what you do at the
# end. "Dirty" was standing in for "this session changed something", and the two
# come apart the moment anybody commits.
#
# So a clean tree is only silence when this session also committed nothing.
# Unknown counts as unchanged: no session id, no mark, no git — the hook keeps
# its old behaviour rather than starting to block trees it knows nothing about.
#
# A night still has something to say over a tree with nothing to verify: the
# session stopping before its first commit is the one a night was granted to
# keep going, and this exit used to let it close for the night.
if ! felix_tree_dirty "$ROOT" "$FELIX_HOME_DIR"; then
  if ! felix_session_committed "$FELIX_HOME_DIR" "${SID:-}" "$ROOT"; then
    felix_overnight_owns "$PROJ" "${SID:-}" && _felix_stop_night ""
    exit 0
  fi
fi

TID="$(felix_tree_id "$ROOT" "$FELIX_HOME_DIR")" || TID=""
if [ -z "$TID" ]; then
  felix_verify_log "$PROJ" "allowed" "" "tree identity unavailable"
  exit 0
fi

# The override is the founder's, not the model's. It is read from the
# environment the session was launched with, and an export inside a Bash tool
# call reaches that subprocess, not the already-running parent this hook
# inherits from. An override the model can reach for is not an override.
if [ "${FELIX_ALLOW_RED:-}" = "1" ]; then
  felix_verify_log "$PROJ" "override" "$TID" "FELIX_ALLOW_RED"
  exit 0
fi

# What the active route asked for and this session never used. Needs the route
# recorded by the prompt hook and the transcript this payload names; without
# either it says nothing rather than guessing.
_felix_stop_skipped() {
  local sid state routename play tp
  [ -f "$PROJ/routes.tsv" ] || return 0
  sid="$(printf '%s' "$raw" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$sid" ] || return 0
  state="$FELIX_HOME_DIR/state/route/$sid"
  [ -f "$state" ] || return 0
  routename="$(cut -d: -f1 < "$state" 2>/dev/null)"
  [ -n "$routename" ] || return 0
  # A route read off the working tree is Felix's guess, not anybody's
  # instruction, so a play it named going unused is evidence of nothing. This
  # complaint used to fire either way and cost a paragraph of explanation each
  # time, which is how a signal teaches people to skim it — and the case worth
  # reading is the other one, where a session was told to reach for something on
  # the strength of what it actually typed and did not.
  #
  # An empty third field is a state file written before provenance existed, and
  # it complains, which is what it did before. Hooks bind at session start, so
  # the writer and the reader are always the same version and that case is only
  # ever a stale file from a dead session.
  felix_route_state_guessed "$state" && return 0
  play="$(_felix_route_rows "$PROJ" | awk -F'\t' -v r="$routename" '$1==r{print $4}')"
  [ -n "$play" ] && [ "$play" != "-" ] || return 0
  tp="$(printf '%s' "$raw" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$tp" ] && [ -f "$tp" ] || return 0
  felix_route_skipped "$tp" "$play"
}

# A hook belonging to another plugin that refused tool calls this session.
_felix_stop_blocks() {
  local tp rows n hook msg who
  tp="$(printf '%s' "$raw" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$tp" ] && [ -f "$tp" ] || return 0
  rows="$(felix_guard_blocks "$tp")"
  [ -n "$rows" ] || return 0
  # Felix's own refusals are skipped rather than taken as the top row, because a
  # session that hit both would otherwise report Felix and hide the plugin that
  # is actually broken. The rows arrive sorted by count, so the first survivor
  # is still the loudest one that is somebody else's.
  n=""; hook=""; msg=""
  while IFS=$'\t' read -r c h m; do
    [ -n "${m:-}" ] || continue
    felix_guard_is_own "$m" && continue
    n="$c"; hook="$h"; msg="$m"; break
  done <<EOF
$rows
EOF
  [ -n "$msg" ] || return 0
  who="$(felix_guard_culprit "$msg")"
  printf 'Something blocked %s tool call(s) this session, and it was not Felix.\n\n' "$n"
  printf '  hook     %s\n  says     %s\n' "$hook" "$msg"
  [ -n "$who" ] && printf '  from     the %s plugin\n' "$who"
  printf '\nA plugin that ships hooks is a dependency on that plugin working, and\n'
  printf 'when one fails the error lands on the tool rather than on the plugin, so\n'
  printf 'it reads as the editor being broken. Tell the founder plainly.\n'
  # Never Felix, whatever the resolver said. The remedy for a report is not
  # switching off the thing that reports.
  [ -n "$who" ] && [ "$who" != "felix" ] && \
    printf '\nThe way out, which takes effect in the NEXT session and not this one:\n\n  felix quarantine %s\n' "$who"
}

receipt="$(felix_verify_receipt "$ROOT" "$FELIX_HOME_DIR")"
r_tid="$(printf '%s' "$receipt" | cut -f1)"
r_res="$(printf '%s' "$receipt" | cut -f2)"
r_when="$(printf '%s' "$receipt" | cut -f3)"

# Current by verify.sh's reading, which the merge boundary shares: the exact
# tree, green, and the decision epoch the gate ran under still the epoch now.
# The epoch is recomputed only on this branch, where the answer would
# otherwise be "verified", so the cost lands where a wrong answer would.
current="$(felix_verify_current "$ROOT" "$FELIX_HOME_DIR" "$PROJ" 2>/dev/null)" || true
if [ "$current" = "current" ]; then
  felix_verify_log "$PROJ" "allowed" "$TID" "green"

  # A night that was granted is a reason not to close on a green gate.
  #
  # This is the only branch in this file that holds a session whose work IS
  # verified, and it is deliberately the narrowest: it fires only for the
  # session the night belongs to, only while that night is inside its own
  # bounds, it spends one of the continuations the grant allowed, and it ends
  # the night itself the moment a bound is reached. What it says is what the
  # machine can actually see: maintenance rows that are due, decisions already
  # deferred, and whether the last continuation called any tool. It does not
  # invent work. The decision is lib/overnight-stop.sh's felix_overnight_continue.
  #
  # The condition is "this session holds a night", not "its night is live", and
  # the difference is a branch that could never run. A live night is false
  # precisely when a bound has been reached, so an expired night entered that
  # way could only ever be one that expired DURING this stop — a deadline that
  # passed while the session sat idle would skip the branch entirely, leave the
  # state file behind, and close without ever handing over the report. A
  # fixture whose deadline was in the past is what found it.
  if felix_overnight_owns "$PROJ" "${SID:-}"; then
    # The branch holds the session, so it must also carry what the branches
    # below it would have said. Written the other way round first, and it cost
    # the founder's own instruction: a night swallowed the verification nudge
    # and the skipped-play question entirely, because a blocking branch that
    # exits first is a branch that silences every message after it. Each is
    # still once per session, using the same markers those branches use.
    #
    # Once per session means once per night as well. A night holds a session
    # through the chain up to its whole budget, and a rider with no marker of
    # its own repeated at every hold, the plugin report rescanning the whole
    # transcript each time. So each says itself once and writes that it did.
    _on_extra=""
    _on_said="$FELIX_HOME_DIR/state/overnight-said/${SID:-none}"
    if ! grep -qx blocks "$_on_said" 2>/dev/null; then
      _on_blocks="$(_felix_stop_blocks)"
      if [ -n "$_on_blocks" ]; then
        _on_extra="${_on_extra}

${_on_blocks}"
        mkdir -p "$(dirname "$_on_said")" 2>/dev/null && printf 'blocks\n' >> "$_on_said" 2>/dev/null
      fi
    fi
    if ! grep -qx unrecorded "$_on_said" 2>/dev/null; then
      _on_unrec="$(felix_guard_unrecorded "$PROJ")"
      if [ -n "$_on_unrec" ]; then
        _on_extra="${_on_extra}

${_on_unrec}"
        mkdir -p "$(dirname "$_on_said")" 2>/dev/null && printf 'unrecorded\n' >> "$_on_said" 2>/dev/null
      fi
    fi
    if [ -n "${SID:-}" ] \
       && grep -qE "	superpowers(@[^	]*)?	" "$PROJ/stack.tsv" 2>/dev/null \
       && [ ! -f "$FELIX_HOME_DIR/state/verified/$SID" ]; then
      mkdir -p "$FELIX_HOME_DIR/state/verified" 2>/dev/null \
        && : > "$FELIX_HOME_DIR/state/verified/$SID" 2>/dev/null
      _on_extra="${_on_extra}

The gate is green, which means the suite passed. It does not mean the things
you said are true. Use superpowers:verification-before-completion on this
piece before you take the next one: check the claims, not the tests."
    fi
    _felix_stop_night "$_on_extra"
  fi
  # The gate is satisfied, so nothing is held. But this is the one moment where
  # "you changed the results page and never opened a browser" is a fact about
  # the work rather than a rule quoted at turn one, so it is worth saying.
  # additionalContext is non-error feedback: the conversation continues.
  # Somebody else's plugin refusing your edits looks like the editor being
  # broken, because the error lands on the tool rather than on the plugin that
  # caused it. This is the moment the count is already known.
  blocks="$(_felix_stop_blocks)"
  if [ -n "$blocks" ]; then
    felix_say "$PROJ" "plugin-blocked" "$blocks" "" "${SID:-}"
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "additionalContext": "%s"\n  }\n}\n' \
      "$(escape_for_json "$blocks")"
    exit 0
  fi

  # One message per stop, most urgent first. Something actively blocking the
  # session outranks a step that was skipped, which outranks a debt.
  unrecorded="$(felix_guard_unrecorded "$PROJ")"

  skipped="$(_felix_stop_skipped)"
  if [ -z "$skipped" ] && [ -n "$unrecorded" ]; then
    felix_say "$PROJ" "unrecorded" "$unrecorded" "" "${SID:-}"
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "additionalContext": "%s"\n  }\n}\n' \
      "$(escape_for_json "$unrecorded")"
    exit 0
  fi
  if [ -n "$skipped" ]; then
    # Three defects lived in this block and each got its own fix (#98).
    #
    # The sentence misnamed the play: both interpolations were ${skipped}, so a
    # partly-followed three-step play was reported as though the route had only
    # ever asked for the one step that was missed — and the message asks the
    # reader to judge whether the skip was right, which is the judgement it had
    # just removed the context for. The first slot now names the play.
    #
    # There was no way to answer it: it asked for a sentence and nothing could
    # receive one, so it fired identically at every close and got read as
    # furniture. `felix route --ack` is the answer channel; a recorded decline
    # consumes here, once, and lands the reason in decisions.log.
    #
    # And it repeated every stop. Once per session now, same state pattern as
    # the verification nudge below — the second raise of an unanswered question
    # adds pressure, not information.
    playline=""
    if [ -f "$FELIX_HOME_DIR/state/route/${SID:-}" ]; then
      routename="$(cut -d: -f1 < "$FELIX_HOME_DIR/state/route/${SID:-}" 2>/dev/null)"
      playline="$(_felix_route_rows "$PROJ" | awk -F'\t' -v r="$routename" '$1==r{print $4}')"
    fi
    if felix_route_ack_consume "$ROOT" "$FELIX_HOME_DIR"; then
      felix_verify_log "$PROJ" "allowed" "$TID" "play declined on the record"
      exit 0
    fi
    sstate="$FELIX_HOME_DIR/state/skipped/${SID:-none}"
    if [ -n "${SID:-}" ] && [ ! -f "$sstate" ]; then
      mkdir -p "$(dirname "$sstate")" 2>/dev/null && : > "$sstate" 2>/dev/null
      body="Before you call this finished: this session routed to work whose play is
${playline:-$skipped}, and the transcript shows ${skipped} was never used.

That may be right. Decline it on the record —

  felix route --ack \"why it does not fit\"

— or use it. A recorded decline tunes the table; this message will not repeat
this session either way."
      felix_say "$PROJ" "skipped" "$body" "" "${SID:-}"
      printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "additionalContext": "%s"\n  }\n}\n' \
        "$(escape_for_json "$body")"
    fi
    exit 0
  fi

  # A green gate proves the suite passed. It proves nothing about the claims
  # made on the way there, and those are what go wrong: work reported as fixed
  # that reached no session, a tool reported as removed that was still
  # installed, a document describing a capability the thing had already
  # outgrown. Every one of those passed a gate.
  #
  # So the last word before a session ends is the verification skill, once, and
  # only when the gate is green — a red gate is already the more urgent message
  # and has said so above. This is the end of the session, which the doctrine
  # says is one of the two moments Felix is allowed to speak.
  # Declared, not routed. Requiring a route to name it would mean it never
  # fires for a project whose table happens not to mention it — including
  # Felix's own, which is exactly the session this was missing from.
  if [ -n "${SID:-}" ] \
     && grep -qE "	superpowers(@[^	]*)?	" "$PROJ/stack.tsv" 2>/dev/null; then
    vstate="$FELIX_HOME_DIR/state/verified/$SID"
    if [ ! -f "$vstate" ]; then
      mkdir -p "$(dirname "$vstate")" 2>/dev/null && : > "$vstate" 2>/dev/null
      # What the gate actually checked, not what green is assumed to mean.
      # `felix gate --quick` skips the suite and still exits 0, and this
      # sentence said "the suite passed" over it. The receipt's fifth field
      # names what the gate reported skipping; `-` means it reported none,
      # which is not the same as none having been skipped.
      _skips="$(printf '%s' "$receipt" | cut -f5)"
      if [ -n "$_skips" ] && [ "$_skips" != "-" ]; then
        _green_line="The gate is green, but it skipped: ${_skips}. Green here does not
mean those ran."
      else
        _green_line="The gate is green, which means the suite passed."
      fi
      body="${_green_line} It does not mean
the things you said are true.

Use superpowers:verification-before-completion before calling this done. Check
the claims, not the tests: that what you reported as fixed is fixed where it
runs, that what you reported as removed is gone, and that anything you wrote
down describes what the code does now."
      felix_say "$PROJ" "verify" "$body" "" "$SID"
      printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "additionalContext": "%s"\n  }\n}\n' \
        "$(escape_for_json "$body")"
    fi
  fi
  exit 0
fi

if [ -z "$receipt" ]; then
  why="The gate has never run in this checkout."
  detail="never verified"
elif [ "$r_tid" = "$TID" ] && [ "$r_res" = "green" ]; then
  # Green on this exact tree and still not current: a fact the verdict rests
  # on moved outside the tree. Said with the reason, because "run the gate" on
  # a tree that did not change reads as the hook being broken.
  why="The gate passed on this exact tree at $r_when, but $(printf '%s' "$current" | cut -f2 | sed 's/; run felix gate$//')."
  detail="epoch moved"
elif [ "$r_tid" = "$TID" ]; then
  why="The gate failed on this exact tree, at $r_when."
  detail="failed"
else
  why="The gate last ran at $r_when, on a different tree. It has not seen this work."
  detail="stale receipt"
fi

# Inside a night's chain this refusal is only bounded by the night, so it is
# counted against it (felix_overnight_charge). A night that runs out here hands
# over the morning page and lets the session close on the red tree, which is
# what a chain always did; out of a chain nothing is charged.
if [ "$CHAIN" = "1" ]; then
  _on_body="$(felix_overnight_charge "$PROJ" "${SID:-}" "$(_felix_stop_tp)" "$detail")"; _on_rc=$?
  if [ "$_on_rc" -eq 2 ]; then
    felix_verify_log "$PROJ" "allowed" "$TID" "night over; $detail"
    felix_say "$PROJ" "overnight-end" "$_on_body" "" "${SID:-}"
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "Stop",\n    "additionalContext": "%s"\n  }\n}\n' \
      "$(escape_for_json "$_on_body")"
    exit 0
  fi
  [ "$_on_rc" -eq 0 ] || exit 0
fi

if ! _felix_stop_may_hold; then
  felix_verify_log "$PROJ" "allowed" "$TID" "$detail; inside another hook's chain, and the hold could not be recorded"
  exit 0
fi
felix_verify_log "$PROJ" "blocked" "$TID" "$detail"

reason="$why

Do not describe this work as complete until it has passed.

  felix gate

If you have already decided to stop with a red gate, that is the founder's call
to make, not yours: they can set FELIX_ALLOW_RED=1 in the environment they
launch a session from. If the red is one TASK_BLOCKING obligation, the narrower
way past it is a row in the project's exceptions.tsv, keyed to that obligation
and dated, merged by a person; a session cannot grant itself one."

felix_say "$PROJ" "held" "$reason" "" "${SID:-}"
printf '{\n  "decision": "block",\n  "reason": "%s"\n}\n' "$(escape_for_json "$reason")"
exit 0
