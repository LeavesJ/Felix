# Sets PROJ in the caller's shell rather than printing it. Printing would force
# callers into $(...), and an exit inside a command substitution only kills the
# subshell: the script would sail past a failed resolution and die later with a
# misleading message and the wrong status.
#
# The status is 2 unless the caller names another. A command whose exit status
# is read by a machine may already mean something by 2: felix repair's 2 is the
# repair ceiling, and the unattended template escalated an unresolvable checkout
# to a person as a spent ceiling.
resolve_or_die() {
  local rc="${1:-2}"
  PROJ="$(felix_resolve_project "$PWD" "$FELIX_HOME_DIR")" || PROJ=""
  [ -n "$PROJ" ] && return 0
  # The CLI already refused here, but it refused with the wrong sentence. A
  # marker naming a project that does not exist is not an absent binding, and
  # telling somebody to "add a .felix file" while a broken one sits in front of
  # them sends them to add a second problem.
  local broken; broken="$(felix_binding_broken "$PWD" "$FELIX_HOME_DIR")"
  [ -n "$broken" ] && die "$broken" "$rc"
  die "no project governs $PWD.
  Either add a .felix file naming one, or declare remote_match in a project.json.
  Known projects: $(ls "$FELIX_HOME_DIR/projects" 2>/dev/null | tr '\n' ' ')" "$rc"
}


cmd_install() {
  local uninstall=0 home="" a bump=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --uninstall) uninstall=1; shift ;;
      # Bumping is the default because withholding it is what cost nine gate
      # failures. The flag exists for the one case where somebody genuinely
      # wants to see the mismatch without changing the manifest.
      --no-bump)   bump=0; shift ;;
      --home) need_value "$@"; home="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [ "$uninstall" -eq 1 ]; then
    claude plugin uninstall felix@felix >/dev/null 2>&1 \
      && printf 'removed the felix plugin\n' \
      || printf 'felix plugin was not installed\n'
    # Neither is touched, and both are named, because they stopped being one
    # directory on 2026-08-14. This message still said the home held doctrine
    # and memory long after memory had moved out of it — accurate about what was
    # preserved and wrong about where, which on the one path where somebody is
    # deciding whether they are about to lose something is the worst place for a
    # message to be vague.
    printf 'left %s alone: it holds your doctrine\n' "$FELIX_HOME_DIR"
    printf 'left %s alone: it holds your memory\n' "$(felix_mem_root)"
    return 0
  fi

  [ -n "$home" ] && FELIX_HOME_DIR="$(cd "$home" 2>/dev/null && pwd || printf '%s' "$home")"
  mkdir -p "$FELIX_HOME_DIR/projects"
  printf '%s\n' "$FELIX_HOME_DIR" > "$HOME/.felix-home"
  printf 'home:    %s\n' "$FELIX_HOME_DIR"

  # The tree being deployed FROM, which is not the tree this script is running
  # IN whenever somebody follows the instruction every session prints and
  # invokes the deployed CLI. FELIX_ROOT comes from the running script's own
  # location and cannot be overridden, so from the plugin cache it names the
  # cache — and every check below it compared the deployed engine with itself,
  # passed, and deployed nothing. #55.
  #
  # Resolved after --home on purpose, so an explicit --home is honoured.
  #
  # Not $FELIX_HOME_DIR, which is what the issue proposed. The home is the
  # repository ROOT and the engine is nested one level inside it —
  # marketplace.json declares `"source": "./engine"`, so the deployed tree is
  # the CONTENTS of engine/. Substituting the home verbatim names
  # "<repo>/harness", which does not exist, and turns a false pass into a false
  # failure with a wrong diagnosis. Worse, on the very invocation #55 is about
  # the home is read from ~/.felix-home and is an unrelated absolute path that
  # happens to be right only on the primary checkout.
  #
  # Resolved by felix_engine_source, which is where this logic now lives so that
  # cmd_bootstrap can share it rather than answer the same question its own way
  # and get it wrong its own way (#65).
  local src=""
  src="$(felix_engine_source "$FELIX_ROOT" "$FELIX_HOME_DIR")" || src=""
  # Refused rather than guessed. Comparing the cache with itself is the thing
  # this command was doing wrong, so falling back to it would keep the defect
  # and merely move the comment. There is no safe default here: a wrong answer
  # reports a deploy that did not happen.
  [ -n "$src" ] || die "this is the deployed copy of Felix, not a checkout of it, and no
  Felix checkout could be found to install FROM. Nothing was deployed.
  Run felix install from inside the Felix repository, or pass --home naming it.
  Comparing $FELIX_ROOT with itself is what this command used to do (#55)."

  printf 'engine:  %s\n\n' "$src"

  command -v claude >/dev/null 2>&1 || {
    printf 'The claude CLI is not on PATH, so the session hook cannot be registered.\n'
    printf 'The felix command still works; only the automatic binding is missing.\n'
    return 1
  }

  # The directory that HOLDS marketplace.json, which is the repository root —
  # not the engine one level inside it. `$src` is <repo>/engine, because
  # marketplace.json declares `"source": "./engine"` and the deployed tree is
  # the contents of that. The manifest itself stays at the root.
  #
  # #66, and measured against the real CLI in a scratch HOME rather than
  # reasoned about:
  #   add <repo>/engine -> exit 1, "Marketplace file not found at
  #                        <repo>/engine/.claude-plugin/marketplace.json"
  #   add <repo>        -> exit 0, installLocation=<repo>
  # It does not resolve upward.
  #
  # So this call had always failed, and the else branch below was doing the
  # work — which is why every reproduction of an install shows "marketplace
  # refreshed" and never "marketplace registered". A refresh only works on a
  # marketplace that is already registered, so the one case this line exists
  # for, a first install on a clean machine, was the one case it could not do.
  if claude plugin marketplace add "${src%/*}" >/dev/null 2>&1; then
    printf '  marketplace registered\n'
  else
    # Adding an already-registered marketplace is a no-op that does not re-read
    # the manifest, so the CLI keeps offering the version it saw first and the
    # update below finds nothing newer. For a marketplace backed by a local
    # directory — which is every Felix install — this refresh is the step that
    # makes a new version visible at all.
    claude plugin marketplace update felix >/dev/null 2>&1 \
      && printf '  marketplace refreshed\n' \
      || printf '  marketplace already registered\n'
  fi
  # Both, unconditionally, and neither is believed. `install` on a plugin that
  # is already present succeeds without upgrading anything, so a bumped version
  # would sit in the marketplace unused while the command reported success.
  # `update` covers that; the verification below is what actually reports.
  claude plugin install felix@felix --scope user >/dev/null 2>&1 || true
  claude plugin update  felix@felix               >/dev/null 2>&1 || true

  # Claude Code caches a plugin by version. With the manifest pinned, install and
  # update are both no-ops on a changed engine and both report success, so the
  # work sits in the repository running nowhere. That has now happened three
  # times in this project's short life, and twice it was found by accident.
  #
  # So the install verifies itself. Printing "installed" without checking is the
  # failure, not the cache.
  local live
  live="$(felix_deployed_engine 2>/dev/null)" || live=""
  if [ -n "$live" ] && [ -d "$live/harness" ]; then
    if felix_deploy_diff "$src" "$live" >/dev/null 2>&1; then
      printf '  verified   the installed engine matches this tree\n'
    elif [ "$bump" -eq 0 ]; then
      printf '\n  WARNING  the installed engine does NOT match this tree.\n'
      printf '           %s\n' "$live"
      printf '           Bumping was declined, so nothing deployed. felix gate will\n'
      printf '           keep failing until the version and the tree agree.\n'
    else
      # The version is the only thing between this tree and a real deployment,
      # and this command already knows it. Printing "bump it and re-run" is a
      # suggestion for something it could safely have done — the charter names
      # that a defect, and the gate had caught `installed` nine times, every one
      # a person typing the digit the command was withholding.
      #
      # Bumping is not the risky half. install is already the thing that
      # replaces the deployed engine.
      # Only when the version is the thing standing in the way. The cache
      # directory is named for the deployed version, so comparing it with the
      # manifest answers the question the comment above claims to be asking —
      # and it had never been asked. A tree that cannot deploy at all differs
      # forever, so every run bumped again: two spurious digits in one session,
      # from re-running install to read its own output.
      local newv curv livev
      curv="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
              "$src/.claude-plugin/plugin.json" 2>/dev/null | head -1)"
      livev="${live##*/}"
      if [ -n "$curv" ] && [ -n "$livev" ] && [ "$curv" != "$livev" ]; then
        printf '\n  %s is already ahead of the deployed %s, so nothing was bumped.\n' \
               "$curv" "$livev"
        if mroot="$(felix_deployable_from "$src")"; then
          printf '           The tree still differs from the cache. Something other than\n'
          printf '           the version is stopping this deploying.\n'
        else
          printf '           The marketplace serves %s, so this worktree was never\n' "$mroot"
          printf '           going to deploy. Merge it and run felix install there.\n'
        fi
      elif newv="$(felix_version_bump "$src/.claude-plugin/plugin.json")"; then
        printf '\n  bumped     %s, because the tree differs and the version did not\n' "$newv"
        # Redeploy at the new version, then verify again rather than assume.
        # The same three steps the deploy above uses. An earlier version did
        # `install` alone and the redeploy silently did nothing, because
        # installing an already-installed plugin is a no-op — `update` is what
        # moves it to the new version.
        claude plugin marketplace update felix        >/dev/null 2>&1 || true
        claude plugin install felix@felix --scope user >/dev/null 2>&1 || true
        claude plugin update  felix@felix              >/dev/null 2>&1 || true
        live="$(felix_deployed_engine 2>/dev/null)" || live=""
        if [ -n "$live" ] && [ -d "$live/harness" ] \
             && felix_deploy_diff "$src" "$live" >/dev/null 2>&1; then
          printf '  verified   the installed engine matches this tree\n'
        else
          local mroot
          if mroot="$(felix_deployable_from "$src")"; then
            printf '\n  WARNING  bumped to %s and it still does not match.\n' "$newv"
            printf '           %s\n' "$live"
            printf '           This is no longer the version cache; something else is wrong.\n'
          else
            printf '\n  not deployed, and nothing is wrong.\n'
            printf '           The marketplace serves %s\n' "$mroot"
            printf '           and this engine is at %s\n' "$src"
            printf '           A directory marketplace is pinned to one path, so a worktree\n'
            printf '           cannot deploy and the cache still matches the tree it names.\n'
            printf '           %s is on the branch and is what makes this deployable when\n' "$newv"
            printf '           it merges. Run felix install there afterwards.\n'
          fi
        fi
      else
        printf '\n  WARNING  the installed engine does NOT match this tree, and the\n'
        printf '           version in engine/.claude-plugin/plugin.json could not be\n'
        printf '           read as three numbers, so it was left alone. Fix it by hand.\n'
      fi
    fi
  fi

  # A hand-registered hook plus the plugin means the binding fires twice and the
  # session is told everything about itself two times. Detected rather than
  # edited: someone else's settings file is not Felix's to rewrite.
  if [ -f "$HOME/.claude/settings.json" ] && \
     felix_contains "$(cat "$HOME/.claude/settings.json" 2>/dev/null)" "harness/hooks/session-start"; then
    printf '\n  WARNING  ~/.claude/settings.json also registers the session hook by hand.\n'
    printf '           The plugin now registers it too, so it will fire twice.\n'
    printf '           Remove the SessionStart entry naming harness/hooks/session-start.\n'
  fi

  printf '\nput felix on PATH:\n'
  printf '  ln -s %s/felix /usr/local/bin/felix\n' "$SCRIPT_DIR"
  printf '\nthen, in a project checkout:  felix new <name>\n'
}

cmd_which() {
  resolve_or_die; local proj="$PROJ"
  printf 'project:      %s\n' "$(basename "$proj")"
  printf 'doctrine:     %s\n' "$proj/CLAUDE.md"
  printf 'memory:       %s\n' "$(felix_mem_dir "$proj")/"
  printf 'gate:         %s\n' "$(felix_json_str "$proj/project.json" gate)"
  printf 'governs:      %s\n' "$(felix_repo_root "$PWD")"
}

cmd_gate() {
  resolve_or_die; local proj="$PROJ" gate
  gate="$(felix_json_str "$proj/project.json" gate)"
  [ -n "$gate" ] || die "project $(basename "$proj") declares no gate in project.json"

  # Run from the checkout being gated, never from Felix. A gate that inspects
  # "the tree it lives in" instead of "the tree it was pointed at" reports a
  # verdict about the wrong code, and a false pass is worse than no gate.
  local root; root="$(felix_repo_root "$PWD")"
  cd "$root" || die "cannot enter repo root"

  # Identity of the tree as the gate finds it, captured before it runs. A gate
  # that rewrites files — a formatter is the ordinary case — would otherwise
  # stamp a receipt describing a tree it never actually verified.
  local tid; tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR")" || tid=""
  export FELIX_PROJECT="$proj"
  # Tools Felix ships for a gate to call. A project gate cannot know where
  # Felix lives, and hardcoding a path would break the moment it moves.
  export FELIX_BIN="$SCRIPT_DIR/bin"

  # A script Felix stores for the project, or any shell command the project
  # already has. The second form is what lets Felix gate a stack it has never
  # heard of: "npm run verify", "dotnet test", "cargo test", "make check".
  # Not exec. The process has to survive the gate so a failure can be recorded:
  # a mistake nobody writes down is one the project gets to make again.
  local log rc
  log="$(mktemp)"
  if [ -x "$proj/$gate" ]; then
    "$proj/$gate" "$@" 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
  else
    bash -c "$gate \"\$@\"" felix-gate "$@" 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
  fi
  # Ground truth, for every project that has a table — asked by the engine
  # rather than by each project's gate script, so no gate has to be edited to
  # get it and none can quietly leave it out. This is the class-level form of
  # what projects/felix/gate.sh carried alone for one night: a check that lives
  # in one gate is an instance, and the instance had to be copied by hand.
  #
  # After the project's own gate and before the failure is recorded, so the
  # project's report reads first and a probe failure lands in mistakes.log
  # under its own name like any other check. Printed in the gate's own line
  # shape for the same reason: the recorder below keys on `<name> FAIL`.
  #
  # A project with no table is SKIPPED and says so. The founder's instruction
  # was every project WITH a table, and a skip that names itself is the rule
  # this gate already holds for a missing scanner — announced, never silent.
  # felix probes and the merge boundary still refuse the absent table; the
  # gate declines to be the third place that turns a new project red on day one.
  local pout prc
  if [ -f "$proj/probes.tsv" ]; then
    pout="$(cmd_probes --gate 2>&1)"; prc=$?
    if [ "$prc" -eq 0 ]; then
      printf '  %-18s ok\n' probes | tee -a "$log"
      printf '                     %s found, %s empty, %s not applicable\n' \
        "$(printf '%s\n' "$pout" | grep -cE '^  found +')" \
        "$(printf '%s\n' "$pout" | grep -cE '^  empty +')" \
        "$(printf '%s\n' "$pout" | grep -cE '^  not-applicable +')"
    else
      printf '  %-18s FAIL\n' probes | tee -a "$log"
      printf '%s\n' "$pout" | grep -vE '^  found ' | head -12 | sed 's/^/  /'
      # The project's gate has already printed its own verdict line, and if
      # that line said pass, the last thing a person reads would now be a pass
      # followed by a FAIL under it. One closing line restates the verdict so
      # the bottom of the output is true. Not printed when the project's gate
      # already failed — its own last line already says so, and two FAIL lines
      # would read as two failures.
      [ "$rc" -eq 0 ] && printf '\ngate: FAIL (probes)\n'
      rc=1
    fi
  else
    printf '  %-18s skipped (no probes.tsv for %s; felix probes says how to write one)\n' \
      probes "$(basename "$proj")"
  fi

  # qualified: does each check that claims to catch something still catch it?
  #
  # Armed on declaration and on nothing else. A project with no qualification
  # table is skipped and announced, the same way an absent probes.tsv is —
  # this gate declines to be the place that turns a new project red on day one.
  # A checker with rows must meet them, because writing a control is the act of
  # claiming the checker catches that case.
  local qout qrc
  if [ -f "$proj/qualification.tsv" ]; then
    qout="$(cmd_qualify --gate 2>&1)"; qrc=$?
    if [ "$qrc" -eq 0 ]; then
      printf '  %-18s ok\n' qualified | tee -a "$log"
      # Counted from the table, not from the rendering. Reading the rendered
      # rows counted the summary line under them as a checker, so one checker
      # reported as two — a number nobody wrote, in the line that says how much
      # was checked.
      printf '                     %s control(s) met across %s checker(s)\n' \
        "$(printf '%s\n' "$qout" | grep -cE '  ok$')" \
        "$(felix_qualify_checkers "$proj" | grep -c .)"
      # An `ok` that covered less than the table declares says by how much, on
      # the line a reader stops at. Counted off the verdict column, the way the
      # met count above is, and not off the summary sentence: #206 removed a
      # count read from prose, and a reworded sentence would drop this line in
      # exactly the checkout that needs it.
      local qna
      qna="$(printf '%s\n' "$qout" | grep -cE '  n/a$')"
      [ "${qna:-0}" -gt 0 ] 2>/dev/null && printf '                     %s did not apply here\n' "$qna"
      # A checker short of the six passes; lib/qualify.sh says why that is
      # reported rather than refused. This is the report, on the same line a
      # reader stops at, so `ok` is not read as six controls of six.
      printf '%s\n' "$qout" | grep -E '^  [^ ]+ declares no control for: ' \
        | sed 's/^  /                     /'
    else
      printf '  %-18s FAIL\n' qualified | tee -a "$log"
      printf '%s\n' "$qout" | grep -E 'HELD|UNRUNNABLE|MALFORMED|^never shown failing in this checkout' | head -8 | sed 's/^/  /'
      [ "$rc" -eq 0 ] && printf '\ngate: FAIL (qualified)\n'
      rc=1
    fi
  else
    printf '  %-18s skipped (no qualification.tsv for %s; felix qualify says how to write one)\n' \
      qualified "$(basename "$proj")"
  fi

  # obligations: what this project has admitted it owes, and whether it owes
  # it in this checkout. Applicability is recomputed here, never read from a
  # store, so a dormant row is reported as dormant rather than vanishing. A
  # project with no table is skipped and announced, like probes; the merge
  # boundary is where absence is refused.
  local oout orc
  if [ -f "$proj/obligations.tsv" ]; then
    oout="$(cmd_obligations --gate 2>&1)"; orc=$?
    if [ "$orc" -eq 0 ]; then
      # A green that rests on a person's grant is not the green of nothing
      # owed, and the receipt's states carry the word printed here: `excepted`,
      # so nobody reads a deferred obligation as a discharged one.
      if printf '%s\n' "$oout" | grep -qE '^[0-9]+ obligation.*; [0-9]+ blocking, [1-9][0-9]* excepted'; then
        printf '  %-18s excepted\n' obligations | tee -a "$log"
      else
        printf '  %-18s ok\n' obligations | tee -a "$log"
      fi
      printf '                     %s\n' "$(printf '%s\n' "$oout" | grep -E '^[0-9]+ obligation' | head -1)"
    else
      printf '  %-18s FAIL\n' obligations | tee -a "$log"
      printf '%s\n' "$oout" | grep -E 'UNSATISFIED|UNKNOWN|admits no|refused|does not declare|^  [a-z]' | head -8 | sed 's/^/  /'
      [ "$rc" -eq 0 ] && printf '\ngate: FAIL (obligations)\n'
      rc=1
    fi
  else
    printf '  %-18s skipped (no obligations.tsv for %s; felix obligations says how to write one)\n' \
      obligations "$(basename "$proj")"
  fi

  # commission: offline and announce-only, except for the empty case. Only
  # hashes and file parsing run here — no check, no instrument, no cli — so
  # CI sees the same line a laptop does. A receipt that is stale, absent or
  # indeterminate is ANNOUNCED and never FAIL, because the Stop hook reads
  # the gate receipt and would then hold every session for a reason nobody
  # chose: session-start's own adopt moves the tables it hashes. An empty or
  # malformed table is a defect somebody made, and that one fails.
  local croot cwhy crows cmal
  croot="$(felix_repo_root "$PWD")"
  if [ ! -f "$proj/commissioning.tsv" ]; then
    printf '  %-18s skipped (no commissioning.tsv for %s; felix commission says how to write one)\n' \
      commission "$(basename "$proj")"
  else
    crows="$(felix_commission_rows "$proj")"; cmal="$(felix_commission_malformed "$proj")"
    if [ -z "$crows" ] || [ -n "$cmal" ]; then
      printf '  %-18s FAIL\n' commission | tee -a "$log"
      [ -z "$crows" ] && printf '    commissioning.tsv declares no need: a shelf with nothing on it\n'
      [ -n "$cmal" ] && printf '%s\n' "$cmal" | awk -F'\t' 'NR <= 6 { printf "    %s: %s\n", $1, $2 }'
      [ "$rc" -eq 0 ] && printf '\ngate: FAIL (commission)\n'
      rc=1
    elif cwhy="$(felix_commission_receipt_valid "$FELIX_HOME_DIR" "$proj" "$croot")"; then
      printf '  %-18s ok\n' commission | tee -a "$log"
      printf '                     %s\n' "$cwhy"
    else
      printf '  %-18s %s\n' commission "$cwhy"
    fi
  fi

  if [ "$rc" -ne 0 ]; then
    # Which checks failed, if the gate names them. Falls back to the exit status
    # rather than guessing, because an invented cause is worse than a vague one.
    #
    # A gate may mark a failure `FAIL (structural: ...)`, meaning it failed for a
    # property of where it ran rather than of the work. Those are subtracted
    # here. This log is the input to `felix promote` and to rank 5 of
    # `felix next`, both of which ask what keeps costing time and answer with
    # "build a mechanism" — and a check that could not have passed did not catch
    # anything, so it has no mechanism to build and no lesson to teach.
    #
    # Felix's own `installed` check is the case: it compares the tree against
    # the deployed cache, which in a worktree can never match, so every run
    # there recorded a mistake nobody made. The count reached 11 and sat at the
    # top of the ranking. The engine still learns no check's name — the gate
    # that owns the check declares it, which is the only place that knows.
    #
    # The verdict is untouched. The gate still failed and still exits non-zero.
    #
    # The fallback fires only when the gate named NOTHING. A gate whose every
    # failure was structural has told us precisely what happened, so falling
    # back to `exit-1` there would re-introduce the same permanent row under a
    # less informative name — which is what happened the first time this was
    # tried, caught by running it in a real worktree rather than the suite.
    local what named
    # No `|| printf 0` here. `grep -c` prints the count and *also* exits 1 when
    # that count is zero, so the fallback appended a second zero and made this
    # "0\n0" — not an integer, so the test below errored and took the wrong
    # branch. A guard firing on a command that succeeded at reporting nothing is
    # the same shape as everything else in this commit.
    named="$(grep -icE '^[[:space:]]*[a-z-]+[[:space:]]+FAIL' "$log" 2>/dev/null | tr -dc '0-9')"
    what="$(grep -iE '^[[:space:]]*[a-z-]+[[:space:]]+FAIL' "$log" 2>/dev/null \
            | grep -viE 'FAIL[[:space:]]*\((structural)' \
            | awk '{print $1}' | tr '\n' ' ')"
    if [ -n "$what" ]; then
      felix_mem_mistake "$proj" "$root" "$what"
    elif [ "${named:-0}" -eq 0 ]; then
      felix_mem_mistake "$proj" "$root" "exit-$rc"
    fi
  fi
  # Which checks the gate said it skipped, read off its own report rather than
  # off the flags this command was given. A project gate that skips for its own
  # reasons is recorded the same way, and no gate has to be edited to be heard.
  local skipped
  skipped="$(awk '$2 == "skipped" { printf "%s%s", sep, $1; sep = "," }' "$log" 2>/dev/null)"
  # And every check it reported, with the verdict it printed, off the same
  # report. Until this was recorded the only roster of what the gate checks was
  # one a session typed into a handoff by hand, and `felix qualify` had no way
  # to say which of them no row qualifies. Same limit as the skips: a check
  # that runs without printing a line is not here.
  #
  # The line's shape, not a list of verdict words. The first draft took ok,
  # FAIL and skipped, and its first real gate run printed `commission stale` —
  # a checker that ran, reported, and would have been absent from the roster;
  # the source prints `waits` as well. A checker line is exactly two spaces, a
  # lowercase name, then a word; every sub-line the gate prints is indented
  # deeper or starts with a number. A reader that has never been given real
  # input is not known to work, however many tests it has.
  local reported
  reported="$(awk '$0 ~ /^  [a-z][a-z-]* +[A-Za-z]/ { printf "%s%s:%s", sep, $1, $2; sep = "," }' "$log" 2>/dev/null)"
  rm -f "$log"

  # The receipt. Recorded on failure as well as success: no receipt and a red
  # one both stop a session, but only one of them says what happened — and now
  # also what it did not check, and what it did, and the decision epoch it ran
  # under, so a fact that moves outside the tree stales it.
  local epoch_fields
  epoch_fields="$(felix_verify_epoch_fields "$proj" "$root")"
  felix_verify_record "$root" "$FELIX_HOME_DIR" "$rc" "$gate" "$tid" "$skipped" "$reported" \
    "$(printf '%s' "$epoch_fields" | cut -f1)" "$(printf '%s' "$epoch_fields" | cut -f2)"
  exit "$rc"
}

cmd_new() {
  # --no-commission is taken wherever it stands, and it is the only flag taken.
  # It exists so that governing a project can be tried for the price of a
  # directory and a marker — no marketplace, no plugin install, no network —
  # with commissioning one command away. So any other word starting with - is
  # refused, wherever it stands, before anything is made, and named as the
  # flag it is: a mistyped --no-commission is the natural one, and dropped
  # without a word in the third place it let full commissioning run, a
  # marketplace added and plugins installed at user scope, for someone who
  # asked for neither. Taken as the name, a flag would also make a project
  # directory the independence check enumerates and governs forever (#102);
  # taken as the path, it made projects/<name>, failed to write the marker,
  # printed "bound via" anyway and exited 0.
  local synopsis="usage: felix new <name> [path-to-checkout] [--no-commission]"
  local commission=1 a
  local rest=()
  for a in "$@"; do
    case "$a" in
      --no-commission) commission=0 ;;
      -*) die "$synopsis (got a flag it does not take: $a; nothing was made)" ;;
      *) rest+=("$a") ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  local name="${1:-}" target="${2:-$PWD}"
  [ -n "$name" ] || die "$synopsis"
  # A name and a path, and nothing after them.
  [ $# -le 2 ] || die "$synopsis (unexpected argument: $3; nothing was made)"
  _felix_name_ok "$name" \
    || die "$synopsis (a name is one directory name: letters, digits, . _ -; got: $name)"
  # The path is checked before anything is made. One that is not a directory
  # used to create projects/<name>, fail to write the marker, print "bound
  # via" anyway and exit 0, leaving a project the retry refuses as existing.
  [ -d "$target" ] || die "$synopsis (not a directory: $target)"
  local dir="$FELIX_HOME_DIR/projects/$name"
  [ -e "$dir" ] && die "project $name already exists at $dir"
  local tpl="$SCRIPT_DIR/templates"
  [ -d "$tpl" ] || die "missing $tpl"

  local root caps gate slug
  root="$(felix_repo_root "$target")"
  caps="$(felix_detect "$root" | sort -u)"
  gate="$(felix_guess_gate "$root")"
  slug="$(felix_repo_slug "$root")"
  # The marker binds the checkout, so a checkout it cannot be written into is
  # refused here, before projects/<name> exists. Refused only after it, the
  # project was left behind, and the same command, once the checkout was
  # writable, refused it as already there.
  if [ -d "$root/.felix" ] || { [ -e "$root/.felix" ] && [ ! -w "$root/.felix" ]; } \
     || { [ ! -e "$root/.felix" ] && [ ! -w "$root" ]; }; then
    die "cannot write the marker $root/.felix, which binds the checkout; nothing was made"
  fi

  mkdir -p "$(felix_mem_dir "$dir")" "$dir/setup"

  # project.json. remote_match is only useful when there is a remote; the .felix
  # marker below covers every other case, including no remote at all.
  # The risk envelope's first key (v3.2 §8 step 1). Asked only where a person
  # is present: on a TTY, or through FELIX_MATURITY. Otherwise absent, and the
  # commissioning row that reads it is held until a person writes it. No
  # subcommand writes it, because a session could then write it as easily.
  local maturity="${FELIX_MATURITY:-}"
  if [ -z "$maturity" ] && [ -t 0 ]; then
    printf 'maturity (prototype / internal / public-beta / production; blank leaves it for later): ' >&2
    read -r maturity || maturity=""
  fi
  case "$maturity" in prototype|internal|public-beta|production) ;; *) maturity="" ;; esac
  # Built before the here-document, not inside it. It was `${maturity:+...}`
  # in the body, and bash removes the double quotes inside that expansion
  # there — 3.2.57 and 5.2.21 both, measured — so the file said
  # `maturity: prototype` and felix_json_str, which matches a quoted key, read
  # nothing back.
  local maturity_line=""
  if [ -n "$maturity" ]; then
    maturity_line="$(printf ',\n  "maturity": "%s"' "$maturity")"
  fi
  cat > "$dir/project.json" <<EOF
{
  "name": "$name",
  "remote_match": "$slug",
  "gate": "$gate"$maturity_line
}
EOF

  printf '%s\n' "$caps" | grep -v '^$' > "$dir/capabilities" || true

  # Keep catalogue rows that are unconditional or whose capability was detected.
  {
    printf '# Declared tooling for %s. Seeded from the catalogue by felix new,\n' "$name"
    printf '# filtered to what this checkout actually shows. Edit freely.\n#\n'
    # The sixth column is who grounded the row. A catalogue tier is a person's
    # judgment, so a seeded row is DECLARED; a row the engine writes after
    # reading a plugin is OBSERVED; a row with no sixth column is a person's.
    printf '# kind\tname\tsource\trisk\tcapability\tgrounding\n'
    grep -vE '^\s*(#|$)' "$tpl/catalog.tsv" | while IFS=$'\t' read -r k n src r c _kw; do
      if [ "$c" = "always" ] || printf '%s\n' "$caps" | grep -qxF "$c"; then
        printf '%s\t%s\t%s\t%s\t%s\tDECLARED\n' "$k" "$n" "$src" "$r" "$c"
      fi
    done
  } > "$dir/stack.tsv"

  cp "$tpl/profiles.tsv" "$dir/profiles.tsv"
  cp "$tpl/routes.tsv" "$dir/routes.tsv"
  cp "$tpl/risk.tsv" "$dir/risk.tsv"
  cp "$tpl/evidence.tsv" "$dir/evidence.tsv"
  cp "$tpl/maintenance.tsv" "$dir/maintenance.tsv"
  # Seeded, because the alternative is a project that is born reading nothing
  # from reality and refusing its own gate on day one. The seeded rows are
  # QUESTIONS — git and the filesystem, which every checkout has — and the
  # answers still come back from the checkout, so this is not Felix authoring
  # an enumeration. What it prevents is the shape procedures.tsv had: a surface
  # nobody was ever handed a starting row for, and so nobody wrote one.
  cp "$tpl/probes.tsv" "$dir/probes.tsv"
  cp "$tpl/commissioning.tsv" "$dir/commissioning.tsv"
  # And the ledger, for the same reason: a project with no obligations.tsv is
  # refused at its MERGE boundary — the gate skips it and announces the skip,
  # which is a weaker thing and is what the code does — and the seeded row is
  # dormant unless the project is a plugin that ships hooks, so nothing here
  # is Felix deciding what a stranger owes. The commissioning row for step 8
  # seeds it where felix new did not run: a project older than the template.
  cp "$tpl/obligations.tsv" "$dir/obligations.tsv"
  # And the table of exceptions, empty: a grant that clears a TASK_BLOCKING
  # row at the task moment (amendments §3) is read from the base ref, never
  # the working tree, so seeding the file grants nothing; it gives the person
  # the columns and the reasons in the place a grant would go.
  cp "$tpl/exceptions.tsv" "$dir/exceptions.tsv"

  # Same filter for human steps, and only copy the runbooks that survive it.
  {
    printf '# Human steps for %s. Seeded by felix new.\n#\n' "$name"
    printf '# id\ttitle\tcapability\tcheck\n'
    grep -vE '^\s*(#|$)' "$tpl/setup.tsv" | while IFS=$'\t' read -r id title c chk; do
      if [ "$c" = "always" ] || printf '%s\n' "$caps" | grep -qxF "$c"; then
        printf '%s\t%s\t%s\t%s\n' "$id" "$title" "$c" "${chk//\{\{REPO\}\}/$slug}"
        [ -f "$tpl/setup/$id.md" ] && \
          sed "s|{{REPO}}|$slug|g" "$tpl/setup/$id.md" > "$dir/setup/$id.md"
      fi
    done
  } > "$dir/setup.tsv"

  # A real starting constitution rather than a stub telling someone to write one.
  #
  # The mechanical half is derivable and should be: the gate, the capabilities,
  # the commands. The invariants are not, and asking a founder to invent them on
  # day one produces either nothing or something copied. So the file says where
  # they come from instead: the ladder from a caught mistake, to a lesson, to a
  # rule, which is the guidebook's promotion logic pointed at its own doctrine.
  {
    printf '# %s\n\n' "$name"
    printf 'Governed by Felix. This file is the project constitution: what is true\n'
    printf 'about %s and nothing else.\n\n' "$name"
    printf '## Verification\n\n'
    printf 'Run the gate before claiming anything is done.\n\n'
    printf '```bash\nfelix gate\n```\n\n'
    [ -n "$gate" ] && printf 'It runs `%s` in this checkout.\n\n' "$gate"
    printf '## What this project has\n\n'
    printf 'Detected at onboarding. `felix doctor` keeps this honest as it changes.\n\n'
    printf '%s\n' "$caps" | grep -v '^$' | sed 's/^/- /'
    printf '\n## Invariants\n\n'
    printf 'Empty on purpose, and not for long.\n\n'
    printf 'These are the things no linter can catch, and they are earned rather\n'
    printf 'than invented. The gate records what it catches in `memory/mistakes.log`.\n'
    printf 'Anything it catches twice shows up in `felix promote`. A mistake that\n'
    printf 'keeps happening becomes a lesson; a lesson that keeps being violated\n'
    printf 'has outgrown the lessons file and belongs here, where the gate can see\n'
    printf 'it.\n\n'
    printf 'Write them down as they arrive. A constitution invented on day one is\n'
    printf 'either empty or borrowed.\n\n'
    printf '## Risk\n\n'
    printf 'Tiers live in `risk.tsv`, evidence requirements in `evidence.tsv`, both\n'
    printf 'beside this file. `felix classify` and `felix evidence` read them, and\n'
    printf 'nothing red is ever touched unattended.\n'
  } > "$dir/CLAUDE.md"
  # Created, never truncated. The refusal above looks at the project directory
  # and memory is not in it: invariant 6 says nothing deletes a memory root, so
  # <memory>/<name>/ routinely outlives projects/<name>/ — removed by hand, or
  # on a second machine whose memory synced first. These were `: >`, which
  # left a surviving devlog, lessons file and handoff at zero bytes each for
  # the next pulse commit to record.
  local memdir kept="" f
  memdir="$(felix_mem_dir "$dir")"
  for f in DEVLOG.md lessons.md SESSION_HANDOFF.md; do
    if [ -e "$memdir/$f" ]; then kept="$kept $f"; else : > "$memdir/$f"; fi
  done

  # The marker binds the checkout without needing a remote.
  printf '%s\n' "$name" > "$root/.felix" \
    || die "created $dir, but could not write the marker $root/.felix; write '$name' into it to bind the checkout"

  printf 'created %s\n\n' "$dir"
  printf '  detected     %s\n' "$(printf '%s' "$caps" | tr '\n' ' ')"
  printf '  gate guess   %s\n' "${gate:-none, set it yourself}"
  printf '  repo         %s\n' "${slug:-no github remote}"
  printf '  bound via    %s/.felix\n' "$root"
  [ -n "$kept" ] && printf '  memory       kept%s, already in %s\n' "$kept" "$memdir"
  printf '\n'
  printf 'seeded stack.tsv, profiles.tsv, setup.tsv and %s runbook(s).\n' \
    "$(ls "$dir/setup" 2>/dev/null | wc -l | tr -d ' ')"
  # The sequence this used to print is run instead. Invariant 3: printing a
  # suggestion for something Felix could safely have done is a defect, and
  # every stage below holds its own install ceiling. Commissioning's exit
  # status is its own report; the project was created either way.
  #
  # Unless the person said not to. That is not a suggestion printed in place
  # of an action Felix could take (invariant 3): the action was declined, by
  # the one person entitled to decline it, and the line says how to take it.
  if [ "$commission" -eq 0 ]; then
    printf '\ncommissioning skipped (--no-commission): nothing was installed, registered or fetched. Run felix commission in %s when you want it.\n' "$root"
    printf '\nA starting constitution was written at %s/CLAUDE.md.\n' "$dir"
    return 0
  fi
  printf '\ncommissioning — every engine stage that answers a need runs now, and an\n'
  printf 'independent check says whether it did.\n\n'
  ( cd "$root" && cmd_commission ) || true
  printf '\nA starting constitution was written at %s/CLAUDE.md.\n' "$dir"
  printf 'felix commission --status re-reads all of this without running anything.\n'
}


cmd_recommend() {
  resolve_or_die; local proj="$PROJ" want="" tpl="$SCRIPT_DIR/templates"
  while [ $# -gt 0 ]; do
    case "$1" in
      --want) need_value "$@"; want="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local root eco caps
  root="$(felix_repo_root "$PWD")"
  eco="$(felix_guess_ecosystem "$root")"
  caps="$(felix_declared "$proj" | tr '\n' ' ')"

  if [ -n "$want" ]; then
    printf 'you asked for: %s\n\n' "$want"
    local hits; hits="$(felix_recommend_intent "$tpl" "$want" | sort -rn)"
    if [ -z "$hits" ]; then
      printf 'Nothing in the catalogue matches that.\n\n'
      printf 'The catalogue is small on purpose. Hand it to the recommender below,\n'
      printf 'which knows far more than fifteen rows.\n\n'
    else
      printf '%s\n' "$hits" | while IFS=$'\t' read -r score kind name risk cap; do
        [ -n "${score:-}" ] || continue
        local have="not mounted"
        grep -qF "	$name	" "$proj/stack.tsv" 2>/dev/null && have="already declared"
        printf '  %-10s %-46s %-7s %s\n' "$kind" "$name" "$risk" "$have"
      done
      printf '\nDeclare one with: felix adopt <capability>, or add the row to\n'
      printf '%s/stack.tsv directly. Nothing was installed.\n\n' "$proj"
    fi
  else
    printf 'project:    %s\necosystem:  %s\ndeclared:   %s\n\n' \
      "$(basename "$proj")" "$eco" "${caps:-none}"
    local missing; missing="$(felix_recommend_missing "$proj" "$tpl")"
    if [ -z "$missing" ]; then
      printf 'Every catalogue row this project could use is already declared.\n\n'
    else
      printf 'in the catalogue, not yet declared here\n'
      printf '%s\n' "$missing" | while IFS=$'\t' read -r kind name risk cap; do
        [ -n "${kind:-}" ] || continue
        local why="applies once %s exists"
        if [ "$cap" = "always" ]; then why="applies to any project"
        elif felix_has_line "$(felix_declared "$proj")" "$cap"; then why="$cap is active here"
        else why="waits for $cap"; fi
        printf '  %-10s %-46s %-7s %s\n' "$kind" "$name" "$risk" "$why"
      done
      printf '\n'
    fi
  fi

  # The handoff. Felix knows this project; the recommender knows the ecosystem.
  # Passing the established facts keeps its answer from repeating them back.
  printf 'For anything beyond this catalogue, paste into a session:\n\n'
  printf '  /claude-code-setup:claude-automation-recommender\n'
  printf '  Project %s, a %s codebase. Felix already detected: %s\n' \
    "$(basename "$proj")" "$eco" "${caps:-nothing yet}"
  printf '  Already declared, do not repeat these: %s\n' \
    "$(grep -vE '^[[:space:]]*(#|$)' "$proj/stack.tsv" 2>/dev/null | cut -f2 | tr '\n' ' ')"
  printf '  Recommend hooks, subagents and skills this stack implies that are\n'
  printf '  not in that list. Read-only: I will decide what to adopt.\n'
}

cmd_route() {
  resolve_or_die; local proj="$PROJ" want="" explain=0 list=0 promote=0 ack=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --for)     need_value "$@"; want="$2"; shift 2 ;;
      --explain) explain=1; shift ;;
      --list)    list=1; shift ;;
      --promote) promote=1; shift ;;
      --ack)     need_value "$@"; ack="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/routes.tsv" ] || die "project $(basename "$proj") declares no routes.tsv"
  local root; root="$(felix_repo_root "$PWD")"

  # Decline the rendered mandate, on the record. The reason is the payload:
  # it lands in decisions.log as a labeled example for whoever revises the
  # table, and it quiets exactly one close-of-session complaint. Recording
  # only — nothing here enforces, per the deliberation-layer gate in HANDOFF
  # §0z, which this command deliberately stays on the near side of.
  if [ -n "$ack" ]; then
    felix_route_ack "$proj" "$root" "$FELIX_HOME_DIR" "$ack" \
      || die "could not record the decline in $(felix_mem_dir "$proj")/decisions.log"
    printf 'declined, on the record. The reason is in decisions.log and the\n'
    printf 'close-of-session check will not raise this play again this session.\n'
    return 0
  fi

  if [ "$list" -eq 1 ]; then
    printf 'routes for %s, in precedence order\n\n' "$(basename "$proj")"
    _felix_route_rows "$proj" | while IFS=$'\t' read -r n _k pr pl; do
      printf '  %-10s %-10s %s\n' "$n" "$pr" "$pl"
    done
    return 0
  fi

  if [ "$promote" -eq 1 ]; then
    # Exit status, not emptiness. These are different facts and this report
    # could not tell them apart: when the pipeline died on a malformed byte it
    # returned nothing, and nothing was printed as "no misses worth a row" —
    # a crash wearing an all-clear, in the report that exists to say what the
    # routing table is missing.
    local hits hrc
    hits="$(felix_route_promote "$proj")" && hrc=0 || hrc=$?
    if [ "$hrc" -ne 0 ]; then
      printf 'Could not read the miss log; this is not an all-clear.\n\n'
      printf '  %s\n\n' "$(felix_mem_dir "$proj")/routes.log"
      printf 'felix route --promote exited %s. Until that is fixed it cannot\n' "$hrc"
      printf 'tell you what the table is missing, so do not read silence as none.\n'
      return 1
    fi
    if [ -z "$hits" ]; then
      printf 'Nothing has missed often enough to be worth a row yet.\n'
      return 0
    fi
    printf 'words that keep appearing in prompts no route understood\n\n'
    printf '%s\n' "$hits" | while IFS=$'\t' read -r n w; do
      printf '  %-4s %s\n' "$n" "$w"
    done
    printf '\nWord frequency, not understanding. A term appearing often may want a\n'
    printf 'route, or may simply be what this project is about. Add the keyword to\n'
    printf 'an existing row in %s/routes.tsv if it would change what you reach for.\n' "$proj"
    return 0
  fi

  local ctx; ctx="$(felix_route_context "$root")"

  if [ "$explain" -eq 1 ]; then
    printf 'prompt:    %s\nthreshold: %s\n\n' "${want:-<none, using the tree>}" "$FELIX_ROUTE_MIN_SCORE"
    printf '  %-5s %-5s %-5s %-10s %s\n' total typed tree route play
    felix_route_score "$proj" "$want" "$ctx" | sort -k2,2nr -k3,3nr -k4,4n \
      | while IFS=$'\t' read -r s ps cs _i n _pr pl; do
          printf '  %-5s %-5s %-5s %-10s %s\n' "$s" "$ps" "$cs" "$n" "$pl"
        done
    printf '\nTyped wins first, then tree, then file order. The tree contributes at\n'
    printf 'most %s however many of its tokens match. Below %s nothing is said.\n' \
      "$FELIX_ROUTE_CONTEXT_CAP" \
      "$FELIX_ROUTE_MIN_SCORE"
    return 0
  fi

  local best
  if ! best="$(felix_route_best "$proj" "$want" "$ctx")"; then
    felix_route_log "$proj" "" 0 "$want"
    return 0
  fi
  local score pscore name play
  score="$(printf '%s' "$best" | cut -f1)"
  pscore="$(printf '%s' "$best" | cut -f2)"
  name="$(printf '%s' "$best" | cut -f5)"
  play="$(printf '%s' "$best" | cut -f7)"
  felix_route_log "$proj" "$name" "$score" "$want"
  felix_route_render "$proj" "$name" "$play" "$root" "$pscore"
}

cmd_quarantine() {
  resolve_or_die; local proj="$PROJ" name="${1:-}" why=""
  shift 2>/dev/null || true
  while [ $# -gt 0 ]; do
    case "$1" in --why) need_value "$@"; why="$2"; shift 2 ;; *) shift ;; esac
  done
  [ -n "$name" ] || die 'usage: felix quarantine <plugin> [--why "..."]'
  case "$name" in -*) die 'usage: felix quarantine <plugin> [--why "..."] (the first argument must be a plugin, not a flag)' ;; esac
  command -v claude >/dev/null 2>&1 || die "felix quarantine needs the claude CLI"

  local id
  id="$(felix_ready_inventory | awk -F'\t' -v n="$name" '$2==n{print $2; exit}')"
  [ -n "$id" ] || die "no installed plugin called $name. felix ready lists what is here."

  if claude plugin disable "$name" >/dev/null 2>&1 \
     || claude plugin disable "$name@claude-plugins-official" >/dev/null 2>&1; then
    printf 'quarantined %s\n\n' "$name"
  else
    die "could not disable $name; try: claude plugin disable $name"
  fi

  # Recorded, because a plugin switched off and forgotten is a capability that
  # silently stopped existing, and six months later nobody remembers why.
  [ -d "$(felix_mem_dir "$proj")" ] && printf '%s\tquarantine\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "${why:-no reason given}" \
    >> "$(felix_mem_dir "$proj")/verification.log" 2>/dev/null

  printf 'This takes effect in your NEXT session. A plugin already loaded stays\n'
  printf 'loaded, hooks and all, so the current one behaves exactly as before.\n\n'
  printf 'Undo whenever it is fixed:\n\n  claude plugin enable %s\n' "$name"
}

cmd_brief() {
  resolve_or_die; local proj="$PROJ" src="" title="" num="" body=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)  need_value "$@"; src="$2"; shift 2 ;;
      --title) need_value "$@"; title="$2"; shift 2 ;;
      -*)      die "unknown flag: $1" ;;
      *)       num="$1"; shift ;;
    esac
  done

  local root; root="$(felix_repo_root "$PWD")"

  if [ -n "$src" ]; then
    if [ "$src" = "-" ]; then body="$(cat)"; else
      [ -f "$src" ] || die "no such file: $src"
      body="$(cat "$src")"
    fi
  elif [ -n "$num" ]; then
    command -v gh >/dev/null 2>&1 || die "felix brief needs the gh CLI, which is not on PATH"
    local slug; slug="$(felix_repo_slug "$root")"
    [ -n "$slug" ] || die "no github remote; pass the text with --from - instead"
    # Two calls rather than one templated one: the engine parses no JSON.
    title="$(gh issue view "$num" --repo "$slug" --json title -q .title 2>/dev/null)" \
      || die "could not read issue $num from $slug"
    [ -n "$title" ] || die "issue $num has no title, or does not exist in $slug"
    body="$(gh issue view "$num" --repo "$slug" --json body -q .body 2>/dev/null)"
  else
    die "felix brief <issue-number>, or felix brief --from - with the text on stdin"
  fi

  felix_brief_render "$proj" "$root" "${title:-untitled}" "$body"
}

cmd_pr() {
  resolve_or_die; local proj="$PROJ" base="main" create=0 issue="" title=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)   need_value "$@"; base="$2"; shift 2 ;;
      --issue)  need_value "$@"; issue="$2"; shift 2 ;;
      --title)  need_value "$@"; title="$2"; shift 2 ;;
      --create) create=1; shift ;;
      *) shift ;;
    esac
  done

  local root branch body tier findings cbase
  root="$(felix_repo_root "$PWD")"
  branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [ "$branch" != "$base" ] || die "already on $base; make a branch before opening a pull request"

  # Two bases, and they are genuinely different things. `$base` is the branch
  # name the pull request will target, and gh needs exactly that — `origin/main`
  # is not a branch anyone can open a request against. `$cbase` is the ref to
  # COMPARE against, which is the remote-tracking one where it exists: `main` is
  # a local ref a worktree can never advance, and comparing against a stale one
  # reports a tier for a diff nobody is proposing (#74).
  cbase="$(felix_base_ref "$root" "$base" 2>/dev/null || printf '%s' "$base")"

  [ -n "$title" ] || title="$(git -C "$root" log -1 --format=%s 2>/dev/null)"
  body="$(felix_pr_body "$root" "$cbase")"
  [ -n "$issue" ] && body="$body

closes #$issue"

  # Two calls, exactly as cmd_classify does it: diff produces findings, tier
  # reduces them. felix_classify_tier takes the findings, not the paths.
  findings="$(felix_classify_diff "$proj" "$cbase" "$root" 2>/dev/null)"
  tier="$(felix_classify_tier "$findings" 2>/dev/null)"

  # `|| tier=green` was here, and it is the most expensive default in the file:
  # this tier is applied to the pull request as a risk-<tier> label, and green
  # is the tier that can auto-merge. An unresolvable base produced no findings,
  # no findings reduced to green, and a branch nobody had compared was labelled
  # safe to merge itself. Refused rather than defaulted — and refused here, not
  # at the label, because a preview that says `tier: green` is read and believed
  # long before anyone runs --create.
  #
  # gh would reject this base anyway, client-side. Saying so first means the
  # reason given is the real one.
  [ "$tier" = "unknown" ] && die "the base '$base' names nothing this repository holds, so
  nothing was compared and there is no tier to put on this. No pull request
  was opened. Check --base, or the default branch, which is not \`main\`
  everywhere."
  [ -n "$tier" ] || die "could not classify this change against '$base', so there is no
  risk tier to label the pull request with. No pull request was opened."

  printf 'branch:   %s -> %s\ntitle:    %s\ntier:     %s\n\n' "$branch" "$base" "$title" "$tier"
  printf '%s\n' "$body"

  if [ "$create" -eq 0 ]; then
    printf '\nPreview only. Add --create to open it.\n'
    return 0
  fi

  command -v gh >/dev/null 2>&1 || die "felix pr --create needs the gh CLI, which is not on PATH"
  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote"

  # Draft when the gate has not passed on this exact tree. Read the receipt the
  # way the Stop hook does: identity must match AND the result must be green,
  # because a green receipt for a different tree is not a green gate.
  #
  # Opened anyway rather than refused. The repair loop attaches to an existing
  # pull request, so refusing here would leave it nothing to attach to.
  local draft="--draft"
  felix_verify_current "$root" "$FELIX_HOME_DIR" "$proj" >/dev/null 2>&1 && draft=""

  # shellcheck disable=SC2086
  gh pr create --repo "$slug" --base "$base" --head "$branch" \
    --title "$title" --body "$body" $draft || die "gh pr create failed"
  printf '\ncreated. labelling risk-%s\n' "$tier"
  gh pr edit --repo "$slug" --add-label "risk-$tier" >/dev/null 2>&1 \
    || printf 'could not apply risk-%s; the label may not exist yet\n' "$tier"
}

# The blockers, computed by the engine `main` declares rather than by this one.
#
# A child shell that sources only the kernel's libraries, so nothing from the
# tree under judgement is in scope when the verdict forms. review.sh is in the
# list and must stay: escape.sh guards the reviewed channel with
# `command -v felix_review_passed`, so leaving it out does not error — it
# silently stops a reviewer's pass from ever clearing, which is the one
# exception invariant 2 grants.
#
# The exit status separates three answers that must not be confused: it judged
# (0), it is too old to judge (4), it could not be loaded (3). Only 0 permits.
_felix_kernel_blockers() {
  local kernel="$1" proj="$2" base="$3" root="$4" home="$5"
  [ -d "$kernel/lib" ] || return 3
  bash -c '
    set -uo pipefail
    k="$1"
    for f in resolve verify review classify evidence escape; do
      [ -r "$k/lib/$f.sh" ] || exit 3
      . "$k/lib/$f.sh" 2>/dev/null || exit 3
    done
    command -v felix_merge_blockers >/dev/null 2>&1 || exit 4
    felix_merge_blockers "$2" "$3" "$4" "$5"
  ' _ "$kernel" "$proj" "$base" "$root" "$home"
}

cmd_merge() {
  resolve_or_die
  local proj="$PROJ" root base="main" dry=0
  root="$(felix_repo_root "$PWD")"
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)    need_value "$@"; base="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      # Discarding this is how `felix merge 35` merged whatever HEAD was on and
      # reported that it had verified it. A command told to merge one thing and
      # given no way to do so has nothing safer to do than stop.
      *) die "felix merge does not take '$1'. It merges the branch that is checked out, so check out the branch you mean." ;;
    esac
  done

  # origin/<base> when it exists, and the name as given otherwise. `main` is a
  # local ref a worktree can never advance, so it goes stale silently and the
  # comparison is then against whatever the primary checkout last pulled (#74).
  # Resolved here rather than inside the diff functions so every line this
  # command prints names the ref it actually used.
  base="$(felix_base_ref "$root" "$base" 2>/dev/null || printf '%s' "$base")"

  # Read before anything is verified, and read again immediately before the
  # merge. Every blocker below is a claim about one checkout, and the branch is
  # what the merge acts on — reading it afterwards is what let a peer's
  # `git checkout` inside the gap merge a branch nothing had looked at and
  # print that nothing in it escaped the tree (#33). Taking it first bounds the
  # window at the whole of felix_merge_blockers rather than at the tail of it.
  local was; was="$(felix_merge_checkout "$root" "$FELIX_HOME_DIR")"
  local branch; branch="$(printf '%s' "$was" | cut -f1)"
  [ -n "$branch" ] && [ "$branch" != "HEAD" ] || die "cannot name the branch to merge"

  # Judged by the engine main declares, never by this tree — but only where
  # that circularity exists. A governed product's rules live in the Felix home
  # and are not in its diff, so it is judged as it always was and needs no
  # installed engine at all.
  local blockers krc
  if felix_self_governed "$root"; then
    # The judge is not chosen by the environment (#260). FELIX_KERNEL named one
    # outright and is refused by name; the cache variables still compose the
    # path, so the entry they resolve is checked, byte for byte, against the
    # engine main holds at the base ref — the same question the gate's
    # installed check asks — and a judge that is not that engine does not judge.
    [ -z "${FELIX_KERNEL:-}" ] || die "FELIX_KERNEL is set, and the merge boundary does not take a judge from the environment: unset it. The judge is the engine main declares, deployed and byte-identical to main."
    local kernel; kernel="$(felix_kernel_dir "$root" "$base")" || kernel=""
    if [ -z "$kernel" ] || [ ! -d "$kernel/lib" ]; then
      local jver jcache
      jver="$(_felix_plugin_version "$root" "$base" 2>/dev/null)"
      jcache="${FELIX_KERNEL_CACHE:-${FELIX_PLUGIN_CACHE:-$HOME/.claude/plugins/cache}/felix/felix}"
      die "no installed copy of the engine main declares (${jver:-no version readable at $base}) under $jcache, so there is nothing to judge this that is not this. Run felix install on main, then try again."
    fi
    local jentry jout jrc jlib
    # The judge must not be the candidate — but only when the candidate is the
    # judge's own source. A branch that does not touch engine/ has no
    # circularity to break, and an identical judge there is not self-judgement:
    # it is the base version, unchanged, which is exactly what should be
    # judging. The first version of this check omitted that condition and made
    # every documentation branch unmergeable; the first real use found it.
    # engine/harness/, not engine/. The kernel is built from engine/harness, and
    # every deploy forces a version bump in engine/.claude-plugin — which cannot
    # touch engine/harness. Testing the wider path told a bump-only branch to
    # bump the version and install main's: advice already followed, and unable
    # to change the thing being compared.
    if felix_changed_paths "$root" "$base" | grep -q '^engine/harness/' \
         && diff -rq "$root/engine/harness" "$kernel" >/dev/null 2>&1; then
      die "the engine that would judge this is byte-identical to the tree it is judging, so it would be judging itself. Bump the version and install main's, or say plainly that this is unjudged."
    fi
    # And the judge must be the engine main accepted, byte for byte (#260): the
    # cache entry for main's version against main's engine at the base ref,
    # the same question the gate's installed check asks. Asked through main's
    # OWN resolve.sh, read out of the base commit and sourced in a subshell —
    # never through the copy this CLI sourced, which is the candidate's when
    # this command runs from the branch — so the code that answers is the code
    # main accepted, and nothing a candidate writes reaches it. After the
    # self-judgement guard, so a cache cut from the candidate is named as
    # judging itself, which is the truer of the two refusals.
    jlib="$(mktemp -d 2>/dev/null)" || die "could not make a directory to read main's resolve.sh into"
    if ! git -C "$root" show "$base:engine/harness/lib/resolve.sh" > "$jlib/resolve.sh" 2>/dev/null; then
      rm -rf "$jlib"; die "main's engine at $base has no lib/resolve.sh, so nothing there can say whether the judge is main's engine"
    fi
    jout="$( . "$jlib/resolve.sh" >/dev/null 2>&1
             command -v felix_accepted_deploy_diff >/dev/null 2>&1 || exit 3
             felix_accepted_deploy_diff "$root" "$base" 2>/dev/null )"; jrc=$?
    rm -rf "$jlib"
    case "$jrc" in
      0) jentry="$jout" ;;
      3) die "main's engine at $base defines no felix_accepted_deploy_diff, so it cannot say whether the judge is main's engine" ;;
      2) die "cannot tell whether the judge is main's engine: $jout" ;;
      *) die "the judge is not the engine main accepted: $(printf '%s\n' "$jout" | head -3 | tr '\n' ';') — a cache entry that differs from main's engine does not judge. Run felix install on main, or unset a cache override that points elsewhere." ;;
    esac
    [ "$kernel" -ef "$jentry/harness" ] || die "the judge resolved to $kernel and the engine main accepted is at $jentry/harness; they are not the same directory, and only that engine judges."
    blockers="$(_felix_kernel_blockers "$kernel" "$proj" "$base" "$root" "$FELIX_HOME_DIR")"
    krc=$?
    case "$krc" in
      0) ;;
      4) die "the installed engine at $kernel is too old to judge this: it has no felix_merge_blockers. Install a newer main." ;;
      *) die "the installed engine at $kernel could not be loaded to judge this." ;;
    esac
  else
    blockers="$(felix_merge_blockers "$proj" "$base" "$root" "$FELIX_HOME_DIR")"
  fi

  if [ -n "$blockers" ]; then
    local kind subject reason esc=0 unk=0 stamp=0 table=0 owed=0
    printf 'not merging\n\n'
    while IFS=$'\t' read -r kind subject reason; do
      [ -n "${kind:-}" ] || continue
      printf '  %-11s %-22s %s\n' "$kind" "$subject" "$reason"
      # Which closing paragraph a blocker belongs under is decided per blocker,
      # from its kind and subject and never from the reason's wording. A
      # commission receipt or table ends in a commission run, which is the
      # founder's or, under their grant, the session-start hook's (HANDOFF
      # §0aq, §0bl): calling it work Felix owes sent a session to re-run a gate
      # that had passed, or to commission for itself. `engine` is the judge
      # failing to load commission.sh, which no run reaches; it sits with every
      # other kind.
      case "$kind:$subject" in
        escape:*)           esc=1 ;;
        unknown:*)          unk=1 ;;
        commission:receipt) stamp=1 ;;
        commission:table)   stamp=1; table=1 ;;
        *)                  owed=1 ;;
      esac
    done <<EOF
$blockers
EOF
    # The declared objective is founder interruptions per session, so the
    # moments Felix could not decide have to be recorded where they happen.
    # Counting them later out of a transcript is the parsing approach this
    # project rejected twice; and a number nobody records is a number nobody
    # moves. Only escapes count. An unrun gate or a missing test is Felix's own
    # work, and counting those would let the figure improve by gating less.
    if [ "$esc" -eq 1 ]; then
      while IFS=$'\t' read -r kind subject reason; do
        [ "${kind:-}" = "escape" ] || continue
        felix_say "$proj" "escalated" "$subject: $reason" "felix merge" "" 2>/dev/null || true
      done <<EOF
$blockers
EOF
    fi

    # `unknown` is checked before `escape`, because the sentence in the last
    # branch below is the exact claim #56 is about. Saying "nothing here escapes
    # the tree" after a scan that never ran would move the false all-clear from
    # the verdict into the explanation and leave it just as wrong. Nothing was
    # compared, so nothing can be said about what escapes.
    if [ "$unk" -eq 1 ]; then
      printf '\nNothing was compared, so nothing above is a finding about this branch.\n'
      printf 'The base names nothing this repository holds — check --base, or the\n'
      printf 'default branch, which is not `main` everywhere. This says nothing\n'
      printf 'about whether the change escapes the tree; that was never asked.\n'
    elif [ "$esc" -eq 1 ]; then
      printf '\nMerging this writes something outside the tree that a revert does not\n'
      printf 'reach, so it is the founder who decides. Show them the diff and the\n'
      printf 'reversal path; a green gate is not the question here.\n'
    fi
    # Said whatever else is said, beside an escape too: the founder is being
    # asked already, and a merge they clear would stop again on the receipt.
    #
    # What clears it is a commission run, and who makes that run depends on the
    # grant, which the receipt itself never reads. A grant that still covers
    # the tables runs one unattended at the next session start
    # (felix_commission_resume_bg). One stamped over tables that have moved
    # runs nothing until the founder re-arms it, which is the case a table
    # edit merged to main produces. With no grant, the run is simply theirs,
    # and naming `felix autonomy --allow commission` there would be asking for
    # a standing consent the merge does not need.
    if [ "$stamp" -eq 1 ]; then
      local grant=none
      if felix_autonomy_allows "$proj" commission 2>/dev/null; then
        grant=stale
        felix_autonomy_commission_current "$proj" 2>/dev/null && grant=current
      fi
      case "$grant" in
        current)
          printf '\nThe commission is not a session'"'"'s to clear. The founder'"'"'s commission\n'
          printf 'grant still covers these tables, so the next session started in this\n'
          printf 'checkout re-commissions unattended; or they run it themselves:\n\n'
          printf '  felix commission\n\n' ;;
        stale)
          printf '\nThe commission is not Felix'"'"'s to clear: this merge waits for the founder.\n'
          printf 'Their commission grant was stamped over tables that have moved since, so\n'
          printf 'nothing re-commissions unattended until they re-arm it, having read what\n'
          printf 'changed. Ask them to run, in order:\n\n'
          printf '  felix autonomy --allow commission\n'
          printf '  felix commission\n\n' ;;
        *)
          printf '\nThe commission is not Felix'"'"'s to clear: this merge waits for the founder.\n'
          printf 'This project grants no unattended commission, so the run is theirs:\n\n'
          printf '  felix commission\n\n'
          printf 'Clearing this needs no grant; granting one is a separate decision.\n' ;;
      esac
      if [ "$table" -eq 1 ]; then
        printf 'Put the table named above right first: felix commission cannot clear this\n'
        printf 'over a table it cannot read.\n'
      fi
      printf 'Felix never writes a project'"'"'s autonomy file and a session does not\n'
      printf 'commission for itself, so a green gate does not clear this.\n'
    fi
    if [ "$unk" -eq 0 ] && [ "$esc" -eq 0 ]; then
      if [ "$stamp" -eq 1 ] && [ "$owed" -eq 1 ]; then
        printf '\nThe rest escapes nothing and is work Felix owes: run the gate, or\n'
        printf 'write the test that is missing, then run this again.\n'
      elif [ "$stamp" -eq 0 ]; then
        printf '\nNothing here escapes the tree, so none of it is a founder decision.\n'
        printf 'It is work Felix owes: run the gate, or write the test that is missing,\n'
        printf 'then run this again.\n'
      fi
    fi
    return 3
  fi

  if [ "$dry" -eq 1 ]; then
    printf 'nothing escapes this tree, and the gate is green on it.\n'
    if [ -n "${jentry:-}" ]; then printf 'judged by %s, the engine main declares, byte-identical to main.\n' "$jentry"; fi
    printf 'felix merge would squash this now.\n'
    return 0
  fi

  command -v gh >/dev/null 2>&1 || die "felix merge needs the gh CLI, which is not on PATH"
  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote"

  # The remote is consulted last and only to perform the merge. Every reason to
  # refuse was computed above, offline, so this command says no the same way
  # with or without a network.
  #
  # The branch is the selector, and leaving it out is why this command could
  # never merge anything: `gh pr merge --repo <slug>` with no pull request named
  # is refused by gh itself, client-side, before any network call. It shipped
  # that way because every test covered a refusal or a dry run, so the one line
  # that reaches gh was never executed.
  # Last thing before the only line that acts. If the checkout moved, every
  # verdict above describes something that is no longer here, and merging on it
  # would be the one outcome this command exists to prevent.
  local now; now="$(felix_merge_checkout "$root" "$FELIX_HOME_DIR")"
  if [ "$now" != "$was" ]; then
    # Name the field that moved. Printing a fixed prefix of the record meant the
    # tree-id case — the one the third field was added to catch, where a peer
    # edits an uncommitted file and leaves branch and commit alone — rendered as
    # two identical lines under a sentence saying the checkout had moved, which
    # it had not. A refusal whose evidence contradicts its own reason is worse
    # than a bare one: it sends somebody to look at the thing that is fine.
    local wb nb ws ns wt nt moved=""
    wb="$(printf '%s' "$was" | cut -f1)"; nb="$(printf '%s' "$now" | cut -f1)"
    ws="$(printf '%s' "$was" | cut -f2)"; ns="$(printf '%s' "$now" | cut -f2)"
    wt="$(printf '%s' "$was" | cut -f3)"; nt="$(printf '%s' "$now" | cut -f3)"
    printf 'not merging\n\n'
    [ "$wb" != "$nb" ] && { printf '  branch     %s -> %s\n' "$wb" "$nb"; moved="checkout"; }
    [ "$ws" != "$ns" ] && { printf '  commit     %s -> %s\n' "$ws" "$ns"; moved="checkout"; }
    [ "$wt" != "$nt" ] && { printf '  tree       edited under it, uncommitted or untracked\n'
                            [ -n "$moved" ] || moved="tree"; }
    if [ "$moved" = "tree" ]; then
      printf '\nThe working tree was edited while this ran, so the receipt accepted\n'
      printf 'above describes a tree that is already gone. Nothing was merged.\n'
    else
      printf '\nThe checkout moved while this ran, so what was verified is not what\n'
      printf 'would be merged. Nothing was merged.\n'
    fi
    printf 'Run it again once nothing else is touching this working copy.\n'
    return 4
  fi
  gh pr merge "$branch" --repo "$slug" --squash || die "gh pr merge failed"
  printf 'merged. nothing in it escaped the tree.\n'
  # Said, not only printed: a merge is the moment the boundary let something
  # through, and which engine judged it is the fact a reader of says.log
  # would want beside it. An if, not a short-circuit: this is the command's
  # last statement, and a product merge has no judge to name.
  if [ -n "${jentry:-}" ]; then
    printf 'judged by %s, the engine main declares, byte-identical to main.\n' "$jentry"
    felix_say "$proj" "merged" "$branch: judged by $jentry, the engine main declares" "felix merge" "" 2>/dev/null || true
  else
    felix_say "$proj" "merged" "$branch: a governed product, judged by this engine" "felix merge" "" 2>/dev/null || true
  fi
  return 0
}

cmd_next() {
  resolve_or_die
  local proj="$PROJ" root base="main" a
  root="$(felix_repo_root "$PWD")"
  for a in "$@"; do case "$a" in --base) shift; base="${1:-main}" ;; esac; done
  # origin/<base> when it exists, and the name as given otherwise. `main` is a
  # local ref a worktree can never advance, so it goes stale silently and the
  # comparison is then against whatever the primary checkout last pulled (#74).
  # Resolved here rather than inside the diff functions so every line this
  # command prints names the ref it actually used.
  base="$(felix_base_ref "$root" "$base" 2>/dev/null || printf '%s' "$base")"

  local rows; rows="$(felix_next "$proj" "$FELIX_HOME_DIR" "$root" "$base")"
  if [ -z "$rows" ]; then
    printf 'nothing due for %s\n\n' "$(basename "$proj")"
    printf 'The gate is green on this tree, nothing escapes it, every tool a\n'
    printf 'route names is reachable, and no upkeep is past its cadence.\n'
    return 0
  fi

  local rank owner what do_ last="" n=0
  printf 'next for %s\n' "$(basename "$proj")"
  while IFS=$'\t' read -r rank owner what do_; do
    [ -n "${rank:-}" ] || continue
    if [ "$rank" != "$last" ]; then
      printf '\n'
      case "$rank" in
        1) printf '  the change in hand\n' ;;
        2) printf '  yours to decide\n' ;;
        3) printf '  before the next session starts\n' ;;
        4) printf '  upkeep\n' ;;
        5) printf '  already cost time more than once\n' ;;
        6) printf '  a check that is not checking\n' ;;
        7) printf '  routing\n' ;;
      esac
      last="$rank"
    fi
    printf '    %-8s %s\n' "$owner" "$what"
    printf '    %-8s   %s\n' "" "$do_"
    n=$((n+1))
  done <<EOF
$rows
EOF

  printf '\n%s item(s). Ranked by what interrupts you, then by what is blocking.\n' "$n"
  printf 'Anything marked felix is Felix'"'"'s own work and not a decision for you;\n'
  printf 'it is listed because it costs time, not because it needs approving.\n'
}

cmd_review() {
  resolve_or_die
  local proj="$PROJ" root verdict="" by="" note="" where="" tid
  root="$(felix_repo_root "$PWD")"
  while [ $# -gt 0 ]; do
    case "$1" in
      --pass)  verdict=pass;  shift ;;
      --block) verdict=block; shift ;;
      --by)    need_value "$@"; by="$2";   shift 2 ;;
      --note)  need_value "$@"; note="$2"; shift 2 ;;
      --in)    need_value "$@"; where="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR" 2>/dev/null)"
  [ -n "$tid" ] || die "cannot identify this tree"

  if [ -n "$verdict" ]; then
    [ -n "$by" ] || die "felix review --pass|--block needs --by <who reviewed it>"
    if ! felix_review_record "$FELIX_HOME_DIR" "$proj" "$tid" "$verdict" "$by" "$note" "$where" "$root"; then
      [ "$verdict" = "pass" ] && [ -n "$where" ] \
        && die "that pass says it ran in the tree under review. A reviewer running against the live tree while it is being edited reports results about neither, so this is refused rather than recorded. Run it in a separate worktree at this commit."
      die "could not write the verdict"
    fi
    printf 'recorded: %s by %s, for this tree only\n' "$verdict" "$by"
    [ "$verdict" = "pass" ] \
      && printf '\nThis clears the reviewed channel and nothing else. Any other escape\nstands, and the verdict dies the moment the tree changes.\n'
    return 0
  fi

  local rec; rec="$(felix_review_verdict "$FELIX_HOME_DIR" "$proj" "$tid")"
  if [ -z "$rec" ]; then
    printf 'no verdict for this tree\n\n'
    printf 'A reviewed surface is one no test can judge, so nothing here can tell\n'
    printf 'you whether it is fine. Dispatch a reviewer that runs the claim in a\n'
    printf 'separate worktree at this commit, then record what it found:\n\n'
    printf '  felix review --pass  --by <reviewer> --note <what it ran>\n'
    printf '  felix review --block --by <reviewer> --note <what it found>\n'
    return 0
  fi
  printf 'verdict:  %s\n' "$(printf '%s' "$rec" | cut -f2)"
  printf 'by:       %s\n' "$(printf '%s' "$rec" | cut -f4)"
  printf 'when:     %s\n' "$(printf '%s' "$rec" | cut -f3)"
  printf 'note:     %s\n' "$(printf '%s' "$rec" | cut -f5)"
  printf '\nFelix records the claim and who made it. It cannot check that the\nreviewer was independent, ran in an isolated worktree, or executed\nanything — that is a property of how it was dispatched, and no receipt\ncan establish it.\n'
}

cmd_autonomy() {
  resolve_or_die; local proj="$PROJ" allow="" revoke="" a
  while [ $# -gt 0 ]; do
    case "$1" in
      --allow)  need_value "$@"; allow="$2"; shift 2 ;;
      --revoke) need_value "$@"; revoke="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [ -n "$revoke" ]; then
    if [ -f "$proj/autonomy" ]; then
      grep -vxF "$revoke" "$proj/autonomy" > "$proj/autonomy.new" 2>/dev/null \
        && mv -f "$proj/autonomy.new" "$proj/autonomy"
    fi
    # The stamp goes with the grant. Left behind, a later --allow would look
    # like it had already been read against a table nobody re-read.
    rm -f "$(felix_autonomy_stamp_path "$proj" "$revoke")" 2>/dev/null
    printf 'revoked: %s\n' "$revoke"
  fi

  if [ -n "$allow" ]; then
    case "$allow" in
      tidy|commission) ;;
      *) die "unknown capability: $allow. They are 'tidy' and 'commission'." ;;
    esac
    if felix_autonomy_allows "$proj" "$allow"; then
      printf 'already allowed: %s\n' "$allow"
    else
      [ -f "$proj/autonomy" ] || printf '# What Felix may do here unattended.\n' > "$proj/autonomy"
      printf '%s\n' "$allow" >> "$proj/autonomy"
      printf 'allowed: %s\n' "$allow"
    fi
    # Stamped with the table it was granted over, so a later edit to that table
    # does not inherit the grant. Written on every --allow, not only the first,
    # because re-granting is how a person re-arms it after reading a change.
    if [ "$allow" = commission ]; then
      printf '%s\n' "$(felix_commission_policy_version "$proj")" \
        > "$(felix_autonomy_stamp_path "$proj" commission)"
      printf 'stamped against commissioning.tsv as it stands now.\n'
    fi
  fi

  printf '\nautonomy for %s\n\n' "$(basename "$proj")"
  if felix_autonomy_allows "$proj" tidy; then
    printf '  [x] tidy    remove a lookalike script when Felix already holds that file\n'
  else
    printf '  [ ] tidy    remove a lookalike script when Felix already holds that file\n'
  fi
  printf '\nNothing is granted by default, and Felix never writes this file for a\n'
  printf 'project: a permission a system grants itself is not a permission.\n'
  printf '\nTidy removes a file only when every one of these holds: this project\n'
  printf 'opted in, Felix holds a file of that exact name, git does not track it,\n'
  printf 'it is not the declared gate, and a backup was written and confirmed\n'
  printf 'readable first. A tracked file is part of what the repository says it\n'
  printf 'contains, and removing one is a change to the project rather than the\n'
  printf 'removal of a stray.\n'
  if felix_autonomy_allows "$proj" commission; then
    if felix_autonomy_commission_current "$proj"; then
      printf '\n  [x] commission  run the commissioning pipeline with nobody present\n'
    else
      printf '\n  [!] commission  granted, but not over this commissioning.tsv\n'
    fi
  else
    printf '\n  [ ] commission  run the commissioning pipeline with nobody present\n'
  fi
  printf '\nCommission is not a scheduling change, and the wording matters because\n'
  printf 'it is what is being consented to. The pipeline evaluates two columns of\n'
  printf '%s/commissioning.tsv as shell — `when` and `check` — in\n' "$proj"
  printf 'this checkout. Nothing on a hook path does that today; the session hook\n'
  printf 'says so, and the only callers are commands a person types. Granting\n'
  printf 'this puts them on a hook path.\n'
  printf '\nWhat it does NOT do is install anything. A run declares: it appends\n'
  printf 'rows to stack.tsv carrying OBSERVED, and installing them is still\n'
  printf 'felix stack apply, which a person still runs. A declaration is a line\n'
  printf 'in a table and is undone by deleting it.\n'
  printf '\nThe grant is stamped against that table. Edit commissioning.tsv and\n'
  printf 'the grant stops covering it — the row above reads [!] and the\n'
  printf 'unattended run refuses — because an ordinary edit to a project table\n'
  printf 'must not become code that runs unattended. Re-granting is how a person\n'
  printf 'says they have read the change.\n'
  printf '\n  felix autonomy --allow tidy      grant it\n'
  printf '  felix autonomy --revoke tidy     take it back\n'
  printf '  felix autonomy --allow commission    grant it, over the table as it stands\n'
  printf '  felix autonomy --revoke commission   take it back\n'
}

# A night's standing direction, so a founder types it once instead of every time.
#
# The argument for this being a command rather than a habit is in
# lib/overnight.sh. The argument for it being a command rather than a grant in
# `autonomy` is here: autonomy rows are permanent until revoked, and a
# permanent "never stop" is wrong for the two-minute session where somebody
# asks a question. A night is a duration, so it is started, bounded, and over.
#
# It grants no new authority. Every refusal, channel and gate stands exactly as
# it did; what changes is that a session which hits one writes the decision
# down and keeps working instead of waiting for somebody who is asleep.
cmd_overnight() {
  resolve_or_die; local proj="$PROJ"
  local start=0 hours="" turns="" note="" report=0 clear=0 end="" defer="" what="" unblock="" sid="" named=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --start)   start=1; shift ;;
      --hours)   need_value "$@"; hours="$2"; shift 2 ;;
      --turns)   need_value "$@"; turns="$2"; shift 2 ;;
      --note)    need_value "$@"; note="$2"; shift 2 ;;
      --session) need_value "$@"; sid="$2"; named=1; shift 2 ;;
      --defer)   need_value "$@"; defer="$2"; shift 2 ;;
      --what)    need_value "$@"; what="$2"; shift 2 ;;
      --unblock) need_value "$@"; unblock="$2"; shift 2 ;;
      --report)  report=1; shift ;;
      --clear)   clear=1; shift ;;
      --end)     case "${2:-}" in ''|-*) end="ended by hand"; shift ;; *) end="$2"; shift 2 ;; esac ;;
      --all)     all=1; shift ;;
      --status)  shift ;;
      -*) die "usage: felix overnight [--start [--hours N] [--turns N] [--note ...]] [--session ID] [--defer KIND --what ... [--unblock ...]] [--report] [--clear] [--end [reason] [--all]]" ;;
      *) shift ;;
    esac
  done

  # Whose night this command is about. A night belongs to one session (see
  # lib/overnight.sh), and the session a shell belongs to is the one the
  # platform exports to it; --session names another. A terminal outside every
  # session has no id at all. It cannot start a night, since there is nobody
  # for the night to hold, and it is the one caller for whom --end means every
  # night: that is a person's way out, and a person at a terminal is inside
  # none of them.
  local scope="session"
  [ "$named" -eq 1 ] || sid="${CLAUDE_CODE_SESSION_ID:-}"
  # From inside a session, a night is that session's to take and nobody
  # else's to give: a grant there holds whatever session it names at every
  # stop, and the one inside it is the only one that asked. Naming another
  # session is for a person at a terminal, which exports no id.
  if [ "$start" -eq 1 ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "$sid" != "$CLAUDE_CODE_SESSION_ID" ]; then
    die "from inside a session, a night can only be granted to that session. Type it in the session the night is for."
  fi
  [ "$all" -eq 1 ] && scope="all"
  if [ -z "$sid" ]; then scope="all"
  elif ! _felix_overnight_sid_ok "$sid"; then
    die "the session id cannot name a night: letters, digits, dot, dash and underscore only"
  fi

  if [ -n "$defer" ]; then
    case "$defer" in
      approval|irreversible|blocked|question) ;;
      *) die "unknown kind: $defer. They are approval, irreversible, blocked and question." ;;
    esac
    [ -n "$what" ] || die "felix overnight --defer needs --what \"the thing that is waiting\""
    felix_overnight_defer "$proj" "$defer" "$what" "$unblock" \
      || die "could not write the deferral queue under $(felix_overnight_dir "$proj")"
    printf 'deferred [%s] %s\n' "$defer" "$what"
    [ -n "$unblock" ] && printf '  unblock: %s\n' "$unblock"
    printf '%s decision(s) now waiting. felix overnight --report reads them.\n' \
      "$(felix_overnight_deferred_count "$proj")"
    return 0
  fi

  if [ -n "$end" ]; then
    local id key ended=0
    if [ "$scope" = "all" ]; then
      while IFS= read -r id; do
        [ -n "$id" ] || continue
        key="$id"; [ "$id" = "-" ] && key=""
        felix_overnight_end "$proj" "$end" "$key"; ended=$(( ended + 1 ))
      done <<EOT
$(felix_overnight_nights "$proj")
EOT
      printf 'ended %s night(s): %s\n\n' "$ended" "$end"
    elif felix_overnight_owns "$proj" "$sid"; then
      felix_overnight_end "$proj" "$end" "$sid"
      printf 'overnight ended for %s: %s\n\n' "$(_felix_overnight_whose "$sid")" "$end"
    else
      printf 'no night was running for %s. Another session'"'"'s night is ended from inside\n' "$(_felix_overnight_whose "$sid")"
      printf 'it, or with felix overnight --end --all, which ends every night.\n\n'
    fi
    felix_overnight_report "$proj" "$sid"
    return 0
  fi

  if [ "$clear" -eq 1 ]; then
    local n; n="$(felix_overnight_deferred_count "$proj")"
    felix_overnight_clear "$proj"
    printf 'cleared %s deferred decision(s).\n' "$n"
    return 0
  fi

  if [ "$start" -eq 1 ]; then
    local why
    [ "$scope" = "all" ] && die "overnight --start needs the session the night is for, and this shell is in none.
Type it inside that session, where the platform exports its id:  ! felix overnight --start
or name the session:  felix overnight --start --session <session id>"
    if why="$(felix_overnight_start "$proj" "${hours:-$FELIX_OVERNIGHT_DEFAULT_HOURS}" \
                "${turns:-$FELIX_OVERNIGHT_DEFAULT_TURNS}" "$sid" "$note")"; then
      printf 'overnight is on for %s, for %s and no other.\n\n' "$(basename "$proj")" "$(_felix_overnight_whose "$sid")"
      felix_overnight_direction
      printf '\nIt ends on whichever comes first: %s hour(s), %s continuation(s), or two\n' \
        "${hours:-$FELIX_OVERNIGHT_DEFAULT_HOURS}" "${turns:-$FELIX_OVERNIGHT_DEFAULT_TURNS}"
      printf 'continuations in a row that call no tool. felix overnight --end stops it now,\n'
      printf 'and closing the session stops it too — nothing here runs without one.\n'
      return 0
    fi
    die "overnight --start refused: $why"
  fi

  # Status, which is also what a bare `felix overnight` answers: about this
  # session's night when there is a session, and about every night when not.
  if [ "$scope" = "session" ] && felix_overnight_active "$proj" "$sid"; then
    printf 'overnight is ON for %s, %s\n\n' "$(basename "$proj")" "$(_felix_overnight_whose "$sid")"
    felix_overnight_direction
    printf '\n'
  elif [ "$scope" = "session" ] && felix_overnight_owns "$proj" "$sid"; then
    printf 'overnight is OVER for %s, %s: %s\n\n' "$(basename "$proj")" \
      "$(_felix_overnight_whose "$sid")" "$(felix_overnight_expired "$proj" "$sid")"
    printf 'The state is still here so the report can read it. felix overnight --end\n'
    printf 'closes it, and --start begins another.\n\n'
  elif [ "$scope" = "all" ] && [ -n "$(felix_overnight_nights "$proj")" ]; then
    printf 'overnight: %s night(s) on record for %s, listed below.\n\n' \
      "$(felix_overnight_nights "$proj" | grep -c .)" "$(basename "$proj")"
  else
    printf 'overnight is off for %s' "$(basename "$proj")"
    [ "$scope" = "session" ] && printf ', %s' "$(_felix_overnight_whose "$sid")"
    printf '\n\n'
    printf 'A night is a duration a person grants, not a setting. It changes what a\n'
    printf 'session does when something stops it — write the decision down and keep\n'
    printf 'working, rather than wait for somebody asleep — and changes nothing about\n'
    printf 'what may stop it. It belongs to the session that starts it.\n\n'
    printf '  felix overnight --start                  %s hours, %s continuations\n' \
      "$FELIX_OVERNIGHT_DEFAULT_HOURS" "$FELIX_OVERNIGHT_DEFAULT_TURNS"
    printf '  felix overnight --start --hours 10       longer, up to %s\n' "$FELIX_OVERNIGHT_MAX_HOURS"
    printf '  felix overnight --report                 the morning page\n\n'
  fi
  felix_overnight_report "$proj" "$sid"
}

# Does a check fail when the thing it protects is broken?
#
# v3.2's conformance amendments call checker qualification the largest gap in
# the spec. Every layer above narrows what a model may WRITE; none of them asks
# whether the checker that judges the writing works. A check that passes over a
# violation is worse than no check, because the report says the property holds.
#
# Report only. Arming this — refusing to let an unqualified checker enforce —
# turns every gate red the day it lands, and how much Felix may block is a
# founder's decision. Making the gap visible is the half that needs no decision,
# and it is the half that was missing.
cmd_qualify() {
  resolve_or_die; local proj="$PROJ" want="" gate=0 a root
  for a in "$@"; do
    case "$a" in
      --gate) gate=1 ;;
      -*)     die "usage: felix qualify [--gate] [checker]" ;;
      *)      want="$a" ;;
    esac
  done
  root="$(felix_repo_root "$PWD")"

  local rows mal
  rows="$(felix_qualify_rows "$proj")"
  mal="$(felix_qualify_malformed "$proj")"
  printf 'qualification for %s\n\n' "$(basename "$proj")"
  # Before the empty-table answer, so a table whose every row is malformed says
  # which rows and why rather than reading as one that declares nothing.
  if [ -n "$mal" ]; then
    printf 'rows that cannot be read as a control\n\n'
    printf '%s\n' "$mal" | awk -F'\t' '{ printf "  %-16s MALFORMED  %s\n", $1, $2 }'
    printf '\nA malformed row is a control nobody is applying, so it is not run, and\n'
    printf 'silence about it would read as a control that passed. Each control has\n'
    printf 'one verdict: violation, alternate and decoupled_violation fail; the other\n'
    printf 'three pass. A row may not choose another.\n\n'
  fi
  if [ -z "$rows" ]; then
    printf 'No checker here is qualified, because %s/qualification.tsv\n' "$proj"
    printf 'declares no control that can be run. Every check this project runs is\n'
    printf 'currently trusted on the strength of having been written.\n\n'
    printf '  checker <TAB> command <TAB> control <TAB> expect <TAB> mutation [<TAB> premise]\n\n'
    printf 'Six controls per checker, from the conformance amendments: violation,\n'
    printf 'restoration, irrelevant, alternate, decoupled_violation and\n'
    printf 'decoupled_satisfaction.\n\n'
    printf 'A premise is optional: a command run before the mutation. Exit 1 means\n'
    printf 'the control cannot be staged in this checkout and it is reported as not\n'
    printf 'applying; any other failure is a control that could not run.\n'
    return 1
  fi

  local out held=0 unrun=0 total=0 inapp=0 unshown
  out="$(felix_qualify_run "$proj" "$root" "$want")"
  printf '  %-10s %-24s %-7s %-7s %s\n' CHECKER CONTROL EXPECT GOT ''
  printf '%s\n' "$out" | while IFS=$'\t' read -r c ctl exp got v; do
    [ -n "${c:-}" ] || continue
    case "$v" in
      met)          printf '  %-10s %-24s %-7s %-7s ok\n'         "$c" "$ctl" "$exp" "$got" ;;
      unrunnable)   printf '  %-10s %-24s %-7s %-7s UNRUNNABLE\n' "$c" "$ctl" "$exp" "$got" ;;
      inapplicable) printf '  %-10s %-24s %-7s %-7s n/a\n'        "$c" "$ctl" "$exp" "$got" ;;
      *)            printf '  %-10s %-24s %-7s %-7s HELD\n'       "$c" "$ctl" "$exp" "$got" ;;
    esac
  done
  held="$(printf '%s\n' "$out"  | awk -F'\t' '$5 == "held" { n++ } END { print n+0 }')"
  unrun="$(printf '%s\n' "$out" | awk -F'\t' '$5 == "unrunnable" { n++ } END { print n+0 }')"
  inapp="$(printf '%s\n' "$out" | awk -F'\t' '$5 == "inapplicable" { n++ } END { print n+0 }')"
  total="$(printf '%s\n' "$out" | awk -F'\t' 'NF >= 5 { n++ } END { print n+0 }')"
  unshown="$(felix_qualify_unshown "$proj" "$out" | tr '\n' ' ')"

  # Controls a checker has no row for. Four of six is not qualified, and the two
  # usually missing are the two that separate the marker from the property.
  local c miss
  for c in $(felix_qualify_checkers "$proj"); do
    [ -z "$want" ] || [ "$want" = "$c" ] || continue
    miss="$(felix_qualify_missing_controls "$proj" "$c" | tr '\n' ' ')"
    [ -n "${miss% }" ] && printf '\n  %s declares no control for: %s\n' "$c" "${miss% }"
  done

  printf '\n%s of %s control(s) held; %s could not run.\n' "$held" "$total" "$unrun"
  # Said only when it happened, and never folded into the held count or the met
  # one: a control whose premise is absent is neither broken nor kept.
  [ "${inapp:-0}" -gt 0 ] && printf '%s did not apply in this checkout: its premise is absent here.\n' "$inapp"
  # One inapplicable control is not a refusal: it is not a control anybody broke.
  # A checker ALL of whose fail-expecting controls did not apply is, under
  # --gate, and the first draft of this said otherwise. It reasoned from the
  # ratchet — a checker with no rows is not red — and the reasoning does not
  # transfer: those controls were written, which is the claim that the checker
  # catches something, and in this checkout nothing shows it catching anything.
  # `qualified ok` over that is invariant 5 broken in the one check that exists
  # to enforce invariant 5. A review caught it before it merged.
  #
  # The remedy is not a looser verdict but a better control: one that stages its
  # own premise — creates the thing whose absence made the others inapplicable,
  # then breaks the property with it — applies in every checkout.
  if [ -n "${unshown% }" ]; then
    printf '\nnever shown failing in this checkout: %s\n' "${unshown% }"
    printf 'Every control that expects it to fail has a premise this checkout lacks,\n'
    printf 'so nothing here shows it catching anything. It is not qualified here.\n'
    printf 'Declare a control that stages its own premise, and it applies everywhere.\n'
  fi
  if [ "${held:-0}" -gt 0 ]; then
    printf '\nA held control is the checker passing over a tree that violates what it\n'
    printf 'protects. That is not a failing test — it is the check reporting a\n'
    printf 'property the tree does not have.\n'
  fi
  # Armed, and the ratchet is what makes that safe.
  #
  # A declared control binds. Nothing else does: a checker with no rows is not
  # reported as failing, and a control nobody wrote is not a control anybody
  # broke. So this cannot turn a gate red on the day it lands — on the day it
  # landed, the one checker with rows met all six of them. What it can do is
  # turn red the day a checker stops catching something it used to catch, which
  # is the only moment a qualification suite is worth having.
  #
  # Declaring a control is therefore a commitment, taken deliberately, one edit
  # at a time. That is the opposite of the design this replaced — refuse
  # everything unqualified, which is unarmable because it fails everything at
  # once and teaches a person to switch it off.
  #
  # Which of the checks the last gate reported has no row here. Read off the
  # receipt's roster, so the list is what the gate PRINTED for this tree and
  # not a roster somebody typed — which is how the count was kept until now:
  # by hand, in a handoff, and wrong the day a checker was added. Not under
  # --gate, because this is a gap report and not a verdict: the arming
  # decision above leaves an unqualified checker exactly as it was.
  if [ "$gate" -eq 0 ]; then
    local rcpt field roster ungov
    rcpt="$(felix_verify_receipt "$root" "$FELIX_HOME_DIR" 2>/dev/null)"
    field="$(printf '%s' "$rcpt" | cut -f6)"
    if [ -z "$rcpt" ]; then
      printf '\nNo gate receipt for this tree, so what the gate reports here is not\n'
      printf 'known; felix gate writes one.\n'
    elif [ -z "$field" ] || [ "$field" = "-" ]; then
      printf '\nThe last gate receipt for this tree carries no roster of what it\n'
      printf 'reported; felix gate writes one now.\n'
    else
      # Back into the gate's own line shape — two spaces, name, verdict — so
      # the reader below has one shape to read, whether it is handed a gate
      # log or this roster.
      roster="$(printf '%s\n' "$field" | tr ',' '\n' | sed 's/:/ /; s/^/  /')"
      ungov="$(felix_qualify_ungoverned "$proj" "$roster" | tr '\n' ' ')"
      if [ -n "${ungov% }" ]; then
        printf '\nreported by the last gate and qualified by no row: %s\n' "${ungov% }"
      else
        printf '\nEvery check the last gate reported has a row here.\n'
      fi
    fi
  fi
  if [ "$gate" -eq 1 ]; then
    # A malformed row refuses too. It was written as a control, so by the
    # ratchet it binds, and it cannot be met because it is never run. Running it
    # is what let a violation expecting `pass` read as met.
    [ "${held:-0}" -eq 0 ] && [ "${unrun:-0}" -eq 0 ] && [ -z "${unshown% }" ] \
      && [ -z "$mal" ] && return 0
    if [ "${held:-0}" -gt 0 ] || [ "${unrun:-0}" -gt 0 ]; then
      printf '\nA declared control that does not hold is this check reporting a\n'
      printf 'property the tree does not have. Fix the checker, or delete the\n'
      printf 'control and say in the diff that it is no longer claimed; felix merge\n'
      printf 'stops that deletion for a person to read.\n'
    fi
    return 1
  fi
  printf '\nA declared control binds; an undeclared one does not. felix qualify\n'
  # `printf --`: the sentence begins with --gate, and bash's printf read the
  # format as an option and printed its usage in the middle of the report.
  printf -- '--gate refuses on a held control, so a checker that stops catching what\n'
  printf 'it caught turns the gate red — and a checker nobody has qualified yet\n'
  printf 'is left exactly as it was.\n'
  return 0
}

cmd_coverage() {
  local tpl="$SCRIPT_DIR/templates" hooks="$SCRIPT_DIR/../hooks/hooks.json"
  local state event detail bad=0

  printf 'lifecycle coverage\n\n'
  while IFS=$'\t' read -r state event detail; do
    [ -n "${event:-}" ] || continue
    case "$state" in
      ok) printf '  [x] %-18s %s\n' "$event" "$detail" ;;
      *)  printf '  [!] %-18s %s\n' "$event" "$detail"; bad=$((bad+1)) ;;
    esac
  done <<EOF
$(felix_coverage_check "$tpl" "$hooks")
EOF

  local un; un="$(felix_coverage_unconsidered "$tpl" | tr '\n' ' ')"
  if [ -n "${un% }" ]; then
    printf '\n  [ ] %s\n' "${un% }"
    printf '      offered by the platform, and this table has no opinion on it\n'
    bad=$((bad+1))
  fi

  if [ "$bad" -eq 0 ]; then
    printf '\nEvery moment has a stance, and the wiring matches it.\n'
  else
    printf '\n%s moment(s) need a decision.\n' "$bad"
  fi

  # Said whether or not anything is wrong. A decline resting on judgement is not
  # a fault, but the share of them is the one number that says how much of this
  # table is taking itself on trust.
  local unchecked; unchecked="$(felix_coverage_unchecked "$tpl")"
  if [ "${unchecked:-0}" -gt 0 ]; then
    printf '\n%s decline(s) rest on judgement, with no literal a check can read.\n' "$unchecked"
  fi

  printf '\nThis checks that every moment was considered, never that what runs at\n'
  printf 'one is any good. A hook doing the wrong thing passes here and should:\n'
  printf 'judging that is not mechanical, and a report implying otherwise would\n'
  printf 'be worse than no report. Two gaps were found by a person noticing, and\n'
  printf 'the point of this table is that the third one fails instead.\n'
  # The residual, stated where trust is claimed rather than kept in a design
  # note. This table is an enumeration, and enumeration is the joint that
  # cannot be behavioural: a moment nobody listed is not reported missing, it
  # is not reported at all.
  printf '\nOne authority writes both the work and the judgement of the work, and\n'
  printf 'no row here closes that. A moment absent from the template is missing\n'
  printf 'from this list rather than reported as a gap in it — an entrypoint\n'
  printf 'never found is never executed.\n'
}

cmd_shape() {
  resolve_or_die
  local plan="${1:-}"
  [ -n "$plan" ] || die "usage: felix shape <plan.md>"
  [ -f "$plan" ] || die "no such plan: $plan"

  local groups; groups="$(felix_shape_groups "$plan")"
  if [ -z "$groups" ]; then
    printf 'No task declares any file in %s.\n\n' "$plan"
    printf 'Shape is computed from the files each task creates, modifies and\n'
    printf 'tests. Without those, nothing here can be judged, and guessing at it\n'
    printf 'would be the taste this command exists to replace.\n'
    return 0
  fi

  local coupled=0 alone=0 g n
  printf 'shape of %s\n\n' "$plan"
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    n="$(printf '%s' "$g" | tr ',' '\n' | grep -c .)"
    if [ "$n" -gt 1 ]; then
      printf '  one context   tasks %-18s share files\n' "$g"
      coupled=$((coupled+1))
    else
      printf '  separable     task  %-18s shares nothing\n' "$g"
      alone=$((alone+1))
    fi
  done <<EOF
$groups
EOF

  printf '\n%s group(s) that must not be split, %s that may run apart.\n' "$coupled" "$alone"
  printf '\nThe first half binds. Two tasks writing one file cannot be worked in\n'
  printf 'parallel: one overwrites the other, or they invent conflicting\n'
  printf 'assumptions about a file neither owns.\n'
  printf '\nThe second half does not. Disjoint files are necessary for fanning out\n'
  printf 'and never sufficient — a caller and the signature it consumes share no\n'
  printf 'file at all. Read the interfaces before trusting a "separable".\n'
}

cmd_ledger() {
  resolve_or_die; local proj="$PROJ" name sessions calls named n=0

  # Fold anything nothing folded, before reading. The rollup runs only from the
  # SessionEnd hook, so every session that was killed, slept, or torn down left
  # its appends uncounted — 31 of them on this machine when this was found,
  # against 12 that had folded. Reading without this reports whichever sessions
  # happened to exit cleanly and calls it unconfounded. Done here rather than in
  # a hook because it is several greps per distinct signal per stranded session,
  # and that cost belongs to a person asking for a report.
  local lroot; lroot="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)"
  local caught; caught="$(felix_ledger_catchup "$proj" "$FELIX_HOME_DIR" "$lroot" 2>/dev/null)"

  local rows; rows="$(_felix_ledger_rows "$(felix_mem_dir "$proj")")"

  if [ "${caught:-0}" -gt 0 ] 2>/dev/null; then
    # "ended without folding themselves" was true while the catch-up only ever
    # folded sessions that had never folded. It now also re-folds one whose
    # fold stopped keeping up — a session resumed under the same id, or one
    # that was alive when it was last folded — and that session did fold
    # itself, once. The count is of folds brought up to date, which covers
    # both and overstates neither.
    printf 'folded %s session(s) whose record was behind what is on disk.\n' "$caught"
    printf 'Their calls were recorded all along and had never been counted.\n\n'
  fi

  if [ -z "$rows" ]; then
    printf 'Nothing recorded yet for %s.\n\n' "$(basename "$proj")"
    printf 'The ledger is written by hooks, and hooks bind when a session starts,\n'
    printf 'so a session running when they were installed records nothing. It fills\n'
    printf 'from the next session onwards.\n'
    return 0
  fi

  printf 'ledger for %s, %s session(s)\n\n' "$(basename "$proj")" \
    "$(felix_ledger_sessions "$proj")"
  printf '  %-34s %-10s %-9s %s\n' CAPABILITY SESSIONS NAMED REACHED
  while IFS=$'\t' read -r name sessions calls named; do
    [ -n "${name:-}" ] || continue
    case "${named:--1}" in -1) named="?" ;; esac
    printf '  %-34s %-10s %-9s %s\n' "$name" "$sessions" "$named" "$calls"
    n=$((n+1))
  done <<EOF
$(felix_ledger_summary "$proj")
EOF
  [ "$n" -eq 0 ] && printf '  nothing yet\n'

  local retire; retire="$(felix_ledger_retire "$proj")"
  if [ -n "$retire" ]; then
    printf '\npointed at and never reached for, across %s or more sessions\n\n' "$FELIX_LEDGER_MIN"
    printf '%s\n' "$retire" | while IFS=$'\t' read -r name sessions named; do
      [ -n "${name:-}" ] || continue
      printf '  %-34s %s sessions, named %s times, 0 invocations\n' "$name" "$sessions" "$named"
    done
    printf '\nThat is the one signal here worth acting on. Remove the row from\n'
    printf '%s/stack.tsv and any play that names it.\n' "$proj"
  fi

  # A zero that cannot be observed is not a zero. A hook leaves no tool call,
  # so a plugin whose contribution is a hook reads zero forever however much it
  # does; said as unmeasurable, and proposed for nothing.
  local unobserved; unobserved="$(felix_ledger_unobserved "$proj")"
  if [ -n "$unobserved" ]; then
    printf '\npointed at, never reached for, and unmeasurable: their contribution is a hook\n\n'
    printf '%s\n' "$unobserved" | while IFS=$'\t' read -r name sessions named; do
      [ -n "${name:-}" ] || continue
      printf '  %-34s %s sessions, named %s times, hooks leave no call to count\n' "$name" "$sessions" "$named"
    done
    printf '\nA hook fires inside Claude Code and the ledger never sees it, so a zero here\n'
    printf 'says nothing about use. A capability whose value is keeping a session off a\n'
    printf 'wrong path is never invoked when it works. Nothing is proposed for these.\n'
  fi

  # The zero on a plugin that ships a hook AND countable surfaces. The
  # countable part was pointed at and never reached — that is disuse — while
  # the hook cannot be counted. Said apart, and the proposal scoped to the play
  # rather than the row, because the row is what mounts the hook.
  local partly; partly="$(felix_ledger_partly "$proj")"
  if [ -n "$partly" ]; then
    printf '\npointed at, never reached for, and only partly countable: a hook plus something that leaves a call\n\n'
    printf '%s\n' "$partly" | while IFS=$'\t' read -r name sessions named; do
      [ -n "${name:-}" ] || continue
      printf '  %-34s %s sessions, named %s times, its countable surfaces never reached, its hook uncounted\n' "$name" "$sessions" "$named"
    done
    printf '\nThe skills, agents or server it ships were pointed at and the session went\n'
    printf 'elsewhere; that part is disuse. The hook is not, because the ledger cannot see\n'
    printf 'one fire. Drop it from the play that names it and keep the row in\n'
    printf '%s/stack.tsv: the row is what mounts the hook.\n' "$proj"
  fi

  local unrouted; unrouted="$(felix_ledger_unrouted "$proj")"
  if [ -n "$unrouted" ]; then
    printf '\nmounted, and no route pointed at it in any recorded session\n\n'
    printf '%s\n' "$unrouted" | while IFS=$'\t' read -r name sessions; do
      [ -n "${name:-}" ] || continue
      printf '  %-34s %s sessions, never pointed at\n' "$name" "$sessions"
    done
    printf '\nA finding about %s/routes.tsv, not about these capabilities. A route\n' "$proj"
    printf 'may well name them — felix toolbox reads the table and will say so —\n'
    printf 'but its keywords have not matched real work yet. Their zero measures\n'
    printf 'what Felix suggests, not what they are worth, so retiring on it would\n'
    printf 'conclude they deserved to be ignored because they were ignored.\n'
    # The caveat, evaluated rather than printed.
    #
    # This used to be a straight-line "Weak while few sessions are recorded",
    # keyed to nothing: the same sentence over three sessions, where it is apt,
    # and over eighty-two, where the rows two lines above contradict it. A
    # conditional whose antecedent is never checked is decoration, and the
    # engine holds what would decide it. felix_ledger_unrouted carries no
    # session threshold — unlike retire, and correctly, since a one-session row
    # here is legitimate output — so this sentence is the only thing standing
    # where retire has a filter, and prose cannot do a filter's job.
    #
    # Recomputed from $unrouted rather than read from the loop above: that
    # `sessions` is a variable inside a pipeline subshell and is gone by here.
    local _umin
    _umin="$(printf '%s\n' "$unrouted" \
             | LC_ALL=C awk -F'\t' 'NF { if (m == "" || $2 + 0 < m) m = $2 + 0 }
                                     END { print (m == "" ? 0 : m) }')"
    if [ "${_umin:-0}" -lt "${FELIX_LEDGER_MIN:-5}" ] 2>/dev/null; then
      printf 'Weak here: the thinnest row above rests on %s session(s). A route that\n' "$_umin"
      printf 'has not fired yet looks exactly like one that never will.\n'
    else
      printf 'Every row above rests on %s session(s) or more, so "it has not fired\n' "$_umin"
      printf 'yet" is the weaker of the two readings rather than the safe one.\n'
    fi
  fi

  printf '\nOnly retiring is ever proposed, and only for what Felix pointed at.\n'
  printf 'Loading a capability is what causes it to be used, so a high count\n'
  printf 'cannot show anything earned its place.\n'
  printf '\nTwo things this still cannot see, stated because a report that implies\n'
  printf 'otherwise is worse than none. A capability whose value is keeping a\n'
  printf 'session off a wrong path is never invoked when it works, so counting\n'
  printf 'calls punishes prevention and nothing here observes that. And a gate\n'
  printf 'verdict is one bit for a session holding dozens of decisions, so none of\n'
  printf 'this says which capability earned it, or whether the work was any good.\n'
}

cmd_toolbox() {
  resolve_or_die; local proj="$PROJ" wire=0 all=0 a tpl="$SCRIPT_DIR/templates"
  for a in "$@"; do case "$a" in --route) wire=1 ;; --all) all=1 ;; esac; done

  local rules; rules="$(_felix_discover_rules "$tpl" "$proj")"
  local n_routed=0 n_wired=0 n_orphan=0 n_nocap=0

  printf 'toolbox for %s\n\n' "$(basename "$proj")"
  printf '  %-26s %-8s %-12s %s\n' NAME RISK CAPABILITY REACHABLE

  while IFS=$'\t' read -r kind name; do
    [ "${kind:-}" = "plugin" ] || continue
    [ -n "${name:-}" ] || continue

    local dir risk cap routes reach
    dir="$(felix_toolbox_path "$name")" || dir=""
    risk="-"
    # Bundled plugins are real, reachable, and have no directory to read. That
    # is a normal answer: unknown risk, not a missing plugin.
    if [ -n "$dir" ]; then
      risk="$(felix_toolbox_risk "$name" "$dir")"
    fi
    cap="$(felix_toolbox_capability "$name" "$rules" "$dir")"

    local show=1
    if felix_toolbox_routed "$proj" "$name"; then
      reach="a route names it"; n_routed=$((n_routed+1))
    elif [ -z "$cap" ]; then
      # Not routed and matching nothing this project declares. Counted, never
      # listed: it is a fact about the machine, not about this project.
      reach="no declared capability looks like it"; n_nocap=$((n_nocap+1)); show=0
    else
      routes="$(felix_toolbox_route_for "$proj" "$cap" | head -1)"
      if [ -z "$routes" ]; then
        reach="capability '$cap' is in no profile"; n_orphan=$((n_orphan+1))
      elif [ "$wire" -eq 1 ] && [ "$risk" != "high" ]; then
        # Appended to the play, never rewritten: the play is ordered, earlier
        # entries are named first, and reordering somebody's table to add to it
        # would change what gets reached for before this ever ran.
        felix_route_append_play "$proj" "$routes" "$name" \
          && { reach="wired into '$routes'"; n_wired=$((n_wired+1)); } \
          || reach="could not write routes.tsv"
      else
        reach="could go in '$routes'"; n_orphan=$((n_orphan+1))
      fi
    fi
    # A plugin matching no capability this project declares is not a problem to
    # solve, it is a machine that has other projects on it. Counted, not listed:
    # twenty-six rows saying "nothing to do here" is how a report stops being
    # read, and then the rows that did matter go unread with them. Anything a
    # route names is always shown, capability match or not, or the listing and
    # the count below it disagree.
    if [ "$show" -eq 1 ] || [ "$all" -eq 1 ]; then
      printf '  %-26s %-8s %-12s %s\n' "$name" "$risk" "${cap:--}" "$reach"
    fi
  done <<EOF
$(felix_ready_inventory | sort -u)
EOF

  printf '\n%s reachable, %s wired now, %s could be.\n' \
    "$n_routed" "$n_wired" "$n_orphan"
  if [ "$n_nocap" -gt 0 ] && [ "$all" -eq 0 ]; then
    printf '%s installed here match no capability %s declares, and are not listed.\n' \
      "$n_nocap" "$(basename "$proj")"
    printf 'felix toolbox --all     shows them\n'
  fi
  if [ "$wire" -eq 0 ] && [ "$n_orphan" -gt 0 ]; then
    printf '\nfelix toolbox --route   wires the ones that have somewhere to go\n'
  fi
  printf '\nA plugin no route names is never reached for and costs context in every\n'
  printf 'session regardless. High risk is never wired: it ships hooks, a floating\n'
  printf 'version, or an interpolated secret, and a person decides those.\n'
}

cmd_discover() {
  resolve_or_die; local proj="$PROJ" inspect=0 quiet=0 adopt=0 a tpl="$SCRIPT_DIR/templates"
  for a in "$@"; do
    case "$a" in
      --inspect) inspect=1 ;;
      --quiet)   quiet=1 ;;
      --adopt)   adopt=1 ;;
      --yes)     die "there is no --yes. felix discover --adopt declares and installs what it read and judged low risk, and nothing else." ;;
    esac
  done
  command -v claude >/dev/null 2>&1 || die "felix discover needs the claude CLI to see the marketplaces"

  # Acting on what has already been read. The candidate was fetched at its
  # pinned sha, its contents were read, and a tier was scored from what it
  # actually ships; printing a shopping list after all that was the governance
  # charter talking. Low only, and no flag from any caller touches high.
  if [ "$adopt" -eq 1 ]; then
    # An absent cache is filled here, in the foreground, before anything is
    # adopted. This used to say "felix discover --inspect fills it now", and
    # it did not: only the --quiet form writes the cache, and only the
    # session-start hook ran it. Reading is all this does — nothing fetched
    # here is executed — so it is safe in front of a person.
    local cache; cache="$(_felix_discover_cache "$proj" "$FELIX_HOME_DIR").tsv"
    if ! felix_discover_cache_current "$proj" "$FELIX_HOME_DIR" "$tpl"; then
      printf 'filling the discovery cache first: each candidate is fetched at its\n'
      printf 'pinned commit and read, and nothing is executed.\n\n'
      mkdir -p "$(dirname "$cache")" 2>/dev/null
      if cmd_discover --inspect --quiet > "$cache.new" 2>/dev/null; then
        mv -f "$cache.new" "$cache"
      else
        # Not "nothing matches". The catalogue was never seen, so there is no
        # answer to act on and none to cache; the next run asks again.
        rm -f "$cache.new" 2>/dev/null
        printf 'The marketplaces could not be read, so the cache was not written and\n'
        printf 'nothing was adopted. That is not "nothing matches": nothing was seen.\n'
        printf 'Check that `claude plugin list --available` answers, then run this again.\n'
        return 2
      fi
    fi
    local plan; plan="$(felix_discover_adopt "$proj" "$FELIX_HOME_DIR" "$tpl")"
    if [ -z "$plan" ]; then
      printf 'Nothing to adopt for %s.\n\n' "$(basename "$proj")"
      printf 'The discovery cache holds no candidate matching what this project\n'
      printf 'declares. Declaring another capability widens the search.\n'
      return 0
    fi
    local n_dec=0 n_ref=0 kind
    printf 'adopting for %s\n\n' "$(basename "$proj")"
    while IFS=$'\t' read -r act name cap risk; do
      [ -n "${act:-}" ] || continue
      case "$act" in
        declare)
          # skill, plugin or mcp is not knowable from the catalogue listing, and
          # plugin is what a marketplace entry is. A wrong kind here would make
          # felix stack apply call the wrong installer, so it is stated rather
          # than guessed at install time.
          kind=plugin
          # OBSERVED: the tier is what the engine read off the copy on disk,
          # and the row must never read back as a person's on the next run.
          printf '%s\t%s\t-\t%s\t%s\tOBSERVED\n' "$kind" "$name" "$risk" "$cap" >> "$proj/stack.tsv"
          if felix_stack_install "$kind" "$name" "-"; then
            printf '  installed  %-24s %-10s %s\n' "$name" "$risk" "$cap"
            # Invariant 4 says Felix installs what it has read. This is the
            # line where that is either true or a sentence in a document: the
            # copy just installed is digested and compared against the digest
            # of the copy discovery read and scored. Two fetches happened —
            # one here, one in the marketplace's installer — and until this
            # ran nothing had ever compared them.
            #
            # It reports and does not undo. An uninstall would be reversible
            # enough to do unattended, but the common cause measured here is a
            # marketplace that moved its branch under an unchanged version
            # string, and ripping out a working plugin over that is a worse
            # answer than saying what happened.
            #
            # Captured and then cut, rather than read with a tab IFS from a
            # heredoc holding the substitution. That spelling hands the tab
            # IFS to the captured command as well, and this repository's
            # constitution names it as the trap that costs a session every
            # time somebody rediscovers it.
            local dline dstate ddetail
            dline="$(felix_discover_drift "$proj" "$FELIX_HOME_DIR" "$name")"
            dstate="$(printf '%s' "$dline" | cut -f1)"
            ddetail="$(printf '%s' "$dline" | cut -f2-)"
            case "${dstate:-}" in
              drift)
                printf '  DRIFT      %-24s the installed copy is not the copy that was read\n' "$name"
                printf '             %s\n' "$ddetail"
                printf '             the %s tier above was scored from the other one\n' "$risk" ;;
              unread)
                printf '             %-24s no digest was recorded, so nothing here is claimed\n' "$name" ;;
            esac
          else
            printf '  declared   %-24s %-10s %s (install failed; felix stack apply --yes retries)\n' \
              "$name" "$risk" "$cap"
          fi
          n_dec=$((n_dec+1)) ;;
        refuse)
          printf '  refused    %-24s %-10s a person decides this one\n' "$name" "$risk"
          n_ref=$((n_ref+1)) ;;
      esac
    done <<EOF
$plan
EOF
    printf '\n%s adopted, %s refused.\n' "$n_dec" "$n_ref"
    if [ "$n_ref" -gt 0 ]; then
      printf '\nMedium means it ships an MCP server, which usually needs a credential\n'
      printf 'only you can supply. High means hooks, a floating version, or an\n'
      printf 'interpolated secret. No flag installs those.\n'
    fi
    [ "$n_dec" -gt 0 ] && printf '\nDeclared rows were appended to %s/stack.tsv. Revert by deleting them.\n' "$proj"
    return 0
  fi

  local cands crc; cands="$(felix_discover_candidates "$proj" "$tpl")"; crc=$?
  # A catalogue that could not be read is not one with nothing in it. Before
  # the stamp, because the stamp is what makes a cache current: the quiet
  # form must write nothing here, so the caller's `&&` leaves the last real
  # answer standing rather than replacing it with seven days of "nothing".
  #
  # The DECLARED code, not "non-zero". The first version of this tested
  # `-ne 0`, and felix_discover_candidates used to end in a pipeline whose
  # status was the scoring loop's — 1 whenever the last plugin in the listing
  # did not match, which is most listings. So the fix for "an unread
  # catalogue reads as empty" shipped with its own inverse: a catalogue read
  # perfectly well, reported unreadable. Measured against the real CLI, not
  # reasoned about. Reading a status means naming the value you expect.
  #
  # Any other non-zero is a defect in that function rather than a fact about
  # the marketplace. It still refuses to cache, because that is the direction
  # that cannot invent an answer, and it says which of the two it is so the
  # next occurrence is a bug report and not a network diagnosis.
  if [ "$crc" -ne 0 ]; then
    [ "$quiet" -eq 1 ] && return 2
    if [ "$crc" -eq 3 ]; then
      printf 'The marketplaces could not be read for %s.\n\n' "$(basename "$proj")"
      printf 'That is not "nothing matches": the catalogue was never seen. Check that\n'
      printf '`claude plugin list --available` answers, then run this again.\n'
    else
      printf 'Reading the catalogue for %s ended with status %s, which is not a\n' \
        "$(basename "$proj")" "$crc"
      printf 'verdict this engine knows how to read: 0 is read and 3 is unreadable.\n'
      printf 'Nothing was cached and nothing was adopted. This is a defect in\n'
      printf 'felix_discover_candidates, not an answer about the marketplaces.\n'
    fi
    return 2
  fi
  # The quiet form writes the cache, so its first line is the stamp the
  # readers check, and an empty result is an empty cache rather than a
  # sentence about it — prose in a cache is a row that refuses to parse.
  [ "$quiet" -eq 1 ] && _felix_discover_stamp_line "$tpl"
  if [ -z "$cands" ]; then
    [ "$quiet" -eq 1 ] && return 0
    printf 'Nothing in the marketplaces matches what %s declares.\n' "$(basename "$proj")"
    printf '\nThat is a statement about the catalogue and this project, not about\nwhat exists. Declaring another capability widens the search.\n'
    return 0
  fi

  if [ "$quiet" -eq 1 ]; then
    # name <TAB> capability <TAB> tier, for the cache. No prose, no headings:
    # this is read by a machine and diffed against what was already reported.
    # Global, and the trap guards against unset. A trap body is evaluated when
    # it fires, by which time a `local` is gone: this exact mistake was made
    # and fixed in this file already, then made again here. Second occurrence.
    _FELIX_DISCOVER_SCRATCH=""
    trap 'rm -rf "${_FELIX_DISCOVER_SCRATCH:-}" 2>/dev/null' EXIT INT TERM
    _FELIX_DISCOVER_SCRATCH="$(mktemp -d)" || return 0
    local scratchq="$_FELIX_DISCOVER_SCRATCH"
    printf '%s\n' "$cands" | while IFS=$'\t' read -r score cap name desc; do
      [ -n "${name:-}" ] || continue
      local src url sha sub mkt facts tier
      src="$(felix_discover_source "$name")" || src=""
      url="$(printf '%s' "$src" | cut -f1)"
      sha="$(printf '%s' "$src" | cut -f2)"
      sub="$(printf '%s' "$src" | cut -f3)"
      mkt="$(printf '%s' "$src" | cut -f4)"
      tier="unknown"
      local digest=""
      if [ -n "$url" ] && felix_discover_fetch "$url" "$sha" "$scratchq/$name"; then
        facts="$(felix_discover_inspect "$scratchq/$name" "$sub" \
          "$(felix_discover_marketplace_file "$mkt")" "$name")"
        tier="$(felix_discover_risk "$facts")"
        # Taken here, from the copy the tier was scored off, because there is
        # no second chance at it: the catalogue drops a plugin from
        # --available the moment it is installed, so after adoption there is
        # no source left to re-read. A tier with no digest beside it is a
        # judgement about bytes nobody can produce again.
        digest="$(felix_discover_digest "$scratchq/$name" "$sub")" || digest=""
        # Re-scored against what the plugin says about itself and what it
        # actually ships, now that a copy is on disk. The catalogue blurb is
        # written to be chosen from; the manifest is written to describe, and
        # scoring the blurb is how a tracing plugin and an inference provider
        # were both filed under the capability of whichever project happened
        # to be looking. The skills come out of the same inspect read that
        # scored the risk (Decision C, 2026-08-30).
        local own skl
        own="$(felix_plugin_description "$scratchq/$name/${sub:-.}")"
        skl="$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "skill" { print $2 }')"
        if [ -n "$own" ] || [ -n "$skl" ]; then
          local rehit; rehit="$(felix_capability_match "$name" "$own" \
            "$(_felix_discover_rules "$tpl" "$proj")" "$skl")"
          if [ "$(printf '%s' "$rehit" | cut -f1)" -ge "${FELIX_DISCOVER_MIN:-3}" ]; then
            cap="$(printf '%s' "$rehit" | cut -f2)"
          else
            cap="-"
          fi
        fi
        rm -rf "$scratchq/$name"
      fi
      printf '%s\t%s\t%s\t%s\n' "$name" "$cap" "$tier" "$digest"
    done
    return 0
  fi

  printf 'candidates for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$cands" | while IFS=$'\t' read -r score cap name desc; do
    [ -n "${name:-}" ] || continue
    printf '  %-26s %-14s %s\n' "$name" "$cap" "$(printf '%s' "$desc" | cut -c1-64)"
  done

  # Said before the advice, because it is a fact about this machine rather
  # than about the catalogue: a plugin that was read, judged and installed is
  # no longer the copy that was judged. Silent when nothing has moved, which
  # is the only way a line like this stays worth reading.
  local drifted; drifted="$(felix_discover_drifted "$proj" "$FELIX_HOME_DIR")"
  if [ -n "$drifted" ]; then
    printf '\ninstalled copies that are no longer what was read\n\n'
    printf '%s\n' "$drifted" | while IFS=$'\t' read -r dn dd; do
      [ -n "${dn:-}" ] || continue
      printf '  %-26s %s\n' "$dn" "$dd"
    done
    printf '\nThe tier on file for each was scored from the other copy. Re-reading\n'
    printf 'them is felix discover --inspect; nothing here has been changed.\n'
  fi

  if [ "$inspect" -ne 1 ]; then
    printf '\nThat is the catalogue talking. It says nothing about what any of them\n'
    printf 'actually ship, and the listing carries no hooks or servers to check.\n\n'
    printf 'read the source before trusting any of it:  felix discover --inspect\n'
    return 0
  fi

  printf '\nfetching each at its pinned commit and reading it. nothing is executed.\n\n'
  # Deleted whatever happens, including on interrupt: a half-fetched plugin
  # left on disk is exactly the kind of thing someone later runs by accident.
  #
  # The path is global and the trap is written defensively. A trap body is
  # evaluated when it fires, not when it is set, and a `local` is long gone by
  # then — so referring to one made the cleanup itself die on an unbound
  # variable, leaving behind precisely what it existed to remove.
  _FELIX_DISCOVER_SCRATCH=""
  trap 'rm -rf "${_FELIX_DISCOVER_SCRATCH:-}" 2>/dev/null' EXIT INT TERM
  _FELIX_DISCOVER_SCRATCH="$(mktemp -d)" || die "cannot create a scratch directory"
  local scratch="$_FELIX_DISCOVER_SCRATCH"

  printf '%s\n' "$cands" | while IFS=$'\t' read -r score cap name desc; do
    [ -n "${name:-}" ] || continue
    local src url sha sub mkt facts risk why
    src="$(felix_discover_source "$name")" || src=""
    url="$(printf '%s' "$src" | cut -f1)"
    sha="$(printf '%s' "$src" | cut -f2)"
    sub="$(printf '%s' "$src" | cut -f3)"
    mkt="$(printf '%s' "$src" | cut -f4)"
    if [ -z "$url" ]; then
      printf '  %-26s %-8s could not resolve a source to read\n' "$name" "unknown"
      continue
    fi
    if ! felix_discover_fetch "$url" "$sha" "$scratch/$name"; then
      printf '  %-26s %-8s fetch failed, skipped\n' "$name" "unknown"
      continue
    fi
    facts="$(felix_discover_inspect "$scratch/$name" "$sub" \
      "$(felix_discover_marketplace_file "$mkt")" "$name")"
    risk="$(felix_discover_risk "$facts")"
    why="$(felix_discover_why "$facts")"
    printf '  %-26s %-8s %s\n' "$name" "$risk" "${why:-skills only, nothing that runs on its own}"
    [ -z "$sha" ] && printf '  %-26s %-8s (no pinned sha: what you install may differ from this)\n' "" ""
    rm -rf "$scratch/$name"
  done

  printf '\nNothing was installed and nothing was written. To act on this:\n\n'
  printf '  felix discover --adopt    declares and installs the low-risk ones\n\n'
  printf 'A high tier is not an accusation. It means the thing runs code on your\n'
  printf 'machine, and that this check reads files rather than behaviour: a plugin\n'
  printf 'that passes every line above can still do as it likes once it runs.\n'
}

cmd_ready() {
  resolve_or_die; local proj="$PROJ" fix=0 a
  for a in "$@"; do [ "$a" = "--fix" ] && fix=1; done
  [ -f "$proj/routes.tsv" ] || die "project $(basename "$proj") declares no routes.tsv"

  local rows; rows="$(felix_ready_report "$proj")"
  if [ -z "$rows" ]; then
    printf 'No route in %s names a tool. Nothing to check.\n' "$(basename "$proj")"
    return 0
  fi

  printf 'tools %s could reach for\n\n' "$(basename "$proj")"
  printf '%s\n' "$rows" | while IFS=$'\t' read -r st name detail; do
    [ -n "${st:-}" ] || continue
    case "$st" in
      usable)     printf '  [x] %-34s %s\n' "$name" "$detail" ;;
      disabled)   printf '  [!] %-34s %s\n' "$name" "$detail" ;;
      absent)     printf '  [ ] %-34s %s\n' "$name" "$detail" ;;
      undeclared) printf '  [?] %-34s %s\n' "$name" "$detail" ;;
      unknown)    printf '  [-] %-34s %s\n' "$name" "$detail" ;;
    esac
  done

  # What exists here that no route reaches for. A table naming one plugin five
  # times while thirty others sit idle is a habit, not a router.
  local unused n_unused
  unused="$(felix_ready_unused "$proj")"
  n_unused="$(printf '%s\n' "$unused" | grep -c . || true)"
  if [ "${n_unused:-0}" -gt 0 ]; then
    printf '\ninstalled here, never reached for by any route (%s)\n\n' "$n_unused"
    printf '%s\n' "$unused" | head -24 | while IFS=$'\t' read -r k nm; do
      [ -n "${k:-}" ] || continue
      printf '  %-8s %s\n' "$k" "$nm"
    done
    [ "$n_unused" -gt 24 ] && printf '  ... and %s more\n' "$((n_unused - 24))"
    printf '\nNot a problem, a menu. Add a keyword to %s/routes.tsv for any of\n' "$proj"
    printf 'these you would want reached for automatically.\n'
  fi

  local bad unknown
  bad="$(printf '%s\n' "$rows" | grep -cE '^(disabled|absent)' || true)"
  unknown="$(printf '%s\n' "$rows" | grep -cE '^(unknown|undeclared)' || true)"
  printf '\n'
  # Reporting "everything is fine" when nothing could be checked is the failure
  # this whole project keeps finding: a check that proves nothing must not read
  # like a check that passed.
  if [ "${unknown:-0}" -gt 0 ]; then
    printf '%s of these could not be checked, so this is not a clean bill.\n' "$unknown"
  fi
  if [ "${bad:-0}" -eq 0 ] && [ "${unknown:-0}" -eq 0 ]; then
    printf 'Everything a route can name is installed and switched on.\n'
    return 0
  fi
  if [ "${bad:-0}" -eq 0 ]; then return 1; fi

  printf '%s of these cannot be used in a session.\n\n' "$bad"
  printf 'This matters before a session starts, not during one. A skill can be\n'
  printf 'invoked mid-turn, but a plugin that is switched off cannot be switched\n'
  printf 'on without a restart, so the router would name it and nothing would\n'
  printf 'happen. A disabled plugin is the worst case: it is installed, so every\n'
  printf 'check by eye passes, and it contributes nothing.\n\n'

  if [ "$fix" -ne 1 ]; then
    printf 'fix what is safe to fix with: felix ready --fix\n'
    return 1
  fi

  command -v claude >/dev/null 2>&1 || die "felix ready --fix needs the claude CLI"
  printf 'fixing\n'
  # Counted, because the loop's per-row prose is the only place the outcome
  # appeared and no summary aggregated it. The heredoc below keeps this loop in
  # the current shell, so these survive it; a pipe would not (#80).
  local st name detail owner risk repaired=0 unrepaired=0
  while IFS=$'\t' read -r st name detail; do
    [ -n "${st:-}" ] || continue
    case "$name" in *:*) owner="${name%%:*}" ;; *) owner="$name" ;; esac
    local srow; srow="$(grep -E "	($name|$owner)(@[^	]*)?	" "$proj/stack.tsv" 2>/dev/null | head -1)"
    # Read the row the way felix_stack_plan reads it, so the two policy callers
    # cannot disagree about the same line. `cut -f6` and a trailing `read`
    # variable differ on a row with seven fields: cut takes the sixth alone,
    # read takes the sixth onwards. Neither is more right, but they must not
    # both be in the engine deciding the same question.
    local _sk _sn _ss sground
    IFS=$'\t' read -r _sk _sn _ss risk _sc sground <<SROW
$srow
SROW
    case "$st" in
      disabled)
        if claude plugin enable "$detail" >/dev/null 2>&1 || claude plugin enable "$owner" >/dev/null 2>&1; then
          printf '  enabled    %s\n' "$name"; repaired=$((repaired + 1))
        else
          printf '  FAILED     %s (enable by hand)\n' "$name"; unrepaired=$((unrepaired + 1))
        fi ;;
      absent)
        # The same policy as felix stack apply, because it is now literally
        # the same call rather than a second copy of the same bound. The row
        # says who grounded it in its sixth column; a row with none is a
        # person's, DECLARED. A row with no tier at all reads `high`, which
        # refuses — an absent tier is not a licence.
        if [ "$(felix_admit "${risk:-high}" "${sground:-DECLARED}")" = "install" ]; then
          if claude plugin install "$owner" --scope user >/dev/null 2>&1; then
            printf '  installed  %s\n' "$name"; repaired=$((repaired + 1))
          else
            printf '  FAILED     %s (install by hand)\n' "$name"; unrepaired=$((unrepaired + 1))
          fi
        else
          # Refused counts as unrepaired. Nothing failed, Felix simply declined
          # to act — which is the outcome most likely to be read as success.
          printf '  refused    %-24s %s\n' "$name" "$(felix_admit_why "${risk:-high}" "${sground:-DECLARED}")"
          unrepaired=$((unrepaired + 1))
        fi ;;
    esac
  done <<EOF
$(printf '%s\n' "$rows" | grep -E '^(disabled|absent)')
EOF
  printf '\nRe-run felix ready to confirm. Anything newly enabled applies to the\n'
  printf 'NEXT session, not this one.\n'

  # There was no return here at all, so the status was the printf above: 0,
  # whatever happened. A run where every repair failed exited exactly like one
  # that fixed everything. Said in words as well as in the status, because the
  # per-row lines are the only other place this appeared and nobody totals them.
  if [ "$unrepaired" -gt 0 ]; then
    printf '\n%s still cannot be used; %s repaired.\n' "$unrepaired" "$repaired"
    return 1
  fi
  return 0
}

cmd_monitor() {
  local open=0 watch=0 every=5 a out tpl
  while [ $# -gt 0 ]; do
    case "$1" in
      --open)  open=1; shift ;;
      --watch) watch=1; shift ;;
      --every) need_value "$@"; every="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  tpl="$SCRIPT_DIR/templates/monitor.html"
  out="$FELIX_HOME_DIR/state/monitor.html"

  if ! felix_monitor_render "$tpl" "$FELIX_HOME_DIR" "$out"; then
    die "could not render the monitor (template: $tpl)"
  fi

  printf 'wrote %s\n\n' "$out"
  local n
  n="$(ls -d "$FELIX_HOME_DIR"/projects/*/ 2>/dev/null | wc -l | tr -d ' ')"
  printf '  %s project(s)\n' "$n"
  printf '  %s routing decision(s)\n' \
    "$(cat "$(felix_mem_root)"/*/routes.log 2>/dev/null | felix_count .)"
  printf '  %s gate verdict(s)\n' \
    "$(cat "$(felix_mem_root)"/*/verification.log 2>/dev/null | felix_count .)"

  if [ "$watch" -eq 1 ]; then
    if [ "$open" -eq 1 ]; then
      command -v open >/dev/null 2>&1 && open "$out" >/dev/null 2>&1 || true
    fi
    printf '\nwatching. re-rendering every %ss. press the live button on the page,\n' "$every"
    printf 'then leave this running. ctrl-c to stop.\n\n'
    while :; do
      sleep "$every"
      felix_monitor_render "$tpl" "$FELIX_HOME_DIR" "$out" >/dev/null 2>&1 || true
      printf '.'
    done
  fi

  printf '\nA snapshot, not a feed. Re-run this to refresh it, or:\n'
  printf '  felix monitor --watch --open\n'
  if [ "$open" -eq 1 ]; then
    command -v open >/dev/null 2>&1 && open "$out" && return 0
    command -v xdg-open >/dev/null 2>&1 && xdg-open "$out" && return 0
    printf 'no opener found; open the file by hand\n'
  else
    printf 'open it with: felix monitor --open\n'
  fi
}

cmd_profile() {
  resolve_or_die; local proj="$PROJ" want="${1:-}"
  [ -f "$proj/profiles.tsv" ] || die "project $(basename "$proj") declares no profiles"
  if [ -z "$want" ]; then
    printf 'profiles for %s:\n\n' "$(basename "$proj")"
    grep -vE '^\s*(#|$)' "$proj/profiles.tsv" | while IFS=$'\t' read -r n caps _; do
      printf '  %-12s %s\n' "$n" "$caps"
    done
    printf '\nfelix profile <name> shows the tools a profile activates.\n'
    return 0
  fi
  local caps
  caps="$(grep -vE '^\s*(#|$)' "$proj/profiles.tsv" | awk -F'\t' -v p="$want" '$1==p{print $2}')"
  [ -n "$caps" ] || die "no profile named $want"
  printf 'profile:      %s\ncapabilities: %s\n\nactivates:\n' "$want" "$caps"
  _felix_load_state
  # Six variables, not five. A trailing `read` variable absorbs every remaining
  # field INCLUDING its tab, so when stack.tsv grew a grounding column `cap`
  # became "frontend<TAB>DECLARED", the capability test below could never match,
  # and this printed an empty activates list — a wrong answer indistinguishable
  # from the correct one, exit 0. Every reader of these rows takes the column.
  _felix_stack_rows "$proj" | while IFS=$'\t' read -r kind name _ risk cap _ground; do
    # A row belongs to this profile if the profile claims its capability, or if
    # the row is unconditional.
    case ",$caps,always," in *",$cap,"*) ;; *) continue ;; esac
    _felix_have "$kind" "$name" && st="mounted" || st="MISSING"
    printf '  %-10s %-46s %-8s %s\n' "$kind" "$name" "$risk" "$st"
  done
  printf '\nEverything else stays unmounted. Installed is not active.\n'
}

cmd_stack() {
  resolve_or_die; local proj="$PROJ" sub="${1:-plan}" yes=0
  shift || true
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; done

  # The record, read in the one direction plan/apply cannot: what the sessions
  # actually reached for and what the plays actually named, against what the
  # manifest declares. Proposals only — mounting binds at session start, so
  # anything acted on lands next session, and a person does the acting.
  # Answers before the stack.tsv guard below on purpose: a project that never
  # declared a stack still has a record worth reading, and every ledger row is
  # evidence whether or not a manifest exists.
  if [ "$sub" = "reconcile" ]; then
    # Fold anything nothing folded, before reading — the same thing
    # `felix ledger` does one command over, and for the same reason. This
    # reads felix_ledger_summary directly, so without it the report is
    # computed over whichever sessions happened to exit cleanly, and the
    # sentence at the bottom of the empty case says the record and the
    # manifest agree on the strength of that subset. An unmount is proposed
    # from calls at zero, which is precisely what an unfolded session's
    # reaches would falsify, so silence here was the cheapest possible way to
    # be wrong. Done here rather than in a hook because the cost is several
    # greps per distinct signal per stranded session, and that belongs to a
    # person asking for the report.
    local lroot; lroot="$(felix_repo_root "$PWD")"
    local caught; caught="$(felix_ledger_catchup "$proj" "$FELIX_HOME_DIR" "$lroot" 2>/dev/null)"
    if [ "${caught:-0}" -gt 0 ] 2>/dev/null; then
      printf 'folded %s session(s) whose record was behind what is on disk.\n' "$caught"
      printf 'Their calls were recorded all along and had never been counted.\n\n'
    fi
    local props mem; props="$(felix_stack_reconcile "$proj")"
    if [ -z "$props" ]; then
      # An empty answer has two honest readings and only one of them is
      # agreement. With no ledger at all there is no record to agree with,
      # and saying "the record and the manifest agree" would be the
      # passes-by-finding-nothing shape this project keeps paying for.
      mem="$(felix_mem_dir "$proj")"
      if [ ! -f "$mem/ledger.tsv" ] && [ ! -d "$mem/ledger.d" ]; then
        printf 'No record yet for %s. The reconciler reads the ledger, and no\n' "$(basename "$proj")"
        printf 'session has written one; nothing can be proposed or ruled out.\n'
        return 0
      fi
      printf 'The record proposes no change to what is mounted for %s.\n' "$(basename "$proj")"
      printf '\nA mount is proposed only from evidence a session left — an MCP server\n'
      printf 'reached with no row declaring it — and an unmount only from a declared\n'
      printf 'row pointed at and never reached across %s or more sessions.\n' "${FELIX_LEDGER_MIN:-5}"
      printf 'Silence means the record and the manifest agree.\n'
      return 0
    fi
    printf 'reconcile for %s\n\n' "$(basename "$proj")"
    printf '  %-9s %-24s %s\n' ACTION NAME EVIDENCE
    printf '%s\n' "$props" | while IFS=$'\t' read -r act nm ev; do
      [ -n "${act:-}" ] || continue
      printf '  %-9s %-24s %s\n' "$act" "$nm" "$ev"
    done
    printf '\nProposals only. Nothing was installed, removed, or written.\n\n'
    printf 'A mount is a row to add to %s/stack.tsv — mcp, the name, a source,\n' "$proj"
    printf 'a risk a person judges — then felix stack apply --yes installs it. An\n'
    printf 'unmount is that row deleted, and claude mcp remove <name> unmounts the\n'
    printf 'server itself. Mounting binds at session start, so either change lands\n'
    printf 'next session, not this one.\n\n'
    printf 'A declare is the same row with kind plugin rather than mcp: the\n'
    printf 'registry says a plugin provides that server, so claude mcp add has\n'
    printf 'nothing to add and the declaration a person writes has to name the\n'
    printf 'plugin the ledger is actually recording.\n\n'
    printf 'What is left is the case the record genuinely cannot decide: a server\n'
    printf 'the host provides looks exactly like one you added yourself, and\n'
    printf 'neither carries a plugin the registry knows. A mount proposal for one\n'
    printf 'of those is the record saying it is used, not an instruction —\n'
    printf 'leaving it unacted is an answer, and session start will not raise a\n'
    printf 'proposal twice.\n'
    return 0
  fi

  [ -f "$proj/stack.tsv" ] || die "project $(basename "$proj") declares no stack.tsv"

  local plan; plan="$(felix_stack_plan "$proj")"
  printf '%-9s %-11s %s\n' ACTION KIND NAME
  printf '%s\n' "$plan" | while IFS=$'\t' read -r act kind name detail; do
    [ -n "${act:-}" ] || continue
    printf '%-9s %-11s %-46s %s\n' "$act" "$kind" "$name" "$detail"
  done

  local n_install n_blocked
  n_install="$(printf '%s\n' "$plan" | grep -c '^install' || true)"
  n_blocked="$(printf '%s\n' "$plan" | grep -c '^blocked' || true)"

  if [ "$sub" = "plan" ]; then
    # Not "as high risk": a block is now also what an engine-grounded medium
    # gets, and what an unreadable tier gets. The plan's own detail column says
    # which, in the policy's words, and this line stopped being able to.
    printf '\n%s to install, %s blocked.\n' "$n_install" "$n_blocked"
    [ "$n_install" -gt 0 ] && printf 'apply with: felix stack apply --yes\n'
    return 0
  fi

  [ "$sub" = "apply" ] || die "usage: felix stack [plan|apply|reconcile] [--yes]"
  if [ "$yes" -ne 1 ]; then
    printf '\nThis was a plan. Nothing changed.\n'
    printf 'Re-run with --yes to install the %s item(s) above.\n' "$n_install"
    return 0
  fi

  printf '\napplying %s item(s)\n' "$n_install"
  local failed=0
  while IFS=$'\t' read -r act kind name detail; do
    [ "$act" = "install" ] || continue
    local source
    source="$(_felix_stack_rows "$proj" | awk -F'\t' -v n="$name" '$2==n{print $3}')"
    if felix_stack_install "$kind" "$name" "$source"; then
      printf '  installed  %s %s\n' "$kind" "$name"
      # The same comparison the adopt path makes, for the other door into
      # installing something. Drift only: most rows in a stack.tsv were
      # written by a person and never went through discovery, so they carry
      # no digest, and a line saying so for each of them would be noise
      # rather than a finding.
      if [ "$kind" = plugin ]; then
        local sline
        sline="$(felix_discover_drift "$proj" "$FELIX_HOME_DIR" "$name")"
        if [ "$(printf '%s' "$sline" | cut -f1)" = drift ]; then
          printf '  DRIFT      %s %s is not the copy discovery read\n' "$kind" "$name"
          printf '             %s\n' "$(printf '%s' "$sline" | cut -f2-)"
        fi
      fi
    else
      printf '  FAILED     %s %s\n' "$kind" "$name"
      failed=$((failed+1))
    fi
  done <<EOF
$plan
EOF
  if [ "$n_blocked" -gt 0 ]; then
    printf '\n%s high-risk item(s) were not touched. No flag installs those.\n' "$n_blocked"
  fi
  [ "$failed" -eq 0 ] || { printf '\n%s failed.\n' "$failed"; return 1; }
}



cmd_bootstrap() {
  resolve_or_die; local proj="$PROJ" yes=0 a
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; done
  local root slug eco felix_repo branch
  root="$(felix_repo_root "$PWD")"
  slug="$(felix_repo_slug "$root")"
  eco="$(felix_guess_ecosystem "$root")"
  branch="$(git -C "$root" symbolic-ref --short HEAD 2>/dev/null || echo main)"
  # The file the repair loop and the auto-merge streak read the gate's runs
  # from, so the one this looks for and writes. Resolved before anything is
  # printed: a refused gate_workflow is a fact about the project to fix first.
  local gwf; gwf="$(felix_gate_workflow "$proj")" || die "$gwf"
  # The Felix checkout, not the directory this script happens to sit in. #65:
  # `felix_repo_slug "$FELIX_ROOT"` asked git for a remote inside the running
  # engine, which from the deployed CLI is the plugin cache — no remote, so this
  # printed "none, CI cannot fetch the harness" about an engine whose remote
  # exists. Worse on a machine whose home directory is itself a git repository
  # with an origin: that slug would be returned instead and interpolated into
  # the generated workflow's `repository:`, beside a deploy key.
  #
  # The correct pattern was already two lines above, in this same function:
  # resolve the tree first, then slug the tree.
  local esrc; esrc="$(felix_engine_source "$FELIX_ROOT" "$FELIX_HOME_DIR")" || esrc=""
  felix_repo=""
  [ -n "$esrc" ] && felix_repo="$(felix_repo_slug "$esrc")"
  # The commit CI checks Felix out at, from the same checkout as the slug, and
  # holding this project when the project lives in that checkout. Physical
  # paths on both sides: macOS spells /var as /private/var, and git reports
  # the resolved form.
  local etop pdir prel="" felix_ref
  etop="$(git -C "$esrc" rev-parse --show-toplevel 2>/dev/null)" || etop=""
  pdir="$(cd "$proj" 2>/dev/null && pwd -P)" || pdir=""
  case "$pdir" in "$etop"/?*) [ -n "$etop" ] && prel="${pdir#"$etop"/}" ;; esac
  felix_ref="$(felix_bs_pin_ref "$esrc" "$prel")" || felix_ref=""
  local ref_none="none: no commit of the engine checkout that origin's default branch holds${prel:+ with $prel in it}; the workflow gets {{FELIX_REF}} to fill"

  printf 'repo:        %s\n' "${slug:-no github remote}"
  printf 'ecosystem:   %s\n' "$eco"
  printf 'felix repo:  %s\n' "${felix_repo:-none, CI cannot fetch the harness}"
  printf 'felix ref:   %s\n\n' "${felix_ref:-$ref_none}"

  local todo=0
  _bs() {  # name, already-satisfied, description
    if [ "$2" = "yes" ]; then printf '  [x] %-12s %s\n' "$1" "$3"
    else printf '  [ ] %-12s %s\n' "$1" "$3"; todo=$((todo+1)); fi
  }
  _felix_bs_have_workflow "$root" "$gwf" && w=yes || w=no
  _bs ci-workflow "$w" ".github/workflows/$gwf calling felix gate"
  if [ -n "$slug" ]; then
    _felix_bs_have_labels "$slug" && l=yes || l=no
    _bs labels "$l" "escalation and risk labels the repair loop applies"
    _felix_bs_have_protection "$slug" "$branch" && p=yes || p=no
    _bs protection "$p" "require the gate on $branch, block force pushes"
  else
    printf '  [-] %-12s no github remote; labels and protection skipped\n' "github"
  fi
  _felix_bs_have_perms "$root" && m=yes || m=no
  _bs permissions "$m" ".claude/settings.json deny and ask policy"

  if [ "$todo" -eq 0 ]; then printf '\nBaseline already in place.\n'; return 0; fi
  if [ "$yes" -ne 1 ]; then
    printf '\n%s step(s) outstanding. Nothing changed.\n' "$todo"
    printf 'apply with: felix bootstrap --yes\n'
    return 0
  fi

  printf '\napplying\n'
  if ! _felix_bs_have_workflow "$root" "$gwf"; then
    if [ -z "$felix_repo" ]; then
      printf '  skipped    ci-workflow (Felix has no remote for CI to fetch)\n'
    else
      mkdir -p "$root/.github/workflows"
      felix_bs_render_workflow "$eco" "$felix_repo" "$felix_ref" > "$root/.github/workflows/$gwf"
      printf '  wrote      .github/workflows/%s (review, then commit it)\n' "$gwf"
      [ -n "$felix_ref" ] || printf "             its ref: is {{FELIX_REF}}; set the full sha of a commit on %s's default branch first\n" "$felix_repo"
    fi
  fi
  if [ -n "$slug" ] && ! _felix_bs_have_labels "$slug"; then
    gh label create needs-founder --repo "$slug" --color D93F0B --description "Repair loop hit its ceiling; a human must diagnose" >/dev/null 2>&1
    gh label create needs-architecture --repo "$slug" --color 5319E7 --description "Failure is a design problem, not a patch" >/dev/null 2>&1
    gh label create risk-green --repo "$slug" --color 0E8A16 --description "Reversible" >/dev/null 2>&1
    gh label create risk-yellow --repo "$slug" --color FBCA04 --description "Not obviously safe; look closely, then merge on green CI" >/dev/null 2>&1
    gh label create risk-red --repo "$slug" --color B60205 --description "Look hardest; an escape channel, not this label, stops a merge" >/dev/null 2>&1
    printf '  created    5 labels\n'
  fi
  if [ -n "$slug" ] && ! _felix_bs_have_protection "$slug" "$branch"; then
    # enforce_admins stays false on purpose: locking the founder out of their own
    # repository during an incident is not a safety property.
    if printf '{"required_status_checks":{"strict":false,"contexts":["gate"]},"enforce_admins":false,"required_pull_request_reviews":null,"restrictions":null,"allow_force_pushes":false,"allow_deletions":false}' \
       | gh api -X PUT "repos/$slug/branches/$branch/protection" --input - >/dev/null 2>&1; then
      printf '  protected  %s requires the gate\n' "$branch"
    else
      printf '  FAILED     branch protection (admin rights needed on %s)\n' "$slug"
    fi
  fi
  if ! _felix_bs_have_perms "$root"; then
    mkdir -p "$root/.claude"
    if [ -f "$root/.claude/settings.json" ]; then
      printf '  skipped    permissions (settings.json exists; merge by hand rather than clobber it)\n'
    else
      felix_bs_render_perms > "$root/.claude/settings.json"
      printf '  wrote      .claude/settings.json\n'
    fi
  fi
  printf '\nRe-run felix bootstrap to confirm.\n'
}

cmd_setup() {
  resolve_or_die; local proj="$PROJ" want="${1:-}"
  [ -f "$proj/setup.tsv" ] || die "project $(basename "$proj") declares no setup steps"

  if [ -n "$want" ]; then
    felix_setup_runbook "$proj" "$want"; return $?
  fi

  local st; st="$(felix_setup_status "$proj")"
  local todo; todo="$(printf '%s\n' "$st" | grep -c '^todo' || true)"

  printf 'setup for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$st" | while IFS=$'\t' read -r s id title; do
    [ -n "${s:-}" ] || continue
    case "$s" in
      done)    printf '  [x] %-22s %s\n' "$id" "$title" ;;
      todo)    printf '  [ ] %-22s %s\n' "$id" "$title" ;;
      dormant) printf '  [-] %-22s %s (not needed yet)\n' "$id" "$title" ;;
    esac
  done

  if [ "$todo" -eq 0 ]; then
    printf '\nNothing outstanding.\n'
    return 0
  fi
  printf '\n%s step(s) need you. These are things an agent should not do:\n' "$todo"
  printf 'creating accounts, completing OAuth, handling live keys.\n\n'
  printf 'felix setup <id>   full instructions for one step\n'
}



cmd_receipt() {
  resolve_or_die; local proj="$PROJ" base="main"
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local root; root="$(felix_repo_root "$PWD")"
  # origin/<base> when it exists, and the name as given otherwise. `main` is a
  # local ref a worktree can never advance, so it goes stale silently and the
  # comparison is then against whatever the primary checkout last pulled (#74).
  # Resolved here rather than inside the diff functions so every line this
  # command prints names the ref it actually used.
  base="$(felix_base_ref "$root" "$base" 2>/dev/null || printf '%s' "$base")"
  felix_receipt "$proj" "$base" "$root" "$FELIX_HOME_DIR"
}

cmd_evidence() {
  resolve_or_die; local proj="$PROJ" base="main" strict=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      --strict) strict=1; shift ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/evidence.tsv" ] || die "project $(basename "$proj") declares no evidence.tsv"
  local root results gaps
  root="$(felix_repo_root "$PWD")"
  # origin/<base> when it exists, and the name as given otherwise. `main` is a
  # local ref a worktree can never advance, so it goes stale silently and the
  # comparison is then against whatever the primary checkout last pulled (#74).
  # Resolved here rather than inside the diff functions so every line this
  # command prints names the ref it actually used.
  base="$(felix_base_ref "$root" "$base" 2>/dev/null || printf '%s' "$base")"
  results="$(felix_evidence_check "$proj" "$base" "$root")"
  [ -n "$results" ] || { printf 'No evidence rules declared.\n'; return 0; }

  printf 'base:  %s\n\n' "$base"

  # Checked before the rows are rendered, because the sentence at the bottom is
  # the one that gets read. "No evidence gaps" after a scan that never ran is
  # the same false all-clear #56 removed from felix merge, and leaving it here
  # would move it rather than fix it. Exits non-zero regardless of --strict: an
  # unanswerable question is not a passing report.
  if printf '%s\n' "$results" | grep -q '^unknown	'; then
    printf '%s\n' "$results" | while IFS=$'\t' read -r st name reason; do
      [ "${st:-}" = "unknown" ] || continue
      printf '  [?] %-14s %s\n' "$name" "$reason"
    done
    printf '\nNothing was compared, so nothing above is a finding about this change.\n'
    printf 'Check --base, or the default branch, which is not `main` everywhere.\n'
    printf 'This says nothing about what the change owes; that was never asked.\n'
    return 1
  fi

  printf '%s\n' "$results" | while IFS=$'\t' read -r st name reason; do
    [ -n "${st:-}" ] || continue
    case "$st" in
      met) printf '  [x] %-14s %s\n' "$name" "$reason" ;;
      gap) printf '  [!] %-14s %s\n' "$name" "$reason" ;;
      n/a) printf '  [-] %-14s %s\n' "$name" "$reason" ;;
    esac
  done

  gaps="$(printf '%s\n' "$results" | grep -c '^gap' || true)"
  printf '\n'
  if [ "$gaps" -eq 0 ]; then
    printf 'No evidence gaps.\n'
    return 0
  fi
  printf '%s gap(s). Each one is a change to behaviour with nothing proving it.\n' "$gaps"
  printf 'Add the test, or say in the pull request why it is not practical here.\n'
  [ "$strict" -eq 1 ] || return 0
  printf '\n--strict: failing.\n'
  return 1
}





cmd_unattended() {
  resolve_or_die; local proj="$PROJ"
  command -v gh >/dev/null 2>&1 || die "felix unattended needs the gh CLI"
  local repo; repo="$(felix_repo_slug "$(felix_repo_root "$PWD")")"
  [ -n "$repo" ] || die "no github remote"
  local gwf; gwf="$(felix_gate_workflow "$proj")" || die "$gwf"

  local st switch key dry dryfail streak need
  st="$(felix_unattended_state "$repo")"
  switch="$(printf '%s\n' "$st" | awk -F'\t' '$1=="switch"{print $2}')"
  key="$(printf '%s\n' "$st" | awk -F'\t' '$1=="key"{print $2}')"
  dry="$(printf '%s\n' "$st" | awk -F'\t' '$1=="dryruns"{print $2}')"
  dryfail="$(printf '%s\n' "$st" | awk -F'\t' '$1=="dryfails"{print $2}')"
  streak="$(felix_automerge_streak "$(felix_automerge_history "$repo" "$gwf")")"
  need="$FELIX_AUTOMERGE_REQUIRED"

  printf 'repo:  %s\n\n' "$repo"
  [ "${switch:-0}" -gt 0 ] && printf '  ON      the loop invokes a model on CI failure\n' \
                           || printf '  off     the guards run; nothing is invoked\n'
  [ "${key:-0}" -gt 0 ] && printf '  [x] %-26s %s\n' "api key" "present" \
                        || printf '  [ ] %-26s %s\n' "api key" "absent; nothing could run anyway"
  printf '  %s %-26s %s of %s\n' \
    "$([ "${streak:-0}" -ge "$need" ] && printf '[x]' || printf '[ ]')" \
    "green merges judged well" "$streak" "$need"
  printf '  %s %-26s %s run(s), %s errored\n' \
    "$([ "${dry:-0}" -gt 0 ] && [ "${dryfail:-0}" -eq 0 ] && printf '[x]' || printf '[ ]')" \
    "guards exercised" "${dry:-0}" "${dryfail:-0}"
  # Both of these were printf constants, and this is the report somebody reads
  # while deciding whether to switch on a loop that invokes a model unattended
  # (#87). A checklist that manufactures the evidence for its own switch-on is
  # worse than one that says nothing.
  #
  # The ceiling gets `[?]`, not `[x]` or `[ ]`, and the third mark is the point.
  # Its old `[x]` was not wrong about what it SAID - a ceiling is configured,
  # and felix_budget_limit can never return "none" - but readiness means the
  # bound HOLDS, and where the loop actually runs it does not: the ledger sits
  # in a checkout made fresh every run, so the count restarts at zero (#84).
  # Felix cannot determine that mechanically - the deciding fact is whether the
  # filesystem is ephemeral, which neither git nor bash can answer - so marking
  # it either way would be a claim it has not earned. It reads the ledger now
  # rather than only the configured number, so at least the figure is a reading.
  printf '  [?] %-26s %s per 24h, %s spent here; does it survive a fresh checkout\n' \
    "budget ceiling" "$(felix_budget_limit "$proj")" "$(felix_budget_used "$proj")"

  # And the scope bound is computed from the table that would do the refusing.
  # Literal, it stayed checked for a project declaring no red path at all -
  # which is exactly the case where nothing is out of scope and the bound it
  # names does not exist.
  #
  # Both kinds, not paths alone (#100). risk.tsv's second column takes `path`
  # or `content`, and a content rule refuses just as a path rule does - felix
  # scope classifies the whole diff. Counting paths alone told a project whose
  # red tier is all content rules - secrets, destructive SQL, the material the
  # red tier exists for - that nothing was out of scope, on the checklist read
  # before switching on unattended model runs; a governed project carries two
  # such rules today. And felix_count rather than `grep -c || printf 0`: that idiom
  # yields "0\n0" on a zero count and is the trap #40 extracted felix_count to
  # end. The case guard below it was carrying the fix by accident.
  local redrules=0
  [ -f "$proj/risk.tsv" ] && redrules="$(felix_count -E '^red[[:space:]]+(path|content)[[:space:]]' "$proj/risk.tsv")"
  if [ "$redrules" -gt 0 ]; then
    printf '  [x] %-26s %s red rule(s), refused before the log is read\n' \
      "scope bound" "$redrules"
  else
    printf '  [ ] %-26s no red rule declared; nothing is out of scope\n' "scope bound"
  fi

  printf '\n'
  if [ "${switch:-0}" -gt 0 ]; then
    printf 'Already on. Turn it off with:\n  gh variable delete FELIX_UNATTENDED --repo %s\n' "$repo"
    return 0
  fi

  printf 'Felix will not turn this on for you, and the reason is not caution.\n\n'
  printf '[?] is not [x]. The ceiling is configured and it binds on this disk;\n'
  printf 'whether it binds where the loop runs depends on the ledger surviving a\n'
  printf 'fresh checkout, and that is not a fact Felix can read. See issue #84.\n\n'
  printf 'Auto-merge can unlock itself because what it unlocks is bounded and its\n'
  printf 'worst case is a revert. This is not that. And the evidence that would\n'
  printf 'justify it cannot be gathered without spending it: every dry run stops\n'
  printf 'before the model is invoked, so they show the guards run and say nothing\n'
  printf 'about whether the guards hold. Nothing has tried to get past them yet.\n\n'
  printf 'The first real unattended repair wants someone watching, which means the\n'
  printf 'first one is not unattended. There is no way around that, only through.\n\n'
  printf '  gh variable set FELIX_UNATTENDED --body true --repo %s\n' "$repo"
}

cmd_budget() {
  resolve_or_die; local proj="$PROJ" record=0 why="unattended run"
  while [ $# -gt 0 ]; do
    case "$1" in
      --record) record=1; shift ;;
      --why) need_value "$@"; why="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local limit used left
  limit="$(felix_budget_limit "$proj")"
  used="$(felix_budget_used "$proj")"
  left=$((limit - used))
  [ "$left" -lt 0 ] && left=0

  if [ "$record" -eq 1 ]; then
    if [ "$used" -ge "$limit" ]; then
      printf 'budget exhausted: %s of %s used in the last 24h\n' "$used" "$limit" >&2
      printf 'Refusing to start. A loop nobody is watching can repeat a mistake all\n' >&2
      printf 'night, and the ceiling worth having fails between runs, not during one.\n' >&2
      return 3
    fi
    # Checked, and distinct from exhaustion. Exit 3 means the ceiling refused
    # this run; exit 4 means the ceiling could not be KEPT, which is worse and
    # was previously reported as success.
    if ! felix_budget_record "$proj" "$why"; then
      printf 'could not record the spend: %s/budget.log was not written.\n' "$proj" >&2
      printf 'Refusing to start. An unrecorded run is an unbounded one - the next\n' >&2
      printf 'read sees the same count, so the ceiling never binds and never says so.\n' >&2
      return 4
    fi
    # Re-read rather than `$((used + 1))`. The old arithmetic was computed
    # before the write and reported a spend whether or not one happened, which
    # is how a failed append announced itself as `recorded.` This number now
    # comes from the ledger, so it can only say what the ledger holds.
    used="$(felix_budget_used "$proj")"

    # Counted AFTER the append, and this is the whole of the race fix.
    #
    # The comparison above is check-then-act with no lock: two callers that both
    # read 9 against a limit of 10 both pass it and both append. Reproduced on
    # one machine, no CI involved - seeded at 9 of 10, three concurrent callers,
    # all three recorded, ledger left at 12. The only mechanical bound on
    # unattended model runs was overrun by three ordinary shells.
    #
    # No lock, deliberately. A lock file needs a staleness rule, and a lock that
    # can be broken is one that can be raced; the ledger is append-only and a
    # line this short is written atomically, so the file itself is the
    # serialisation point. Appending first and deciding afterwards turns the
    # ledger's own length into the compare-and-swap.
    #
    # The direction of error is what makes this correct rather than merely
    # different. A caller that loses the race sees a ledger at least as large as
    # the one it read, so it can only refuse SOONER, and its own entry stays -
    # burning a slot it did not use. At most one caller can observe exactly the
    # limit, so at most the right number proceed. Over-refusing is reachable and
    # costs a repair that waits for the window to reopen; over-spending is not
    # reachable, and that is the asymmetry invariant 3 asks for.
    #
    # Measured, five racers against one remaining slot, three trials: once one
    # caller recorded with the ledger at exactly the ceiling, and twice nobody
    # recorded, because every caller appended before any of them re-read. That
    # second outcome leaves the refused entries standing, so a concurrent burst
    # spends the window on attempts rather than on work. It is the honest cost
    # and it is the right way round: a burst of simultaneous unattended runs is
    # the loop this ceiling exists to stop, and it ages out in 24h by itself.
    if [ "$used" -gt "$limit" ]; then
      printf 'budget exhausted: %s of %s used in the last 24h\n' "$used" "$limit" >&2
      printf 'This run lost a race for the last slot and its entry stands, so the\n' >&2
      printf 'count is over the ceiling. Refusing to start; the window reopens as\n' >&2
      printf 'the oldest entries age out.\n' >&2
      return 3
    fi
    printf 'recorded. %s of %s used in the last 24h\n' "$used" "$limit"
    return 0
  fi

  printf 'limit:  %s unattended run(s) per 24h\nused:   %s\nleft:   %s\n' \
    "$limit" "$used" "$left"
  [ "$left" -gt 0 ] || { printf '\nExhausted. Nothing unattended starts until this ages out.\n'; return 3; }
}

cmd_automerge() {
  resolve_or_die; local proj="$PROJ" enable=0
  for a in "$@"; do [ "$a" = "--enable" ] && enable=1; done
  command -v gh >/dev/null 2>&1 || die "felix automerge needs the gh CLI"
  local repo; repo="$(felix_repo_slug "$(felix_repo_root "$PWD")")"
  [ -n "$repo" ] || die "no github remote"
  local gwf; gwf="$(felix_gate_workflow "$proj")" || die "$gwf"

  local history streak need
  history="$(felix_automerge_history "$repo" "$gwf")"
  streak="$(felix_automerge_streak "$history")"
  need="$FELIX_AUTOMERGE_REQUIRED"

  printf 'repo:    %s\nstreak:  %s of %s consecutive clean green merges\n\n' \
    "$repo" "$streak" "$need"

  if [ -z "$history" ]; then
    printf 'No green pull requests have merged yet.\n\n'
  else
    printf '%s\n' "$history" | head -8 | while IFS=$'\t' read -r num state title; do
      [ -n "${num:-}" ] || continue
      case "$state" in
        clean)   printf '  clean  #%-5s %s\n' "$num" "$title" ;;
        dirty)   printf '  CI RED #%-5s %s\n' "$num" "$title" ;;
        unknown) printf '  ?      #%-5s %s (CI history unavailable)\n' "$num" "$title" ;;
      esac
    done
    printf '\n'
  fi

  if [ "$streak" -lt "$need" ]; then
    printf 'Not yet earned.\n\n'
    printf 'A green classification claims no risky path was touched. CI failing on a\n'
    printf 'green pull request means that claim was wrong, and the rules deciding it\n'
    printf 'have never been tested against a real change. Merge %s more green one(s)\n' \
      "$((need - streak))"
    printf 'by hand and watch whether the tier ever surprises you. If one does, you\n'
    printf 'learned something about the rules for the price of one manual merge.\n'
    return 1
  fi

  printf 'Earned. %s consecutive green merges, none of which CI disagreed with.\n\n' "$streak"
  [ "$enable" -eq 1 ] || { printf 'enable with: felix automerge --enable\n'; return 0; }

  if gh repo edit "$repo" --enable-auto-merge >/dev/null 2>&1; then
    printf 'auto-merge enabled on %s.\n\n' "$repo"
    printf 'It still requires every check to pass. Green plus no evidence gap plus a\n'
    printf 'green gate is the bar; yellow and red are untouched and always will be.\n'
    printf 'A change editing risk.tsv is classified against both the inherited table\n'
    printf 'and its own, and the stricter wins, so a green row cannot green the diff\n'
    printf 'that adds it. That is enforced. Two things are not: evidence.tsv gets no\n'
    printf 'such treatment and is still read off the branch that changes it, and the\n'
    printf 'label this streak counts is applied by hand, never re-derived.\n'
  else
    printf 'could not enable auto-merge; admin rights needed on %s\n' "$repo" >&2
    return 1
  fi
}

cmd_scope() {
  resolve_or_die; local proj="$PROJ" base="" paths=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      -) paths="$(cat)"; shift ;;
      *) paths="$paths
$1"; shift ;;
    esac
  done
  [ -f "$proj/risk.tsv" ] || die "project $(basename "$proj") declares no risk.tsv"
  local root from_diff=0; root="$(felix_repo_root "$PWD")"
  if [ -z "$(printf '%s' "$paths" | tr -d '[:space:]')" ]; then
    from_diff=1
    base="${base:-main}"
    paths="$(felix_changed_paths "$root" "$base")"
  fi
  paths="$(printf '%s\n' "$paths" | grep -v '^$' | sort -u)"
  [ -n "$paths" ] || { printf 'No paths given and no changes found. Nothing to scope.\n'; return 0; }

  # From a diff, the full classifier — it reads content rules, and both shipped
  # tables carry them. felix_incident_severity takes paths, so it could only
  # ever apply path rules, and this gate said "in scope for unattended work"
  # about a diff that added a live credential to a documentation file.
  #
  # From bare paths there is no diff to read, so content rules cannot be applied
  # at all. That is stated rather than papered over: a tier computed from names
  # alone is not the same answer, and printing it as though it were is how a
  # gate gets trusted for something it never checked.
  local sev partial=0
  if [ "$from_diff" -eq 1 ]; then
    sev="$(felix_classify_tier "$(felix_classify_diff "$proj" "$base" "$root")")"
  else
    sev="$(felix_incident_severity "$proj" "$paths")"
    partial=1
  fi
  printf 'paths:\n'; printf '%s\n' "$paths" | sed 's|^|  |'
  printf '\nhighest tier: %s\n\n' "$sev"
  if [ "$partial" -eq 1 ]; then
    printf 'Path rules only. No diff was given, so no content rule could run and a\n'
    printf 'credential or destructive SQL in the changes would not be seen here.\n'
    printf 'Scope a branch instead to get the whole answer.\n\n'
  fi

  if [ "$sev" = "red" ]; then
    printf 'OUT OF SCOPE for unattended work.\n\n'
    printf 'A red path is implicated. The bound that matters is not how many times\n'
    printf 'an agent may try, it is what it may touch: three careful attempts at\n'
    printf 'the authorization model is not safer than one, it is three times the\n'
    printf 'exposure. A person decides here.\n'
    return 3
  fi
  printf 'In scope. Reversible enough for an unattended attempt, still subject to\n'
  printf 'the gate, the classifier and the evidence policy like any other change.\n'
}

cmd_classify() {
  resolve_or_die; local proj="$PROJ" base="main" apply=0 a
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/risk.tsv" ] || die "project $(basename "$proj") declares no risk.tsv"
  local root findings tier
  root="$(felix_repo_root "$PWD")"
  # origin/<base> when it exists, and the name as given otherwise. `main` is a
  # local ref a worktree can never advance, so it goes stale silently and the
  # comparison is then against whatever the primary checkout last pulled (#74).
  # Resolved here rather than inside the diff functions so every line this
  # command prints names the ref it actually used.
  base="$(felix_base_ref "$root" "$base" 2>/dev/null || printf '%s' "$base")"
  findings="$(felix_classify_diff "$proj" "$base" "$root")"

  if [ -z "$findings" ]; then
    printf 'No changes against %s. Nothing to classify.\n' "$base"
    return 0
  fi
  tier="$(felix_classify_tier "$findings")"

  # Before the tier line, because printing `tier:  unknown` beside a findings
  # table would read as a computed verdict on a real diff. There is no diff.
  if [ "$tier" = "unknown" ]; then
    printf 'base:  %s\ntier:  unknown\n\n' "$base"
    printf '%s\n' "$findings" | while IFS=$'\t' read -r t f r; do
      [ "${t:-}" = "unknown" ] || continue
      printf '  %-7s %-46s %s\n' "$t" "$f" "$r"
    done
    printf '\nNothing was compared. This is not a green change and not a risky one;\n'
    printf 'it is a base this repository cannot resolve. Check --base, or the\n'
    printf 'default branch, which is not `main` everywhere.\n'
    return 1
  fi

  printf 'base:  %s\ntier:  %s\n\n' "$base" "$tier"
  printf '%s\n' "$findings" | sort -r | while IFS=$'\t' read -r t f r; do
    [ -n "${t:-}" ] || continue
    printf '  %-7s %-46s %s\n' "$t" "$f" "$r"
  done

  printf '\n'
  case "$tier" in
    green)
      # Green means no risky path was touched. It does not mean the change was
      # proven. Auto-merging on tier alone would ship untested behaviour whenever
      # that behaviour happened to live somewhere unremarkable.
      local ev_gaps=0
      if [ -f "$proj/evidence.tsv" ]; then
        ev_gaps="$(felix_evidence_check "$proj" "$base" "$root" | grep -c '^gap' || true)"
      fi
      if [ "$ev_gaps" -eq 0 ]; then
        printf 'Reversible, and nothing is unproven. Eligible for auto-merge once\nevery required check passes.\n'
      else
        printf 'Reversible, but %s evidence gap(s). Not auto-merge eligible: a green\ntier means no risky path was touched, not that the change was proven.\nRun felix evidence.\n' "$ev_gaps"
      fi
      ;;
    # Tier is advice about how hard to look, and these two lines are what a
    # session reads when it ships. They used to say "a human merges" and
    # "approval required before merge", which nothing enforced — felix merge
    # never reads the tier, only escape channels — and which the founder had
    # already overruled (2026-09-12: Felix merges its own pull requests). A
    # session believed the printed sentence over the direction and left five
    # merges for a person. The stop is a channel; the sentence now says so.
    yellow) printf 'Not obviously safe, though nothing here is irreversible. Look closely,\nthen merge once CI is green; felix merge stops only on a channel that\nescapes the tree.\n' ;;
    red)    printf 'Look hardest here: a mistake in these paths is silent and reaches every\nsession. Put the exact change and its reversal path in the pull request.\nThe tier stops nothing: merge once CI is green unless felix merge names an\nescape channel, which is where a person decides.\n' ;;
  esac

  [ "$apply" -eq 1 ] || { printf '\nlabel the PR with: felix classify --apply\n'; return 0; }

  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote; cannot label"
  # Replace rather than accumulate: a stale green beside a new red reads as a
  # disagreement between two labels instead of a decision.
  gh pr edit --repo "$slug" \
     --remove-label risk-green --remove-label risk-yellow --remove-label risk-red \
     >/dev/null 2>&1 || true
  if gh pr edit --repo "$slug" --add-label "risk-$tier" >/dev/null 2>&1; then
    printf '\nlabelled risk-%s\n' "$tier"
  else
    printf '\ncould not label; is there an open PR for this branch?\n' >&2
    return 1
  fi
}



cmd_maintenance() {
  resolve_or_die; local proj="$PROJ" ran=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ran) need_value "$@"; ran="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/maintenance.tsv" ] || die "project $(basename "$proj") declares no maintenance routines"

  if [ -n "$ran" ]; then
    _felix_maint_rows "$proj" | cut -f1 | grep -qxF "$ran" \
      || die "no routine named $ran"
    felix_maint_record "$proj" "$ran"
    printf 'recorded a run of %s\n' "$ran"
    printf 'commit %s/maintenance.log so the cadence survives this machine.\n' "$proj"
    return 0
  fi

  local st due
  st="$(felix_maint_status "$proj" "$(felix_repo_root "$PWD")")"
  due="$(printf '%s\n' "$st" | grep -c '^due' || true)"

  printf 'maintenance for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$st" | while IFS=$'\t' read -r s name age cadence desc; do
    [ -n "${s:-}" ] || continue
    case "$s" in
      # A checked event row has no age and no cadence: it is due because its
      # check failed and ok because its check passed, and the columns that
      # mean "days since" and "every N days" would render as `-d ago every 0d`
      # — a number nobody wrote, in a row about a fact rather than a clock.
      due)     if [ "$age" = "check" ]; then printf '  DUE     %-18s %-14s %s\n' "$name" "check failed" "$desc"
               else printf '  DUE     %-18s %-14s %s\n' "$name" "last: $age" "$desc"; fi ;;
      ok)      if [ "${cadence:-0}" -eq 0 ] 2>/dev/null; then printf '  ok      %-18s %-14s %s\n' "$name" "check passed" "$desc"
               else printf '  ok      %-18s %-14s every %sd\n' "$name" "${age}d ago" "$cadence"; fi ;;
      event)   printf '  event   %-18s %-14s %s\n' "$name" "on trigger" "$desc" ;;
      # A row with a check, asked from somewhere with no checkout in front of
      # it. Not `event`, which would say the row has nothing to answer to.
      unchecked) printf '  ?       %-18s %-14s %s\n' "$name" "not asked" "$desc" ;;
      dormant) printf '  -       %-18s %-14s %s\n' "$name" "not yet" "$desc" ;;
    esac
  done

  # "Nothing due" and "nothing is being checked" render identically — this
  # project's own recorded lesson, and this is the surface it was written
  # about. A row whose capability nothing declares is dormant forever, so it
  # can never be due, and printing only "Nothing due." over it is that
  # collision. The guard for it was written and then called by nothing but the
  # suite: every surface that reads maintenance keeps `^due` alone.
  local _mu; _mu="$(felix_maint_unreachable "$proj" 2>/dev/null)"
  if [ -n "$_mu" ]; then
    printf '\nDormant rather than satisfied — these wait on a capability nothing\n'
    printf 'declares, so they can never come due as written:\n\n'
    printf '%s\n' "$_mu" | while IFS=$'\t' read -r _mn _mc; do
      [ -n "${_mn:-}" ] || continue
      printf '  %-18s waits on: %s\n' "$_mn" "$_mc"
    done
    printf '\nFix the capability in %s/maintenance.tsv, or declare it.\n' "$proj"
  fi
  if [ "$due" -eq 0 ]; then printf '\nNothing due.\n'; return 0; fi
  printf '\n%s routine(s) due.\n\n' "$due"
  printf 'Do them on one branch, not %s. A flood of autonomous maintenance pull\n' "$due"
  printf 'requests is not review, it is noise that trains people to rubber-stamp.\n'
  printf 'Keep security findings separate, because isolation is what makes those\n'
  printf 'shippable on their own.\n\n'
  printf 'record each with: felix maintenance --ran <name>\n'
}

cmd_incident() {
  resolve_or_die; local proj="$PROJ" src="-" create=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) need_value "$@"; src="$2"; shift 2 ;;
      --create) create=1; shift ;;
      *) shift ;;
    esac
  done
  local root text
  root="$(felix_repo_root "$PWD")"
  if [ "$src" = "-" ]; then text="$(cat)"; else
    [ -f "$src" ] || die "no such file: $src"
    text="$(cat "$src")"
  fi
  [ -n "$text" ] || die "no error text given. pipe it in, or use --from <file>"

  local paths sev suspects
  paths="$(felix_incident_paths "$root" "$text")"
  if [ -z "$paths" ]; then
    printf 'No file in this checkout appears in that text.\n\n'
    printf 'Either the failure is outside this repository, or the trace names\n'
    printf 'paths from another machine. Triage it by hand rather than trusting a\n'
    printf 'brief built from nothing.\n'
    return 0
  fi
  sev="$(felix_incident_severity "$proj" "$paths")"
  suspects="$(felix_incident_suspects "$root" "$paths")"

  local label headline
  case "$sev" in
    red)    label="risk-red";    headline="SEV1. Escalate now, do not start an unattended fix." ;;
    yellow) label="risk-yellow"; headline="SEV2. Fix under normal review." ;;
    *)      label="risk-green";  headline="SEV3. Routine." ;;
  esac

  printf 'project:   %s\nseverity:  %s (%s)\n\n%s\n\n' \
    "$(basename "$proj")" "$sev" "$label" "$headline"

  printf 'implicated files\n'
  printf '%s\n' "$paths" | sed 's|^|  |'

  printf '\nlast touched by\n'
  printf '%s\n' "$suspects" | while IFS=$'\t' read -r f c; do
    [ -n "${f:-}" ] || continue
    printf '  %-44s %s\n' "$f" "$c"
  done

  if [ -f "$proj/evidence.tsv" ]; then
    printf '\nthe fix will have to prove\n'
    while IFS=$'\t' read -r name when requires reason; do
      [ -n "${name:-}" ] || continue
      _felix_any_match "$paths" "$when" && printf '  %-14s %s\n' "$name" "$reason"
    done <<EOF
$(_felix_evidence_rows "$proj")
EOF
  fi

  # Policy, stated every time because urgency is exactly when it gets skipped.
  printf '\nUrgency does not bypass the gates. The fix goes through the same gate,\n'
  printf 'the same classification, and the same evidence policy as any other change.\n'
  [ "$sev" = "red" ] && printf 'A red path is implicated: read the fix harder than usual. The tier is\nadvice; the fix merges on green CI unless felix merge names an escape\nchannel, and that is the part a person decides.\n'

  [ "$create" -eq 1 ] || { printf '\nopen an issue with: felix incident --create\n'; return 0; }

  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote; cannot open an issue"
  local body
  body="$(printf 'Severity: %s\n\n%s\n\n## Implicated files\n\n%s\n\n## Last touched by\n\n%s\n\n## Signal\n\n```\n%s\n```\n' \
    "$sev" "$headline" "$paths" "$suspects" "$(printf '%s' "$text" | head -40)")"
  if gh issue create --repo "$slug" --title "incident: $(printf '%s' "$paths" | head -1)" \
       --body "$body" --label "$label" 2>/dev/null; then
    printf '\nissue opened\n'
  else
    printf '\ncould not open an issue; is the %s label present? try felix bootstrap\n' "$label" >&2
    return 1
  fi
}

cmd_repair() {
  # 4, not resolution's usual 2, which here is the ceiling. The statuses are
  # listed in lib/repair.sh.
  resolve_or_die 4; local proj="$PROJ"
  _felix_repair_require_gh || return 1
  local repo branch latest run_id status conclusion attempts gwf
  repo="$(git remote get-url origin 2>/dev/null | sed -E 's#.*github\.com[:/]##; s#\.git$##')"
  [ -n "$repo" ] || die "no github remote; felix repair supports GitHub Actions only"
  gwf="$(felix_gate_workflow "$proj")" || die "$gwf"
  branch="$(felix_repair_branch)"
  # A detached checkout names its branch HEAD, which no run is on, and "no runs
  # yet" below is nothing to repair: a green job over a failure nobody read.
  [ -n "$branch" ] && [ "$branch" != "HEAD" ] \
    || die "no branch is checked out here, so there is no branch whose gate runs to read. Check out the branch whose run failed."

  # Unreadable is not "no runs". gh fails on a workflow the repository does not
  # have and on a network that does not answer, and both printed nothing, which
  # this read as nothing to repair: a claim about CI that nothing had checked.
  latest="$(felix_repair_latest "$branch" "$repo" "$gwf")" || {
    printf 'Could not read the %s runs for %s: that workflow is not on %s, or gh\n' "$gwf" "$branch" "$repo"
    printf 'could not answer. A project whose gate runs in another workflow names it as\n'
    printf 'gate_workflow in its project.json. Nothing is repaired from a run nobody read.\n'
    return 1
  }
  # Nothing to repair exits 5, its own status, because 0 is a brief to act on
  # and the unattended template reads the status and nothing else. All three
  # cases below exited 0 until 2026-09-23, so a dispatch on a green branch, or
  # a gate run started after the failure the template was woken for, would have
  # spent the budget and handed a model a brief saying nothing was wrong.
  [ -n "$latest" ] || { printf 'No %s runs for %s yet.\n' "$gwf" "$branch"; return 5; }
  run_id="$(printf '%s' "$latest" | cut -f1)"
  status="$(printf '%s' "$latest" | cut -f2)"
  conclusion="$(printf '%s' "$latest" | cut -f3)"

  printf 'branch:   %s\nrun:      %s (%s / %s)\n' "$branch" "$run_id" "$status" "$conclusion"

  if [ "$status" != "completed" ]; then
    printf '\nStill running. Wait for it rather than guessing at the failure.\n'
    return 5
  fi
  # Repair acts only on what its ceiling counts, and failure and timed_out
  # are what it acts on. Until 2026-09-23 only success was caught here and the
  # rest fell through to a brief, including conclusions felix_repair_attempts
  # then stopped at, so the ceiling read zero however many failures sat behind
  # the run. A run that completed without failing is nothing to repair.
  # startup_failure did fail, but the gate never ran and no step left a log,
  # so it is refused, and so is a conclusion this code does not know, rather
  # than guessed at.
  case "$conclusion" in
    failure|timed_out) ;;
    success)
      printf '\nGreen. Nothing to repair.\n'
      return 5 ;;
    cancelled|skipped|neutral|stale|action_required)
      printf '\nThe gate run ended %s, which is not a failure. Nothing to repair;\n' "$conclusion"
      printf 'the next gate run decides.\n'
      return 5 ;;
    startup_failure)
      printf '\nThe gate run failed to start, so no step ran to leave a log. The gate\n'
      printf 'workflow itself needs a look. Nothing is repaired from a run nobody read.\n'
      return 1 ;;
    *)
      printf '\nThe gate run ended %s, a conclusion felix repair does not know, so\n' "$conclusion"
      printf 'whether it failed is not guessed at. Nothing is repaired from a run nobody read.\n'
      return 1 ;;
  esac

  # A count that could not be read is not zero attempts, which is what it was
  # read as: every time gh did not answer, the ceiling reported itself unspent.
  # It stops here with the ceiling's own status, because what could not be
  # shown is that the bound holds, and a caller that honours the ceiling
  # honours this without having to learn a new code.
  attempts="$(felix_repair_attempts "$branch" "$repo" "$gwf")" || {
    printf 'attempts: unreadable\n\n'
    printf 'CEILING UNKNOWN. The %s runs on %s could not be counted, so the ceiling\n' "$gwf" "$branch"
    printf 'cannot be shown unspent: gh did not answer, or its newest runs held no\n'
    printf 'success and fewer failures than the ceiling. Not patching past a bound\n'
    printf 'nobody read; run this again once gh answers or the gate has passed, or\n'
    printf 'escalate:\n\n'
    printf '  gh pr edit --repo %s --add-label needs-founder\n' "$repo"
    return 2
  }
  printf 'attempts: %s of %s\n' "$attempts" "$FELIX_REPAIR_MAX"

  if [ "$attempts" -ge "$FELIX_REPAIR_MAX" ]; then
    printf '\nCEILING REACHED. Stop patching.\n\n'
    printf '%s failures since the gate last passed means the diagnosis is wrong, not the patch.\n' "$attempts"
    printf 'Escalate instead of trying again:\n\n'
    printf '  gh pr edit --repo %s --add-label needs-founder\n\n' "$repo"
    printf 'Then write what was tried and why each attempt failed into\n'
    printf '%s/DEVLOG.md before handing it over.\n' "$(felix_mem_dir "$proj")"
    return 2
  fi

  # Scope before excerpt. Handing an agent the failing log of an authorization
  # change and telling it afterwards not to touch anything is the wrong order:
  # by then it has a plan.
  local log_text implicated sev

  # An excerpt that came back empty implicated no path, so the red-path check
  # below never ran, and the brief named no path and carried no failing output.
  # gh not answering, a log GitHub no longer holds, and a log with no failed
  # step in it all read that way, and none of them is a brief.
  log_text="$(felix_repair_excerpt "$run_id" "$repo")" || {
    printf '\nThe log of run %s could not be read: gh did not answer, GitHub no longer\n' "$run_id"
    printf 'holds it, or no failed step left one. Nothing is repaired from a run nobody read.\n'
    return 1
  }
  implicated="$(felix_incident_paths "$(felix_repo_root "$PWD")" "$log_text")"
  if [ -n "$implicated" ] && [ -f "$proj/risk.tsv" ]; then
    sev="$(felix_incident_severity "$proj" "$implicated")"
    if [ "$sev" = "red" ]; then
      # Out of scope for an unattended repair, which is a consent boundary and
      # stays one: nobody is present to read a red fix adversarially. It is not
      # a merge rule — a session takes this, and merges on green like any other.
      printf '\nOUT OF SCOPE for unattended repair. The failure implicates a red path:\n\n'
      printf '%s\n' "$implicated" | sed 's|^|  |'
      printf '\nAttempts remaining is the wrong bound here. A session takes it; to flag it:\n\n'
      printf '  gh pr edit --repo %s --add-label needs-founder\n' "$repo"
      return 3
    fi
  fi

  printf '\nfailing output:\n\n'
  printf '%s\n' "$log_text" | sed 's/^/  /'
  printf '\nPatch the same branch, run the gate locally, then push.\n'
  printf '%s attempt(s) left before this escalates.\n' "$((FELIX_REPAIR_MAX - attempts))"
}

cmd_doctor() {
  resolve_or_die; local proj="$PROJ" root new gate rivals fix=0 a
  for a in "$@"; do case "$a" in --fix) fix=1 ;; esac; done
  root="$(felix_repo_root "$PWD")"
  new="$(felix_undeclared "$root" "$proj")"
  gate="$(felix_json_str "$proj/project.json" gate)"
  rivals="$(_felix_rival_gates "$root" "$proj" "$gate")"

  # Removing a lookalike Felix already holds loses nothing and is exactly the
  # reversible work the charter says to do rather than escalate. Nobody should
  # be told where a duplicate script lives; it is not a decision, it is tidying.
  #
  # Only when Felix holds a copy under that name. A gate-named script Felix does
  # not hold is somebody's only copy, and deleting that would be destroying work
  # to clean up a report.
  if [ "$fix" -eq 1 ] && [ -n "$rivals" ]; then
    local st ff nn kept=""
    while IFS=$'\t' read -r st ff nn; do
      [ -n "${ff:-}" ] || continue
      local base="${ff##*/}"
      if [ -f "$proj/$base" ]; then
        mkdir -p "$FELIX_HOME_DIR/state/rivals" 2>/dev/null
        cp "$root/$ff" \
           "$FELIX_HOME_DIR/state/rivals/$(basename "$proj")-$(printf '%s' "$ff" | tr '/' '-')" \
           2>/dev/null
        rm -f "$root/$ff" 2>/dev/null
      else
        kept="${kept}${ff}
"
      fi
    done <<EOF
$rivals
EOF
    rivals="$(_felix_rival_gates "$root" "$proj" "$gate")"
    if [ -n "$kept" ]; then
      printf 'kept, because Felix holds no copy and this may be the only one:\n'
      printf '%s' "$kept" | sed 's|^|  |'
      printf '\n'
    fi
  fi

  printf 'project:      %s\n' "$(basename "$proj")"
  printf 'declared:     %s\n' "$(felix_declared "$proj" | tr '\n' ' ')"
  if [ -z "$new" ]; then
    printf 'undeclared:   none\n'
  else
    printf 'undeclared:   %s\n\n' "$(printf '%s' "$new" | tr '\n' ' ')"
    printf 'These surfaces exist in the checkout but this project has never\n'
    printf 'declared them. Each one is a gate the guidebook expects and that\n'
    printf 'nothing is currently enforcing:\n\n'
    printf '%s\n' "$new" | while read -r c; do
      [ -n "$c" ] || continue
      printf '  %-14s %s\n' "$c" "$(_felix_why "$c")"
    done
    printf '\nadopt with: felix adopt <capability>\n'
  fi

  if [ -n "$rivals" ]; then
    printf '\nrival gates\n\n'
    printf '%s\n' "$rivals" | while IFS=$'\t' read -r state f note; do
      [ -n "${f:-}" ] || continue
      printf '  %-32s %-10s %s\n' "$f" "$state" "$note"
    done
    printf '\nEach of these is executable, and is either a copy of something Felix\n'
    printf 'holds for this project or named as though it gates. None of them is\n'
    printf 'the copy Felix runs. Whichever one a session reaches for decides what\n'
    printf 'green means, and the one in plain sight is the one it reaches for.\n'
    printf '\nfelix gate   is the only verdict that gets recorded\n'
  fi

  # A rule too broad to enforce is skipped at the moment it would have fired,
  # and the hook says nothing because it runs on every tool call. Silence there
  # has to be paid for here, or the project owns a rule that quietly does
  # nothing — which is the exact complaint Felix makes about other plugins.
  local wide; wide="$(felix_deny_overbroad_rows "$proj" 2>/dev/null)"
  if [ -n "$wide" ]; then
    printf '\ndeny rules too broad to enforce\n\n'
    printf '%s\n' "$wide" | while IFS=$'\t' read -r t p r; do
      [ -n "${p:-}" ] || continue
      printf '  %-14s %s\n' "$t" "$p"
    done
    printf '\nEach of these refuses everything it was asked about, so Felix skips it\n'
    printf 'rather than honouring it. A rule that also matches ordinary work cannot\n'
    printf 'be told apart from a broken editor by the person hitting it, and the\n'
    printf 'harness gets switched off rather than the row corrected.\n'
    printf '\nNarrow the pattern in %s/deny.tsv, or drop the row.\n' "$proj"
  fi

  # A declared capability with no curated row scores on its own name alone,
  # which is thin, and for the short names it scores on nothing at all. That
  # is a fact about this project's tables rather than about any plugin, and
  # nothing else says it out loud — the funnel was measured at 4 matches
  # across 35 installed plugins before anybody looked.
  local unruled; unruled="$(felix_capabilities_unruled "$proj" "$SCRIPT_DIR/templates" 2>/dev/null)"
  if [ -n "$unruled" ]; then
    printf '\ncapabilities with no discovery rule\n\n'
    printf '%s\n' "$unruled" | while read -r c; do
      [ -n "$c" ] || continue
      if [ "${#c}" -ge 5 ]; then
        printf '  %-14s scored on its own name only\n' "$c"
      else
        printf '  %-14s scored on nothing: too short to be its own keyword\n' "$c"
      fi
    done
    printf '\nDiscovery scores a plugin against the keywords each declared capability\n'
    printf 'carries. These carry none of their own, so tooling that serves them is\n'
    printf 'unlikely to be found. Add a row to discover-rules.tsv naming the words\n'
    printf 'such a plugin would actually use.\n'
  fi

  # Reporting drift is not a failure. Exit 0 so a session hook or a CI step can
  # surface this without turning a green tree red for work nobody asked for yet.
  return 0
}

_felix_why() {
  case "$1" in
    ci)            echo "workflows exist; confirm the gate is a required check" ;;
    deploy)        echo "a deploy target exists; preview and smoke tests apply" ;;
    iac)           echo "infrastructure as code; plan-before-apply applies" ;;
    observability) echo "error reporting present; the incident loop applies" ;;
    billing)       echo "payments present; live writes need a broker and approval gate" ;;
    e2e)           echo "browser tooling present; critical flows should be covered" ;;
    database)      echo "schema or migrations present; migration and access tests apply" ;;
    api)           echo "a served surface exists; contract tests apply" ;;
    frontend)      echo "a web surface exists; build and design checks apply" ;;
    llm)           echo "built on a model SDK; prompts get pinned, outputs graded, refusal and cost are failure modes" ;;
    rust)          echo "a cargo crate; clippy, types and a release profile apply" ;;
    tests)         echo "a test suite exists; it belongs in the gate" ;;
    secrets)       echo "env templates present; secret scanning applies" ;;
    *)             echo "detected in the checkout" ;;
  esac
}


cmd_log() {
  resolve_or_die; local proj="$PROJ" text="$*"
  [ -n "$text" ] || die 'usage: felix log "what happened and why"'
  felix_mem_log "$proj" "$(felix_repo_root "$PWD")" "$text"
  printf 'logged to %s/DEVLOG.md\n' "$(felix_mem_dir "$proj")"
}

cmd_lesson() {
  resolve_or_die; local proj="$PROJ" text="$*"
  [ -n "$text" ] || die 'usage: felix lesson "the thing worth repeating"'
  # A lesson that begins with a dash is a mistyped flag, and this file is
  # matched into every prompt - a row reading "--help" is noise forever (#102).
  case "$text" in -*) die 'usage: felix lesson "the thing worth repeating" (got a flag)' ;; esac
  felix_mem_lesson "$proj" "$(felix_repo_root "$PWD")" "$text"
  printf 'recorded in %s/lessons.md\n' "$(felix_mem_dir "$proj")"
  printf 'Only durable things belong here. A lessons file people stop reading\n'
  printf 'is worse than none, and it stops being read when it fills with one-offs.\n'
}

cmd_handoff() {
  resolve_or_die; local proj="$PROJ" root gate note="" was="" words="" replace=0 mode="" section="" base=""
  # #127. The catch-all used to shift anything it did not know, so
  # `felix handoff "what was in progress"` — the invocation everyone types —
  # dropped the one line git cannot rebuild and printed success over an older
  # note. Words are the note now, a flag it does not know refuses, and a note
  # given both ways refuses rather than choosing one silently.
  while [ $# -gt 0 ]; do
    case "$1" in
      --was)     need_value "$@"; was="$2"; shift 2 ;;
      --replace) replace=1; shift ;;
      --section) need_value "$@"; mode="${mode:+both}${mode:-section}"; section="$2"; shift 2 ;;
      --rotate)  mode="${mode:+both}${mode:-rotate}"; shift ;;
      --check)   mode="${mode:+both}${mode:-check}"; shift ;;
      --base)    need_value "$@"; base="$2"; shift 2 ;;
      --)        shift; words="${words:+$words }$*"; break ;;
      -*)        die "usage: felix handoff [--was \"what was in progress\" | what was in progress] [--replace] | --section FILE | --rotate | --check [--base REF]" ;;
      *)         words="${words:+$words }$1"; shift ;;
    esac
  done
  if [ -n "$mode" ]; then
    case "$mode" in *both*) die "felix handoff takes one of --section, --rotate and --check at a time" ;; esac
    [ -z "$was$words" ] && [ "$replace" = 0 ] \
      || die "--section, --rotate and --check are about the repository's HANDOFF.md, and take no note"
    _cmd_handoff_sections "$mode" "$section" "$base"; return $?
  fi
  [ -n "$base" ] && die "--base goes with --section, --rotate or --check"
  [ -n "$was" ] && [ -n "$words" ] \
    && die "usage: felix handoff [--was \"what was in progress\" | what was in progress] [--replace] — the note was given twice"
  note="${was:-$words}"
  root="$(felix_repo_root "$PWD")"
  gate="$(felix_json_str "$proj/project.json" gate)"
  # Asked before the write, because the write is what changes the answer. The
  # lifecycle row (lib/lifecycle.sh) says which of three things happened: a
  # handoff this command did not write was refused, or replaced because
  # --replace said so, or the file was written as it always has been. A write
  # that fails for any other reason is not a refusal, and records nothing.
  local foreign=0
  felix_mem_handoff_foreign "$(felix_mem_dir "$proj")/SESSION_HANDOFF.md" && foreign=1
  # A handoff this command did not write is refused by the library, which says
  # why and how large it is; nothing below runs, because nothing was written.
  if ! felix_mem_handoff "$proj" "$root" "$gate" "$note" "$replace"; then
    [ "$foreign" = 1 ] && [ "$replace" != 1 ] \
      && felix_lifecycle_handoff "$proj" "$root" refused >/dev/null 2>&1
    exit 1
  fi
  if [ "$foreign" = 1 ]; then felix_lifecycle_handoff "$proj" "$root" replaced >/dev/null 2>&1
  else                        felix_lifecycle_handoff "$proj" "$root" written  >/dev/null 2>&1; fi
  printf 'wrote %s/SESSION_HANDOFF.md\n\n' "$(felix_mem_dir "$proj")"
  # Carrying a note across a regeneration is right; carrying it in silence is
  # how a two-session-old note read as this session's. Said only when nothing
  # was given, because then the note in the file is not the caller's.
  if [ -z "$note" ]; then
    local kept
    kept="$(sed -n 's/^- what was in progress: //p' "$(felix_mem_dir "$proj")/SESSION_HANDOFF.md" 2>/dev/null | head -1)"
    case "$kept" in
      ''|_fill*) printf 'no note of what was in progress. felix handoff "..." records one.\n\n' ;;
      *)         printf 'kept the note from the last handoff, which may not be this session'"'"'s:\n  %s\n' "$(printf '%s' "$kept" | cut -c1-160)"
                 printf 'felix handoff "..." replaces it.\n\n' ;;
    esac
  fi

  # The session-end list from the guidebook, as a check rather than a memory
  # exercise. Each line is something a person is about to not do.
  printf 'before you stop:\n'
  local dirty; dirty="$(git -C "$root" status --short 2>/dev/null | grep -v '^??' || true)"
  [ -n "$dirty" ] && printf '  [ ] the tree is dirty; commit it or say in the devlog why not\n' \
                  || printf '  [x] tree is clean\n'
  if git -C "$root" log -1 --format=%H >/dev/null 2>&1; then
    printf '  [ ] devlog entry for this work?   felix log "..."\n'
    printf '  [ ] anything durable to keep?     felix lesson "..."\n'
  fi
  printf '  [ ] gate green?                   felix gate\n'
  printf '  [ ] commit the project directory in Felix so this survives the machine\n'
}

# The repository's HANDOFF.md, kept as sections (lib/handoff.sh). Not the
# memory handoff above: that one is the state of a tree and is not direction.
# A session adds its section as a file of its own, and the ids, the archive
# and the index are derived from the order sections landed on the base, so no
# two sessions ever write the same path.
_cmd_handoff_sections() {
  local mode="$1" file="$2" base="$3" root out rc
  root="$(felix_repo_root "$PWD")"
  [ -n "$base" ] || base="$(felix_base_ref "$root" main 2>/dev/null)" || base=""
  case "$mode" in
    section)
      out="$(felix_handoff_section "$root" "$file" "$base")" || exit 1
      printf 'wrote %s\n\n' "$out"
      printf 'Commit it on this branch. It lands as a file no other session writes, so\n'
      printf 'it cannot collide with theirs, and the session start names it until\n'
      printf 'felix handoff --rotate folds it into HANDOFF.md and gives it an id.\n'
      ;;
    rotate)
      [ -f "$root/$FELIX_HANDOFF_FILE" ] || die "no $FELIX_HANDOFF_FILE in $root"
      out="$(felix_handoff_rotate "$root" "$base")" || die "nothing folded: $out"
      printf '%s\n' "$out" | awk -F'\t' 'NF == 2 { printf "  %-6s %s\n", $1, $2; next } { print "  " $0 }'
      # Read back at once, by the check the gate runs, so a fold that wrote
      # something the check refuses is said here and not at the gate.
      out="$(felix_handoff_check "$root" "$base")"; rc=$?
      [ "$rc" -eq 0 ] || { printf '\nand the check refuses what it wrote:\n'; printf '%s\n' "$out" | sed 's/^/  /'; exit 1; }
      printf '\nThe check reads it back clean. Commit HANDOFF.md, %s/ and the removed\n' "$FELIX_HANDOFF_DIR"
      printf 'pending files as one change.\n'
      ;;
    check)
      out="$(felix_handoff_check "$root" "$base")"; rc=$?
      [ -z "$out" ] || printf '%s\n' "$out" | awk -F'\t' '{ printf "  %-14s %s\n", $1, $2 }'
      [ "$rc" -eq 0 ] && printf 'handoff: HANDOFF.md and %s/ are what the fold writes\n' "$FELIX_HANDOFF_DIR"
      return "$rc"
      ;;
  esac
}


cmd_lessons() {
  resolve_or_die; local proj="$PROJ" want=""
  while [ $# -gt 0 ]; do
    case "$1" in --for) need_value "$@"; want="$2"; shift 2 ;; *) want="$want $1"; shift ;; esac
  done
  local file="$(felix_mem_dir "$proj")/lessons.md"
  [ -s "$file" ] || die "no lessons recorded yet for $(basename "$proj")"
  local root; root="$(felix_repo_root "$PWD")"

  local always; always="$(felix_lessons_always "$file")"
  if [ -n "$always" ]; then
    printf 'always\n\n'; printf '%s\n' "$always" | sed 's/^/  /'; printf '\n'
  fi
  local matched; matched="$(felix_lessons_for "$file" "$(felix_lessons_context "$root" "$want")" 8)"
  if [ -n "$matched" ]; then
    printf 'matched to this change\n\n'; printf '%s\n' "$matched" | sed 's/^/  /'
  else
    printf 'nothing matched this context. All of them: %s\n' "$file"
  fi
}

cmd_promote() {
  resolve_or_die; local proj="$PROJ"
  local mistakes; mistakes="$(felix_mem_recurring_mistakes "$proj")"

  # Mistakes first. A check that keeps failing is a habit, and a habit is what a
  # lesson is for. Word frequency in a devlog is a weaker signal and belongs
  # underneath the strong one, not instead of it.
  printf 'the gate keeps catching\n\n'
  if [ -z "$mistakes" ]; then
    printf '  nothing twice yet\n'
  else
    # Both numbers, because they are not the same fact. The first is how many
    # separate trees this was caught on, which is what makes it a habit; the
    # second is how many gate runs it cost, which is what makes it expensive.
    # A tree gated five times without being fixed is one of the first and five
    # of the second, and only the first is an argument for a lesson.
    printf '%s\n' "$mistakes" | while IFS=$'\t' read -r n term last runs; do
      [ -n "${n:-}" ] || continue
      printf '  %-4s %-20s last %s   (%s run(s))\n' "$n" "$term" "${last:-?}" "${runs:-?}"
    done
    printf '\nEach of these is a mistake this project has now made more than once.\n'
    printf 'That is the strongest promotion signal there is: not that something is\n'
    printf 'interesting, but that it already cost time twice.\n'
    printf '\nStill recurring, which is a different claim from having recurred: a\n'
    printf 'check nothing has caught in a fortnight is history and is not listed.\n'
  fi

  if [ -f "$(felix_mem_dir "$proj")/DEVLOG.md" ]; then
    local hits; hits="$(felix_mem_promotable "$proj")"
    if [ -n "$hits" ]; then
      printf '\nrecurring in the devlog, absent from the lessons\n\n'
      printf '%s\n' "$hits" | head -8 | while IFS=$'\t' read -r n term; do
        [ -n "${n:-}" ] || continue
        printf '  %-4s %s\n' "$n" "$term"
      done
      printf '\nWord frequency, not understanding. A term appearing often may be a\n'
      printf 'lesson, or may simply be what this project is about.\n'
    fi
  fi

  printf '\nPromote what would change what someone does next time:\n\n'
  printf '  felix lesson "..."\n\n'
  printf 'And when a lesson keeps being violated anyway, it has outgrown the\n'
  printf 'lessons file and belongs in the constitution, where the gate can see it.\n'
}

cmd_adopt() {
  resolve_or_die; local proj="$PROJ" cap="${1:-}"
  [ -n "$cap" ] || die "usage: felix adopt <capability>"
  # A flag is not a capability, and this command writes three durable files
  # before anything else would notice (#102). Refused rather than stripped:
  # guessing what a mistyped flag meant is how the wrong thing gets declared.
  case "$cap" in -*) die "usage: felix adopt <capability> (got a flag: $cap)" ;; esac
  local slug counts
  slug="$(felix_repo_slug "$(felix_repo_root "$PWD")")"
  if ! counts="$(felix_adopt_capability "$proj" "$cap" "$SCRIPT_DIR/templates" "$slug")"; then
    printf '%s already declared\n' "$cap"; return 0
  fi
  printf 'declared %s for %s\n' "$cap" "$(basename "$proj")"
  set -- $counts
  if [ "${1:-0}" -gt 0 ] || [ "${2:-0}" -gt 0 ]; then
    printf 'backfilled %s tooling row(s) and %s human step(s) that %s implies.\n' "$1" "$2" "$cap"
    printf 'review with: felix stack plan   and   felix setup\n'
  fi
  printf 'commit %s in the Felix repo to make it durable.\n' "$proj"
}

# The deliberation record, readable. Decision B (approved 2026-08-30) holds
# enforcement until the recording has run for 20 sessions; this is the tracker
# that decision is judged from, so losing or eyeballing the data is not an
# option.
#
# Three numbers, each from its own file and each saying only what its file can
# say. Mandates rendered: the "Use this now" lines a session was shown
# (says.log). Declines: decisions.log, whose sole appender is
# `felix route --ack` and whose sole verdict is the literal `declined`.
# Rendered and not used: the Stop hook's `skipped` row, written once per
# session when a play was shown and the transcript never reached for it.
#
# What is NOT here, and the correction that removed it: this used to render
# "answered N of M" over declines and mandates. Nothing writes a row when a
# mandate is FOLLOWED — the Stop hook names both responses, "Decline it on the
# record ... or use it", and only the first leaves a trace — so the gap
# collapsed compliance and disregard into one number and called all of it
# unanswered. A rate needs a numerator that can contain both outcomes, and
# this one cannot. The `skipped` column recovers the disregard half, which the
# engine had been writing all along and this command ignored; the rest is
# unknown and is now said to be unknown.
#
# Both counts are windowed from the same date. The numerator was not, so a
# decline predating the channel counted against mandates that excluded it.
cmd_decisions() {
  resolve_or_die; local proj="$PROJ"
  local mem; mem="$(felix_mem_dir "$proj")"
  local dlog="$mem/decisions.log" slog="$mem/says.log"
  local declined=0 mandates=0 skipped=0
  # Counted only from the day the answer channel existed. 56 mandates rendered
  # before felix route --ack shipped could not have been answered, and a rate
  # computed over them reports a compliance failure nobody could have avoided -
  # the same shape as the follow-through figures computed against suggestions
  # nobody was shown. The channel shipped 2026-08-30.
  FELIX_DECISIONS_SINCE="${FELIX_DECISIONS_SINCE:-2026-08-30}"
  # The verdict field, not the word: a reason containing "declined" is one row,
  # not two. And the same window as everything below it.
  declined="$([ -f "$dlog" ] && awk -F'\t' -v s="$FELIX_DECISIONS_SINCE" \
    '$1 >= s && $3 == "declined" {n++} END {print n+0}' "$dlog" || printf 0)"
  mandates="$([ -f "$slog" ] && awk -F'\t' -v s="$FELIX_DECISIONS_SINCE" \
    '$1 >= s && index($0,"Use this now") {n++} END {print n+0}' "$slog" || printf 0)"
  skipped="$([ -f "$slog" ] && awk -F'\t' -v s="$FELIX_DECISIONS_SINCE" \
    '$1 >= s && $2 == "skipped" {n++} END {print n+0}' "$slog" || printf 0)"
  printf 'capability decisions for %s, since %s\n\n' "$(basename "$proj")" "$FELIX_DECISIONS_SINCE"
  printf '  mandates rendered          %s\n' "$mandates"
  printf '  declined, on the record    %s\n' "$declined"
  printf '  rendered and not used      %s\n' "$skipped"
  if [ "$mandates" -gt 0 ]; then
    printf '\nNothing records a mandate that was FOLLOWED, so these do not sum to the\n'
    printf 'mandates above and the remainder is not a compliance figure. What the\n'
    printf 'files can say: %s declined on the record, %s shown and demonstrably not\n' \
      "$declined" "$skipped"
    # The two counts come from different populations — a session can decline
    # without ever earning a skipped row, and the skipped row is written once
    # per session while mandates are counted per rendering. So the remainder is
    # a subtraction that can go negative, and a negative "nothing was written
    # about" would be a number nobody can act on. Said as an overlap instead,
    # which is what it means.
    if [ "$(( declined + skipped ))" -le "$mandates" ]; then
      printf 'reached for, and %s about which nothing was written either way.\n' \
        "$(( mandates - declined - skipped ))"
    else
      printf 'reached for — together more than the mandates rendered, so some\n'
      printf 'sessions are counted in both.\n'
    fi
  fi
  printf '\n'
  if [ -f "$dlog" ]; then
    printf 'recent declines, newest last\n\n'
    tail -5 "$dlog" | while IFS=$'\t' read -r ts _root verdict reason; do
      printf '  %s  %s\n' "${ts%%T*}" "$reason"
    done
  else
    printf 'No declines recorded yet. A session declines a rendered mandate with\n'
    printf '  felix route --ack "why it does not fit"\n'
  fi
  printf '\nRecording only. Enforcement is decided at the 20-session review from\n'
  printf 'this data - HANDOFF 0af and docs/2026-08-30-advisory-redesign.md B.\n'
}

# What each moment has to answer for, and what nothing answers yet.
#
# The gap list is the product. A project that has taken no stances sees every
# item, which is the correct first output rather than an empty success: the
# defect this exists for was a question nobody asked, and a report that only
# ever shows what somebody already thought of would repeat it.
cmd_procedures() {
  resolve_or_die; local proj="$PROJ" a
  for a in "$@"; do die "usage: felix procedures (got: $a)"; done
  local tpl="$SCRIPT_DIR/templates" root
  root="$(felix_repo_root "$PWD")"

  printf 'procedures for %s\n\n' "$(basename "$proj")"

  local n_item n_gap n_stance
  n_item="$(felix_procedures_items "$proj" "$root" | grep -c .)"
  n_gap="$(felix_procedures_gaps "$proj" "$root" "$tpl" | grep -c .)"
  n_stance="$(felix_procedures_wellformed "$proj" | grep -c .)"

  # Stances first, by moment, so what IS handled reads as the smaller thing it
  # currently is rather than as the summary.
  local m item moment by line shown
  if [ "${n_stance:-0}" -gt 0 ]; then
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      shown=0
      # cut per field rather than `IFS=$'\t' read`: tab is an IFS whitespace
      # character, so bash coalesces runs of it and an empty cell shifts every
      # later column left.
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        item="$(printf '%s\n' "$line" | cut -f1)"
        moment="$(printf '%s\n' "$line" | cut -f2)"
        by="$(printf '%s\n' "$line" | cut -f3)"
        [ "${moment:-}" = "$m" ] || continue
        [ "$shown" -eq 0 ] && { printf '  %s\n' "$m"; shown=1; }
        printf '    %-26s %s\n' "$item" "${by:--}"
      done <<EOF
$(felix_procedures_wellformed "$proj")
EOF
      [ "$shown" -eq 1 ] && printf '\n'
    done <<EOF
$(felix_procedures_moments "$tpl")
EOF
  fi

  if [ "${n_gap:-0}" -gt 0 ]; then
    printf 'nothing answers these\n\n'
    felix_procedures_gaps "$proj" "$root" "$tpl" | while IFS= read -r item; do
      [ -n "$item" ] || continue
      case "$item" in
        capability:*) printf '  %-26s a surface this checkout has\n' "$item" ;;
        failure:*)    printf '  %-26s something that has already gone wrong here\n' "$item" ;;
        *)            printf '  %s\n' "$item" ;;
      esac
    done
    printf '\n%s of %s items have no stance. Neither list is one Felix wrote:\n' "$n_gap" "$n_item"
    printf 'surfaces come from what the checkout has, failures from what the gate\n'
    printf 'has actually caught. A stance says at which moment an item is answered\n'
    printf 'and by what, and belongs to a person — add rows to\n'
    printf '%s/procedures.tsv.\n' "$proj"
  fi

  # A row that names an item and records nothing else. It used to close the
  # item's gap and then appear in no section at all, because every display
  # path keys on the moment — one item vanishing from three lists at once
  # while the report said everything had a stance.
  local malformed orphans
  malformed="$(felix_procedures_malformed "$proj")"
  if [ -n "$malformed" ]; then
    printf '\nrows that record no judgement\n\n'
    printf '%s\n' "$malformed" | while IFS= read -r item; do
      [ -n "$item" ] || continue
      printf '  %s\n' "$item"
    done
    printf '\nA stance needs an item, a moment, and something that answers it. These\n'
    printf 'name an item and stop, so they close nothing — their items are still\n'
    printf 'listed above as unanswered.\n'
  fi

  # And the other direction: a stance for something nothing enumerates any
  # more. The precedent this copies checks both, because a table is wrong when
  # it lacks a row reality has and equally wrong when it keeps one reality
  # dropped.
  orphans="$(felix_procedures_orphans "$proj" "$root")"
  if [ -n "$orphans" ]; then
    printf '\nstances for things nothing enumerates\n\n'
    printf '%s\n' "$orphans" | while IFS= read -r item; do
      [ -n "$item" ] || continue
      printf '  %s\n' "$item"
    done
    printf '\nEach answers for a surface the checkout no longer shows, or a name that\n'
    printf 'never existed. A stance nobody can reach is a claim nobody checks.\n'
  fi

  local unknown
  unknown="$(felix_procedures_unknown_moments "$proj" "$tpl")"
  if [ -n "$unknown" ]; then
    printf '\nstances at a moment nobody declared\n\n'
    printf '%s\n' "$unknown" | while IFS=$'\t' read -r moment item; do
      [ -n "${moment:-}" ] || continue
      printf '  %-16s claimed by %s\n' "$moment" "$item"
    done
    printf '\nEach of these answers nothing while looking like an answer. Declare the\n'
    printf 'moment in templates/moments.tsv, or correct the row.\n'
  fi

  if [ "${n_gap:-0}" -eq 0 ] && [ -z "$unknown" ] && [ -z "$malformed" ] \
     && [ -z "$orphans" ]; then
    printf 'Every item has a stance. That is a claim about this table, not about\n'
    printf 'the project: an item nothing enumerates cannot appear here, so this\n'
    printf 'says the known questions are answered and nothing about the unknown.\n'
  fi
  return 0
}

# What reality says, and what nothing here has asked it.
#
# `--gate` is the same run with a verdict attached, for a project gate to call.
# The two are one command deliberately: a reporting mode and an enforcing mode
# that compute their answers separately drift, and the enforcing one is the
# half nobody reads.
# Runs one `felix:` answer in-process. The stages hold the install policy;
# commissioning only asks afterwards whether the check now passes.
_felix_commission_answer() {
  case "${1:-}" in
    'felix:discover --adopt')  cmd_discover --adopt ;;
    'felix:stack apply --yes') cmd_stack apply --yes ;;
    'felix:ready --fix')       cmd_ready --fix ;;
    'felix:toolbox --route')   cmd_toolbox --route ;;
    'felix:obligations --seed') cmd_obligations --seed ;;
    *) return 127 ;;
  esac
}

cmd_commission() {
  resolve_or_die; local proj="$PROJ" status=0 a tpl="$SCRIPT_DIR/templates"
  for a in "$@"; do
    case "$a" in
      --status) status=1 ;;
      --yes) die "there is no --yes. felix commission runs the engine stages that already hold the install policy, and a person's rows stay a person's." ;;
      *) die "usage: felix commission [--status] (got: $a)" ;;
    esac
  done
  local root tid name; root="$(felix_repo_root "$PWD")"; name="$(basename "$proj")"
  tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR" 2>/dev/null)" || tid=""

  if [ ! -f "$proj/commissioning.tsv" ]; then
    printf 'commissioning for %s\n\n' "$name"
    printf 'This project has no commissioning.tsv, so the first-encounter moment was\n'
    printf 'never asked of it: nothing says what serves this checkout, what reaches\n'
    printf 'it, or what a person still owes.\n\n'
    printf 'Write %s/commissioning.tsv. One row per need:\n\n' "$proj"
    printf '  need <TAB> grounds <TAB> instrument <TAB> when <TAB> answer <TAB> check <TAB> step\n\n'
    printf 'A template is at %s/templates/commissioning.tsv; felix new copies it.\n' "$SCRIPT_DIR"
    return 1
  fi

  # One run at a time, and only for a run that writes.
  #
  # A full run appends to stack.tsv twice, to commissioning.log, and a play into
  # routes.tsv. None of those is atomic and none is idempotent, so two runs
  # interleaving produce a row written half by each or a capability declared
  # twice — a table that looks like somebody typed it wrong, from two commands
  # that each did exactly what they were told.
  #
  # --status takes nothing. It writes nothing, so two of them cannot collide,
  # and making a person's read wait on somebody else's run would be a lock
  # doing harm to buy nothing.
  local clock=""
  if [ "$status" -eq 0 ]; then
    if ! clock="$(felix_commission_lock "$proj" "$FELIX_HOME_DIR")"; then
      printf 'a commissioning run for %s is already in progress' "$name" >&2
      case "$clock" in
        another) printf '.\n' >&2 ;;
        *)       printf ' (pid %s).\n' "$clock" >&2 ;;
      esac
      printf 'It appends to stack.tsv and routes.tsv, so two at once is a table\n' >&2
      printf 'written half by each. Wait for it, or felix commission --status to\n' >&2
      printf 'read the state without running anything.\n' >&2
      return 1
    fi
    # shellcheck disable=SC2064
    trap "felix_commission_unlock '$clock'" EXIT INT TERM
  fi

  local rows malformed
  rows="$(felix_commission_rows "$proj")"; malformed="$(felix_commission_malformed "$proj")"
  if [ -z "$rows" ]; then
    printf 'commissioning for %s\n\n' "$name"
    printf '%s/commissioning.tsv exists and declares no need.\n' "$proj"
    printf 'An empty table is not a clean bill; it is a shelf with nothing on it.\n'
    if [ -n "$malformed" ]; then
      printf '\nrows that name a need and nothing readable\n\n'
      printf '%s\n' "$malformed" | awk -F'\t' '{ printf "  %-22s %s\n", $1, $2 }'
    fi
    return 1
  fi

  local runner="_felix_commission_answer"
  [ "$status" -eq 1 ] && runner="-"
  local out; out="$(felix_commission_run "$proj" "$root" "$runner" "$tpl")"

  # The record phase, offline: every answered provider file's accepted rows
  # go to the log as INFERRED, once per file hash. Nothing here installs; the
  # admit phase is the next increment and says so below.
  local n_ingested=0 need st cls answer step detail prov k
  if [ "$status" -eq 0 ]; then
    while IFS=$'\t' read -r need st cls answer step detail prov; do
      [ "$st" = "answered" ] || continue
      k="$(felix_commission_record_provider "$proj" "$root" "$need" "$answer" "$tid" "$(felix_commission_policy_version "$proj")")"
      n_ingested=$((n_ingested + ${k:-0}))
    done <<EOF
$out
EOF
  fi

  # The admit phase: fetch each plugin nomination at its pinned sha, read it,
  # tier it, ask the policy — and apply what it declares as a stack.tsv row
  # carrying OBSERVED. It reaches the network, so a full run only, never
  # --status. It runs HERE, before the receipt, so the receipt's hashes cover
  # the rows it writes; run after, every write would stale the receipt it
  # had just been given.
  local adm="" admneed n_app=0 k_app
  if [ "$status" -eq 0 ]; then
    while IFS=$'\t' read -r need st cls answer step detail prov; do
      [ "$st" = "answered" ] || continue
      admneed="$(felix_commission_admit "$proj" "$FELIX_HOME_DIR" "$need" "$tpl")"
      [ -n "$admneed" ] || continue
      adm="$adm$admneed
"
      k_app="$(felix_commission_apply_declares "$proj" "$root" "$admneed" "$tid" "$(felix_commission_policy_version "$proj")" "$need")"
      n_app=$((n_app + ${k_app:-0}))
    done <<EOF
$out
EOF
    # A declared row changes the manifest, and every need's verdict in `$out`
    # was computed before it. Left alone, the receipt below would certify a
    # state this run had already moved — the counts would describe the tree as
    # it was when the run started. Re-checked with the `-` runner, which runs
    # no engine stage and only re-asks each row's check, so this costs a
    # re-read and cannot install anything a second time.
    [ "$n_app" -gt 0 ] && out="$(felix_commission_run "$proj" "$root" - "$tpl")"
  fi

  # Recorded and receipted after the last write of the run, so the hashes
  # cover what discover --adopt appended and toolbox --route rewrote.
  local recorded=1 result=""
  if [ "$status" -eq 0 ]; then
    felix_commission_record "$proj" "$tid" "$(felix_commission_policy_version "$proj")" "$out" || recorded=0
    result="$(felix_commission_receipt_write "$FELIX_HOME_DIR" "$proj" "$root" "$out" "$malformed")" || result=""
  fi

  local n_done n_held n_unk n_mal n_await n_na
  read -r n_done n_held n_unk n_mal n_await n_na <<EOF
$(felix_commission_counts "$out" "$malformed")
EOF

  printf 'commissioning for %s\n\n' "$name"
  printf '%s\n' "$out" | while IFS=$'\t' read -r need st cls answer step detail prov; do
    [ -n "$need" ] || continue
    printf '  %-15s %-20s %s\n' "$st" "$need" "$detail"
  done
  printf '\n%s done, %s held, %s unknown, %s awaiting a session, %s did not apply' \
    "$n_done" "$n_held" "$n_unk" "$n_await" "$n_na"
  [ "$n_mal" -gt 0 ] && printf ', %s malformed' "$n_mal"
  printf '\n'

  if [ "$status" -eq 1 ]; then
    local cwhy; cwhy="$(felix_commission_receipt_valid "$FELIX_HOME_DIR" "$proj" "$root")" || true
    printf 'receipt: %s\n' "$cwhy"
  else
    printf 'receipt: %s, written to %s\n' "${result:-NOT written}" "$(felix_commission_receipt_path "$FELIX_HOME_DIR" "$proj")"
  fi

  # What a provider said, read back from its file: rows the engine accepted
  # as INFERRED and rows it refused by shape. A provider row that is answered
  # holds nothing and installs nothing — the admit phase that fetches, reads,
  # tiers and corroborates a nomination is not built, and this says so.
  local n_answered; n_answered="$(printf '%s\n' "$out" | awk -F'\t' '$2 == "answered"' | grep -c .)"
  if [ "$n_answered" -gt 0 ]; then
    printf '\nnamed by a provider, recorded and not acted on\n\n'
    printf '%s\n' "$out" | while IFS=$'\t' read -r need st cls answer step detail prov; do
      [ "$st" = "answered" ] || continue
      local pcf; pcf="$(felix_commission_provider_classifier "$need")"
      felix_commission_provider_rows "$proj" "$need" | while IFS= read -r prow; do
        [ -n "$prow" ] || continue
        printf '  %-20s %-9s %-32s %s\n' "$need" \
          "$(printf '%s\n' "$prow" | cut -f1)" \
          "$(printf '%s\n' "$prow" | cut -f2)" \
          "$(printf '%s\n' "$prow" | cut -f"$pcf")"
      done
      felix_commission_provider_rejects "$proj" "$need" | while IFS=$'\t' read -r rn rwhy; do
        [ -n "$rn" ] || continue
        printf '  %-20s refused   %-32s %s\n' "$need" "$rn" "$rwhy"
      done
    done
    printf '\n%s row(s) recorded as INFERRED this run.\n' "$n_ingested"

    # The admit phase ran before the receipt above; this is only what it found.
    if [ "$status" -eq 0 ]; then
      if [ -n "$adm" ]; then
        printf '\nwhat the engine found when it went and looked\n\n'
        printf '%s' "$adm" | while IFS=$'\t' read -r v k n tier gcap sha why; do
          [ -n "${v:-}" ] || continue
          printf '  %-9s %-9s %-32s %-7s %s\n' "$v" "$k" "$n" "$tier" "$why"
        done
        printf '\nA nomination carries no tier: risk is not the model'"'"'s to assign. Every\n'
        printf 'tier above was read off the copy on disk, fetched at its pinned commit\n'
        printf 'and never executed, which is what turns INFERRED into OBSERVED. An mcp\n'
        printf 'row is refused on its kind before anything is fetched. `unknown` is not\n'
        printf 'a refusal: nothing could be read, so nothing is known, and a later run\n'
        printf 'can still answer it. Only a `declare` is written down.\n'
        if [ "${n_app:-0}" -gt 0 ]; then
          printf '\n%s declared into %s/stack.tsv, each row carrying OBSERVED: the\n' "$n_app" "$proj"
          printf 'grounding the engine read, never a person'"'"'s word, so the policy reads it\n'
          printf 'that way on every later run. Nothing in the table above was installed by\n'
          printf 'the admit phase — a declared row installs through felix stack apply, under\n'
          printf 'the policy for what the engine read.\n'
        else
          printf '\nNothing above was installed, and nothing was declared.\n'
        fi
      fi
    fi
  fi

  if [ "$n_held" -gt 0 ] || [ "$n_await" -gt 0 ]; then
    printf '\nheld, and who answers it\n\n'
    printf '%s\n' "$out" | while IFS=$'\t' read -r need st cls answer step detail prov; do
      case "$st" in held|awaiting|stale|partial) ;; *) continue ;; esac
      case "$answer" in
        felix:*)    printf '  %-20s felix commission ran %s and the check still does not pass\n' "$need" "${answer#felix:}" ;;
        provider:*)
          printf '  %-20s a session runs /%s and writes the answer the request names; the engine cannot\n' "$need" "${answer#provider:}"
          printf '  %-20s request: %s\n' "" "$(felix_commission_request_path "$proj" "$need")"
          [ "$st" != "awaiting" ] && printf '  %-20s %s\n' "" "$detail" ;;
        *)          printf '  %-20s a person; the check in commissioning.tsv says what would satisfy it\n' "$need" ;;
      esac
    done
  fi
  if [ "$n_unk" -gt 0 ]; then
    printf '\ncould not be asked here\n\n'
    printf '%s\n' "$out" | awk -F'\t' '$2 == "unknown" { printf "  %-20s %s\n", $1, $6 }'
    printf '\nUnknown is not held and not done. It blocks the receipt, and only the\n'
    printf 'machine changing can clear it.\n'
  fi
  if [ -n "$malformed" ]; then
    printf '\nrows that name a need and nothing readable\n\n'
    printf '%s\n' "$malformed" | awk -F'\t' '{ printf "  %-22s %s\n", $1, $2 }'
    printf '\nThese were not run and count toward nothing. The receipt is\n'
    printf 'indeterminate while any of them stands.\n'
  fi

  local gaps; gaps="$(felix_commission_gaps "$proj" "$root")"
  if [ -n "$gaps" ]; then
    printf '\nsurfaces nothing serves, reaches, or grounds\n\n'
    printf '%s\n' "$gaps" | while IFS=$'\t' read -r cap served reached grounded; do
      [ -n "$cap" ] || continue
      local miss=""
      [ "$served" = "no" ]   && miss="$miss; no catalogue row serves it"
      [ "$reached" = "no" ]  && miss="$miss; no profile reaches it"
      [ "$grounded" = "no" ] && miss="$miss; no probe grounds it"
      printf '  %-14s %s\n' "$cap" "${miss#; }"
    done
    printf '\nEach is a surface this checkout has or this project declared. The three\n'
    printf 'questions are the ones stack.tsv, profiles.tsv and probes.tsv already\n'
    printf 'answer; a miss here is what the printed next-steps used to drop.\n'
  fi
  local tmiss; tmiss="$(felix_commission_template_missing "$proj" "$tpl")"
  if [ -n "$tmiss" ]; then
    printf '\nquestions the template asks that this table lacks\n\n'
    printf '%s\n' "$tmiss" | sed 's/^/  /'
  fi
  local sun; sun="$(felix_commission_steps_unanswered "$proj" "$tpl")"
  if [ -n "$sun" ]; then
    printf '\npipeline steps no row answers\n\n'
    printf '%s\n' "$sun" | awk -F'\t' '{ printf "  %-3s %s\n", $1, $2 }'
  fi

  printf '\nWhat this cannot say: the surfaces above come from felix_detect'"'"'s patterns,\n'
  printf 'so a stack no pattern names produces no capability, no gap and no row;\n'
  printf 'the checks are shell somebody wrote, and a check written to pass will\n'
  printf 'pass; and the provider rows wait on a channel whose precision is\n'
  printf 'unmeasured. Commissioned means every known question was asked and\n'
  printf 'answered, held by name, or named as unaskable here — not that the\n'
  printf 'toolbox is right.\n'
  if [ "$recorded" -eq 0 ]; then
    printf '\nThe record was NOT written to %s/commissioning.log.\n' "$(felix_mem_dir "$proj")"
  fi

  [ "$status" -eq 1 ] && return 0
  [ "$recorded" -eq 1 ] || return 1
  [ -n "$result" ] || return 1
  [ "$result" != "indeterminate" ] || return 1
  return 0
}

cmd_obligations() {
  resolve_or_die; local proj="$PROJ" gate=0 seed=0 request=0 a
  for a in "$@"; do
    case "$a" in
      --gate) gate=1 ;;
      --seed) seed=1 ;;
      --request) request=1 ;;
      *) die "usage: felix obligations [--gate|--seed|--request] (got: $a)" ;;
    esac
  done
  local root; root="$(felix_repo_root "$PWD")"

  # --request: write the discovery request for a session's model to answer
  # (docs/2026-09-16-discovery-baseline-design.md). felix commission writes
  # every provider request on a real run and is the founder's; this writes
  # the one for candidate obligations, touches no table, and is therefore
  # Felix's to run whenever the epoch has moved. Refused when the epoch cannot
  # be computed: a request about a topology the probes could not read would
  # ask for a proposal grounded on nothing.
  if [ "$request" -eq 1 ]; then
    local req
    if req="$(felix_candidates_request "$proj" "$root" "$SCRIPT_DIR/templates")"; then
      printf 'wrote %s\n\nA session answers it by running the request and writing the answer file\n' "$req"
      printf 'it names; felix obligations reads the answer back and admits nothing.\n'
      return 0
    fi
    printf 'no request written: the decision epoch cannot be computed for %s here,\n' "$(basename "$proj")"
    printf 'so nothing could be proposed about it. felix probes says which fact is unknown.\n'
    return 1
  fi

  # --seed: the §8 step 8 answer, "initialize obligation and evidence state".
  # A project born before the template existed has no ledger, and a ledger
  # that is absent is refused at the merge boundary and announced as skipped
  # by the gate — so the commissioning row for step 8 names this, and this
  # writes the template's one row where nothing is. It never touches a ledger that exists: the
  # epoch rule says admitted obligations may grow without a person and may
  # not shrink, and overwriting is the second of those dressed as the first.
  if [ "$seed" -eq 1 ]; then
    printf 'obligations for %s\n\n' "$(basename "$proj")"
    if [ -f "$proj/obligations.tsv" ]; then
      printf '%s/obligations.tsv already exists and seeding never overwrites a\n' "$proj"
      printf 'ledger: what it admits is a person'"'"'s to change, by hand, one row at a time.\n'
      return 0
    fi
    [ -s "$SCRIPT_DIR/templates/obligations.tsv" ] \
      || die "no template at $SCRIPT_DIR/templates/obligations.tsv, so there is nothing to seed from"
    cp "$SCRIPT_DIR/templates/obligations.tsv" "$proj/obligations.tsv" \
      || die "could not write $proj/obligations.tsv"
    printf 'seeded %s/obligations.tsv from the template: the one obligation every\n' "$proj"
    printf 'plugin owes, dormant until this project ships hooks. Presence is\n'
    printf 'admission; felix obligations reads it back on every run.\n'
    return 0
  fi

  # The empty case, refused first. The first of three places (this, the gate,
  # the merge boundary), for the reason cmd_probes gives: a table that can be
  # absent and read as fine is the marker bypass in miniature.
  if [ ! -f "$proj/obligations.tsv" ]; then
    printf 'obligations for %s\n\n' "$(basename "$proj")"
    printf 'This project has admitted no obligation: there is no obligations.tsv,\n'
    printf 'so nothing it owes is written anywhere a merge can read.\n\n'
    printf 'Write %s/obligations.tsv. One row per obligation:\n\n' "$proj"
    printf '  obligation <TAB> class <TAB> pathway <TAB> applies <TAB> evidence <TAB> grounds <TAB> reason\n\n'
    printf 'A template is at %s/templates/obligations.tsv.\n' "$SCRIPT_DIR"
    return 1
  fi
  local rows bad; rows="$(felix_obligation_rows "$proj")"; bad="$(felix_obligation_malformed "$proj")"
  printf 'obligations for %s\n\n' "$(basename "$proj")"
  if [ -n "$bad" ]; then
    printf 'rows refused\n\n'; printf '%s\n' "$bad" | sed 's/^/  /'
    printf '\nA row needs a name, a class from the set, a pathway from the set and an\n'
    printf 'evidence contract; and a single probabilistic finding may not block.\n\n'
  fi
  if [ -z "$rows" ]; then
    printf '%s/obligations.tsv admits no obligation.\n' "$proj"
    printf 'An empty ledger is not a clean bill; it is a ledger with nothing owed.\n'
    return 1
  fi
  local orphans; orphans="$(felix_obligations_orphans "$proj")"
  if [ -n "$orphans" ]; then
    printf 'grounded on a probe %s/probes.tsv does not declare\n\n' "$proj"
    printf '%s\n' "$orphans" | sed 's/^/  /'; printf '\n'
  fi

  local out; out="$(felix_obligations_run "$proj" "$root")"
  # ROW is the hash a grant in exceptions.tsv is keyed to (exceptions.sh): the
  # ledger line, verbatim, with its newline. Printed so a person copies it
  # rather than computing it. An excepted row keeps its discharge — the
  # obligation is still owed — and says who accepted that, until when.
  printf '  %-22s %-18s %-9s %-12s %-12s %s\n' OBLIGATION CLASS APPLIES DISCHARGE ROW ''
  printf '%s\n' "$out" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    local oname odetail oexc ohash
    oname="$(printf '%s\n' "$line" | cut -f1)"; odetail="$(printf '%s\n' "$line" | cut -f6)"
    oexc="$(printf '%s\n' "$line" | cut -f8)"
    ohash="$(command -v felix_obligation_row_hash >/dev/null 2>&1 && felix_obligation_row_hash "$proj" "$oname" 2>/dev/null | cut -c1-12)"
    case "$oexc" in
      'excepted|'*) odetail="excepted until $(printf '%s\n' "$oexc" | cut -d'|' -f2) by $(printf '%s\n' "$oexc" | cut -d'|' -f3-)${odetail:+; $odetail}" ;;
    esac
    printf '  %-22s %-18s %-9s %-12s %-12s %s\n' \
      "$oname" "$(printf '%s\n' "$line" | cut -f2)" \
      "$(printf '%s\n' "$line" | cut -f4)" "$(printf '%s\n' "$line" | cut -f5)" \
      "${ohash:--}" "$odetail"
  done
  local n_block; n_block="$(printf '%s\n' "$out" | felix_obligations_blocking | grep -c .)"
  local n_exc; n_exc="$(printf '%s\n' "$out" | awk -F'\t' 'index($8, "excepted|") == 1' | grep -c .)"
  printf '\n%s obligation(s): %s active, %s dormant, %s unknown; %s blocking, %s excepted' \
    "$(printf '%s\n' "$out" | grep -c .)" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$4 == "ACTIVE"'  | grep -c .)" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$4 == "DORMANT"' | grep -c .)" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$4 == "UNKNOWN"' | grep -c .)" \
    "$n_block" "$n_exc"
  local n_ung; n_ung="$(felix_obligations_ungrounded "$proj" | grep -c .)"
  [ "$n_ung" -gt 0 ] && printf '; %s ground on no probe' "$n_ung"
  printf '\n'
  # A clearance that happened silently would leave the founder a green with
  # nothing in the record saying a person's grant produced it: said, once per
  # row, at the moment it is consumed (exceptions.sh, amendments §3).
  if [ "$gate" -eq 1 ] && [ "$n_exc" -gt 0 ]; then
    printf '%s\n' "$out" | awk -F'\t' 'index($8, "excepted|") == 1 { print $1 "\t" $8 }' | while IFS=$'\t' read -r xname xexc; do
      [ -n "$xname" ] || continue
      felix_say "$proj" "excepted" "$xname: excepted until $(printf '%s\n' "$xexc" | cut -d'|' -f2) by $(printf '%s\n' "$xexc" | cut -d'|' -f3-)" "felix obligations --gate" "" 2>/dev/null || true
    done
  fi
  # The grants themselves, read from the base ref and judged against the
  # ledger as it stands, and what this tree holds that the base does not.
  if [ "$gate" -ne 1 ] && command -v felix_exceptions_judge >/dev/null 2>&1 && ! felix_same_repo "$proj" "$root" 2>/dev/null; then
    if [ -f "$proj/exceptions.tsv" ] && grep -qvE '^[[:space:]]*(#|$)' "$proj/exceptions.tsv"; then
      printf '\nexceptions: not read for this project. Its tables live in %s, whose merges\n' "$(dirname "$proj")"
      printf 'this boundary does not examine, so a grant there is not yet a person'"'"'s act.\n'
    fi
  elif [ "$gate" -ne 1 ] && command -v felix_exceptions_judge >/dev/null 2>&1; then
    local xref xj xu n_x
    xref="$(felix_exceptions_ref "$proj" 2>/dev/null)" || xref=""
    xj="$(felix_exceptions_judge "$proj" "" "$out")"; xu="$(felix_exceptions_unmerged "$proj" "$root")"; n_x="$(felix_exceptions_count "$proj")"
    if [ -n "$xj" ] || [ -n "$xu" ]; then
      local xhead
      if [ -n "$xref" ]; then xhead="$xref ($(felix_exceptions_ref_date "$proj"))"; else xhead="no refs/remotes/origin/main, so none can be read"; fi
      printf '\nexceptions at %s: %s granted\n' "$xhead" "$n_x"
      [ -n "$xj" ] && printf '%s\n' "$xj" | awk -F'\t' 'NF >= 5 { printf "  %-8s %-22s %-21s %-14s %s\n", $1, $2, $3, $4, $5 }'
      if [ -n "$xu" ]; then
        printf '\n  written in this tree and not at %s, so not yet a grant:\n' "${xref:-the base ref}"
        printf '%s\n' "$xu" | awk -F'\t' '{ printf "    %-22s until %s by %s\n", $1, $3, $4 }'
      fi
    fi
  fi
  # The epoch these were evaluated under. Report only, and only in the report:
  # the gate's copy of this output is read by other things, and a line added
  # there would be a format change rather than a fact.
  if [ "$gate" -ne 1 ]; then
    local ep; ep="$(felix_epoch "$proj" "$root")" || ep=""
    [ -n "$ep" ] && printf '\nscoped to decision epoch %s\n' "$ep"
    # What a model proposed, and nothing admitted. Ingested here on every
    # read rather than in a hook, so the file a session wrote is read the
    # first time anyone asks; reported only in the report, never under
    # --gate, because the gate's copy of this output is parsed.
    if [ -f "$(felix_candidates_answer_path "$proj")" ] || [ -f "$(felix_candidates_path "$proj")" ]; then
      felix_candidates_record "$proj" "$root" >/dev/null 2>&1
      local cands refused n_c n_cur n_adm
      cands="$(felix_candidates_stale "$proj" "$root")"
      refused="$(felix_candidates_rules "$proj" "$root" | awk -F'\t' '$1 == "refuse" { print $2 ": " $3 }')"
      n_c="$(printf '%s\n' "$cands" | grep -c .)"
      n_cur="$(printf '%s\n' "$cands" | awk -F'\t' '$2 == "current"' | grep -c .)"
      n_adm="$(printf '%s\n' "$rows" | grep -c .)"
      printf '\ncandidates: %s proposed, %s under this epoch, none admitted by the engine\n' "$n_c" "$n_cur"
      printf '%s\n' "$cands" | awk -F'\t' 'NF == 2 { printf "  %-22s %s\n", $1, $2 }'
      if [ -n "$refused" ]; then
        printf '\n  refused, with the reason\n'
        printf '%s\n' "$refused" | sed 's/^/    /'
      fi
      printf '\ndiscovered %s, admitted %s, granted %s. A candidate is admitted by a person copying its\n' \
        "$n_c" "$n_adm" "$(command -v felix_exceptions_count >/dev/null 2>&1 && felix_exceptions_count "$proj" || printf 0)"
      printf 'row into %s/obligations.tsv and committing; the engine never does.\n' "$proj"
    fi
  fi
  if [ "$gate" -eq 1 ]; then
    [ "$n_block" -eq 0 ] && [ -z "$bad" ] && [ -z "$orphans" ] || return 1
  fi
  return 0
}

cmd_epoch() {
  resolve_or_die; local proj="$PROJ" root a
  for a in "$@"; do
    case "$a" in
      --*) die "usage: felix epoch (got: $a)" ;;
    esac
  done
  root="$(felix_repo_root "$PWD")"

  local e comps
  comps="$(felix_epoch_components "$proj" "$root")"
  e="$(felix_epoch "$proj" "$root")" || e=""

  printf 'decision epoch for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$comps" | while IFS=$'\t' read -r k v; do
    [ -n "${k:-}" ] || continue
    printf '  %-18s %s\n' "$k" "$v"
  done
  printf '\n'
  if [ -n "$e" ]; then
    printf '  epoch              %s\n' "$e"
  else
    printf '  epoch              -\n\n'
    printf 'A component above is unknown, so there is no epoch. Hashing over the\n'
    printf 'absence would read as a world that had moved every time a probe broke.\n'
    return 2
  fi
  printf '\nWithin one epoch, admitted blocking obligations may stay constant or\n'
  printf 'increase; a new grounded topology or a new table set makes a new one,\n'
  printf 'and that is when applicability is recomputed. This command reports it\n'
  printf 'and changes no verdict: shrinking the ledger escapes to a person\n'
  printf 'whatever the epoch says, which is stricter than the rule above.\n'
}

cmd_probes() {
  resolve_or_die; local proj="$PROJ" gate=0 a
  for a in "$@"; do
    case "$a" in
      --gate) gate=1 ;;
      *) die "usage: felix probes [--gate] (got: $a)" ;;
    esac
  done
  local root tid rows malformed
  root="$(felix_repo_root "$PWD")"
  tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR" 2>/dev/null)" || tid=""

  # The empty case, refused first and refused loudly. This is the first of the
  # three places it is refused, and it exists because `procedures.tsv` shipped
  # to three projects and none of them ever wrote one — a surface that reports
  # gaps, holding no rows, reporting nothing, indistinguishable from a project
  # with no gaps at all. A table that can be absent and read as fine is the
  # marker bypass in miniature.
  if [ ! -f "$proj/probes.tsv" ]; then
    printf 'probes for %s\n\n' "$(basename "$proj")"
    printf 'This project has no probes.tsv, so nothing here is read from reality.\n'
    printf 'Every capability it claims rests on a filename match, and no command\n'
    printf 'has been asked to confirm any of it.\n\n'
    printf 'Write %s/probes.tsv. One row per question:\n\n' "$proj"
    printf '  predicate <TAB> grounds <TAB> when <TAB> probe <TAB> witness\n\n'
    printf 'A template is at %s/templates/probes.tsv.\n' "$SCRIPT_DIR"
    return 1
  fi
  rows="$(felix_probe_rows "$proj")"
  malformed="$(felix_probe_malformed "$proj")"
  if [ -z "$rows" ]; then
    printf 'probes for %s\n\n' "$(basename "$proj")"
    printf '%s/probes.tsv exists and declares no probe.\n' "$proj"
    printf 'An empty table is not a clean bill; it is a shelf with nothing on it.\n'
    if [ -n "$malformed" ]; then
      printf '\nrows that name a predicate and no command\n\n'
      printf '%s\n' "$malformed" | sed 's/^/  /'
      printf '\nA probe needs a predicate and something to run. These record neither\n'
      printf 'a question nor an answer, so they enumerate nothing.\n'
    fi
    return 1
  fi

  local out
  out="$(felix_probes_run "$proj" "$root")"

  # Recorded before anything is printed, so a fact log entry cannot depend on
  # the report rendering. #84's shape: a record that reports success when the
  # append failed turns a ceiling into no ceiling and says nothing.
  local recorded=1
  felix_probes_record "$proj" "$root" "$tid" "$out" || recorded=0

  local n_all n_block n_empty n_na n_nosrc
  n_all="$(printf '%s\n' "$out" | grep -c .)"
  n_block="$(printf '%s\n' "$out" | felix_probes_blocking | grep -c .)"
  n_empty="$(printf '%s\n' "$out" | awk -F'\t' '$3 == "empty"' | grep -c .)"
  # Counted because `when` is a disarm channel: a row whose applicability test
  # is always false claims nothing, blocks nothing, and looks like a row. The
  # merge boundary catches the edit — rewriting a row removes its old line and
  # probes.tsv is in the escape set — but the gate would not, and a table that
  # can quietly switch itself off should have to say how much of itself is off.
  n_na="$(printf '%s\n' "$out" | awk -F'\t' '$3 == "not-applicable"' | grep -c .)"
  # How many rows identify no instrument. Derived from the probe's first word,
  # so a row beginning with an assignment or a variable gets none — which means
  # a count that moves in it cannot be told apart from the tool underneath it
  # moving. That is a real limit on what the drift report can say, and a limit
  # nobody prints is a limit nobody reads.
  n_nosrc="$(printf '%s\n' "$out" | awk -F'\t' '$3 != "not-applicable" && ($7 == "-" || $7 == "")' | grep -c .)"

  printf 'probes for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$out" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '  %-10s %-22s %s\n' \
      "$(printf '%s\n' "$line" | cut -f3)" \
      "$(printf '%s\n' "$line" | cut -f1)" \
      "$(printf '%s\n' "$line" | cut -f5)"
  done

  # Never folded into a total. `empty` is a real observation and it is also the
  # exact shape of every failure this file was built after, so it is said in
  # words next to the count rather than counted as one of the fine ones.
  #
  # The blank line is printed only when something follows it. Unconditional, it
  # left a project whose every probe came back `found` with two blank lines and
  # then a heading, which reads as a section that failed to render.
  [ "${n_block:-0}" -gt 0 ] || [ "${n_empty:-0}" -gt 0 ] || [ "${n_na:-0}" -gt 0 ] \
    || [ "${n_nosrc:-0}" -gt 0 ] && printf '\n'
  if [ "${n_block:-0}" -gt 0 ]; then
    printf '%s of %s could not be established. Those are not passes:\n' "$n_block" "$n_all"
    printf 'blind means the witness proves a surface the probe cannot see, and\n'
    printf 'unknown means nothing decided either way.\n'
  fi
  if [ "${n_empty:-0}" -gt 0 ]; then
    printf '%s returned nothing and a witness agreed the surface is absent. That\n' "$n_empty"
    printf 'is an observation, not a clean bill: read them.\n'
  fi
  if [ "${n_na:-0}" -gt 0 ]; then
    printf '%s of %s did not apply here and asked nothing. A row can be switched\n' "$n_na" "$n_all"
    printf 'off by making its `when` false, so this number is worth reading.\n'
  fi
  if [ "${n_nosrc:-0}" -gt 0 ]; then
    printf '%s of %s identify no instrument, because the probe does not begin\n' "$n_nosrc" "$n_all"
    printf 'with a bare command name. A count that moves in those cannot be told\n'
    printf 'apart from the tool underneath them moving.\n'
  fi

  if [ -n "$malformed" ]; then
    printf '\nrows that name a predicate and no command\n\n'
    printf '%s\n' "$malformed" | sed 's/^/  /'
    printf '\nThese enumerate nothing and stand for nothing. They are not counted\n'
    printf 'above, so a table of them reads as an empty table, which it is.\n'
  fi

  # What changed since the last tree this was asked about. Reported before the
  # gaps because it is about what this branch did, and after the states because
  # a surface nobody can see any more is already a refusal above.
  local drift
  drift="$(felix_probes_drift "$proj" "$tid" "$out")"
  if [ -n "$drift" ]; then
    printf '\nchanged since the last tree\n\n'
    printf '%s\n' "$drift" | while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '  %-22s %-14s -> %-14s %s\n' \
        "$(printf '%s\n' "$line" | cut -f1)" \
        "$(printf '%s\n' "$line" | cut -f2)" \
        "$(printf '%s\n' "$line" | cut -f3)" \
        "$(printf '%s\n' "$line" | cut -f4)"
    done
    printf '\nRead rather than enforced, and that is the specification rather than\n'
    printf 'timidity: relations produce facts, not obligations. A member that went\n'
    printf 'away can be somebody deleting a file on purpose. What nothing else can\n'
    printf 'say is that there used to be more of them — nothing greps for a hook\n'
    printf 'that was deleted, because absence has no line number.\n'
  fi

  # The gap report, in the idiom procedures already uses: what nothing covers,
  # enumerated by something other than this table.
  local gaps orphans
  gaps="$(felix_probes_gaps "$proj" "$root")"
  if [ -n "$gaps" ]; then
    printf '\nsurfaces nothing probes\n\n'
    printf '%s\n' "$gaps" | while read -r c; do
      [ -n "$c" ] || continue
      printf '  %-14s %s\n' "$c" "$(_felix_why "$c")"
    done
    printf '\nEach was reached by matching filenames and manifests, and no command\n'
    printf 'has confirmed any of it. Neither list is one Felix wrote: surfaces come\n'
    printf 'from the checkout, and a probe grounding one is the difference between\n'
    printf 'believing that match and having asked the thing that knows.\n'
  fi

  orphans="$(felix_probes_orphans "$proj" "$root")"
  if [ -n "$orphans" ]; then
    printf '\nprobes for surfaces nothing enumerates\n\n'
    printf '%s\n' "$orphans" | sed 's/^/  /'
    printf '\nEach grounds a capability this checkout no longer shows, or a name\n'
    printf 'that never existed. A table is wrong when it lacks a row reality has\n'
    printf 'and equally wrong when it keeps one reality dropped.\n'
  fi

  if [ "$recorded" -eq 0 ]; then
    printf '\nThe fact log was NOT written to %s/facts.log.\n' "$(felix_mem_dir "$proj")"
    printf 'Every state above was computed and none of it was kept, so nothing\n'
    printf 'later can compare this run against another one.\n'
  fi

  # The residual, on the surface it bites hardest.
  #
  # This command exists to ask reality rather than to trust a filename, which
  # makes it the strongest claim to trustworthiness Felix prints — and its own
  # weakest joint is the one v3.2's amendments close on. Every count above is
  # an enumeration, and enumeration cannot be behavioural: a member the probe
  # never reached is not reported missing, it is absent from the denominator,
  # and nothing downstream can notice a number that was never wrong.
  #
  # Said every run rather than on a condition, because there is no state in
  # which it stops being true and a caveat that appears only sometimes reads
  # as a finding about this run.
  printf '\nWhat none of this can reach. Every row above is an enumeration, and an\n'
  printf 'entrypoint never found is never executed — a surface no probe names is\n'
  printf 'missing from these counts rather than reported as a gap in them. And\n'
  printf 'one authority still writes both the work and the judgement of the work:\n'
  printf 'these rows narrow what may be claimed, not who claims it.\n'

  [ "$gate" -eq 1 ] || return 0
  [ "$recorded" -eq 1 ] || return 1
  [ "${n_block:-0}" -eq 0 ] || return 1
  # A row nothing can run has to stop the gate as well as appear in the report.
  # procedures.tsv shipped with exactly this hole — a malformed row was named
  # and the surface still read as answered — and reproducing it here would be
  # the same mistake made twice with the file that documents it.
  [ -z "$malformed" ] || return 1
  return 0
}

# The heartbeat, and the one command that may run with no session and no
# governed checkout anywhere near it: launchd starts it in $HOME. So it does
# not resolve a project — it is home-scoped, iterating every governed project
# for the report — and it exits 0 on honest nothing-to-do. Installing the
# schedule is a separate, explicit act: the grant is the founder running
# --install, never a default.
cmd_pulse() {
  local a install=0 uninstall=0
  for a in "$@"; do
    case "$a" in
      --install)   install=1 ;;
      --uninstall) uninstall=1 ;;
      # A discarded flag ran the default path — a real commit and push — and
      # printed a normal successful heartbeat, which reads as confirmation.
      # `felix pulse --uninstal` therefore said everything was fine while the
      # schedule it was asked to remove kept running.
      *) die "usage: felix pulse [--install|--uninstall] (got: $a)" ;;
    esac
  done
  local plist="$HOME/Library/LaunchAgents/felix.pulse.plist"
  local log="$FELIX_HOME_DIR/state/pulse.log"

  if [ "$uninstall" -eq 1 ]; then
    # The unload's status is the whole answer. `Unload failed: 5` is routine,
    # and deleting the plist anyway left the job loaded — still committing
    # and pushing daily — with the founder told the grant was taken back and
    # the file that would let them retry gone.
    if [ ! -f "$plist" ]; then
      printf 'nothing scheduled; %s does not exist\n' "$plist"
      return 0
    fi
    if launchctl unload "$plist" >/dev/null 2>&1; then
      rm -f "$plist"
      printf 'pulse unscheduled; %s removed\n' "$plist"
      return 0
    fi
    printf 'launchctl refused to unload %s, so it was NOT removed — the schedule\n' "$plist"
    printf 'may still be running. Unload it by hand, then delete that file.\n'
    return 1
  fi

  if [ "$install" -eq 1 ]; then
    if [ "$(uname)" != "Darwin" ]; then
      printf 'no launchd here. schedule it yourself, e.g. cron:\n'
      printf '  7 9 * * * %s/felix pulse\n' "$SCRIPT_DIR"
      return 1
    fi
    # The engine that survives this checkout: the marketplace root when one
    # is registered. felix_engine_source returns any non-plugin copy
    # verbatim — a worktree included — and a plist pointing into a worktree
    # dies with the worktree, so that is only the fallback when no
    # marketplace answers.
    local esrc mroot
    mroot="$(felix_marketplace_root 2>/dev/null)" || mroot=""
    if [ -n "$mroot" ] && [ -x "$mroot/engine/harness/felix" ]; then
      esrc="$mroot/engine"
    else
      esrc="$(felix_engine_source "$FELIX_ROOT" "$FELIX_HOME_DIR")" || esrc=""
    fi
    [ -n "$esrc" ] || { printf 'cannot resolve a served engine to schedule\n'; return 1; }
    mkdir -p "$HOME/Library/LaunchAgents" "$FELIX_HOME_DIR/state" 2>/dev/null
    # Checked, because the redirection's failure is silent without set -e and
    # both branches below assert the file exists: on a machine where
    # LaunchAgents is not writable, this returned 0 claiming to have written
    # a plist that was never there.
    if ! felix_pulse_plist "$esrc/harness/felix" "$log" > "$plist" 2>/dev/null \
       || [ ! -s "$plist" ]; then
      printf 'could not write %s; nothing was scheduled\n' "$plist"
      return 1
    fi
    launchctl unload "$plist" >/dev/null 2>&1
    if launchctl load "$plist" >/dev/null 2>&1; then
      printf 'scheduled: %s pulse, daily at 09:07, logging to %s\n' "$esrc/harness/felix" "$log"
    else
      printf 'wrote %s but launchctl load failed; load it by hand\n' "$plist"
    fi
    printf 'this was the grant: nothing scheduled itself. felix pulse --uninstall takes it back\n'
    return 0
  fi

  mkdir -p "$FELIX_HOME_DIR/state" 2>/dev/null
  {
    printf 'pulse\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    felix_pulse_backup "$(felix_pulse_mem_repo "$FELIX_HOME_DIR")"
    felix_pulse_report "$FELIX_HOME_DIR"
  } | tee -a "$log" 2>/dev/null
  return 0
}

# `<subcommand> --help` answers with usage instead of running (#102). No
# subcommand handled the flag, 24 of them take a first positional, and the ones
# that write took the flag AS the positional: `felix adopt --help` declared a
# capability named `--help`, created a setup.tsv whose presence flips `felix
# setup` from "declares no setup steps" to "Nothing outstanding.", and minted
# ~/.felix/memory/--help/. Found as residue — it had already happened
# unprompted, at the hour a project was being mounted, which is exactly when
# somebody reaches for --help. The check is on $2 so `felix --help` keeps its
# own row below, and it answers usage rather than dying because asking for help
# is not an error.
case "${2:-}" in
  -h|--help) case "${1:-}" in help|-h|--help|'') ;; *) usage; exit 0 ;; esac ;;
esac

case "${1:-help}" in
  which)  shift; cmd_which "$@" ;;
  gate)   shift; cmd_gate "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  pulse)   shift; cmd_pulse "$@" ;;
  procedures) shift; cmd_procedures "$@" ;;
  commission) shift; cmd_commission "$@" ;;
  probes)     shift; cmd_probes "$@" ;;
  obligations) shift; cmd_obligations "$@" ;;
  epoch)     shift; cmd_epoch "$@" ;;
  profile)   shift; cmd_profile "$@" ;;
  route)     shift; cmd_route "$@" ;;
  decisions) shift; cmd_decisions "$@" ;;
  monitor)   shift; cmd_monitor "$@" ;;
  ready)     shift; cmd_ready "$@" ;;
  discover)  shift; cmd_discover "$@" ;;
  toolbox)   shift; cmd_toolbox "$@" ;;
  ledger)    shift; cmd_ledger "$@" ;;
  shape)     shift; cmd_shape "$@" ;;
  coverage)  shift; cmd_coverage "$@" ;;
  qualify)   shift; cmd_qualify "$@" ;;
  merge)     shift; cmd_merge "$@" ;;
  review)    shift; cmd_review "$@" ;;
  next)      shift; cmd_next "$@" ;;
  autonomy)  shift; cmd_autonomy "$@" ;;
  overnight) shift; cmd_overnight "$@" ;;
  brief)     shift; cmd_brief "$@" ;;
  pr)        shift; cmd_pr "$@" ;;
  quarantine) shift; cmd_quarantine "$@" ;;
  recommend) shift; cmd_recommend "$@" ;;
  stack)   shift; cmd_stack "$@" ;;
  adopt)   shift; cmd_adopt "$@" ;;
  log)     shift; cmd_log "$@" ;;
  lesson)  shift; cmd_lesson "$@" ;;
  handoff) shift; cmd_handoff "$@" ;;
  promote) shift; cmd_promote "$@" ;;
  lessons) shift; cmd_lessons "$@" ;;
  setup)  shift; cmd_setup "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  repair)   shift; cmd_repair "$@" ;;
  incident) shift; cmd_incident "$@" ;;
  maintenance) shift; cmd_maintenance "$@" ;;
  classify) shift; cmd_classify "$@" ;;
  scope)     shift; cmd_scope "$@" ;;
  automerge) shift; cmd_automerge "$@" ;;
  budget)     shift; cmd_budget "$@" ;;
  unattended) shift; cmd_unattended "$@" ;;
  evidence) shift; cmd_evidence "$@" ;;
  receipt)  shift; cmd_receipt "$@" ;;
  new)     shift; cmd_new "$@" ;;
  install) shift; cmd_install "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $1. Try 'felix help'." ;;
esac
