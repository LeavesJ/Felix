printf '\na branch that rewrites the rules it is judged by\n'
# When Felix governs itself, projects/felix/risk.tsv is a tracked file in the
# repository being classified — and _felix_risk_rows read it off disk. So a
# commit could add a green row and then be classified by the row it had just
# added. The candidate wrote its own judge.
#
# Reproduced before it was believed: a commit deleting the red row for
# engine/harness/lib and adding a green one classified its own engine edit
# green. `verifier` catches that particular shape at merge because a row was
# removed, but classification is a separate surface with its own consumers —
# the tier label, the auto-merge streak, the receipt — and it was wrong at all
# of them.
#
# The rule is now that a change to an enforcing table may only ever tighten the
# diff carrying it. Both versions are evaluated and the stricter wins, so a
# widening applies from the next diff on and a tightening applies immediately.
# That is the base-version evaluation the earned-autonomy decision asks for
# (docs/2026-08-14-earned-autonomy-decision.md §4a), achieved for the tables,
# which is the half of the authority kernel that is data rather than code.
SELF="$TMP/self"; mkdir -p "$SELF/projects/p" "$SELF/engine/lib" "$SELF/engine/bin"
( cd "$SELF" && git init -q . && git config user.email t@t && git config user.name t )
printf 'red\tpath\t^engine/lib/\tsourced by every hook\nyellow\tpath\t^projects/[^/]+/risk\\.tsv$\trules\n' \
  > "$SELF/projects/p/risk.tsv"
printf 'lib\n'  > "$SELF/engine/lib/classify.sh"
printf 'scan\n' > "$SELF/engine/bin/secret-scan"
( cd "$SELF" && git add -A >/dev/null && git commit -qm base >/dev/null )
SELF_BASE="$( cd "$SELF" && git rev-parse HEAD )"

# Asserted per path, not on the whole diff. risk.tsv rates itself yellow, so
# every diff carrying one of these edits is floored at yellow no matter what
# happens to the file under attack — which is why the first report of this read
# the reproduction as green-versus-yellow rather than as the demotion it is. A
# whole-diff assertion here would pass without the fix.
_selfpath() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/classify.sh"
                felix_classify_tier \
                  "$(felix_classify_diff "$SELF/projects/p" "$SELF_BASE" "$SELF" \
                     | awk -F'\t' -v p="$1" '$2==p')" ); }

# Demotion: delete the red row, add a green one, edit the file it covered.
( cd "$SELF" && grep -v '^red' projects/p/risk.tsv > t && mv t projects/p/risk.tsv
  printf 'green\tpath\t^engine/lib/\tharmless\n' >> projects/p/risk.tsv
  printf 'PWNED\n' >> engine/lib/classify.sh
  git add -A >/dev/null && git commit -qm demote >/dev/null )
is "a green row cannot demote the diff that adds it" \
   "$(_selfpath engine/lib/classify.sh)" "red"
( cd "$SELF" && git reset -q --hard "$SELF_BASE" )

# The additive half, which `verifier` structurally cannot see: nothing is
# removed, so the escape guarding these tables never fires. A green row for a
# path that had no row at all takes a file from the yellow default to green in
# one commit — and engine/bin is where the credential scanner lives, the one
# the `disclose` channel shells out to.
( cd "$SELF" && printf 'green\tpath\t^engine/bin/\ttooling\n' >> projects/p/risk.tsv
  printf 'exit 0\n' > engine/bin/secret-scan
  git add -A >/dev/null && git commit -qm additive >/dev/null )
is "a green row for a previously unruled path does not green it either" \
   "$(_selfpath engine/bin/secret-scan)" "yellow"
( cd "$SELF" && git reset -q --hard "$SELF_BASE" )

# Tightening applies immediately. The stricter of the two versions wins, not
# the older one — otherwise the rule would be a reason to ignore the table.
( cd "$SELF" && printf 'red\tpath\t^engine/bin/\tthe scanner\n' >> projects/p/risk.tsv
  printf 'exit 0\n' > engine/bin/secret-scan
  git add -A >/dev/null && git commit -qm tighten >/dev/null )
is "a red row added applies to the diff that adds it" \
   "$(_selfpath engine/bin/secret-scan)" "red"
( cd "$SELF" && git reset -q --hard "$SELF_BASE" )

# The guard's own failure mode, which nothing asserted. felix_table_rel decided
# whether the base-version pass runs by comparing path strings, so any way the
# two paths were spelled differently switched the protection off and said
# nothing: a worktree, whose root is a different directory in the same
# repository, and a macOS /var vs /private/var pair, which is one directory
# spelled twice. Both reproduced before this was changed. Asking git is the only
# thing that gets both right, and felix_same_repo already existed for exactly
# this reason — it replaced two path-prefix guards that had lapsed the same way.
_tr() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/classify.sh"
          felix_table_rel "$1" "$2" ); }
SELFP="$( cd "$SELF" && pwd -P )"
is "the table resolves to its repo-relative path" \
   "$(_tr "$SELF" "$SELF/projects/p/risk.tsv")" "projects/p/risk.tsv"
is "and still resolves when the root is spelled the other way" \
   "$(_tr "$SELFP" "$SELF/projects/p/risk.tsv")" "projects/p/risk.tsv"
( cd "$SELF" && git worktree add -q "$TMP/selfwt" -b wt >/dev/null 2>&1 )
if [ -d "$TMP/selfwt" ]; then
  is "and from a worktree of the same repository" \
     "$(_tr "$TMP/selfwt" "$SELF/projects/p/risk.tsv")" "projects/p/risk.tsv"
else
  skip "and from a worktree of the same repository" "worktree add failed"
fi
# The other direction has to keep failing, or every governed product regresses.
is "a table in a different repository resolves to nothing" \
   "$(_tr "$REPO" "$SELF/projects/p/risk.tsv")" ""

# The trap this fix could set. A governed product's tables live in the Felix
# home and are not in its diff at all, so there is nothing there to defend
# against. Reading a base version that does not exist would yield no rows and
# floor every product diff at the yellow default — turning a fix for Felix into
# a regression for every project Felix governs. The second evaluation is
# skipped unless the table is tracked in the repository under judgement.
printf 'notes\n' > "$REPO/README.md"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "a table outside the classified repo is still read once, at HEAD" "$out" "tier:  green"
_reset

printf '\nwhat a revert cannot undo\n'
# A tier used to be a function of which file you touched, and that is what sent
# a one-line dependency-floor correction to the founder for a day. The question
# a stop must answer is not "is this file important" but "does merging write
# something outside this tree that a revert cannot reach".
#
# Escapes are engine constants. A project may add to them and may never declare
# one away, so this is not a table anybody can weaken into agreement.
_esc() { ( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
           felix_escapes "$FROOT/projects/widget" HEAD~1 "$REPO" ); }
# L-25 again: this section appends rows to the widget's table, and every later
# assertion in the file reads that table. Snapshot it here, restore at the end,
# and assert the restore rather than trusting it.
cp "$FROOT/projects/widget/risk.tsv" "$TMP/risk.keep"

printf 'notes and more notes\n' > "$REPO/README.md"; _stage
is "a documentation change escapes nothing" "$(_esc)" ""
_reset

# Merging this runs the job, holding every secret the repository has. Reverting
# restores the YAML; it does not un-run the job or un-read the key.
mkdir -p "$REPO/.github/workflows"; printf 'on: push\n' > "$REPO/.github/workflows/ci.yml"; _stage
has "a workflow change escapes as execute" "$(_esc)" "execute"

# Merging this grants Felix a power it then holds in every session after it.
# The file IS the permission — writing it is granting it — and that is exactly
# what a `git add -A` swept into a pull request whose own body said the grant
# was ungranted. Nothing stopped it, because nothing named the file. A revert
# takes the word back and does not un-run the sessions Felix ran with it, which
# is the marker's own argument one file over. Any change fires, in either
# direction: a revoke is the safe direction and costs one look.
mkdir -p "$REPO/projects/anyproj"; printf 'commission\n' > "$REPO/projects/anyproj/autonomy"; _stage
has "a grant of authority escapes"                      "$(_esc)" "authority"
_reset
mkdir -p "$REPO/projects/anyproj"; printf 'deadbeef\n' > "$REPO/projects/anyproj/autonomy.commission"; _stage
has "and so does the stamp that says what it was read against" "$(_esc)" "authority	projects/anyproj/autonomy.commission"
_reset

# The marker is the binding: break it and every hook resolves nothing, which
# is not something a revert of the word undoes for the sessions that ran while
# it was wrong. A tier alone would have said "look carefully" to nobody in
# particular, so the row carries a channel and stops the merge.
printf 'widget\n\n' > "$REPO/.felix"; _stage
has "a change to the project marker escapes" "$(_esc)" "verifier"
_reset

# The table of exemptions. Every other enforcing table narrows by removal and
# the channel fires on removal only. ecosystem.tsv narrows by ADDITION — an
# allow row is a file the check stops reading, a mute row a word it stops
# seeing — so a branch could add the exemption for the very file it was about
# to break invariant 1 in, and merge green. Any change to it fires.
printf '# kind\tpath\twords\tnote\n' > "$REPO/ecosystem.tsv"; _stage
printf 'allow\tlib/x.sh\tcargo\tprose\n' >> "$REPO/ecosystem.tsv"; _stage
has "adding a row to the ecosystem table escapes as verifier" "$(_esc)" "verifier"
has "and says why growth is the narrowing direction there" "$(_esc)" "exempt"
_reset
printf '# a reworded comment\n' >> "$REPO/ecosystem.tsv"; _stage
is "a comment added to it is still free" "$(_esc | grep -c verifier)" "0"
_reset; _reset

# #56. The same workflow, judged against a base git cannot name. Every git error
# in felix_changed_paths goes to /dev/null, so an unresolvable base produced no
# paths and no complaint, and felix_escapes returned "nothing escaped" from its
# `[ -n "$paths" ] || return 0` line — before a single channel was consulted,
# `execute` included, which risk.tsv's own header calls unconditional.
#
# It stayed latent because both governed repositories are on `main`. It fires on
# a --base typo, on a repository whose default branch is `master`, on a clone
# with no local `main`, and on the next governed project. The precondition is a
# clean tree, because a dirty one still yields a working-tree diff — and a clean
# tree is exactly what felix merge requires, so that softens nothing.
_esc_at() { ( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
              felix_escapes "$FROOT/projects/widget" "$1" "$REPO" ); }
has "a base that does not resolve is unknown, not clean" "$(_esc_at no-such-ref)" "unknown"
case "$(_esc_at no-such-ref)" in
  *execute*) bad "and does not name a channel it never got to consult" "$(_esc_at no-such-ref)" ;;
  *)         ok  "and does not name a channel it never got to consult" ;;
esac
# The lesson felix_kernel_dir already carried: `git rev-parse --verify <40-hex>`
# exits 0 for a sha no repository holds, because a full-length hex string is a
# syntactically valid object name and --verify alone checks syntax. Peeling to a
# commit is what makes it an existence test. Without `^{commit}` this reads as a
# resolvable base and clears the merge exactly as before.
has "a full-length sha nothing holds is unknown too" \
    "$(_esc_at 0000000000000000000000000000000000000000)" "unknown"
# And the good case is not collateral: a base that resolves still answers.
has "a base that resolves still names the channel" "$(_esc)" "execute"
# An empty base is a deliberate no-base — working tree only — and not a failure
# to resolve one. felix_changed_paths has always meant it that way.
is "an empty base is not reported as unknown" "$(_esc_at '')" ""
_reset

mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/003.sql"; _stage
has "a migration escapes as durable" "$(_esc)" "durable"
_reset

# The trailing marker is a scanner exclusion, and it sits in a shell comment so
# it never reaches leak.py — the fixture file still holds a clean credential for
# the scanner under test to find. Without it Felix's own gate goes red on this
# line, which is the scanner working on the suite that tests the scanner.
printf 'api_key = "sk-ant-api03-BBBBBBBBBBBBBBBBBBBBBBBB"\n' > "$REPO/leak.py"; _stage  # must_flag
has "a credential in added lines escapes as disclose" "$(_esc)" "disclose"
_reset

# The verifier channel. A green produced by a narrowed judge certifies itself,
# so shrinking what judges is the one edit that cannot be checked by the thing
# it shrank. Adding to a table is free; removing from it is not.
#
# The table has to be inside the repository being merged for a diff to contain
# it. For a governed product that is never true — its tables live in the Felix
# home — so this channel fires when Felix's *own* repository is the one being
# merged, which is exactly where those tables are edited. Indirect, and complete.
_block_head="$( cd "$REPO" && git rev-parse --short HEAD )"
mkdir -p "$REPO/projects/thing"
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
  printf 'red\tpath\t^auth/\tauthorization model\n'
} > "$REPO/projects/thing/risk.tsv"; _stage
printf 'green\tpath\t^extra/\tan added row\n' >> "$REPO/projects/thing/risk.tsv"; _stage
is "adding a row to an enforcing table escapes nothing" "$(_esc)" ""
_reset

# JSON punishes line-identity comparison. Adding a key rewrites the line above
# it, because that line gains a comma — so a naive shrink test reads every
# addition as a removal, and fires on the single most common edit anyone makes
# to project.json. Observed on the commit that declared consumers.
printf '{\n  "name": "thing",\n  "gate": "g.sh"\n}\n' > "$REPO/projects/thing/project.json"; _stage
printf '{\n  "name": "thing",\n  "gate": "g.sh",\n  "consumers": "none"\n}\n' > "$REPO/projects/thing/project.json"; _stage
is "adding a key to json escapes nothing" "$(_esc)" ""
_reset
printf '{\n  "name": "thing"\n}\n' > "$REPO/projects/thing/project.json"; _stage
has "but removing one still escapes" "$(_esc)" "verifier"
_reset; _reset
sed '/^red.path.\^auth/d' "$REPO/projects/thing/risk.tsv" > "$TMP/rt" && mv "$TMP/rt" "$REPO/projects/thing/risk.tsv"
_stage
has "removing one escapes as verifier" "$(_esc)" "verifier"
has "and names the table"              "$(_esc)" "projects/thing/risk.tsv"
_reset
# L-25: restore the fixture and assert the restore, or every later assertion in
# this file runs against a repository this block quietly changed.
_reset
# By head, not by _esc — and this is #56 caught in the suite's own fixture.
#
# This assertion used to read `is "..." "$(_esc)" ""`, and _esc scans against
# HEAD~1. Measured, not inferred: at this point the fixture is at its ROOT
# commit, depth 1, so HEAD~1 names nothing. git diff exits 128,
# felix_changed_paths sent that to /dev/null, and the scan returned empty for
# every possible state of the repository. The guard L-25 wrote to catch a
# quietly changed fixture could not observe one, and it passed for four months
# on an instrument that had gone blind at exactly the state it was checking.
# Adding felix_base_resolves is what made it visible.
#
# A head comparison is the claim this line was always making, and unlike the
# scan it can fail. The porcelain check is the half _esc could still see —
# uncommitted drift — kept rather than dropped.
is "and the repository is back to where it started" \
   "$( cd "$REPO" && git rev-parse --short HEAD )" "$_block_head"
is "and nothing is left uncommitted under it" \
   "$( cd "$REPO" && git status --porcelain )" ""

# Confinement, which is the whole reason PR #4 should not have waited. The
# manifest is dual-use: it declares dependencies AND configures the gate. So the
# row stays, and stops firing only when every changed line is a version
# constraint and the package names are the same on both sides.
{ printf 'red\tpath\t^pyproject\\.toml$\tmanifest is also gate config\tverifier\t'
  printf '^[-+][[:space:]]*"?[A-Za-z0-9._-]+[[:space:]]*[<>=!~^,"]\n'
} >> "$FROOT/projects/widget/risk.tsv"
printf '[project]\ndependencies = [\n  "anthropic>=0.40",\n]\n' > "$REPO/pyproject.toml"; _stage
printf '[project]\ndependencies = [\n  "anthropic>=0.120",\n]\n' > "$REPO/pyproject.toml"; _stage
is "a version bump alone escapes nothing" "$(_esc)" ""
_reset

# The evil twin: same file, same PR shape, one extra line that deletes tests
# from the gate without touching a single test.
printf '[project]\ndependencies = [\n  "anthropic>=0.120",\n]\n[tool.pytest.ini_options]\naddopts = "--ignore=tests/test_judgment.py"\n' > "$REPO/pyproject.toml"; _stage
has "the same file with an unconfined line escapes" "$(_esc)" "pyproject.toml"
_reset; _reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"

# A verifier row counts rather than compares. The suite is the thing that
# judges, so weakening it must stop — but comparing line identity would fire on
# every refactor and on every ordinary edit, and a stop that fires constantly is
# one people route around. What must not go down is the number of assertions.
{ printf 'yellow\tpath\t^suite\\.sh$\tweakening the suite is how a gate stops being one\tverifier\t'
  printf 'count:^[[:space:]]*(ok|is|has) \n'
} >> "$FROOT/projects/widget/risk.tsv"
printf 'ok one\nis two\nhas three\n' > "$REPO/suite.sh"; _stage
printf 'ok one\nis two\nhas three\nok four\n' > "$REPO/suite.sh"; _stage
is "adding an assertion escapes nothing" "$(_esc)" ""
_reset
printf 'ok one\nis two\n' > "$REPO/suite.sh"; _stage
has "removing one escapes as verifier" "$(_esc)" "verifier"
_reset
# Rewriting every line while keeping the count is a refactor, not a weakening.
printf 'ok ONE\nis TWO\nhas THREE\n' > "$REPO/suite.sh"; _stage
is "rewriting assertions without losing any escapes nothing" "$(_esc)" ""
_reset; _reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"

# #77 item 2, against the SHIPPED gate and the SHIPPED confine rather than a
# stand-in, because the defect is a property of that exact file's shape.
#
# The confine is anchored to line start. Three of the gate's seven checks report
# mid-line — `[ -z "$BAD" ] && pass syntax || {...}`, the same for executable,
# and `; then pass secret` / `else fail secret` — so they can be deleted whole
# without the count dropping. Measured: the count is 9 before, and 9 after
# `sed 34d` removes the entire syntax report. The reason column on that row
# reads "a gate that cannot fail is not a gate".
#
# A `check <name>` marker line would NOT fix this, which is why it is not what
# landed. It detects deleting a whole check block and leaves the marker standing
# when only the reporting line goes — the smaller and more deniable weakening,
# and the exact shape the issue describes.
REAL_GATE="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/gate.sh"
if [ -f "$REAL_GATE" ]; then
  cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"
  printf 'yellow\tpath\t^projects/[^/]+/gate\\.sh$\ta gate that cannot fail is not a gate\tverifier\tcount:^[[:space:]]*(pass|fail|check) \n' \
    >> "$FROOT/projects/widget/risk.tsv"
  mkdir -p "$REPO/projects/thing"
  cp "$REAL_GATE" "$REPO/projects/thing/gate.sh"; _stage

  # Every check the gate reports must be behind the confine. Named individually
  # so a failure says WHICH one slipped out rather than that a number moved.
  #
  # ENUMERATED FROM THE GATE, not listed here. This was seven names typed by
  # hand, and it went stale the first time the gate grew an eighth check: the
  # new one was outside the confine and no assertion said so, while seven `ok`
  # lines printed. That is the same defect the coverage table exists to catch
  # and the same one the `executable` check above already records — a list of
  # things to check is a list that stops matching what exists — arriving in the
  # test written to keep the gate honest.
  #
  # Read before the loop, because the loop rewrites the file it would read.
  _GCHECKS="$(grep -oE '^[[:space:]]*(pass|fail) [a-z][a-z-]*' "$REPO/projects/thing/gate.sh" \
              | awk '{print $2}' | LC_ALL=C sort -u | tr '\n' ' ')"
  [ -n "$_GCHECKS" ] || bad "the gate reports checks this suite can enumerate" \
                            "no 'pass <name>' or 'fail <name>' lines in $REAL_GATE"
  for _c in $_GCHECKS; do
    _n_before="$(grep -cE '^[[:space:]]*(pass|fail|check) ' "$REPO/projects/thing/gate.sh")"
    grep -vE "^[[:space:]]*(pass|fail) $_c\$" "$REPO/projects/thing/gate.sh" \
      | grep -vE "^[[:space:]]*(pass|fail) $_c;" > "$TMP/gt" && mv "$TMP/gt" "$REPO/projects/thing/gate.sh"
    _n_after="$(grep -cE '^[[:space:]]*(pass|fail|check) ' "$REPO/projects/thing/gate.sh")"
    [ "$_n_after" -lt "$_n_before" ] \
      && ok "the $_c check is behind the verifier confine" \
      || bad "the $_c check is behind the verifier confine" \
             "removing its report left the count at $_n_after"
    cp "$REAL_GATE" "$REPO/projects/thing/gate.sh"
  done

  # And end to end: deleting one must actually fire the channel, not merely move
  # a number. This is the assertion #77 asks for by name.
  grep -v 'pass syntax' "$REPO/projects/thing/gate.sh" | grep -v 'fail syntax' > "$TMP/gt" \
    && mv "$TMP/gt" "$REPO/projects/thing/gate.sh"; _stage
  has "and deleting the syntax check escapes as verifier" "$(_esc)" "verifier"
  has "naming the gate it was removed from" "$(_esc)" "projects/thing/gate.sh"
  _reset; _reset
  cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"
else
  skip "the syntax check is behind the verifier confine" "no shipped gate"
fi

# A row with no channel is advisory. Every table written before this column
# existed is exactly that, and must keep classifying without ever stopping a
# merge on its own.
printf 'red\tpath\t^legacy/\tno channel named\n' >> "$FROOT/projects/widget/risk.tsv"
mkdir -p "$REPO/legacy"; printf 'x\n' > "$REPO/legacy/a.txt"; _stage
is "a red row naming no channel stops nothing" "$(_esc)" ""
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "but it still classifies red" "$out" "tier:  red"
_reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"

# `unknown` is the engine's word for "nothing was scanned", and felix merge
# prints a whole paragraph off it saying no finding describes the branch. A
# table that could declare that word would make a row which DID fire render as
# a scan that never ran — the same false all-clear #56 is about, one layer up.
# Renamed rather than skipped, because a project may add to the escapes and may
# never declare one away.
printf 'red\tpath\t^reserved/\ttrying to wear the reserved name\tunknown\n' \
  >> "$FROOT/projects/widget/risk.tsv"
mkdir -p "$REPO/reserved"; printf 'x\n' > "$REPO/reserved/a.txt"; _stage
has "a table declaring the reserved channel still stops the merge" \
    "$(_esc)" "trying to wear the reserved name"
case "$(_esc)" in
  unknown[[:space:]]*) bad "but cannot impersonate an unscanned diff" "$(_esc)" ;;
  *)                   ok  "but cannot impersonate an unscanned diff" ;;
esac
# Inline rather than via _blk, which this file does not define until the merging
# section below. The claim is at the merge layer, so it is asserted there.
_resv_blk="$( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
              . "$FROOT/harness/lib/evidence.sh"; . "$FROOT/harness/lib/verify.sh"
              felix_merge_blockers "$FROOT/projects/widget" HEAD~1 "$REPO" "$FROOT" )"
has "and it reaches merge as an escape, not as unknown" "$_resv_blk" "escape"
# On the kind field, not on a substring: `declared-unknown` ends in the reserved
# word, so a glob for it matched the very rename that proves the fix works.
is "and merge does not call it an unscanned diff" \
   "$(printf '%s\n' "$_resv_blk" | awk -F'\t' '$1=="unknown"{print "found"}')" ""
_reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"

is "the widget's table is exactly as this section found it" \
   "$(diff -q "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv" >/dev/null && echo same)" "same"

printf '\nmerging\n'
# The escape set decides nothing until something consults it. Felix had no way
# to merge at all — the only merge-adjacent code in the engine turned on
# GitHub's auto-merge and then waited for a person — so a rule saying "Felix
# merges what a revert undoes" would have recoloured a label and saved nobody
# anything.
#
# Every blocker is computed before gh is reached. A merge command that discovers
# its own preconditions from the network cannot be tested and cannot refuse
# offline, and refusing offline is the case that matters.
_blk() { ( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
           . "$FROOT/harness/lib/evidence.sh"
           . "$FROOT/harness/lib/verify.sh"
           felix_merge_blockers "$FROOT/projects/widget" HEAD~1 "$REPO" "$FROOT" ); }

printf 'plain notes\n' > "$REPO/README.md"; _stage
has "an unverified tree blocks the merge" "$(_blk)" "unverified"

# A malformed probe row reaches the merge boundary as a blocker. cmd_probes
# --gate already refuses one; a boundary that let the same row through would
# be the weaker of two checks on one table, which is the order they must
# never be in.
printf 'halfrow\t-\n' >> "$FROOT/projects/widget/probes.tsv"
has "a probe row naming a predicate and no command blocks the merge" "$(_blk)" "halfrow"
cp "$TMP/probes.keep" "$FROOT/projects/widget/probes.tsv"
is "the widget's probe table is exactly as this section found it" \
   "$(diff -q "$TMP/probes.keep" "$FROOT/projects/widget/probes.tsv" >/dev/null && echo same)" "same"

# A receipt for a different tree is not a green gate, which is the trap cmd_pr
# already learned. Stamp one for the wrong tree and it must still block.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "not-this-tree" >/dev/null 2>&1 )
has "a receipt for another tree still blocks" "$(_blk)" "unverified"

( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
_cm_stamp
is "a green receipt for this exact tree clears every blocker" "$(_blk)" ""

# And a red receipt for the right tree is not a pass either.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 1 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
has "a red receipt for this tree blocks" "$(_blk)" "unverified"
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
_cm_stamp

# A green receipt says what was checked, and a skipped check is not a check.
#
# `felix gate --quick` skips the test suite and still exits 0, so the receipt
# it stamps was byte-identical to a full run's: one bit, green. Everything
# downstream then spoke as if the suite had passed — the Stop hook said so in
# those words. The gate already prints which checks it skipped; the receipt now
# carries them, so a reader can tell a full verification from a partial one.
#
# What this cannot say: a gate that skips something silently is still invisible.
# The receipt records what the gate REPORTED as skipped, and no absence of skip
# lines proves nothing was skipped. That limit is stated where it is claimed.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" "tests,installed" >/dev/null 2>&1 )
_rcpt="$( . "$FROOT/harness/lib/verify.sh"; felix_verify_receipt "$REPO" "$FROOT" )"
is "the receipt records which checks the gate skipped" "$(printf '%s' "$_rcpt" | cut -f5)" "tests,installed"
is "and a run that skipped nothing says so, rather than leaving it blank" \
   "$( ( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
         felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" "" >/dev/null 2>&1 )
       . "$FROOT/harness/lib/verify.sh"; felix_verify_receipt "$REPO" "$FROOT" | cut -f5 )" "-"
# A sixth field: every check the gate reported, with the verdict it printed.
# The gate's output was a temporary file the command threw away, so the only
# roster of what the gate checks was one typed into a handoff by hand — and a
# typed roster is wrong the day a checker is added. felix qualify reads this
# to say which reported checks no row qualifies.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" "tests" "syntax:ok,tests:skipped,secret:ok" >/dev/null 2>&1 )
_rcpt="$( . "$FROOT/harness/lib/verify.sh"; felix_verify_receipt "$REPO" "$FROOT" )"
is "the receipt records every check the gate reported, with its verdict" \
   "$(printf '%s' "$_rcpt" | cut -f6)" "syntax:ok,tests:skipped,secret:ok"
is "and the skip list is still where it was" "$(printf '%s' "$_rcpt" | cut -f5)" "tests"
is "and a receipt written without a roster says so rather than leaving it blank" \
   "$( ( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
         felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" "" "" >/dev/null 2>&1 )
       . "$FROOT/harness/lib/verify.sh"; felix_verify_receipt "$REPO" "$FROOT" | cut -f6 )" "-"
# The four readers all take fields 1-3 positionally, so a fifth field must not
# disturb any of them. Asserted rather than assumed: a `read -r a b c d` would
# have absorbed it, and that is the shape that broke felix profile.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" "tests" >/dev/null 2>&1 )
_cm_stamp
is "a receipt carrying a skip list still clears every blocker" "$(_blk)" ""

# And cmd_gate reads the skips off the gate's own report rather than off its
# own flags: a project gate that skips for its own reasons is recorded too.
_skipfx="$(printf '  syntax             ok\n  tests              skipped (--quick)\n  installed          skipped (no plugin installed here)\n  secret             ok\n')"
is "the extractor names every skipped check and nothing else" \
   "$(printf '%s\n' "$_skipfx" | awk '$2 == "skipped" { printf "%s%s", sep, $1; sep = "," }')" "tests,installed"
# And the roster the same way: names the gate printed, with what it printed
# beside them, never names anybody listed. Four verdict words: the gate's own
# first real run printed `commission stale`, which a three-word extractor
# dropped — a checker that ran and reported, absent from the roster.
_rosterfx="$(printf 'gate: /tmp/x\n      main @ abc1234\n%s\n    Files a and b differ\n                     1817 passed, 0 failed\n  commission         stale (table set moved; run felix commission)\n  probes             FAIL\n' "$_skipfx")"
is "the roster extractor names every reported check with its verdict, in order" \
   "$(printf '%s\n' "$_rosterfx" | awk '$0 ~ /^  [a-z][a-z-]* +[A-Za-z]/ { printf "%s%s:%s", sep, $1, $2; sep = "," }')" \
   "syntax:ok,tests:skipped,installed:skipped,secret:ok,commission:stale,probes:FAIL"
# And the lib reads the same shape back, so a checker the gate reported under
# any verdict word is a gap when no row qualifies it.
is "felix_qualify_ungoverned keeps every reported checker and drops every sub-line" \
   "$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/qualify.sh"
       felix_qualify_ungoverned "$TMP/no-such-proj" "$_rosterfx" | tr '\n' ' ')" \
   "commission installed probes secret syntax tests "

( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
_cm_stamp

# An escape outranks a green gate. This is the whole point: the gate says the
# code works, and says nothing about whether merging writes outside the tree.
mkdir -p "$REPO/.github/workflows"; printf 'on: push\n' > "$REPO/.github/workflows/x.yml"; _stage
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
_cm_stamp
has "a green gate does not clear an escape" "$(_blk)" "execute"

# #56, at the level that acts. The same branch, the same workflow, the same
# green receipt — merged against a base git cannot name. This is the shown-
# failing case the issue requires: today it prints "nothing in it escaped the
# tree" and merges.
_blk_at() { ( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
              . "$FROOT/harness/lib/evidence.sh"
              . "$FROOT/harness/lib/verify.sh"
              felix_merge_blockers "$FROOT/projects/widget" "$1" "$REPO" "$FROOT" ); }
has "an execute path against an unresolvable base blocks the merge" \
    "$(_blk_at no-such-ref)" "unknown"
# And it blocks as `unknown`, not as `escape`. The distinction is not cosmetic:
# cmd_merge counts escapes as founder escalations — the declared objective is
# interruptions per session — and tells the reader that merging writes outside
# the tree and only they can decide. A base nobody can resolve is neither. It is
# a typo, or a default branch that is not `main`, and correcting it is Felix's
# own work.
case "$(_blk_at no-such-ref)" in
  escape*) bad "and not as an escape, which would escalate a typo to the founder" \
               "$(_blk_at no-such-ref)" ;;
  *)       ok  "and not as an escape, which would escalate a typo to the founder" ;;
esac
_reset

# An evidence gap is not a stop. It is work Felix owes, and handing it back as
# a decision is the defect the charter names.
cp "$FROOT/projects/widget/evidence.tsv" "$TMP/ev.keep" 2>/dev/null || : > "$TMP/ev.keep"
printf 'unit\t^src/\t^tests?/\tcode changes need a test\n' > "$FROOT/projects/widget/evidence.tsv"
mkdir -p "$REPO/src"; printf 'x = 1\n' > "$REPO/src/thing.py"; _stage
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
_cm_stamp
has "an untested change blocks, naming the evidence owed" "$(_blk)" "evidence"
has "and says which rule"                                 "$(_blk)" "unit"
_reset
cp "$TMP/ev.keep" "$FROOT/projects/widget/evidence.tsv"

# The command itself must refuse without reaching the network. gh is not called,
# so this assertion holds on a runner with no credentials and no remote.
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/900.sql"; _stage
out="$( cd "$REPO" && "$FELIX" merge --base HEAD~1 2>&1 )"; rc=$?
is  "felix merge refuses on an escape"  "$rc" "3"
has "and names the channel"             "$out" "durable"
has "and says what would have to change" "$out" "founder"
_reset

printf 'ordinary\n' > "$REPO/README.md"; _stage
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
_cm_stamp
out="$( cd "$REPO" && "$FELIX" merge --base HEAD~1 --dry-run 2>&1 )"; rc=$?
is  "and reports a clear merge without performing one" "$rc" "0"
has "saying so plainly"                                "$out" "nothing escapes"
_reset

printf '\na surface no test can judge\n'
# Some changes are revert-complete, touch no store and reach no stranger, and
# still must not merge unread: a rubric that teaches the wrong thing breaks
# nothing a gate can see. another governed project's constitution already answers this — T2
# wants "an independent reviewer running in an isolated worktree at the reviewed
# commit" — and nothing implemented it, so the row sat red and stopped nothing.
#
# The verdict is a receipt keyed on the tree, exactly like the gate's, because
# the trap is the same one: a verdict for a different tree is not a verdict.
RVH="$TMP/reviewhome"; RVP="$RVH/projects/widget"; mkdir -p "$RVP" "$MEM/widget"
cp "$TMP/risk.keep" "$RVP/risk.tsv" 2>/dev/null || : > "$RVP/risk.tsv"
printf 'red\tpath\t^content/\ta doctrine surface; no test can judge it\treviewed\t-\n' >> "$RVP/risk.tsv"
_resc() { ( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
            . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
            felix_escapes "$RVP" HEAD~1 "$REPO" "$RVH" ); }

mkdir -p "$REPO/content"; printf 'teach this\n' > "$REPO/content/rubric.md"; _stage
has "a doctrine surface with no verdict escapes" "$(_resc)" "reviewed"

# A verdict for some other tree must not clear it.
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "some-other-tree" pass reviewer-1 "looked fine" )
has "a verdict for another tree does not clear it" "$(_resc)" "reviewed"

TID="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$RVH" )"
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" block reviewer-1 "the rubric contradicts the map" )
has "a blocking verdict does not clear it either" "$(_resc)" "reviewed"

# The control for #57 item 2, and the reason it is placed HERE rather than after
# the fix: a verdict exists for this exact tree and it granted nothing, because
# it blocks. `granted_by` must still be "none". Without this, replacing one
# constant with a different constant would pass the assertion below it.
_rgrant() { ( cd "$REPO" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
              . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
              . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"; . "$FROOT/harness/lib/classify.sh"
              . "$FROOT/harness/lib/evidence.sh"; . "$FROOT/harness/lib/receipt.sh"
              felix_receipt "$RVP" HEAD~1 "$REPO" "$RVH" ) \
            | sed -n 's/.*"granted_by": "\([^"]*\)".*/\1/p'; }
is "a verdict that granted nothing names nothing" "$(_rgrant)" "none"

( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-1 "ran it against real content" )
is "a passing verdict for this exact tree clears it" "$(_resc)" ""

# #57, confirmed item 2. The receipt's `granted_by` was the string literal
# "none", printed unconditionally at lib/receipt.sh:192, and the only assertion
# on it compared that literal to "none" — a constant checked against itself.
#
# Meanwhile the `reviewed` channel genuinely grants authority, and it is the one
# place in Felix where a model's output widens permission rather than narrowing
# it (constitution invariant 2, the exception added 2026-08-12). A receipt that
# reached `autonomous: true` because a verdict cleared a red doctrine surface was
# byte-identical to one where nothing was granted. The only field in the wire
# contract that exists to name the provenance of authority could never name any.
is "the receipt names what granted the authority" "$(_rgrant)" "reviewed"

# Independence cannot be checked. Isolation half can, and it is the half that
# has actually gone wrong: a reviewer running pytest against the live tree while
# somebody keeps editing reports false failures, which the governed project's
# own lessons record as a real incident. So a pass claiming it ran in the tree
# under review is refused as a recording, not merely doubted.
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-1 "ran here" "$REPO" "$REPO" ) 2>/dev/null
rc=$?
is "a pass claiming it ran in the reviewed tree is refused" "$rc" "1"
has "and the earlier verdict is not replaced by it" \
    "$( . "$FROOT/harness/lib/review.sh"; felix_review_verdict "$RVH" "$RVP" "$TID" )" "ran it against real content"

( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-2 "ran elsewhere" "$TMP/some-other-worktree" "$REPO" )
has "a pass from a separate worktree records the place it ran" \
    "$( . "$FROOT/harness/lib/review.sh"; felix_review_verdict "$RVH" "$RVP" "$TID" )" "some-other-worktree"

# A block is never refused for where it ran. A reviewer reporting a problem from
# the wrong place is still reporting a problem, and discarding it would make the
# isolation check a way to lose bad news.
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" block reviewer-3 "found a contradiction" "$REPO" "$REPO" )
rc=$?
is "a block from the live tree is still recorded" "$rc" "0"
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-2 "ran elsewhere" "$TMP/some-other-worktree" "$REPO" )

# The boundary that makes this safe to have at all. A reviewer verdict clears
# the one channel with no mechanical test behind it and nothing else, so no
# review can release a secret, run CI, or move a store.
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/970.sql"; _stage
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" \
    "$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$RVH" )" pass reviewer-1 "fine" )
out="$(_resc)"
has "a verdict never clears a durable escape" "$out" "durable"
case "$out" in
  *reviewed*) bad "and the reviewed one is cleared by it" "$out" ;;
  *)          ok  "and the reviewed one is cleared by it" ;;
esac
_reset; _reset

printf '\nthe one number Felix is trying to move\n'
# Declared 2026-08-12: founder interruptions per session. You cannot optimise an
# unnamed objective, and Felix had none — so every improvement was argued rather
# than measured. Gate pass rate was rejected as the target because a gate you
# keep loosening passes more, which makes the metric move the wrong way for the
# worst possible reason.
#
# An interruption is a moment Felix needed a decision it could not make. It has
# to be recorded where it happens; counting it later from a transcript is the
# parsing approach this project already rejected twice.
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/950.sql"; _stage
before="$(grep -c '	escalated	' "$MEM/widget/says.log" 2>/dev/null || echo 0)"
( cd "$REPO" && "$FELIX" merge --base HEAD~1 >/dev/null 2>&1 )
after="$(grep -c '	escalated	' "$MEM/widget/says.log" 2>/dev/null || echo 0)"
[ "$after" -gt "$before" ] \
  && ok "a merge stopped for the founder is recorded as one" \
  || bad "a merge stopped for the founder is recorded as one" "says.log did not grow"
has "and the record names the channel" \
    "$(grep '	escalated	' "$MEM/widget/says.log" | tail -1)" "durable"
_reset

# A blocker Felix can clear itself is not an interruption. Counting an unrun
# gate as founder time would make the number improve by running the gate less.
printf 'notes\n' > "$REPO/README.md"; _stage
before="$(grep -c '	escalated	' "$MEM/widget/says.log" 2>/dev/null || echo 0)"
( cd "$REPO" && "$FELIX" merge --base HEAD~1 >/dev/null 2>&1 )
after="$(grep -c '	escalated	' "$MEM/widget/says.log" 2>/dev/null || echo 0)"
is "an unverified tree is Felix's work, not an interruption" "$after" "$before"
_reset

printf '\na base ref that is behind its remote\n'
# #74, and the sibling of the section below. There the base ref was current and
# the merge-base was frozen; here the base REF itself is behind.
#
# Every command defaults to base="main", and `main` is a local ref. In a
# worktree it is a SHARED local ref naming whatever the primary checkout last
# pulled — and a worktree cannot check main out, so nothing in that workflow
# ever advances it. Observed on this repository: local main sat three merges
# behind origin/main while work continued in a worktree.
#
# It fails in BOTH directions, which is what separates it from the rest of the
# family. Over-reporting is the #51 symptom by a second route. Under-reporting
# is new and worse: an evidence rule can be satisfied by a file that is in the
# diff only BECAUSE the base is stale, which is an all-clear nothing earned.
STALE="$TMP/stalebase"; mkdir -p "$STALE"
( cd "$STALE" && git init -q -b main
  git config user.email t@t; git config user.name t
  printf 'a\n' > a.txt; git add -A; git commit -qm one
  # main stays at one. origin/main advances to two, as a fetch would leave it.
  git checkout -q -b ahead
  printf 'b\n' > b.txt; git add -A; git commit -qm two
  git update-ref refs/remotes/origin/main HEAD
  git checkout -q -b feat
  printf 'c\n' > c.txt; git add -A; git commit -qm work
  git branch -q -D ahead ) >/dev/null 2>&1
STALE="$(cd "$STALE" && pwd -P)"

is "the fixture really has a base ref behind its remote" \
   "$( cd "$STALE" && [ "$(git rev-parse main)" = "$(git rev-parse origin/main)" ] && echo same || echo behind )" \
   "behind"

# felix_base_ref is what every command should resolve its base through.
_bref() { ( cd "$STALE" && . "$FROOT/harness/lib/resolve.sh"
            felix_base_ref "$STALE" "$1" 2>/dev/null || printf 'NONE' ); }
is "a bare branch name prefers the remote-tracking ref" "$(_bref main)" "origin/main"
# And only when that ref exists. A sha, a HEAD~n, or a purely local branch must
# be taken exactly as given — rewriting those would invent a base nobody named.
is "a revision expression is taken as given"  "$(_bref 'HEAD~1')" "HEAD~1"
is "a local-only branch is taken as given"    "$(_bref feat)"     "feat"
is "a base that names nothing is refused"     "$(_bref no-such)"  "NONE"

_stale_paths() { ( cd "$STALE" && . "$FROOT/harness/lib/resolve.sh"
                   felix_changed_paths "$STALE" "$(felix_base_ref "$STALE" main)" ); }
is "so the branch is not blamed for what the remote already had" \
   "$(_stale_paths)" "c.txt"

# And the call sites, because the six assertions above pin the LIBRARY and #65
# was a fix that every library assertion passed while the caller stayed broken.
# A command that resolves nothing would satisfy all of them.
printf 'widget\n' > "$STALE/.felix"
_stale_cmd() { ( cd "$STALE" && "$FELIX" "$@" 2>&1 ); }

# The reported base is the ref actually compared, not the name typed. Printing
# `main` while diffing origin/main would be the same answer wearing a lie.
has "classify names the ref it compared"  "$(_stale_cmd classify --base main)" "origin/main"
# A second call site, because one proves the line and not the pattern. The
# widget has no evidence table this early in the file, so this seeds a rule and
# takes it away again rather than relying on one the later sections own.
[ -f "$FROOT/projects/widget/evidence.tsv" ] && cp "$FROOT/projects/widget/evidence.tsv" "$TMP/ev.stale.keep"
printf 'anything\t.\t^tests?/\tevery change needs a test\n' > "$FROOT/projects/widget/evidence.tsv"
has "and evidence does too"               "$(_stale_cmd evidence --base main)" "origin/main"
rm -f "$FROOT/projects/widget/evidence.tsv"
[ -f "$TMP/ev.stale.keep" ] && mv "$TMP/ev.stale.keep" "$FROOT/projects/widget/evidence.tsv"
# The payoff: b.txt belongs to the remote, not to this branch.
case "$(_stale_cmd classify --base main)" in
  *b.txt*) bad "and the remote's own file is not listed against the branch" \
               "$(_stale_cmd classify --base main)" ;;
  *)       ok  "and the remote's own file is not listed against the branch" ;;
esac
has "while the branch's own file still is" "$(_stale_cmd classify --base main)" "c.txt"
rm -f "$STALE/.felix"

printf '\nstacked on a squashed base\n'
# #51. felix merge squashes, so merging a branch's base does NOT advance
# merge-base(main, branch) — the squash commit is not a descendant of the branch.
# Three-dot therefore keeps blaming the stacked branch for every path its base
# touched, permanently, even though main now holds those exact bytes.
#
# Observed on #50 stacked on #49: a documentation change classified red because
# it inherited engine/.claude-plugin/plugin.json from the branch below it.
#
# The fixture is the smallest thing that reproduces it, and the file the base
# adds is a workflow on purpose: .github/workflows is the `execute` channel, so
# the over-report is not only a wrong tier — it escalates a docs-only branch to
# the founder as writing outside the tree.
STK="$TMP/stacked"; mkdir -p "$STK"
( cd "$STK" && git init -q -b main
  git config user.email t@t; git config user.name t
  printf 'base\n' > base.txt; git add -A; git commit -qm init
  git checkout -q -b feat-a
  mkdir -p .github/workflows; printf 'on: push\n' > .github/workflows/ci.yml
  git add -A; git commit -qm "A: adds a workflow"
  git checkout -q -b feat-b
  printf 'notes\n' > NOTES.md; git add -A; git commit -qm "B: docs only"
  # Squashed, exactly as felix merge does it. A plain merge would advance the
  # merge-base and the bug would not exist.
  git checkout -q main; git merge -q --squash feat-a; git commit -qm "A squashed (#1)"
  git checkout -q feat-b ) >/dev/null 2>&1
STK="$(cd "$STK" && pwd -P)"
printf 'widget\n' > "$STK/.felix"

# The premise, asserted rather than assumed: the merge-base really is frozen
# behind main. If this stops being true the rest of the section proves nothing.
is "the squash leaves the merge-base behind main" \
   "$( cd "$STK" && [ "$(git merge-base main HEAD)" = "$(git rev-parse main)" ] && echo same || echo behind )" \
   "behind"

_stk_paths() { ( cd "$STK" && . "$FROOT/harness/lib/resolve.sh"
                 felix_changed_paths "$STK" main ); }
is "a stacked branch is not blamed for what its base already merged" \
   "$(_stk_paths)" "NOTES.md"

_stk_esc() { ( cd "$STK" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
               felix_escapes "$FROOT/projects/widget" main "$STK" ); }
case "$(_stk_esc)" in
  *execute*) bad "and its base's workflow is not escalated as this branch's escape" "$(_stk_esc)" ;;
  *)         ok  "and its base's workflow is not escalated as this branch's escape" ;;
esac

# The control that keeps this honest: the branch's OWN escape must still fire.
# A fix that simply narrowed everything would pass both assertions above and
# quietly stop enforcing.
( cd "$STK" && mkdir -p .github/workflows && printf 'on: pull_request\n' > .github/workflows/own.yml
  git add -A && git commit -qm "B: adds its own workflow" ) >/dev/null 2>&1
has "but a workflow this branch adds itself still escapes" "$(_stk_esc)" "execute"
has "and it is named"                                      "$(_stk_esc)" "own.yml"
( cd "$STK" && git reset -q --hard HEAD~1 )

# And an ordinary unstacked branch is untouched by any of this.
UNS="$TMP/unstacked"; mkdir -p "$UNS"
( cd "$UNS" && git init -q -b main
  git config user.email t@t; git config user.name t
  printf 'base\n' > base.txt; git add -A; git commit -qm init
  git checkout -q -b feat; printf 'x\n' > src.txt; git add -A; git commit -qm work ) >/dev/null 2>&1
UNS="$(cd "$UNS" && pwd -P)"
is "an unstacked branch reports exactly what it changed" \
   "$( cd "$UNS" && . "$FROOT/harness/lib/resolve.sh"; felix_changed_paths "$UNS" main )" "src.txt"

printf '\nevidence policy\n'
{
  printf 'unit\t^src/\t^tests?/\tcode changes need a test\n'
  printf 'db\t\\.sql$\t^tests?/.*db\tschema changes need a database test\n'
} > "$FROOT/projects/widget/evidence.tsv"

mkdir -p "$REPO/src"; printf 'x\n' > "$REPO/src/thing.js"; _stage
out="$( cd "$REPO" && "$FELIX" evidence --base HEAD~1 2>&1 )"
has "code with no test is a gap" "$out" "[!] unit"
has "and reads as a requirement"  "$out" "code changes need a test"
( cd "$REPO" && "$FELIX" evidence --base HEAD~1 --strict >/dev/null 2>&1 ); rc=$?
is "--strict exits non-zero on a gap" "$rc" "1"
( cd "$REPO" && "$FELIX" evidence --base HEAD~1 >/dev/null 2>&1 ); rc=$?
is "without --strict it only reports"  "$rc" "0"
_reset

mkdir -p "$REPO/src" "$REPO/tests"
printf 'x\n' > "$REPO/src/thing.js"; printf 'x\n' > "$REPO/tests/thing.test.js"; _stage
out="$( cd "$REPO" && "$FELIX" evidence --base HEAD~1 2>&1 )"
has "a matching test closes the gap" "$out" "[x] unit"
has "untouched surfaces are n/a"     "$out" "[-] db"
_reset

printf 'notes\n' > "$REPO/README.md"; _stage
out="$( cd "$REPO" && "$FELIX" evidence --base HEAD~1 2>&1 )"
has "a docs-only change requires nothing" "$out" "No evidence gaps"

# #63. The advisory half of #56, and it is not purely advisory.
#
# felix_changed_paths sends git's exit-128 to /dev/null, so a base that names
# nothing produced an empty path list and every evidence row fell to n/a —
# "this change does not touch that surface", asserted about a diff nobody
# computed — and the command signed off with "No evidence gaps." #56 closed the
# merge path; these three read the same emptiness and still answer.
#
# Same fixture, same clean tree, only the base changed.
ev_unk="$( cd "$REPO" && "$FELIX" evidence --base no-such-ref 2>&1 )"
case "$ev_unk" in
  *"No evidence gaps"*) bad "an unresolvable base is not an evidence all-clear" "$ev_unk" ;;
  *)                    ok  "an unresolvable base is not an evidence all-clear" ;;
esac
case "$ev_unk" in
  *"does not touch that surface"*)
    bad "and claims nothing about surfaces it never compared" "$ev_unk" ;;
  *) ok "and claims nothing about surfaces it never compared" ;;
esac
has "and names the base it could not resolve" "$ev_unk" "no-such-ref"

# classify. `No changes against X` reads as a finding about the branch; it is a
# report that the question was never asked.
cl_unk="$( cd "$REPO" && "$FELIX" classify --base no-such-ref 2>&1 )"
has "an unresolvable base classifies as unknown" "$cl_unk" "unknown"
case "$cl_unk" in
  *"tier:  green"*|*"tier:  yellow"*|*"tier:  red"*)
    bad "and never reports a tier it could not compute" "$cl_unk" ;;
  *) ok "and never reports a tier it could not compute" ;;
esac

# The one that writes, and the reason this is not filed as cosmetic. cmd_pr
# reduces the same empty findings to a tier and then LABELS the pull request
# risk-<tier>. felix_classify_tier returns green for no findings, and cmd_pr
# defaults to green again if that came back empty. Green is the tier that can
# auto-merge, so an unresolvable base labelled a branch as safe to merge itself.
# Preview only here — no --create, so nothing is written.
pr_unk="$( cd "$REPO" && "$FELIX" pr --base no-such-ref 2>&1 )"
case "$pr_unk" in
  *"tier:     green"*) bad "an unresolvable base never labels a pr green" "$pr_unk" ;;
  *)                   ok  "an unresolvable base never labels a pr green" ;;
esac

# The library level, so the fix cannot be a message change in three commands.
_ev_at() { ( cd "$REPO" && . "$FROOT/harness/lib/evidence.sh"
             felix_evidence_check "$FROOT/projects/widget" "$1" "$REPO" ); }
_cl_at() { ( cd "$REPO" && . "$FROOT/harness/lib/classify.sh"
             felix_classify_diff "$FROOT/projects/widget" "$1" "$REPO" ); }
has "felix_evidence_check reports unknown, not n/a" "$(_ev_at no-such-ref)" "unknown"
has "felix_classify_diff reports unknown, not empty" "$(_cl_at no-such-ref)" "unknown"
# Not knowing outranks everything — receipt.sh's stated precedence, because a
# verdict computed from inputs nobody read is the confident wrong answer.
is "and the tier reducer agrees" \
   "$( . "$FROOT/harness/lib/classify.sh"; felix_classify_tier "$(_cl_at no-such-ref)" )" "unknown"
# The good case is not collateral.
has "a base that resolves still classifies normally" "$(_cl_at HEAD~1)" "green"
_reset

# Green tier plus an evidence gap. Unreachable with the default rules, since
# green covers docs and tests while evidence fires on src. It becomes reachable
# the moment a project declares any src path green, which is allowed, so the
# branch is exercised here rather than shipped untested.
printf 'green\tpath\t^src/safe/\tdeclared safe by this project\n' \
  >> "$FROOT/projects/widget/risk.tsv"
mkdir -p "$REPO/src/safe"; printf 'x\n' > "$REPO/src/safe/x.js"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "green tier is still reported"        "$out" "tier:  green"
has "but auto-merge is withheld on a gap" "$out" "Not auto-merge eligible"
_reset

printf '\nengine and home are separate\n'
# A plugin install is a frozen copy of the whole repository. Treating its
# projects/ as a home would govern from a constitution frozen at install time and
# write memory into a directory the next plugin update deletes, both silently.
FAKE_CACHE="$TMP/.claude/plugins/cache/felix/felix/0.1.0"
mkdir -p "$FAKE_CACHE/projects/stale" "$TMP/plainrepo/projects/live"
out="$( unset FELIX_HOME; HOME="$TMP/nohome"; . "$FROOT/harness/lib/resolve.sh"; felix_home "$FAKE_CACHE" )"
case "$out" in
  *"plugins/cache"*) bad "a plugin cache is never treated as home" "$out" ;;
  *) ok "a plugin cache is never treated as home" ;;
esac
out="$( unset FELIX_HOME; HOME="$TMP/nohome"; . "$FROOT/harness/lib/resolve.sh"; felix_home "$TMP/plainrepo" )"
is "a plain checkout with projects/ is a home" "$out" "$TMP/plainrepo"
out="$( FELIX_HOME="$TMP/explicit"; . "$FROOT/harness/lib/resolve.sh"; felix_home "$TMP/plainrepo" )"
is "an explicit FELIX_HOME wins" "$out" "$TMP/explicit"
mkdir -p "$TMP/pointed"
out="$( unset FELIX_HOME; HOME="$TMP/withpointer"; mkdir -p "$HOME"
        printf '%s\n' "$TMP/pointed" > "$HOME/.felix-home"
        . "$FROOT/harness/lib/resolve.sh"; felix_home "$TMP/plainrepo" )"
is "the pointer file beats a sibling projects/" "$out" "$TMP/pointed"

# The test above covers felix_home's use of it. This covers the predicate
# itself, because #55 gave it a second caller: felix install must not treat a
# deployed copy as the tree it is deploying FROM, and the two must agree. A
# frozen copy is byte-identical to its checkout and carries no marker, so where
# it sits is the only evidence there is.
_pc() { ( . "$FROOT/harness/lib/resolve.sh"
          felix_plugin_copy "$1" && printf 'copy' || printf 'checkout' ); }
is "a cache path is a plugin copy" \
   "$(_pc "$HOME/.claude/plugins/cache/felix/felix/0.49.9")" "copy"
# The marketplaces/ half of the pattern, which nothing reached before.
is "a marketplaces path is one too" \
   "$(_pc "$HOME/.claude/plugins/marketplaces/felix/engine")" "copy"
is "an ordinary checkout is not"      "$(_pc "$TMP/plainrepo/engine")" "checkout"
is "and neither is a worktree"        "$(_pc "$TMP/r/.claude/worktrees/w/engine")" "checkout"
is "an empty path is not a copy"      "$(_pc "")"                     "checkout"
# One definition, asserted rather than intended. Two copies of this pattern is
# how it drifts, and a drifted copy fails open in both callers at once: a stale
# home governs from a frozen constitution, and install certifies the cache
# against itself. Counted in the library, where it belongs.
is "the pattern is written down exactly once" \
   "$(grep -c 'plugins/cache/\*|' "$FROOT/harness/lib/resolve.sh")" "1"

# #65. The tree being operated on is not the tree the script lives in — the same
# rule #55 established for felix install, and cmd_bootstrap breaks it one
# function along. It asks "what GitHub repo should CI check out to fetch the
# harness" and answers by running `git remote get-url origin` in whatever
# directory the running script sits in. From the deployed CLI that is the plugin
# cache, which has no remote, so it printed "none, CI cannot fetch the harness"
# about an engine whose remote exists — and on a machine whose home directory is
# itself a git repo with an origin, it would print THAT slug instead, straight
# into a generated workflow's `repository:` beside a deploy key.
#
# HOME is redirected for every call. felix_marketplace_root reads
# $HOME/.claude/plugins/known_marketplaces.json, and on this machine that names
# the real Felix checkout — so without this the assertions would pass by reading
# the developer's own install rather than the fixture.
_ESRC="$TMP/enginesrc"
mkdir -p "$_ESRC/engine/harness"
# Resolved, for the reason stated where $REPO is built: macOS spells /var as
# /private/var and git reports the resolved form, so felix_repo_root returns a
# different string for the same directory than mktemp handed out. Comparing
# against the unresolved name failed here on exactly that.
_ESRC="$(cd "$_ESRC" && pwd -P)"
printf '#!/usr/bin/env bash\nexit 0\n' > "$_ESRC/engine/harness/felix"
chmod +x "$_ESRC/engine/harness/felix"
( cd "$_ESRC" && git init -q -b main \
  && git remote add origin https://github.com/someone/felixsrc.git )
_ECACHE="$TMP/ehome/.claude/plugins/cache/felix/felix/0.1.0"
mkdir -p "$_ECACHE/harness" "$TMP/ehome" "$TMP/nowhere"

# $1 = cwd to stand in, $2 = the engine the script thinks it is
_esrc() { ( cd "$1" && HOME="$TMP/ehome" . "$FROOT/harness/lib/resolve.sh"
            HOME="$TMP/ehome" felix_engine_source "$2" "$3" 2>/dev/null || printf 'NONE' ); }
_eslug() { ( cd "$1" && HOME="$TMP/ehome" . "$FROOT/harness/lib/resolve.sh"
             . "$FROOT/harness/lib/detect.sh"
             s="$(HOME="$TMP/ehome" felix_engine_source "$2" "$3" 2>/dev/null)" \
               && felix_repo_slug "$s" || printf 'NONE' ); }

is "an engine that is a checkout is its own source" \
   "$(_esrc "$_ESRC" "$_ESRC/engine" "$_ESRC")" "$_ESRC/engine"
# The defect: the script is the cache, the checkout is elsewhere and reachable.
is "a deployed engine resolves the checkout, not itself" \
   "$(_esrc "$_ESRC" "$_ECACHE" "$_ESRC")" "$_ESRC/engine"
is "and the slug comes from the checkout's remote" \
   "$(_eslug "$_ESRC" "$_ECACHE" "$_ESRC")" "someone/felixsrc"
# The honest negative. No checkout anywhere is a real answer, and different from
# guessing one — a home that happens to be a git repo must not qualify just by
# having an origin, only by carrying an engine.
is "no reachable checkout resolves to nothing" \
   "$(_esrc "$TMP/nowhere" "$_ECACHE" "$TMP/nowhere")" "NONE"
# One definition. cmd_install grew this resolution first; a second copy in
# cmd_bootstrap is how the two drift, and a drifted copy points CI at the wrong
# repository.
is "the resolution is written down exactly once" \
   "$(grep -c 'felix_marketplace_root)" "$(felix_repo_root' "$FROOT/harness/felix" "$FROOT/harness/lib/resolve.sh" 2>/dev/null | awk -F: '{s+=$2} END {print s+0}')" "1"

# And the call site, which is where the defect actually is. The five assertions
# above pin felix_engine_source and every one of them passed with cmd_bootstrap
# still calling felix_repo_slug "$FELIX_ROOT" — a fix nothing would notice being
# reverted. Caught by neutering the call site and watching the suite stay green,
# which is the check this repository keeps learning to run.
#
# The CLI has to be a deployed copy for the bug to exist at all, so it is run
# from a cache path rather than from $FELIX.
_EDEPLOY="$TMP/ehome/.claude/plugins/cache/felix/felix/0.2.0"
mkdir -p "$_EDEPLOY"
cp -R "$FROOT/harness" "$_EDEPLOY/harness"
printf 'widget\n' > "$_ESRC/.felix"
bs_out="$( cd "$_ESRC" && HOME="$TMP/ehome" FELIX_HOME="$FROOT" \
             "$_EDEPLOY/harness/felix" bootstrap 2>&1 )"
# The `felix repo:` line specifically, not the output. The product's own `repo:`
# line carries the same slug in this fixture, so matching the whole output
# passed against the neutered call site — the label-not-the-value mistake, one
# assertion after correcting the same mistake in the pr preview.
is "bootstrap names the checkout's repo, not the cache's absence" \
   "$(printf '%s\n' "$bs_out" | sed -n 's/^felix repo: *//p')" "someone/felixsrc"
case "$bs_out" in
  *"CI cannot fetch the harness"*)
    bad "and never reports no remote for an engine that has one" "$bs_out" ;;
  *) ok "and never reports no remote for an engine that has one" ;;
esac
rm -f "$_ESRC/.felix"

