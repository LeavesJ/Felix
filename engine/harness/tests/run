is "one red path poisons the whole set" "$rc" "3"
out="$(cd "$REPO" && "$FELIX" scope migrations/003.sql docs/guide.md 2>&1)"; rc=$?
is "regardless of the order given" "$rc" "3"

out="$(cd "$REPO" && printf 'docs/guide.md\n' | "$FELIX" scope - 2>&1)"; rc=$?
is "reads paths from stdin too" "$rc" "0"

out="$(cd "$REPO" && "$FELIX" scope src/thing.js 2>&1)"; rc=$?
is "an unremarkable file is in scope" "$rc" "0"
has "and says the gates still apply" "$out" "evidence policy"

printf '\nearned auto-merge\n'
# The streak logic is the part that decides; the GitHub calls that feed it need a
# network and are exercised by using the thing. Fed synthetic history here.
_streak() { ( . "$FROOT/engine/harness/lib/automerge.sh" 2>/dev/null \
              || . "$FROOT/harness/lib/automerge.sh"; felix_automerge_streak "$1" ); }

is "no history is no streak" "$(_streak "")" "0"
is "all clean counts them all" \
   "$(_streak "$(printf '9\tclean\ta\n8\tclean\tb\n7\tclean\tc')")" "3"
# Consecutive, from the head. A red run in the middle is not something to count
# past: the question is whether the rules have been right lately, not often.
is "a red run breaks the streak" \
   "$(_streak "$(printf '9\tclean\ta\n8\tdirty\tb\n7\tclean\tc')")" "1"
is "and a red run at the head means zero" \
   "$(_streak "$(printf '9\tdirty\ta\n8\tclean\tb')")" "0"
# A number that arrived describing nothing is still not evidence. `gh run list`
# on a branch that no longer exists — which is every merged PR once the branch
# is deleted — returns [], and length of [] is 0, so "no runs found" read as
# "no failures" and counted toward switching auto-merge on.
_hist() { ( . "$FROOT/harness/lib/automerge.sh"; felix_automerge_state "$1" "$2" ); }
is "no runs at all is unknown, not clean" "$(_hist 0 0)" "unknown"
is "runs that all passed are clean"       "$(_hist 4 0)" "clean"
is "runs with a failure are dirty"        "$(_hist 4 2)" "dirty"
is "an unreadable count is unknown"       "$(_hist '' '')" "unknown"

# The state that used to be missing. The failure count comes off the network,
# and an errored `gh run list` prints nothing — which `${failures:-0}` read as
# zero failures, so "could not find out" advanced the streak toward switching
# auto-merge on. A streak is a claim that CI agreed; silence is not agreement.
is "a run nobody could read does not count as clean" \
   "$(_streak "$(printf '9\tunknown\ta\n8\tclean\tb')")" "0"
is "and it stops the streak rather than being skipped past" \
   "$(_streak "$(printf '9\tclean\ta\n8\tunknown\tb\n7\tclean\tc')")" "1"

printf '\nunattended budget\n'
# The ceiling worth having fails between runs, not during one, and counts
# repetition rather than money: ten deliberate attempts in a day is a working
# system, two hundred is a loop whatever each one cost.
rm -f "$FROOT/projects/widget/budget.log"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["unattended_daily_limit"]="2"; p.write_text(json.dumps(d,indent=2))
PYJ
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"
has "reads the per-project limit" "$out" "limit:  2"
has "and reports what is left"    "$out" "left:   2"

( cd "$REPO" && "$FELIX" budget --record >/dev/null 2>&1 )
( cd "$REPO" && "$FELIX" budget --record >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"; rc=$?
has "spending is counted" "$out" "used:   2"
is  "exhausted exits 3"   "$rc" "3"

out="$(cd "$REPO" && "$FELIX" budget --record 2>&1)"; rc=$?
is  "and refuses to spend past the ceiling" "$rc" "3"
has "saying why"                            "$out" "budget exhausted"

# A ceiling in a runner's ephemeral filesystem resets every job, invisibly.
[ -f "$FROOT/projects/widget/budget.log" ] \
  && ok "the ledger is durable state in the project" \
  || bad "the ledger is durable state in the project"

# Old entries age out rather than accumulating forever.
printf '1\t1970-01-01T00:00\tancient\n' >> "$FROOT/projects/widget/budget.log"
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"
has "entries older than a day do not count" "$out" "used:   2"

# #84, the half that is mechanical. The append was unchecked and the caller
# reported `used + 1` - arithmetic on a value read BEFORE the write, not a
# reading of what landed. So a record that never landed printed
# `recorded. 1 of 10 used` and exited 0; `used` stayed 0 forever; and the
# ceiling silently became no ceiling. budget.sh's own header names that exact
# outcome as the thing to prevent - "which is the same as no ceiling, and it
# resets invisibly."
#
# An unwritable project directory is the cheapest real cause. A full disk or a
# read-only mount reach the same place, and one of them is how this would
# actually happen on a runner.
rm -f "$FROOT/projects/widget/budget.log"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["unattended_daily_limit"]="10"; p.write_text(json.dumps(d,indent=2))
PYJ
chmod 555 "$FROOT/projects/widget"
out="$(cd "$REPO" && "$FELIX" budget --record --why "probe" 2>&1)"; rc=$?
chmod 755 "$FROOT/projects/widget"

[ "$rc" -ne 0 ] && ok "a record that could not be written does not exit 0" \
                || bad "a record that could not be written does not exit 0" \
                       "exit $rc after: $out"
case "$out" in
  *"recorded."*) bad "and does not say it recorded" "$out" ;;
  *)             ok  "and does not say it recorded" ;;
esac
# The number is the tell. `used + 1` reports a spend that never happened, and it
# reports it in the same words a real one uses.
case "$out" in
  *"1 of 10"*) bad "nor report a spend that did not happen" "$out" ;;
  *)           ok  "nor report a spend that did not happen" ;;
esac
is "and nothing was written" \
   "$([ -f "$FROOT/projects/widget/budget.log" ] && echo present || echo absent)" "absent"

# The control, and the half a careless fix breaks: a writable project still
# records, still exits 0, and the count it prints is the one the log holds
# rather than one it worked out in advance.
out="$(cd "$REPO" && "$FELIX" budget --record --why "real" 2>&1)"; rc=$?
is  "a writable project still records" "$rc" "0"
has "and says so"                      "$out" "recorded."
is  "the log holds exactly one entry" \
    "$( . "$FROOT/harness/lib/budget.sh"; felix_budget_used "$FROOT/projects/widget" )" "1"
has "which is the number it printed"   "$out" "1 of 10"

# And the library says so on its own, so the fix cannot be a message change in
# the command while the function still swallows the failure.
#
# The log is removed first, and that is not tidiness. Directory permissions gate
# CREATION, not appends to a file that already exists - so with the control's
# budget.log still in place, chmod 555 on the directory leaves the append
# perfectly writable and the probe tests nothing. This assertion passed for that
# reason before the log was removed.
rm -f "$FROOT/projects/widget/budget.log"
chmod 555 "$FROOT/projects/widget"
( . "$FROOT/harness/lib/budget.sh"
  felix_budget_record "$FROOT/projects/widget" "lib probe" 2>/dev/null ); librc=$?
chmod 755 "$FROOT/projects/widget"
[ "$librc" -ne 0 ] && ok "felix_budget_record itself reports the failure" \
                   || bad "felix_budget_record itself reports the failure" "exit $librc"
rm -f "$FROOT/projects/widget/budget.log"

# #84, the race. cmd_budget is check-then-act with no lock: it reads the count,
# compares it to the limit, then appends. Two callers that both read 9 against a
# limit of 10 both pass the comparison and both append, and the ceiling - the
# only mechanical bound on unattended model runs - is overrun.
#
# Reproduced against shipped code on ONE machine, no CI involved: seeded at 9 of
# 10, three concurrent callers, all three recorded, ledger left at 12.
#
# Driven with real concurrent processes rather than a stub, because the defect
# IS the interleaving; a sequential fixture cannot express it. It is made
# deterministic by seeding the ledger so exactly one slot remains, which makes
# the correct outcome exact rather than probabilistic: at most one caller may
# record, however the three interleave.
_seed_budget() {   # $1 = how many entries to seed
  local n="$1" now i
  now="$(date +%s)"
  : > "$FROOT/projects/widget/budget.log"
  i=0; while [ "$i" -lt "$n" ]; do
    printf '%s\t%s\tseed\n' "$now" "1970-01-01T00:00" >> "$FROOT/projects/widget/budget.log"
    i=$((i + 1))
  done
}
_seed_budget 9
RACE="$TMP/race"; rm -rf "$RACE"; mkdir -p "$RACE"
for _r in 1 2 3; do
  ( cd "$REPO" && "$FELIX" budget --record --why "racer$_r" >"$RACE/out$_r" 2>&1
    printf '%s' "$?" > "$RACE/rc$_r" ) &
done
wait

_recorded=0
for _r in 1 2 3; do
  [ "$(cat "$RACE/rc$_r" 2>/dev/null)" = "0" ] && _recorded=$((_recorded + 1))
done
# At most one, because exactly one slot was left. Zero is allowed and safe: if
# every caller observes the ledger after every append, they all refuse, and the
# window reopens on the next invocation. More than one is the overrun.
[ "$_recorded" -le 1 ] \
  && ok "at most one caller records when one slot is left" \
  || bad "at most one caller records when one slot is left" \
         "$_recorded of 3 recorded; ledger has $(grep -c . "$FROOT/projects/widget/budget.log") entries"

# And no caller may claim success while reporting a count past the ceiling. That
# sentence is what a workflow step reads as permission to invoke a model.
_overclaim=0
for _r in 1 2 3; do
  if [ "$(cat "$RACE/rc$_r" 2>/dev/null)" = "0" ]; then
    case "$(cat "$RACE/out$_r")" in
      *"1"[1-9]" of 10"*|*"2"[0-9]" of 10"*) _overclaim=$((_overclaim + 1)) ;;
    esac
  fi
done
is "and none reports a spend past the ceiling as recorded" "$_overclaim" "0"
rm -f "$FROOT/projects/widget/budget.log"

printf '\nunattended readiness\n'
# #87. Two of the five readiness rows were printf constants. This is the report
# a person reads when deciding whether to switch on a loop that invokes a model
# unattended, and `felix unattended` says outright that Felix will not flip that
# switch for them - so the rows have to be true.
#
# `scope bound` was fully literal, mark and text both, so it stayed checked for a
# project that declares no red path at all - i.e. exactly when nothing is out of
# scope and the bound it names does not exist.
#
# `budget ceiling` is a subtler case and the fix is different. Its [x] was not
# wrong about what it said - a ceiling IS configured, and felix_budget_limit can
# never return "none" - but readiness means the bound HOLDS, and in CI it does
# not: the ledger lives in a checkout made fresh every run (#84). Felix cannot
# determine that mechanically, so the honest mark is neither [x] nor [ ].
UNB="$TMP/unattgh"; mkdir -p "$UNB"
cat > "$UNB/gh" <<'STUB'
#!/usr/bin/env bash
case "$1 $2" in
  "variable list") ;;
  "secret list")   printf 'ANTHROPIC_API_KEY\n' ;;
  "run list")      printf '0\n' ;;
esac
exit 0
STUB
chmod +x "$UNB/gh"
# The fixture has no origin at this point and cmd_unattended dies without one -
# which made two of these assertions pass on the error text rather than on the
# behaviour. Added here and removed at the end of the block.
( cd "$REPO" && git remote add origin https://github.com/example/widget.git ) 2>/dev/null
_unatt() { ( cd "$REPO" && PATH="$UNB:$PATH" "$FELIX" unattended 2>&1 ); }
# Asserted, not assumed: if the command still cannot run, everything below is
# testing an error message.
has "the readiness report runs at all" "$(_unatt)" "repo:"

cp "$FROOT/projects/widget/risk.tsv" "$TMP/risk.unatt.keep" 2>/dev/null || : > "$TMP/risk.unatt.keep"

# A table that declares red paths: the bound exists and the row may say so.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
} > "$FROOT/projects/widget/risk.tsv"
# The ROW, not the whole report. A glob like *"[x]"*"scope bound"* matches
# because `[x] api key` appears earlier in the output, so it was true whatever
# the scope row said.
_row() { printf '%s\n' "$1" | grep -F "$2" | head -1; }
out="$(_unatt)"
has "a project with red paths reports the scope bound" "$(_row "$out" 'scope bound')" "[x]"

# A table with no red path at all: nothing is refused, so nothing is bound.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'green\tpath\t^docs/\tprose\n'
} > "$FROOT/projects/widget/risk.tsv"
out="$(_unatt)"
case "$(_row "$out" 'scope bound')" in
  *"[x]"*) bad "and a project with none does not claim it" "$(_row "$out" 'scope bound')" ;;
  *)       ok  "and a project with none does not claim it" ;;
esac
has "saying what is missing" "$out" "no red rule"

# Content rules bound scope exactly as path rules do (#100) — felix scope
# classifies the whole diff and refuses on either kind. Counting paths alone
# told a project whose red tier is all content rules — secrets, destructive
# SQL, the material the red tier exists for — that nothing was out of scope,
# on the checklist read before switching on unattended model runs. another governed project
# declares 2 red content rules today.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tcontent\tDROP[[:space:]]+TABLE\tdestructive sql\n'
} > "$FROOT/projects/widget/risk.tsv"
out="$(_unatt)"
has "a project bounded only by content rules reports the bound" \
    "$(_row "$out" 'scope bound')" "[x]"

# The budget row must not read as a satisfied precondition, because whether the
# ceiling survives where the loop runs is not something this can check.
case "$(_row "$out" 'budget ceiling')" in
  *"[x]"*) bad "the budget row is not reported as satisfied" "$(_row "$out" 'budget ceiling')" ;;
  *)       ok  "the budget row is not reported as satisfied" ;;
esac
has "and is marked unknown rather than unmet" "$(_row "$out" 'budget ceiling')" "[?]"
# And it reads the ledger rather than only the configured number, so the row
# says what has been spent and not merely what was declared.
has "and reports what has been spent" "$out" "spent"

cp "$TMP/risk.unatt.keep" "$FROOT/projects/widget/risk.tsv"
( cd "$REPO" && git remote remove origin ) 2>/dev/null

printf '\ngenerated CI points at a path that exists\n'
# Moving the engine broke every generated workflow at once, in other
# repositories, where this suite never looks. Felix's own gate stayed green
# because it tests Felix. The caller lived elsewhere.
#
# So the generator's output is checked against the filesystem: whatever path it
# tells CI to run must actually resolve inside the engine.
gen="$( . "$FROOT/engine/harness/lib/detect.sh" 2>/dev/null || . "$FROOT/harness/lib/detect.sh"
        . "$FROOT/engine/harness/lib/bootstrap.sh" 2>/dev/null || . "$FROOT/harness/lib/bootstrap.sh"
        felix_bs_render_workflow node someone/repo )"
has "the workflow invokes felix" "$gen" "harness/felix"
felix_path="$(printf '%s' "$gen" | grep -oE '\.\./felix/[a-z/]*harness/felix' | head -1)"
resolved="${felix_path#../felix/}"
# Checked against the real checkout, not the fixture. A generated workflow runs
# against a clone of the actual repository, so that is the layout that has to be
# right, and the fixture flattens the engine in a way no clone does.
REAL_ROOT="$(cd "$REAL_HARNESS/../.." && pwd)"
if [ -x "$REAL_ROOT/$resolved" ]; then
  ok "and that path resolves in a real checkout"
else
  bad "and that path resolves in a real checkout" "generated $resolved, absent from $REAL_ROOT"
fi

printf '\nmistakes record themselves\n'
# Judgement at write time is the wrong shape: it asks for a decision at the exact
# moment someone is trying to finish something else. Write cheaply, curate later.
MISLOG="$MEM/widget/mistakes.log"
rm -f "$MISLOG"
# A script rather than an inline command: project.json holds no escaped quotes,
# which its reader documents that it cannot parse, and a gate script is the more
# common shape anyway.
cat > "$FROOT/projects/widget/failing-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
exit 1
GS
chmod +x "$FROOT/projects/widget/failing-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="failing-gate.sh"
p.write_text(json.dumps(d,indent=2))
PYJ
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a failing gate still exits non-zero" "$rc" "1"
[ -f "$MISLOG" ] && ok "and records the failure without being asked" \
                 || bad "and records the failure without being asked"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "naming which check failed" || bad "naming which check failed"

# The same tree gated again is the same occasion. It cost a second run, and a
# run is not a recurrence: this rank's advice is to write a lesson, and there
# is nothing to generalise from one incident. Felix's own log had `ecosystem`
# five times, every one of them the same branch at the same sha, ranked beside
# `installed` at twenty-two separate commits.
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
case "$out" in
  *lint*) bad "one tree gated twice is one occasion, not a habit" "$out" ;;
  *)      ok  "one tree gated twice is one occasion, not a habit" ;;
esac
# A second tree is. Same failure, different commit — which is what "again"
# means and what a lesson would be generalising over.
( cd "$REPO" && printf 'again\n' >> README.md && git add -A \
  && git -c user.name=t -c user.email=t@t commit -qm second ) >/dev/null 2>&1
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
has "a second tree makes it a promotion candidate" "$out" "the gate keeps catching"
has "and names the habit"                          "$out" "lint"
# Both numbers, because they are not the same fact: two trees, three runs.
has "counted in occasions"           "$out" "2    lint"
has "with the runs it cost beside it" "$out" "(3 run(s))"

# A check that could not have passed did not catch anything.
#
# Felix's `installed` check compares the tree against the deployed plugin cache.
# In a worktree that can never match — the marketplace is pinned to one path, so
# a worktree's engine is not the one being served — and every gate run there
# recorded `installed` as a mistake. The count went 9 to 11 during the session
# that fixed the recurrence report, and it sat at the top of `felix next` rank 5
# under "already cost time more than once", where the advice is to go and build
# a mechanism. The check manufactured the evidence that ranked it.
#
# The verdict is deliberately NOT changed: the gate still fails, because the
# tree genuinely does not match, and loosening a gate to quiet a report is the
# move this project warns about in the definition of its own objective. Only the
# RECORD changes. A gate may mark a failure as a property of where it ran rather
# than of the work, and the engine subtracts those from what it writes down
# without learning any check's name — the project's own gate declares it.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
chmod +x "$FROOT/projects/widget/structural-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="structural-gate.sh"; p.write_text(json.dumps(d,indent=2))
PYJ
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a structural failure still fails the gate" "$rc" "1"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "an ordinary failure is still written down" \
  || bad "an ordinary failure is still written down" "$(cat "$MISLOG")"
grep -q 'deployed' "$MISLOG" 2>/dev/null \
  && bad "but one that could not have passed is not" "$(cat "$MISLOG")" \
  || ok  "but one that could not have passed is not"

# And when EVERY failure was structural, nothing is written — not even the
# exit-status fallback. The first version of this fixed the named check and then
# recorded `exit-1` instead, which is the same permanent row wearing a less
# informative name. Caught by running the real gate in a real worktree, which is
# where the case lives; the suite had passed.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "an all-structural gate still fails"           "$rc" "1"
is "and writes no row at all, not even exit-1"    "$(wc -l < "$MISLOG" | tr -d ' ')" "0"

# The contract, against the line the SHIPPED gate actually prints.
#
# Everything above proves the mechanism with a line the fixture writes itself,
# so it stayed green while the real marker was renamed out from under it: #115
# rewrote `FAIL (structural: ...)` into `FAIL (drift, in a tree that cannot
# deploy: ...)` to stop the message misdiagnosing a stray, and the engine
# greps for `structural`. Every worktree gate failure went back to recording a
# mistake — the manufactured evidence issue #3 was filed for — and it put
# `installed` at the top of `felix next` on a count that was 16 of 20
# work-in-progress branches. Two files, one string between them, and nothing
# joined them up. This renders the gate's own format and drives it through the
# real recording path.
_REALG3="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/gate.sh"
if [ -f "$_REALG3" ]; then
  _sfmt="$(grep -F 'FAIL (' "$_REALG3" | grep -F 'marketplace serves' | head -1 \
           | sed "s/^[[:space:]]*printf '//; s/'[[:space:]]*installed.*$//")"
  if [ -n "$_sfmt" ]; then
    _sline="$(printf "$_sfmt" installed /some/marketplace 2>/dev/null)"
    has "the shipped gate marks its undeployable failure" "$_sline" "installed"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" %s\nexit 1\n' "$(printf '%q' "$_sline")" \
      > "$FROOT/projects/widget/structural-gate.sh"
    : > "$MISLOG"
    ( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
    is "and it still fails the gate"             "$rc" "1"
    is "and the engine writes no mistake for it" "$(wc -l < "$MISLOG" | tr -d ' ')" "0"
  else
    skip "the shipped gate marks its undeployable failure" "no such line in the gate"
    skip "and it still fails the gate"                     "no such line in the gate"
    skip "and the engine writes no mistake for it"         "no such line in the gate"
  fi
else
  skip "the shipped gate marks its undeployable failure" "no shipped gate"
  skip "and it still fails the gate"                     "no shipped gate"
  skip "and the engine writes no mistake for it"         "no shipped gate"
fi

# A gate that names nothing still falls back, because then the status is all
# anybody knows.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "something went wrong but no check is named"
exit 3
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
grep -q 'exit-3' "$MISLOG" 2>/dev/null \
  && ok "a gate naming no check still records its status" \
  || bad "a gate naming no check still records its status" "$(cat "$MISLOG")"

# A passing gate must not record anything, or the signal is just a run counter.
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="true"; p.write_text(json.dumps(d,indent=2))
PYJ
before="$(wc -l < "$MISLOG")"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
is "a passing gate records nothing" "$(wc -l < "$MISLOG")" "$before"

printf '\ngenerated constitution\n'
CDIR="$FROOT/projects/stranger"
[ -s "$CDIR/CLAUDE.md" ] && ok "onboarding writes one" || bad "onboarding writes one"
has "it names the verification command" "$(cat "$CDIR/CLAUDE.md")" "felix gate"
has "and what was detected"             "$(cat "$CDIR/CLAUDE.md")" "billing"
# The invariants are the part that cannot be generated, and the file says why
# rather than pretending or leaving a bare TODO.
has "invariants say where they come from" "$(cat "$CDIR/CLAUDE.md")" "earned rather"
case "$(cat "$CDIR/CLAUDE.md")" in
  *"Replace this"*) bad "no placeholder telling someone to write it" "still a stub" ;;
  *) ok "no placeholder telling someone to write it" ;;
esac

printf '\nlessons are mounted, not offered\n'
cat > "$MEM/widget/lessons.md" <<'LES'
# widget lessons

## Checklist
1. run the gate
2. update the devlog

## Seeded principles
- **L-1 Migrations need a rollback path.** Long evidence about a migration that
  went wrong, with detail nobody needs mounted on every single turn.
- **L-2 Browser tests belong on critical flows.** More evidence, equally long,
  equally irrelevant until someone is actually touching the browser layer.
LES

out="$(cd "$REPO" && "$FELIX" lessons --for "changing a migration" 2>&1)"
has "matches the relevant lesson"   "$out" "L-1"
case "$out" in *"L-2"*) bad "and not the irrelevant one" "$out" ;; *) ok "and not the irrelevant one" ;; esac
has "the always-applicable part is shown" "$out" "run the gate"

# The evidence is why a lesson is believed; the claim is what needs mounting.
# Injecting the evidence every turn is how a helpful injection becomes ignored.
case "$out" in
  *"Long evidence about"*) bad "only the claim is mounted, not the evidence" "$out" ;;
  *) ok "only the claim is mounted, not the evidence" ;;
esac

out="$(cd "$REPO" && "$FELIX" lessons --for "unrelated quantum teleportation" 2>&1)"
has "an unrelated context matches nothing" "$out" "nothing matched"

printf '\nthe prompt hook\n'
HK="$FROOT/harness/hooks/user-prompt"
out="$(cd "$REPO" && printf '{"prompt":"fix the migration rollback"}' | "$HK" 2>&1)"
case "$out" in
  *'"hookSpecificOutput"'*) ok "emits the documented UserPromptSubmit shape" ;;
  *) bad "emits the documented UserPromptSubmit shape" "$out" ;;
esac
ctx="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>&1)"
has "carries the matched lesson" "$ctx" "L-1"
# Bounded. A hook that floods the turn is a hook people learn to skim past.
lines="$(printf '%s\n' "$ctx" | wc -l | tr -d ' ')"
[ "$lines" -le 20 ] && ok "and stays small" \
                    || bad "and stays small" "$lines lines is too much for every turn"

out="$(cd "$PLAIN" && printf '{"prompt":"anything"}' | "$HK" 2>&1)"; rc=$?
is "silent in an ungoverned repo" "${#out}" "0"
is "and exits 0 there"            "$rc" "0"

mv "$MEM/widget/lessons.md" "$TMP/lessons.bak"
out="$(cd "$REPO" && printf '{"prompt":"fix the migration"}' | "$HK" 2>&1)"
is "silent when a project has no lessons yet" "${#out}" "0"
mv "$TMP/lessons.bak" "$MEM/widget/lessons.md"

printf '\npipefail safety\n'
# Regression. Every presence check used to be `producer | grep -q x`, which under
# `set -o pipefail` reports 141 because grep exits on match and the producer takes
# SIGPIPE. The check then says absent about something present, and it is
# timing-dependent, so small producers pass and a real repository fails.
big="$(seq 1 200000)"
# Deliberately not asserting that `producer | grep -q x` fails here. It fails
# only when the producer is still writing when grep exits, so the assertion is a
# race and flakes. The reason the helpers exist is recorded above instead.
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_contains "$big" "199999" ); then
  ok "felix_contains survives a large haystack under pipefail"
else
  bad "felix_contains survives a large haystack under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "$big" "199999" ) ; then
  ok "felix_has_line matches whole lines under pipefail"
else
  bad "felix_has_line matches whole lines under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "alpha
beta" "alph" ); then
  bad "felix_has_line rejects partial lines" "matched a prefix"
else
  ok "felix_has_line rejects partial lines"
fi

printf '\nthe completion gate\n'
# The principle under test: an agent must not be able to say it is finished
# while the tree it changed has never been verified. Everything here drives the
# real Stop hook with real JSON on stdin, against a real git repository.
STOP="$FROOT/harness/hooks/stop"
# Earlier sections rewrite the widget gate to prove other things, so this one
# declares the gate it depends on instead of inheriting whatever ran last.
# Without this the red-gate case silently tests a gate of `true`, which cannot
# fail, and the failure reads like a product bug rather than a suite bug.
cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
GREPO="$TMP/gaterepo"
mkdir -p "$GREPO"
( cd "$GREPO" && git init -q -b main
  printf 'contents\n' > WIDGET.txt
  printf 'widget\n'   > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1 )
GREPO="$(cd "$GREPO" && pwd -P)"

EMPTY_JSON='{"hook_event_name":"Stop","stop_hook_active":false}'
ACTIVE_JSON='{"hook_event_name":"Stop","stop_hook_active":true}'
_stop() { ( cd "$1" && printf '%s' "${2:-$EMPTY_JSON}" | "$STOP" 2>&1 ); }
_blocks() {
  case "$2" in *'"decision"'*'"block"'*) ok "$1" ;; *) bad "$1" "expected a block, got [$2]" ;; esac
}
_allows() { [ -z "$2" ] && ok "$1" || bad "$1" "expected silence, got [$2]"; }

out="$(_stop "$GREPO")"; rc=$?
_allows "a session that changed nothing stops silently" "$out"
is      "and exits 0"                                   "$rc" "0"

# The guidebook states DEFINITION OF DONE absolutely: never declare a task
# complete while a required deterministic verification step is failing. The hook
# opened with a bare `felix_tree_dirty || exit 0`, so committing your work
# skipped the check entirely — and committing is what you do at the end. Every
# session that finished properly was the one never asked.
#
# "Dirty" was standing in for "this session changed something", and those come
# apart the moment anybody commits. SessionStart now records the HEAD it saw, so
# the two can be told apart.
SESS='{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"dod-sess"}'
# Laid by the real hook rather than hand-written, so the test exercises the
# path that actually runs. UserPromptSubmit carries the session id;
# SessionStart never reads its payload at all.
_start_at() {
  rm -f "$FROOT/state/session/dod-sess"
  ( cd "$1" && printf '{"session_id":"dod-sess","prompt":"begin"}' \
      | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
}

_start_at "$GREPO"
out="$(_stop "$GREPO" "$SESS")"
_allows "a recorded session that committed nothing is still silent" "$out"

printf 'committed work\n' >> "$GREPO/WIDGET.txt"
( cd "$GREPO" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm work >/dev/null 2>&1 )
out="$(_stop "$GREPO" "$SESS")"
_blocks "committing unverified work no longer skips the check" "$out"
has     "and says the gate has not seen it"                    "$out" "gate"

# Fail open when there is no record: a session that began before this shipped,
# or one whose id could not be read, must not start blocking on a clean tree.
out="$(_stop "$GREPO" "$EMPTY_JSON")"
_allows "with no session record it behaves as before" "$out"
rm -f "$FROOT/state/session/dod-sess"

# Restore the fixture for the assertions below, which expect an unverified edit.
( cd "$GREPO" && git reset -q --hard HEAD~1 )

printf 'edited\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "an unverified change blocks completion" "$out"
has     "and says the gate never ran"            "$out" "never"

# The table is written BEFORE the gate runs. stack.tsv is in the epoch's
# policy set, and a receipt is bound to the epoch its gate ran under (v3.2
# §5), so a table edited after the gate stales the receipt and the stop below
# would block on "the table set moved" — correctly — instead of reaching the
# nudge this is about.
printf 'plugin\tsuperpowers@x\t-\tlow\talways\n' > "$FROOT/projects/widget/stack.tsv"
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_allows "a green gate on this exact tree allows it" "$out"

# A green gate proves the suite passed and nothing about the claims made on the
# way there. Those are what go wrong: work reported as fixed that reached no
# session, a tool reported as removed that was still installed, a document
# describing a capability the thing had outgrown. All three passed a gate.
rm -rf "$FROOT/state/verified"
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess"}' \
       | "$STOP" 2>&1)"
has "a green gate still asks for verification" "$out" "verification-before-completion"
has "and says why the gate is not enough"      "$out" "does not mean"
has "and says the suite passed when nothing was skipped" "$out" "which means the suite passed"
# Once per session. Said at every stop it becomes noise, and noise is skimmed.
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess"}' \
       | "$STOP" 2>&1)"
case "$out" in
  *verification-before-completion*) bad "and only once per session" "$out" ;;
  *)                                ok  "and only once per session" ;;
esac

# And the sentence does NOT claim a passing suite when the gate skipped it.
# `felix gate --quick` skips the tests and still exits 0, so its receipt was
# byte-identical to a full run's — one bit — and this said "the suite passed"
# over it. The receipt's fifth field names what the gate reported skipping.
# Placed after the once-per-session assertion above, not before it: clearing
# the marker is what that assertion measures, so a block that clears it in the
# middle makes the sentence fire twice and reads as a defect in the hook rather
# than in the fixture.
rm -rf "$FROOT/state/verified"
( cd "$GREPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$GREPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$GREPO" "$FROOT")" "tests" >/dev/null 2>&1 )
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess-skip"}' \
       | "$STOP" 2>&1)"
has "a gate that skipped the suite is not called a passing suite" "$out" "it skipped: tests"
case "$out" in
  *"which means the suite passed"*) bad "and the claim it could not support is gone" "$out" ;;
  *)                                ok  "and the claim it could not support is gone" ;;
esac
( cd "$GREPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$GREPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$GREPO" "$FROOT")" "" >/dev/null 2>&1 )
# A project that does not use superpowers is not told to reach for it.
printf 'plugin\tsomething-else@x\t-\tlow\talways\n' > "$FROOT/projects/widget/stack.tsv"
rm -rf "$FROOT/state/verified"
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess2"}' \
       | "$STOP" 2>&1)"
case "$out" in
  *verification-before-completion*) bad "and never where it is not declared" "$out" ;;
  *)                                ok  "and never where it is not declared" ;;
esac
rm -rf "$FROOT/state/verified"

# The git-status trap. Two different edits to the same file produce identical
# porcelain output, so a receipt keyed on status alone stays valid across a
# change it never saw. The hash has to include diff content.
printf 'different\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "editing the same file again invalidates the receipt" "$out"

( cd "$GREPO" && git checkout -q -- WIDGET.txt )
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
printf 'new\n' > "$GREPO/untracked.txt"
out="$(_stop "$GREPO")"
_blocks "a new untracked file invalidates the receipt" "$out"
rm -f "$GREPO/untracked.txt"

# The platform caps consecutive blocks and documents the contract: return
# success while stop_hook_active is set. Ignoring it is how a hook loops.
printf 'unverified\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO" "$ACTIVE_JSON")"
_allows "stop_hook_active is honoured, so it never loops" "$out"

# The flag is a FIELD. The payload also carries the model's last message, and
# a glob for the key followed by `true` anywhere after it was satisfied by a
# message that used the word — an unverified tree whose session ended with
# "that is true" was exempt from its own gate. Found by the review, not by
# the suite, which had only ever sent the flag alone.
out="$(_stop "$GREPO" '{"hook_event_name":"Stop","stop_hook_active":false,"last_assistant_message":"and that is true"}')"
_blocks "the word true in the last message does not read as the flag" "$out"
out="$(_stop "$GREPO" '{"hook_event_name":"Stop","last_assistant_message":"\"stop_hook_active\": true","stop_hook_active":false}')"
_blocks "nor does the key spelt inside a string, which a quote cannot open" "$out"

# The override is the founder's, not the model's: it is read from the
# environment the session was launched with.
out="$(cd "$GREPO" && FELIX_ALLOW_RED=1 printf '%s' "$EMPTY_JSON" | FELIX_ALLOW_RED=1 "$STOP" 2>&1)"
_allows "FELIX_ALLOW_RED lets a founder stop anyway" "$out"

# A failing gate must leave a red receipt, not no receipt. No receipt and a red
# one both block, but only one of them tells the truth about what happened.
rm -f "$GREPO/WIDGET.txt"
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_blocks "a failing gate still blocks"  "$out"
has     "and says the gate failed"     "$out" "failed"
printf 'contents\n' > "$GREPO/WIDGET.txt"

VLOG="$MEM/widget/verification.log"
[ -s "$VLOG" ] && ok "every decision is recorded" \
               || bad "every decision is recorded" "no verification.log at $VLOG"
if [ -s "$VLOG" ]; then
  grep -q 'blocked'  "$VLOG" && ok "blocks are recorded"    || bad "blocks are recorded"
  grep -q 'override' "$VLOG" && ok "overrides are recorded" || bad "overrides are recorded"
fi

out="$(_stop "$PLAIN")"; rc=$?
_allows "silent in an ungoverned repo" "$out"
is      "and exits 0 there"            "$rc" "0"

NOGIT="$TMP/notgit"; mkdir -p "$NOGIT"; printf 'widget\n' > "$NOGIT/.felix"
out="$(_stop "$NOGIT")"; rc=$?
_allows "silent outside a git repository" "$out"
is      "and exits 0 there too"           "$rc" "0"

printf '\nthe binding itself\n'
# `echo nonexistent > .felix` used to disable the entire floor. The marker is
# tracked, `felix_resolve_project` returned non-zero the moment the named
# project directory was missing, and every hook reads a non-zero resolve as
# "ungoverned" and exits 0. No gate, no hold, no record. `$HOME/.felix-home`
# does the same from outside every repository, so breaking it leaves no diff to
# review and no escape channel at all.
#
# The distinction this section holds, and it is the whole fix. An ABSENT
# binding means the directory is not governed: correct, and it must keep
# working, because Felix has to stay usable in a repository it does not govern.
# A binding that is PRESENT and does not resolve means somebody broke it, and
# this project's own rule is that "nothing due" and "nothing is being checked"
# must not render identically.
BROKEN="$TMP/brokenmarker"; mkdir -p "$BROKEN"
( cd "$BROKEN" && git init -q -b main
  printf 'contents\n' > WIDGET.txt
  printf 'nonexistent\n' > .felix
  git add -A; git -c user.name=t -c user.email=t@t commit -qm init ) >/dev/null 2>&1
BROKEN="$(cd "$BROKEN" && pwd -P)"

out="$(_stop "$BROKEN")"; rc=$?
_blocks "an unresolvable marker refuses instead of exiting clean" "$out"
has     "and quotes the name the marker asks for"  "$out" "nonexistent"
is      "and still returns success, so it cannot loop" "$rc" "0"

# Present and naming nothing is the same fact as present and naming something
# absent: a file exists whose entire job is to say which project governs here,
# and it does not say one.
printf '\n' > "$BROKEN/.felix"
out="$(_stop "$BROKEN")"
_blocks "an empty marker refuses too" "$out"

# `.` and `..` are directories, and `-d projects/.` is true. A marker reading
# `.` resolved to a healthy binding at the projects directory itself — a
# project with no tables, no deny rows and no gate — and every hook read the
# tree as governed. A name is one directory name; a dot or a path is not one.
for _dotname in '.' '..' '../widget' 'widget/..'; do
  printf '%s\n' "$_dotname" > "$BROKEN/.felix"
  out="$(_stop "$BROKEN")"
  _blocks "a marker naming '$_dotname' refuses rather than binding to the projects directory" "$out"
done
has "and says what a project name is" "$out" "not a project name"
out="$(cd "$BROKEN" && "$FELIX" which 2>&1)"
case "$out" in
  *"project:      "*) bad "and felix which does not resolve it" "$out" ;;
  *)                  ok  "and felix which does not resolve it" ;;
esac
out="$("$FELIX" new ../escaped 2>&1)"; rc=$?
is  "felix new refuses the same names the marker refuses" "$rc" "1"
has "and says what a name is" "$out" "one directory name"

# A refusal nothing records is indistinguishable from a hook that never ran,
# and the project this belongs to is precisely what could not be resolved — so
# it lands at the memory root, which belongs to no project.
grep -q 'nonexistent' "$MEM/unresolved.log" 2>/dev/null \
  && ok  "the refusal is recorded where no project is known" \
  || bad "the refusal is recorded where no project is known" "nothing in $MEM/unresolved.log"

# The half that must not regress. No marker at all, no remote to match: this is
# a repository Felix does not govern, and silence is the correct answer even
# with unverified work sitting in the tree.
NOMARK="$TMP/nomarker"; mkdir -p "$NOMARK"
( cd "$NOMARK" && git init -q -b main && printf 'x\n' > a.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm i ) >/dev/null 2>&1
printf 'unverified\n' >> "$NOMARK/a.txt"
out="$(_stop "$NOMARK")"; rc=$?
_allows "an absent marker still means ungoverned" "$out"
is      "and exits 0 with the tree dirty"         "$rc" "0"

# And a marker that resolves is never the broken one, whatever else the hook
# decides about the tree.
printf 'widget\n' > "$BROKEN/.felix"
out="$(_stop "$BROKEN")"
case "$out" in
  *"does not resolve"*) bad "a marker that resolves is not called broken" "$out" ;;
  *)                    ok  "a marker that resolves is not called broken" ;;
esac

# The home pointer, which is the same defect one level up and worse: it sits
# outside every repository, so changing it produces no diff, no classification
# and nothing for a reviewer to see.
POINTHOME="$TMP/pointerhome"; mkdir -p "$POINTHOME" "$TMP/not-a-felix-home"
_stop_as_home() {
  ( cd "$1" && printf '%s' "$EMPTY_JSON" | env -u FELIX_HOME HOME="$2" "$STOP" 2>&1 )
}
printf '%s\n' "$TMP/not-a-felix-home" > "$POINTHOME/.felix-home"
out="$(_stop_as_home "$GREPO" "$POINTHOME")"
_blocks "a home pointer naming something that is not a home refuses" "$out"
has     "and says which directory it was sent to" "$out" "not-a-felix-home"

printf '%s\n' "$TMP/no-such-directory-at-all" > "$POINTHOME/.felix-home"
out="$(_stop_as_home "$GREPO" "$POINTHOME")"
_blocks "so does a pointer naming a directory that is gone" "$out"

# Absent is absent here too. With no pointer the resolver falls back the way it
# always has, and nothing about that is broken.
rm -f "$POINTHOME/.felix-home"
out="$(_stop_as_home "$GREPO" "$POINTHOME")"
case "$out" in
  *"is not a Felix home"*) bad "an absent pointer is not a broken pointer" "$out" ;;
  *)                       ok  "an absent pointer is not a broken pointer" ;;
esac

# A pointer that names a real home is the ordinary case and must stay quiet.
printf '%s\n' "$FROOT" > "$POINTHOME/.felix-home"
out="$(_stop_as_home "$GREPO" "$POINTHOME")"
case "$out" in
  *"is not a Felix home"*) bad "a pointer to a real home is left alone" "$out" ;;
  *)                       ok  "a pointer to a real home is left alone" ;;
esac
rm -f "$POINTHOME/.felix-home"

# The other half of the same hole, and the half a session meets FIRST.
#
# hooks/stop refuses a broken binding, so a session that has one runs
# completely unprotected and only finds out at the very end. Every other hook
# still reads a non-zero resolve as "ungoverned" and exits 0, so the start of
# the session — the one other moment this project's doctrine allows Felix to
# speak — said nothing at all.
#
# It reports; it does not refuse. session-start is a pure text channel with no
# decision to make and no way to strand anybody, which is what makes it safe to
# speak from at the earliest point the fact can be known. PreToolUse is the
# tempting third place and is deliberately not wired: the remedy for a broken
# binding is editing the marker or running felix install, so a refusal there
# would refuse its own repair, with no stop_hook_active cap and no
# FELIX_ALLOW_RED to escape through.
_start() { ( cd "$1" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1 ); }
_start_as_home() {
  ( cd "$1" && env -u FELIX_HOME HOME="$2" CLAUDE_PLUGIN_ROOT="$FROOT" \
      "$FROOT/harness/hooks/session-start" 2>&1 )
}

printf 'nonexistent\n' > "$BROKEN/.felix"
out="$(_start "$BROKEN")"; rc=$?
has "session start reports an unresolvable marker"   "$out" "does not resolve"
has "and quotes the name the marker asks for"        "$out" "nonexistent"
is  "and still exits 0, because start cannot refuse" "$rc"  "0"
# additionalContext reaches the model and never the terminal. A founder whose
# floor is switched off learns nothing from a channel they cannot see, and this
# is the one surface Felix has to tell them.
has "and says it where the founder can see it"       "$out" "systemMessage"
# A resume was never bound before, so a broken binding said nothing there, and
# binding it must not start: the resume exit comes before this report.
out="$(cd "$BROKEN" && printf '{"source":"resume"}' | CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
is  "a resume on a broken binding stays as silent as before it was bound" "${#out}" "0"

printf '\n' > "$BROKEN/.felix"
out="$(_start "$BROKEN")"
has "an empty marker is reported at session start too" "$out" "does not resolve"

# The pointer is the worse surface: it sits outside every repository, so
# breaking it leaves no diff, and it decides which home the marker below is
# resolved against.
printf '%s\n' "$TMP/not-a-felix-home" > "$POINTHOME/.felix-home"
out="$(_start_as_home "$GREPO" "$POINTHOME")"
has "session start reports a broken home pointer" "$out" "is not a Felix home"
rm -f "$POINTHOME/.felix-home"

# The half that must not regress, and it is the whole reason this reports
# rather than refuses. An absent marker is a repository Felix does not govern,
# and a hook that spoke there would make Felix unusable everywhere it has not
# been adopted.
out="$(_start "$NOMARK")"; rc=$?
case "$out" in
  *"does not resolve"*) bad "an absent marker is still silent at session start" "$out" ;;
  *)                    ok  "an absent marker is still silent at session start" ;;
esac
is "and exits 0 in a repository Felix does not govern" "$rc" "0"

# And a binding that resolves gets the ordinary governed context, not this.
printf 'widget\n' > "$BROKEN/.felix"
out="$(_start "$BROKEN")"
case "$out" in
  *"does not resolve"*)           bad "a marker that resolves gets the normal context" "$out" ;;
  *"Felix governs this session"*) ok  "a marker that resolves gets the normal context" ;;
  *)                              bad "a marker that resolves gets the normal context" "$out" ;;
esac

# A project that declares no gate has nothing to enforce, and inventing an
# obligation for it would make Felix unusable on a repo mid-onboarding.
mkdir -p "$FROOT/projects/nogate" "$MEM/nogate"
printf '{\n  "name": "nogate"\n}\n' > "$FROOT/projects/nogate/project.json"
NGREPO="$TMP/nogaterepo"; mkdir -p "$NGREPO"
( cd "$NGREPO" && git init -q -b main && printf 'x\n' > a.txt
  git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
printf 'nogate\n' > "$NGREPO/.felix"; printf 'dirty\n' >> "$NGREPO/a.txt"
out="$(_stop "$NGREPO")"
_allows "a project with no declared gate is left alone" "$out"

# Felix governs projects in languages it does not know, and one of their
# untracked directories may be a virtualenv or a model artifact. Metadata only.
mkdir -p "$GREPO/bigdir"
i=0; while [ "$i" -lt 60 ]; do printf 'x\n' > "$GREPO/bigdir/f$i"; i=$((i+1)); done
t0=$(date +%s); out="$(_stop "$GREPO")"; t1=$(date +%s)
[ $((t1-t0)) -le 3 ] && ok "stays fast with many untracked files" \
                     || bad "stays fast with many untracked files" "$((t1-t0))s"
rm -rf "$GREPO/bigdir"

# The gate and the hook compute tree identity independently. If they ever
# disagree the gate silently stops counting, so they must share one function.
tid_lib="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ -n "$tid_lib" ] && ok "tree identity is computable" \
                  || bad "tree identity is computable" "empty"
printf 'moved\n' >> "$GREPO/WIDGET.txt"
tid2="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ "$tid_lib" != "$tid2" ] && ok "and changes when the tree changes" \
                          || bad "and changes when the tree changes" "$tid_lib == $tid2"
( cd "$GREPO" && git checkout -q -- WIDGET.txt )

# A repository with no commits at all. HEAD is unborn, and every naive
# implementation of this dies there. The suite's own fixture is in that state.
UNBORN="$TMP/unborn"; mkdir -p "$UNBORN"
( cd "$UNBORN" && git init -q -b main )
printf 'widget\n' > "$UNBORN/.felix"; printf 'x\n' > "$UNBORN/new.txt"
tid3="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$UNBORN" )"
[ -n "$tid3" ] && ok "tree identity survives an unborn HEAD" \
               || bad "tree identity survives an unborn HEAD" "empty"
out="$(_stop "$UNBORN")"; rc=$?
is "and the hook still exits 0 there" "$rc" "0"

# Felix governing itself: the home lives INSIDE the tree being gated, so every
# receipt, verification line and route line lands in the repo it describes.
# Writing a receipt then changes the tree, which invalidates the receipt just
# written, and no gate run can ever produce a valid one. The fixture above hides
# this entirely because there the home sits outside the governed repo — which is
# why this reproduces the real layout instead.
SELF="$TMP/selfgoverned"
mkdir -p "$SELF/projects/self" "$MEM/self" "$SELF/harness"
cp -R "$REAL_HARNESS/." "$SELF/harness/"
cat > "$SELF/projects/self/project.json" <<'EOF'
{ "name": "self", "gate": "true" }
EOF
printf '# self\n' > "$SELF/projects/self/CLAUDE.md"
# One probe, so the receipt the gate writes carries an epoch: a project that
# declares none has a receipt resting on nothing Felix reads, and that is
# stale by design rather than a fixture that happens to pass.
printf 'code\t-\t-\tgit ls-files\ttest -e .git\n' > "$SELF/projects/self/probes.tsv"
( cd "$SELF" && git init -q -b main && printf 'x\n' > code.txt && printf 'self\n' > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
SELF="$(cd "$SELF" && pwd -P)"
printf 'real work\n' >> "$SELF/code.txt"
( cd "$SELF" && FELIX_HOME="$SELF" "$SELF/harness/felix" gate >/dev/null 2>&1 )
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "a receipt survives being written inside the tree it describes" "$out"
# And a second stop, which appends another verification line, must also pass.
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "and keeps surviving as its own log grows" "$out"
# Real work still has to be verified, bookkeeping exemption or not.
printf 'more real work\n' >> "$SELF/code.txt"
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_blocks "but a real edit still blocks" "$out"

printf '\nthe same gate, for a subagent\n'
# #83. subagent-stop had NO assertions at all — a risk-red hook that runs in
# every session of every governed project, with nothing holding it. That is why
# both halves of this went unnoticed.
#
# It asks the same question `stop` asks and answers it with a raw
# `git status --porcelain`, where stop uses two helpers written precisely
# because that raw test is wrong in both directions. stop's own comment records
# the diagnosis: "A clean tree used to end the hook here, which meant committing
# your work skipped the completion check entirely — and committing is what you
# do at the end." The fix was never carried across.
SUBSTOP="$FROOT/harness/hooks/subagent-stop"
SUB_SID="sub-session-1"
SUB_JSON="{\"hook_event_name\":\"SubagentStop\",\"session_id\":\"$SUB_SID\"}"
_sub() { ( cd "$1" && FELIX_HOME="$2" printf '%s' "$SUB_JSON" \
           | FELIX_HOME="$2" "$SUBSTOP" 2>&1 ); }
# The matcher is the new sentence's claim — the checkout's state, not the
# subagent's conduct. SubagentStop carries the parent's session id and nothing
# about which subagent finished, so "This subagent changed files" asserted a
# fact the hook cannot know, and was false for every read-only subagent after
# the parent's first commit — 48 of Felix's 136 utterances in five days (#97).
_sub_speaks() { case "$1" in *"no gate has passed on"*) return 0 ;; *) return 1 ;; esac; }

SUBR="$TMP/subrepo"; mkdir -p "$SUBR"
( cd "$SUBR" && git init -q -b main
  printf 'widget\n' > .felix
  printf 'contents\n' > WIDGET.txt
  printf 'x\n' > code.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm init ) >/dev/null 2>&1
SUBR="$(cd "$SUBR" && pwd -P)"

# Baseline: a clean tree this session did not touch. Silence is correct, and
# this is the case the raw test got right — kept so a fix cannot buy the two
# below by simply speaking always.
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && bad "an untouched clean tree stays silent" "$out" \
                   || ok  "an untouched clean tree stays silent"

# UNDER-FIRES. The subagent commits its work, which is what you do at the end,
# so the tree is clean and the hook said nothing about an unverified result.
( cd "$SUBR" && printf 'the subagent work\n' >> code.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm "subagent work" ) >/dev/null 2>&1
# The mark the user-prompt hook writes at the start of a session, which is what
# makes "this session committed something" answerable at all.
( . "$FROOT/harness/lib/verify.sh"
  felix_session_mark "$FROOT" "$SUB_SID" "$SUBR" ) >/dev/null 2>&1
( cd "$SUBR" && printf 'more\n' >> code.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm "more work" ) >/dev/null 2>&1
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && ok  "work the subagent committed is still checked" \
                   || bad "work the subagent committed is still checked" "$out"

# The sentence claims what the hook can know — the checkout — and never the
# subagent's own conduct, which the payload does not carry.
case "$out" in
  *"This subagent changed files"*) bad "and the message does not accuse the subagent" "$out" ;;
  *) ok "and the message does not accuse the subagent" ;;
esac
has "it says the fact it has instead" "$out" "no gate has passed on"

# Once per session, not per agent. Three reviewers after one parent commit got
# three copies of a message that was false for all three; the second telling
# of an unchanged fact is pressure, not information.
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && bad "a second hand-off in the same session stays quiet" "$out" \
                   || ok  "a second hand-off in the same session stays quiet"

# OVER-FIRES, the other direction and the same root cause. Only Felix's own
# bookkeeping changed. felix_tree_dirty excludes it deliberately — "a session
# that appended one line to a log has not changed the work" — and the raw
# status test does not.
#
# Run against the SELF fixture, not the one above, and that is the whole point
# of the case rather than a detail: _felix_tree_excludes returns nothing unless
# the home sits inside the tree being judged. A governed product has its home
# elsewhere and nothing to exclude; Felix governing itself is the layout where
# the exclusion exists and therefore the only layout where ignoring it shows.
# My first attempt used a home with no projects/ at all, so the hook exited on
# an unresolved project and the assertion passed for the wrong reason.
# Committed but deliberately NOT gated. With a green receipt both hooks exit at
# the receipt check and the difference is invisible: felix_tree_id excludes
# bookkeeping too, so appending a log line leaves the receipt valid. The
# over-fire is only reachable on an UNVERIFIED tree, which is exactly the state
# the hook exists to speak about.
( cd "$SELF" && git add -A && git -c user.name=t -c user.email=t@t commit -qm settle ) >/dev/null 2>&1
mkdir -p "$SELF/state"; printf 'a log line\n' >> "$SELF/state/keep.log"
is "the fixture is dirty only in Felix's own bookkeeping" \
   "$( cd "$SELF" && . "$SELF/harness/lib/verify.sh"
       felix_tree_dirty "$SELF" "$SELF" && echo dirty || echo clean )" "clean"
out="$( cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$SUB_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/subagent-stop" 2>&1 )"
_sub_speaks "$out" && bad "but Felix's own bookkeeping is not the subagent's work" "$out" \
                   || ok  "but Felix's own bookkeeping is not the subagent's work"
rm -rf "$SELF/state"

# And a real uncommitted edit still speaks — in a fresh session, because the
# session above has had its one telling. A new session id is a new parent
# integrating reports, and it has not been told anything yet.
( cd "$SUBR" && printf 'uncommitted real work\n' >> code.txt )
SUB_JSON="{\"hook_event_name\":\"SubagentStop\",\"session_id\":\"sub-session-2\"}"
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && ok  "a real uncommitted edit still speaks, in a fresh session" \
                   || bad "a real uncommitted edit still speaks, in a fresh session" "$out"
( cd "$SUBR" && git checkout -q -- code.txt )
SUB_JSON="{\"hook_event_name\":\"SubagentStop\",\"session_id\":\"$SUB_SID\"}"

printf '\na flag is not a positional\n'
# #102. felix --help worked; no SUBCOMMAND handled the flag, 24 take a first
# positional, and the writers took the flag AS the positional: felix adopt
# --help declared a capability named --help, created a setup.tsv whose mere
# presence flips felix setup from "declares no setup steps" to "Nothing
# outstanding.", and minted a memory root named --help. Found as residue - it
# had already happened unprompted on the real machine, at the hour a project
# was being mounted, which is exactly when somebody reaches for --help.
_caps_before="$(cat "$FROOT/projects/widget/capabilities" 2>/dev/null)"
rm -f "$FROOT/projects/widget/setup.tsv"
out="$(cd "$REPO" && "$FELIX" adopt --help 2>&1)"; rc=$?
is  "felix adopt --help answers with usage"        "$rc" "0"
has "and it is the usage text"                     "$out" "The engineering OS"
case "$out" in
  *"declared"*) bad "and declares nothing" "$out" ;;
  *)            ok  "and declares nothing" ;;
esac
is "the capabilities file is untouched" \
   "$(cat "$FROOT/projects/widget/capabilities" 2>/dev/null)" "$_caps_before"
[ -f "$FROOT/projects/widget/setup.tsv" ] \
  && bad "and no setup.tsv appears from asking for help" "created" \
  || ok  "and no setup.tsv appears from asking for help"
[ -d "$MEM/--help" ] \
  && bad "and no memory root named --help is minted" "$MEM/--help exists" \
  || ok  "and no memory root named --help is minted"

# The writers refuse a flag-shaped positional outright, not only -h/--help:
# a mistyped flag must never become a declared capability, a governed project,
# a quarantined plugin, or a lesson matched into every prompt.
out="$(cd "$REPO" && "$FELIX" adopt --yes 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "adopt refuses any flag as a capability" \
                || bad "adopt refuses any flag as a capability" "$out"
out="$(cd "$REPO" && PATH="$CMSTUB:$PATH" "$FELIX" new --force 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "new refuses a flag as a project name" \
                || bad "new refuses a flag as a project name" "$out"
out="$(cd "$REPO" && "$FELIX" lesson --oops 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "lesson refuses a flag as the lesson" \
                || bad "lesson refuses a flag as the lesson" "$out"
# And the bare CLI help path is untouched: no subcommand, flag in slot one.
out="$("$FELIX" --help 2>&1)"; rc=$?
is  "felix --help still answers usage" "$rc" "0"
has "with the usage text"              "$out" "The engineering OS"

printf '\nthe intent router\n'
# Say what you are doing and get the right kit, without naming it. The chain is
# routes.tsv -> profiles.tsv -> stack.tsv, and only the first link is new.
cp "$REAL_HARNESS/templates/routes.tsv"   "$FROOT/projects/widget/routes.tsv"
cp "$REAL_HARNESS/templates/profiles.tsv" "$FROOT/projects/widget/profiles.tsv"
cat > "$FROOT/projects/widget/stack.tsv" <<'EOF'
plugin	frontend-design@claude-plugins-official	-	low	frontend
plugin	playwright@claude-plugins-official	-	low	e2e
skill	impeccable	-	low	frontend
EOF
printf 'frontend\ne2e\n' > "$FROOT/projects/widget/capabilities"

_route() { ( cd "${2:-$REPO}" && "$FELIX" route --for "$1" 2>&1 ); }

out="$(_route "let us build the results page")"
has "a frontend prompt routes to frontend" "$out" "frontend"
has "and names the play in order"          "$out" "frontend-design"
has "with the critique step after it"      "$out" "impeccable"

# The prompt is what you just said; the tree is only where you are standing.
# Without weighting, a dirty frontend tree drags every question toward frontend.
mkdir -p "$REPO/ui"; printf 'x\n' > "$REPO/ui/page.css"
out="$(_route "add a migration for the endpoint schema")"
has "the prompt outweighs the working tree" "$out" "backend"
rm -rf "$REPO/ui"

# Below the threshold nothing is said at all. One stray path token must not be
# enough to decide what you meant.
out="$(_route "ok")"
is "a prompt with no signal says nothing" "${#out}" "0"

# Two corroborating tree tokens do meet the threshold, on purpose. But a route
# the tree chose is a different claim from one you asked for, and presenting the
# second as the first is quietly lying about why.
mkdir -p "$REPO/ui"; printf 'x\n' > "$REPO/ui/page.css"; printf 'x\n' > "$REPO/ui/component.js"
out="$(_route "ok")"
has "the working tree alone can route"       "$out" "frontend"
has "and says so rather than implying I did" "$out" "working tree"
out="$(_route "render the modal component")"
case "$out" in
  *"working tree"*) bad "a typed intent is not labelled a guess" "$out" ;;
  *) ok "a typed intent is not labelled a guess" ;;
esac
rm -rf "$REPO/ui"

out="$(cd "$REPO" && "$FELIX" route --for "let us build the results page" --explain 2>&1)"
has "explain shows the losing routes too" "$out" "build"

# A play entry the project never declared is named, not hidden. It is the seam
# to the discovery slice, and silently dropping it would hide the gap.
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
ghost	nonesuch	frontend	not-declared-anywhere
