! alias . >/dev/null 2>&1 || { unalias .; shopt -u expand_aliases; }
. "$HERE/parts/9990-the-run-stayed-inside-its-temporary-directory.sh"
# The suite's completion marker: tests/red counts a red run only when a line that is exactly "reached" follows its last assertion
# line (#371). The empty line before it is this suite's own, and the red block's marker assertion pins this printf.
printf '\nreached\n'
# What ran, against what is supposed to run (#67): one way only, and counted per name; part 0001 says why.
_ran_counts="$TMP/ran.counts"
_ran_rows < "$FELIX_TEST_RAN" > "$_ran_counts"
if [ "$FELIX_TEST_RECORD" -eq 1 ]; then
  # The manifest, then the mark (whole, or red is ended and not waited for).
  _rcp_mk=written
  cp "$_ran_counts" "$FELIX_TEST_MANIFEST" || _rcp_mk=failed
  [ -z "$_rcp_red" ] || _rcp_mark "$_rcp_mk" "$TMP/manifest.mark"
  printf '  recorded %s assertions to %s\n' \
    "$(awk -F'\t' '{s+=$1} END {print s+0}' "$_ran_counts")" "$FELIX_TEST_MANIFEST"
  # And what red wrote, so the manifest and the count it was shown red with travel in one diff (receipt.sh, `_rcp_red_end`; tests/red): red's status is its own, and a red run that could not be made does not turn a green suite red.
  if [ -n "$_rcp_red" ]; then _rcp_red_end "$TMP/manifest.mark" "$TMP/red.out"
  elif [ "$_rcp_on" -eq 1 ]; then printf '  no tests/red beside this suite: red.tsv not written\n'
  else printf '  no tests/receipt.sh beside this suite: red.tsv not written\n'
  fi
  # Then the record it wrote, judged as a normal run judges it, record mode off for the call (part 1010); the receipt names the tree this run leaves, record files and all.
  if [ "$(type -t _rt_judge)" = function ]; then
    printf '\n%s\n' 'the record this run wrote'
    _rcp_rec="$FELIX_TEST_RECORD"; FELIX_TEST_RECORD=0
    _rt_judge "$REAL_HARNESS/../.."
    FELIX_TEST_RECORD="$_rcp_rec"; _rcp_judged=1
    _ran_rows < "$FELIX_TEST_RAN" > "$_ran_counts"
  else
    printf '  no record judge in this suite: the record is not re-judged\n'
  fi
fi
if [ "$FELIX_TEST_RECORD" -ne 1 ] && [ "${FELIX_TEST_NO_MANIFEST:-0}" = "1" ]; then
  # The red run: this suite is executing inside the base's tree, whose manifest describes the base's assertions, so nothing is compared (tests/red); the line says so rather than reading as a manifest that matched.
  printf '  manifest comparison off (FELIX_TEST_NO_MANIFEST): this is a red run\n'
elif [ -f "$FELIX_TEST_MANIFEST" ]; then
  # Emitted through bad(), so these are `  FAIL` lines, the one channel to a CI log with no workflow change: projects/felix/gate.sh prints a passing suite's last line, greps ^  FAIL on failure; .github/workflows is an escape channel no project can demote.
  _missing=0
  # Read from the files, not through awk -v, which processes backslash escapes, so a name holding one could never equal itself
  # (tests/red; part 0770). One pass: see _manifest_short.
  while IFS=$'\t' read -r want got name; do
    bad "assertion did not run: $name" "expected it $want time(s), reached it $got"
    _missing=$((_missing+1))
  done < <(_manifest_short "$FELIX_TEST_MANIFEST" "$_ran_counts")
  _extra="$(LC_ALL=C comm -13 <(cut -f2 "$FELIX_TEST_MANIFEST" | LC_ALL=C sort -u) \
                              <(cut -f2 "$_ran_counts"        | LC_ALL=C sort -u) | wc -l | tr -d ' ')"
  [ "$_missing" -eq 0 ] \
    && printf '  ok    every assertion in the manifest was reached\n' \
    || printf '  %s assertion(s) in the manifest never ran. Not a failure of the code\n  they name: the suite never got to them on this machine.\n' "$_missing"
  [ "${_extra:-0}" -eq 0 ] || \
    printf '  note  %s assertion(s) ran that the manifest does not list.\n        Re-record with: tests/run --record-assertions\n' "$_extra"
  _rcp_cmp=1
else
  printf '  no manifest yet. Record one with: tests/run --record-assertions\n'
fi
# The receipt, ahead of the summary so that the summary stays the last line of the log (the gate shows that line), with no say in the exit status: reached only by a run whose every part was sourced and which printed `reached` (receipt.sh).
[ "$_rcp_on" -ne 1 ] || _rcp_finish "$_rcp_root" "$FELIX_TEST_RECORD" "$_rcp_cmp" "$_rcp_judged" "$PASS" "$FAIL" "$SKIP"
printf '\n%d passed, %d failed' "$PASS" "$FAIL"
[ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
[ "$_suite_jobs" -le 1 ] || printf ' (counted from lines)'
printf '\n'
[ "$FAIL" -eq 0 ] || exit 1
