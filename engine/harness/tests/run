#!/usr/bin/env bash
# Felix harness self-test. The claim it tests, that Felix governs a project it knows nothing about, is in part 0004.
#   harness/tests/run                       the suite
#   harness/tests/run --record-assertions   the suite, the manifest, red.tsv, then the record judged
#   harness/tests/run --reuse               say the last run on this tree stands, or run
#   harness/tests/run -j N | --part NAME... N units at a time | some parts alone (contract D)
# Exit 1 when an assertion failed in the main shell, a record run's judged record included.
set -uo pipefail
# The caller's environment must not change what a tool prints. Why: the comment above the same lines in engine/harness/felix.
set +o allexport +o errexit +o keyword +o noclobber +o noglob +o physical
export -n SHELLOPTS BASHOPTS
_FELIX_CALLER_CDPATH="${CDPATH-}"
unset GREP_OPTIONS CLICOLOR_FORCE GH_FORCE_TTY TAPE TAR_OPTIONS TAR_READER_OPTIONS QUOTING_STYLE \
      GIT_EXTERNAL_DIFF GIT_DIFF_OPTS GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS \
      GIT_ICASE_PATHSPECS TMOUT POSIXLY_CORRECT CDPATH
# Git's colour stays off for every git this runs; why, and what is out of reach: engine/harness/felix, above the same lines.
_felix_git_pin="'color.ui=never' 'color.advice=never' 'color.branch=never' 'color.diff=never' 'color.grep=never' 'color.interactive=never' 'color.push=never' 'color.remote=never' 'color.showBranch=never' 'color.status=never' 'color.transport=never' 'color.pager=false' 'blame.coloring=none'"
case " ${GIT_CONFIG_PARAMETERS-}" in
  *" $_felix_git_pin") ;;
  *) export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }$_felix_git_pin" ;;
esac
# hooks/session-start reads a payload from stdin unless it is a terminal, and about thirty calls here run it without piping one in, so an inherited pipe left open would hang the first. The suite reads nothing from its stdin: nothing is inherited.
exec </dev/null
HERE="$(cd "$(dirname "$0")" && pwd)"
REAL_HARNESS="$(cd "$HERE/.." && pwd)"
# REAL_HARNESS must name a harness before anything reads or copies it (part 0203: the two runs of 2026-10-08 that did not).
# A section runner sets its own REAL_HARNESS after the line above, wherever that line is.
if [ -z "$REAL_HARNESS" ] || [ ! -f "$REAL_HARNESS/felix" ] || [ ! -d "$REAL_HARNESS/lib" ]; then
  printf 'tests/run: REAL_HARNESS [%s] is not a harness (it needs felix and lib/); nothing was copied\n' "$REAL_HARNESS" >&2
  exit 2
fi
[ ! -r "$REAL_HARNESS/lib/deploy-hold.sh" ] || { . "$REAL_HARNESS/lib/deploy-hold.sh" && _dh_door "tests/run" "$@"; }   # the door: a run waits here while the lander owes a deploy
# The driver: the helpers every assertion uses, one line per part (part 1040 says why not a loop), then the manifest comparison and the verdict. _suite_files, _suite_src and _suite_flat are defined in part 0003.
PASS=0; FAIL=0
# Every assertion that RAN, by name, whatever its verdict: why, and why in a file, at the end of part 0001.
FELIX_TEST_RAN=""
# Each name is also offered to the origin guard (_og_tick, part 0003) once its state exists, so the helper block part 0770 lifts out of this file (this line to skip(), below) stays silent under set -u.
_ran() { [ -n "$FELIX_TEST_RAN" ] || return 0; [ -z "${_og_on:-}" ] || _og_tick "$1"; printf '%s\n' "$1" >> "$FELIX_TEST_RAN"; return 0; }
# The ran file as count<TAB>name rows sorted by name, the manifest's shape, each name kept byte for byte: cutting the count off by assigning to awk's $1 folded the blanks inside a name until 2026-10-01, and red read such a name as never reached (part 0770).
_ran_rows() {   # stdin: names, one a line -> count<TAB>name, sorted by name
  LC_ALL=C sort | uniq -c | LC_ALL=C awk '{ c = $1; sub(/^ *[0-9]+ /, ""); printf "%s\t%s\n", c, $0 }' \
    | LC_ALL=C sort -t"$(printf '\t')" -k2
}
# The names the manifest lists that a run reached fewer times than it lists them: want<TAB>got<TAB>name, in the manifest's order. One pass over both files (a loop of one awk per row was 88 s of the gate), names compared as bytes; the cases are in part 0770.
_manifest_short() {   # manifest counts
  LC_ALL=C awk -F'\t' '
    function name(line) { sub(/^\t+/, "", line); if (!sub(/^[^\t]*\t+/, "", line)) return ""; sub(/\t+$/, "", line); return line }
    function count(line) { sub(/^\t+/, "", line); sub(/\t.*$/, "", line); return line }
    FILENAME == ARGV[1] { got[name($0)] = count($0); next }
    { n = name($0); w = count($0) }
    n == "" || w !~ /^[0-9]+$/ { next }
    { g = (n in got) ? got[n] : 0 }
    g + 0 < w + 0 { printf "%s\t%s\t%s\n", w, g, n }
  ' "$2" "$1"
}
ok()   { PASS=$((PASS+1)); _ran "$1"; printf '  ok    %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); _ran "$1"; printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
is()   { [ "$2" = "$3" ] && ok "$1" || bad "$1" "expected [$3] got [$2]"; }
has()  { case "$2" in *"$3"*) ok "$1" ;; *) bad "$1" "[$2] lacks [$3]" ;; esac; }
# Some skips describe the machine (a real plugin needs the claude CLI), and a skip counts as REACHED for the manifest of what ran: part 0001 says why, above the line that makes the ran file.
SKIP=0
skip() { SKIP=$((SKIP+1)); _ran "$1"; printf '  skip  %s (%s)\n' "$1" "$2"; }
has_claude() { command -v claude >/dev/null 2>&1; }
. "$HERE/parts/0001-the-origin-guard-and-the-temporary-directory.sh"
. "$HERE/parts/0002-fixture-git-commands-stay-in-tmp.sh"
. "$HERE/parts/0003-the-lint-the-origin-record-and-the-exit-trap.sh"
# The manifest of assertions this suite is to reach, tracked beside it; `tests/run --record-assertions` writes it and runs red beside it (receipt.sh, "red, beside a record run"); FELIX_TEST_NO_MANIFEST=1 is how that red run asks this run not to compare.
FELIX_TEST_MANIFEST="$HERE/assertions.tsv"; FELIX_TEST_RECORD=0; _rcp_reuse=0
while :; do case "${1:-}" in
  --record-assertions) FELIX_TEST_RECORD=1; shift ;;
  --reuse)             _rcp_reuse=1; shift ;;
  -j)                  shift 2 ;;
  --part)              shift "$#" ;;
  *)                   break ;;
esac; done
[ "$_rcp_reuse$FELIX_TEST_RECORD" = 11 ] && { printf 'tests/run: --reuse and --record-assertions do not go together\n' >&2; exit 2; }
# The receipt (receipt.sh): --reuse answers from the last passed run on this tree, or runs. A red run and a part run load none:
# FELIX_TEST_NO_MANIFEST and part mode are tested first: red stands in the base's tree, whose own receipt.sh would otherwise load.
_rcp_on=0; _rcp_cmp=0; _rcp_judged=0; _rcp_why=""
if [ "${FELIX_TEST_NO_MANIFEST:-0}" = "1" ]; then _rcp_why="this is a red run"
elif [ -n "${_pm1:-}" ]; then _rcp_why="this is part mode"
elif . "$HERE/receipt.sh" 2>/dev/null; then _rcp_on=1
else _rcp_why="no tests/receipt.sh beside this suite"; fi
[ "$_rcp_on" -eq 1 ] || [ "$_rcp_reuse" -eq 0 ] || printf 'not reused: %s\n' "$_rcp_why"
if [ "$_rcp_on" -eq 1 ]; then
  # The dots resolved: felix_tree_id hashes untracked files by the path it was handed, so one tree spelled two ways is two ids.
  _rcp_root="$(cd "$REAL_HARNESS/../.." && pwd)"
  [ "$_rcp_reuse" -eq 0 ] || _rcp_answer "$_rcp_root"
  _rcp_begin "$_rcp_root"
fi
# Red starts here and not at the end, told where the mark is and which process to watch (receipt.sh, "red, beside a record run"), before the exports of part 0004, so that its suite is made in an environment of its own, as a plain run's is.
_rcp_red=""; if [ "$FELIX_TEST_RECORD" -eq 1 ] && [ "$_rcp_on" -eq 1 ] && [ -x "$HERE/red" ]; then _rcp_red_start "$TMP/manifest.mark"; fi
. "$HERE/parts/0004-the-widget-fixture.sh"
. "$HERE/parts/0005-fixture-floor.sh"
. "$HERE/parts/0006-the-lib-judges.sh"
. "$HERE/parts/0007-the-parallel-runner.sh"
# The names defined so far, one a line, for _lib_clashes: a lib file may not take one.
{ compgen -v; compgen -A function; } | LC_ALL=C sort -u > "$TMP/lib-before.names"
# tests/lib/*.sh, one line each, in name order (contract C2); none runs anything.
. "$HERE/lib/adopt-refusals.sh"
. "$HERE/lib/attempt-step.sh"
. "$HERE/lib/audit-review.sh"
. "$HERE/lib/audit.sh"
. "$HERE/lib/autocomm.sh"
