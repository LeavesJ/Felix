           | "$FROOT/harness/hooks/stop" 2>&1 )" in
  *'"decision"'*'"block"'*) ok  "and Stop, with no id, holds that tree as it always did" ;;
  *)                        bad "and Stop, with no id, holds that tree as it always did" ;;
esac
