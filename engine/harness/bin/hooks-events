#!/usr/bin/env bash
# The lifecycle events one hooks.json binds: the keys of its top-level "hooks"
# object, one per line, whatever the file's formatting.
#
#   hooks-events <hooks.json>
#
#   exit 0  the file was read; every event it binds is on stdout
#   exit 2  cannot examine: no path given, nothing readable at that path, or
#           a file that does not parse — one that leaves a brace open or ends
#           inside a string is not a document the platform would load, so the
#           keys a scanner can still pick out of it bind nothing. Never read
#           as "binds nothing".
#
# This is the `hook_binding` probe's instrument. The probe used to be a grep
# for `"Event": [`, and a blind-authored control moved the whole SubagentStop
# entry one level down into another event's matcher group — every token still
# present, the hook never firing — and the grep read it as bound. The check
# that judges the first admitted obligation was rewritten to read keys through
# felix_hooks_events; the probe that records the same fact kept the grep and
# shared the shadow. Now both read through the one scanner, so a key at the
# wrong depth, or inside a command string, is not an event to either.
#
# Lives beside the engine it reads for, so the probe row can name a bare path
# and felix_probe_source records this file's size as the instrument token.
#
# What that token is worth, stated rather than overclaimed: it tracks THIS
# file, and the scan it delegates to lives in lib/coverage.sh, so editing the
# awk there moves the count without moving the token. The first version of
# this comment claimed the opposite — that the token told a count that moved
# because the scanner changed from one that moved because the hooks did — and
# it is the reverse that holds. Carrying a copy of the scanner here to make
# the claim true would put the deciding code in two places, which is the
# worse trade; the record instead says which instrument answered, and the
# scanner's own change shows up in the diff of coverage.sh.
set -u
HERE="$(cd "$(dirname "$0")/.." && pwd)"
HOOKS="${1:-}"
[ -n "$HOOKS" ] || { printf 'usage: hooks-events <hooks.json>\n' >&2; exit 2; }
# -f and -r as well as -s: `[ -s ]` is true of a directory and of a file this
# user cannot read, and both used to fall through to a silent exit 0 — a
# cannot-examine reported as "binds nothing", which is the one reading the
# contract above forbids.
[ -f "$HOOKS" ] && [ -r "$HOOKS" ] && [ -s "$HOOKS" ] \
  || { printf 'hooks-events: cannot examine: nothing readable at %s\n' "$HOOKS" >&2; exit 2; }

# shellcheck source=../lib/coverage.sh
. "$HERE/lib/coverage.sh"
felix_hooks_events "$HOOKS" \
  || { printf 'hooks-events: cannot examine: %s does not parse as a document the platform would load\n' "$HOOKS" >&2; exit 2; }
exit 0
