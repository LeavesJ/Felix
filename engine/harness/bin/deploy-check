#!/usr/bin/env bash
# Is the engine main accepted the one deployed on this machine?
#
#   deploy-check            the evidence contract
#   deploy-check --applies  the applicability test
#
#   exit 0  the cache entry for the version main declares is byte-identical
#           to main's engine — harness, hooks and commands, ignoring what
#           git ignores
#   exit 1  it is not; every path that differs is on stdout, one per line,
#           which is the coverage report: what was examined and its verdict.
#           Or nothing is installed at the version main declares, which is
#           said in one line naming the version.
#   exit 2  cannot examine: no cache on this machine, no main to read, or a
#           version that cannot be read from it. Never read as matching.
#
#   --applies exits 0 when this obligation applies to this tree — a felix
#   cache exists on this machine and this repository has a main to read —
#   and 1 otherwise. A CI runner has no plugin cache; a repository with no
#   main cannot say what was accepted. Both are DORMANT, reported and never
#   waived, rather than a failure nobody standing there could fix.
#
# THE QUESTION CHANGED with #239 and this followed it. This asked whether the
# engine in the tree standing here was the deployed one, and only the checkout
# the marketplace serves could ever answer yes — so the obligation was dormant
# in every worktree and every runner, and the gate's `installed` check, which
# had moved to asking about MAIN's engine against MAIN's entry, disagreed with
# the ledger in every checkout that was not the served one. Both ask the same
# question now, through felix_accepted_deploy_diff, and the live pointer — the
# CLI's installPath, the marketplace registry — decides nothing. Installing a
# candidate adds a different entry and moves that pointer; it does not touch
# the entry main names, which is the one `felix merge` judges with.
#
# TASK_BLOCKING and not RELEASE_BLOCKING, still: what is owed is that a
# session does not end with main's engine and its deployment apart, and the
# remedy — `felix install` in the served checkout — is one command.
#
# Every way this script can fail to look is 126 or 127, never 1. On the
# applicability axis obligations.sh reads 1 as "does not apply here", which is
# DORMANT — a row that stops blocking — so a script that could not resolve its
# own library must answer "I could not say", which those two codes are.
set -u
# Before the cd, not after. `$0` is the path as invoked, so resolving it once
# the working directory has already moved to the repository toplevel made HERE
# empty for any relative invocation from a subdirectory; the source below then
# failed without exiting (set -u, no set -e) and both modes answered in the
# permissive direction.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." 2>/dev/null && pwd)" || exit 127
[ -n "$HERE" ] || exit 127
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 126
cd "$ROOT" || exit 126

# shellcheck source=../lib/resolve.sh
. "$HERE/lib/resolve.sh" 2>/dev/null || exit 127
command -v felix_base_ref             >/dev/null 2>&1 || exit 127
command -v felix_accepted_deploy_diff >/dev/null 2>&1 || exit 127

if [ "${1:-}" = "--applies" ]; then
  [ -d "${FELIX_KERNEL_CACHE:-${FELIX_PLUGIN_CACHE:-$HOME/.claude/plugins/cache}/felix/felix}" ] || exit 1
  felix_base_ref "$ROOT" >/dev/null 2>&1 || exit 1
  exit 0
fi

out="$(felix_accepted_deploy_diff "$ROOT" 2>/dev/null)"; rc=$?
case "$rc" in
  0) printf '  matches       %s\n' "$out"; exit 0 ;;
  2) printf 'deploy-check: %s\n' "$out"; exit 2 ;;
esac
printf '%s\n' "$out" | grep . | sed 's/^/  /'
case "$out" in
  *"nothing is installed at that version"*) ;;
  *) printf 'deploy-check: %s path(s) differ between the engine main declares and its entry\n' \
       "$(printf '%s\n' "$out" | grep -c .)" ;;
esac
exit 1
